@{
    ViewData["Title"] = "Condition Categories";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1" style="color:#052f4a;">
                <i class="fa-solid fa-folder-tree me-2"
                   style="color:#0284c7;"></i>

                Condition Categories
            </h4>

            <p class="text-muted mb-0" style="font-size:13px;">
                Manage categories used to organize medical conditions.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary px-3"
                data-bs-toggle="modal"
                data-bs-target="#conditionCategoryModal"
                onclick="openAddModal()">

            <i class="fa-solid fa-plus me-1"></i>
            Add Category

        </button>

    </div>


    <!-- =====================================================
         TABLE CARD
         ===================================================== -->

    <div class="card border-0 shadow-sm"
         style="border-radius:12px;">

        <div class="card-body p-0">

            <!-- TABLE TOOLBAR -->

            <div class="p-3 border-bottom">

                <div class="row g-2 align-items-center">

                    <div class="col-md-6">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>

                            <input type="text"
                                   id="categorySearch"
                                   class="form-control"
                                   placeholder="Search condition categories..."
                                   autocomplete="off" />

                        </div>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <span class="text-muted"
                              style="font-size:12px;">

                            <i class="fa-solid fa-circle-info me-1"></i>
                            Click a row to view details.

                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="conditionCategoriesTable">

                    <thead style="background:#f8fafc;">

                        <tr>

                            <th class="px-4 py-3"
                                style="width:100px; cursor:pointer;"
                                onclick="sortTable(0)">

                                ID

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3"
                                style="cursor:pointer;"
                                onclick="sortTable(1)">

                                Category Name

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3 text-center"
                                style="width:180px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <tbody id="categoryTableBody">

                        @if (Model != null)
                        {
                            foreach (var category in Model)
                            {
                                <tr class="category-row"
                                    data-id="@category.ConditionCategoryId"
                                    data-name="@category.Name"
                                    style="cursor:pointer;">

                                    <td class="px-4 fw-semibold text-muted">
                                        @category.ConditionCategoryId
                                    </td>

                                    <td>
                                        <span class="fw-semibold"
                                              style="color:#334155;">

                                            @category.Name

                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                title="Edit"
                                                onclick="event.stopPropagation(); openEditModal('@category.ConditionCategoryId', '@category.Name')">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>


                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                onclick="event.stopPropagation(); confirmDelete('@category.ConditionCategoryId', '@category.Name')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center py-5 text-muted">

                                    <i class="fa-solid fa-folder-open d-block mb-2"
                                       style="font-size:28px;"></i>

                                    No condition categories found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD / EDIT MODAL
     ========================================================= -->

<div class="modal fade"
     id="conditionCategoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#052f4a,#075985); color:#fff;">

                <div>

                    <h5 class="modal-title mb-1"
                        id="categoryModalTitle">

                        Add Condition Category

                    </h5>

                    <small style="color:rgba(255,255,255,.65);">
                        Maintain medical condition categories
                    </small>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form id="conditionCategoryForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <input type="hidden"
                           id="ConditionCategoryId"
                           name="ConditionCategoryId" />


                    <div class="mb-3">

                        <label for="Name"
                               class="form-label fw-semibold"
                               style="font-size:13px;">

                            Category Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               placeholder="Enter category name"
                               maxlength="100"
                               required />

                        <div class="form-text">
                            Example: Cardiovascular, Respiratory, Infectious Diseases.
                        </div>

                    </div>

                </div>


                <div class="modal-footer bg-light">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="saveCategoryButton">

                        <i class="fa-solid fa-floppy-disk me-1"></i>

                        Save Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     VIEW DETAILS MODAL
     ========================================================= -->

<div class="modal fade"
     id="categoryDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#052f4a,#075985); color:#fff;">

                <h5 class="modal-title">

                    <i class="fa-solid fa-folder-tree me-2"></i>
                    Category Details

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body p-4">

                <div class="mb-3">

                    <small class="text-muted d-block mb-1">
                        Category ID
                    </small>

                    <div class="fw-semibold"
                         id="detailsCategoryId">
                    </div>

                </div>


                <div>

                    <small class="text-muted d-block mb-1">
                        Category Name
                    </small>

                    <div class="fw-semibold"
                         style="color:#052f4a;"
                         id="detailsCategoryName">
                    </div>

                </div>

            </div>


            <div class="modal-footer bg-light">

                <button type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     DELETE MODAL
     ========================================================= -->

<div class="modal fade"
     id="deleteCategoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:#991b1b; color:#fff;">

                <h5 class="modal-title">

                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Delete Category

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form id="deleteCategoryForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <input type="hidden"
                           id="deleteCategoryId"
                           name="id" />

                    <p class="mb-2">
                        Are you sure you want to delete this condition category?
                    </p>

                    <div class="p-3 rounded"
                         style="background:#fef2f2; color:#991b1b;">

                        <i class="fa-solid fa-folder-tree me-2"></i>

                        <strong id="deleteCategoryName"></strong>

                    </div>

                    <small class="text-muted d-block mt-3">
                        This action cannot be undone if the category is not
                        referenced by any medical conditions.
                    </small>

                </div>


                <div class="modal-footer bg-light">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <style>

        .table thead th {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            border-bottom: 1px solid #e2e8f0;
        }

        .table tbody td {
            font-size: 13px;
            border-color: #eef2f7;
        }

        .table-hover tbody tr:hover {
            background-color: #f8fbff;
        }

        .form-control {
            border-color: #dbe3ec;
            border-radius: 8px;
            font-size: 13px;
            padding: 9px 12px;
        }

            .form-control:focus {
                border-color: #0284c7;
                box-shadow: 0 0 0 .2rem rgba(2,132,199,.12);
            }

        .btn {
            border-radius: 7px;
            font-size: 13px;
        }

        .modal-content {
            overflow: hidden;
        }

        .category-row {
            transition: background-color .15s ease;
        }

    </style>

}


@section Scripts {

    <script>

        let currentSortColumn = -1;
        let sortAscending = true;


        /* =====================================================
           SEARCH
           ===================================================== */

        document
            .getElementById("categorySearch")
            .addEventListener("keyup", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    document.querySelectorAll(
                        "#categoryTableBody .category-row"
                    );

                rows.forEach(function (row) {

                    const text =
                        row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(searchValue)
                            ? ""
                            : "none";

                });

            });


        /* =====================================================
           SORT
           ===================================================== */

        function sortTable(columnIndex) {

            const table =
                document.getElementById(
                    "conditionCategoriesTable"
                );

            const tbody =
                table.querySelector("tbody");

            const rows =
                Array.from(
                    tbody.querySelectorAll(".category-row")
                );

            if (currentSortColumn === columnIndex) {

                sortAscending =
                    !sortAscending;

            }
            else {

                currentSortColumn =
                    columnIndex;

                sortAscending = true;

            }


            rows.sort(function (a, b) {

                let valueA =
                    a.children[columnIndex]
                        .innerText
                        .trim()
                        .toLowerCase();

                let valueB =
                    b.children[columnIndex]
                        .innerText
                        .trim()
                        .toLowerCase();


                if (columnIndex === 0) {

                    valueA =
                        parseInt(valueA) || 0;

                    valueB =
                        parseInt(valueB) || 0;

                    return sortAscending
                        ? valueA - valueB
                        : valueB - valueA;
                }


                return sortAscending
                    ? valueA.localeCompare(valueB)
                    : valueB.localeCompare(valueA);

            });


            rows.forEach(function (row) {

                tbody.appendChild(row);

            });

        }


        /* =====================================================
           ROW DETAILS
           ===================================================== */

        document.addEventListener(
            "click",
            function (event) {

                const row =
                    event.target.closest(
                        ".category-row"
                    );

                if (!row)
                    return;

                document.getElementById(
                    "detailsCategoryId"
                ).innerText =
                    row.dataset.id;

                document.getElementById(
                    "detailsCategoryName"
                ).innerText =
                    row.dataset.name;


                const modal =
                    new bootstrap.Modal(
                        document.getElementById(
                            "categoryDetailsModal"
                        )
                    );

                modal.show();

            }
        );


        /* =====================================================
           ADD
           ===================================================== */

        function openAddModal() {

            document.getElementById(
                "categoryModalTitle"
            ).innerText =
                "Add Condition Category";

            document.getElementById(
                "ConditionCategoryId"
            ).value = "";

            document.getElementById(
                "Name"
            ).value = "";

            document.getElementById(
                "conditionCategoryForm"
            ).action =
                "@Url.Action("Create", "ConditionCategories", new { area = "Administrator" })";

        }


        /* =====================================================
           EDIT
           ===================================================== */

        function openEditModal(id, name) {

            document.getElementById(
                "categoryModalTitle"
            ).innerText =
                "Edit Condition Category";

            document.getElementById(
                "ConditionCategoryId"
            ).value =
                id;

            document.getElementById(
                "Name"
            ).value =
                name;

            document.getElementById(
                "conditionCategoryForm"
            ).action =
                "@Url.Action("Edit", "ConditionCategories", new { area = "Administrator" })";

            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "conditionCategoryModal"
                    )
                );

            modal.show();

        }


        /* =====================================================
           DELETE
           ===================================================== */

        function confirmDelete(id, name) {

            document.getElementById(
                "deleteCategoryId"
            ).value =
                id;

            document.getElementById(
                "deleteCategoryName"
            ).innerText =
                name;

            document.getElementById(
                "deleteCategoryForm"
            ).action =
                "@Url.Action("Delete", "ConditionCategories", new { area = "Administrator" })";


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "deleteCategoryModal"
                    )
                );

            modal.show();

        }

    </script>

}
