@model IEnumerable<NMB_HLabSys.Areas.Administrator.Models.MedicationModel>

@{
    ViewData["Title"] = "Medications";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1 fw-bold text-dark">
                Medications
            </h4>

            <div class="text-muted small">
                Manage medications and their categories.
            </div>
        </div>

        <button type="button"
                class="btn btn-primary shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#medicationModal"
                onclick="openCreateModal()">

            <i class="fa-solid fa-plus me-2"></i>
            Add Medication

        </button>

    </div>


    <!-- =========================================================
         CONTENT CARD
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <!-- =================================================
                 TABLE TOOLBAR
                 ================================================= -->

            <div class="p-3 border-bottom">

                <div class="row g-3 align-items-center">

                    <div class="col-md-6">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>

                            <input type="text"
                                   id="medicationSearch"
                                   class="form-control"
                                   placeholder="Search medications..."
                                   autocomplete="off" />

                        </div>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <span class="text-muted small">

                            <span id="medicationCount">
                                @(Model?.Count() ?? 0)
                            </span>

                            medications

                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="medicationTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4"
                                style="width:90px; cursor:pointer;"
                                data-sort="id">

                                ID

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th style="cursor:pointer;"
                                data-sort="name">

                                Medication

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th style="cursor:pointer;"
                                data-sort="category">

                                Category

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="text-end px-4"
                                style="width:150px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var medication in Model)
                            {
                                <tr class="medication-row"
                                    data-id="@medication.MedicationId"
                                    data-name="@medication.Name?.ToLower()"
                                    data-category="@medication.MedicationCategory?.Name?.ToLower()">

                                    <td class="px-4 fw-semibold text-muted">

                                        @medication.MedicationId

                                    </td>


                                    <td>

                                        <div class="fw-semibold text-dark">

                                            @medication.Name

                                        </div>

                                    </td>


                                    <td>

                                        @if (medication.MedicationCategory != null)
                                        {
                                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3 py-2">

                                                @medication.MedicationCategory.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Uncategorized
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end px-4">

                                        <div class="btn-group btn-group-sm"
                                             role="group">

                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit"
                                                    onclick="openEditModal(
                                                @medication.MedicationId,
                                                '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(medication.Name ?? ""))',
                                                @medication.MedicationCategoryId
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>


                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Delete"
                                                    onclick="confirmDelete(
                                                @medication.MedicationId,
                                                '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(medication.Name ?? ""))'
                                                )">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-pills fa-2x mb-3 opacity-50"></i>

                                        <div class="fw-semibold">
                                            No medications found.
                                        </div>

                                        <div class="small">
                                            Add a medication to get started.
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<!-- =============================================================
     ADD / EDIT MEDICATION MODAL
     ============================================================= -->

<div class="modal fade"
     id="medicationModal"
     tabindex="-1"
     aria-labelledby="medicationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <form id="medicationForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header border-0">

                    <div>

                        <h5 class="modal-title fw-bold"
                            id="medicationModalLabel">

                            Add Medication

                        </h5>

                        <div class="small text-muted">
                            Enter the medication details.
                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="MedicationId"
                           name="MedicationId"
                           value="0" />


                    <!-- MEDICATION NAME -->

                    <div class="mb-3">

                        <label for="Name"
                               class="form-label fw-semibold">

                            Medication Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               maxlength="150"
                               placeholder="Enter medication name"
                               required />

                    </div>


                    <!-- CATEGORY -->

                    <div class="mb-3">

                        <label for="MedicationCategoryId"
                               class="form-label fw-semibold">

                            Medication Category

                        </label>

                        <select id="MedicationCategoryId"
                                name="MedicationCategoryId"
                                class="form-select"
                                required>

                            <option value="">
                                Select medication category
                            </option>

                            @if (ViewBag.MedicationCategories != null)
                            {
                                foreach (var category in ViewBag.MedicationCategories)
                                {
                                    <option value="@category.MedicationCategoryId">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-2"></i>

                        <span id="submitButtonText">
                            Save Medication
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =============================================================
     DELETE MODAL
     ============================================================= -->

<div class="modal fade"
     id="deleteMedicationModal"
     tabindex="-1"
     aria-labelledby="deleteMedicationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content border-0 shadow-lg">

            <form id="deleteMedicationForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body text-center p-4">

                    <div class="mb-3">

                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                             style="width:60px;height:60px;background:#fef2f2;color:#dc2626;">

                            <i class="fa-solid fa-trash"></i>

                        </div>

                    </div>


                    <h5 class="fw-bold mb-2">
                        Delete Medication?
                    </h5>


                    <p class="text-muted small mb-0">

                        Are you sure you want to delete
                        <strong id="deleteMedicationName"></strong>?

                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-2"></i>
                        Delete

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Styles {

    <style>

        .card {
            border-radius: 12px;
            overflow: hidden;
        }

        .table {
            font-size: 13px;
        }

            .table thead th {
                color: #475569;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .3px;
                text-transform: uppercase;
                white-space: nowrap;
                border-bottom: 1px solid #e2e8f0;
            }

            .table tbody td {
                border-color: #eef2f7;
                color: #475569;
            }

        .table-hover tbody tr:hover {
            background-color: #f8fafc;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            border-color: #0284c7;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #0369a1, #075985);
                border-color: #0369a1;
            }

        .form-control,
        .form-select,
        .input-group-text {
            border-color: #dbe3ec;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #38bdf8;
                box-shadow: 0 0 0 .2rem rgba(14,165,233,.12);
            }

        .btn-group .btn {
            width: 34px;
            height: 32px;
        }

        .medication-row {
            transition: background-color .15s ease;
        }

        [data-sort] {
            user-select: none;
        }

            [data-sort]:hover {
                color: #0284c7 !important;
            }

        .modal-content {
            border-radius: 14px;
        }

        .badge {
            font-size: 10px;
            font-weight: 600;
        }

    </style>

}



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById("medicationSearch");

                const table =
                    document.getElementById("medicationTable");

                const count =
                    document.getElementById("medicationCount");


                /* =================================================
                   SEARCH
                   ================================================= */

                if (searchInput) {

                    searchInput.addEventListener(
                        "input",
                        function () {

                            const search =
                                this.value
                                    .toLowerCase()
                                    .trim();

                            const rows =
                                table.querySelectorAll(
                                    "tbody .medication-row"
                                );

                            let visible = 0;


                            rows.forEach(
                                function (row) {

                                    const name =
                                        row.dataset.name || "";

                                    const category =
                                        row.dataset.category || "";

                                    const id =
                                        row.dataset.id || "";


                                    const matches =
                                        name.includes(search) ||
                                        category.includes(search) ||
                                        id.includes(search);


                                    row.style.display =
                                        matches
                                            ? ""
                                            : "none";


                                    if (matches)
                                        visible++;

                                }
                            );


                            if (count)
                                count.textContent =
                                    visible;

                        }
                    );

                }


                /* =================================================
                   SORTING
                   ================================================= */

                const sortDirection = {};


                document
                    .querySelectorAll("[data-sort]")
                    .forEach(
                        function (header) {

                            header.addEventListener(
                                "click",
                                function () {

                                    const sort =
                                        this.dataset.sort;


                                    sortDirection[sort] =
                                        !sortDirection[sort];


                                    const ascending =
                                        sortDirection[sort];


                                    const tbody =
                                        table.querySelector(
                                            "tbody"
                                        );


                                    const rows =
                                        Array.from(
                                            tbody.querySelectorAll(
                                                ".medication-row"
                                            )
                                        );


                                    rows.sort(
                                        function (a, b) {

                                            let valueA;
                                            let valueB;


                                            if (sort === "id") {

                                                valueA =
                                                    parseInt(
                                                        a.dataset.id
                                                    );

                                                valueB =
                                                    parseInt(
                                                        b.dataset.id
                                                    );

                                                return ascending
                                                    ? valueA - valueB
                                                    : valueB - valueA;
                                            }


                                            if (sort === "name") {

                                                valueA =
                                                    a.dataset.name || "";

                                                valueB =
                                                    b.dataset.name || "";

                                            }
                                            else {

                                                valueA =
                                                    a.dataset.category || "";

                                                valueB =
                                                    b.dataset.category || "";

                                            }


                                            return ascending
                                                ? valueA.localeCompare(valueB)
                                                : valueB.localeCompare(valueA);

                                        }
                                    );


                                    rows.forEach(
                                        function (row) {

                                            tbody.appendChild(row);

                                        }
                                    );

                                }
                            );

                        }
                    );

            }
        );


        /* =========================================================
           CREATE
           ========================================================= */

        function openCreateModal() {

            document.getElementById(
                "medicationModalLabel"
            ).textContent =
                "Add Medication";


            document.getElementById(
                "submitButtonText"
            ).textContent =
                "Save Medication";


            document.getElementById(
                "MedicationId"
            ).value =
                "0";


            document.getElementById(
                "Name"
            ).value =
                "";


            document.getElementById(
                "MedicationCategoryId"
            ).value =
                "";


            document.getElementById(
                "medicationForm"
            ).action =
                "@Url.Action("Create", "Medications", new { area = "Administrator" })";

        }


        /* =========================================================
           EDIT
           ========================================================= */

        function openEditModal(id, name, categoryId) {

            document.getElementById(
                "medicationModalLabel"
            ).textContent =
                "Edit Medication";


            document.getElementById(
                "submitButtonText"
            ).textContent =
                "Update Medication";


            document.getElementById(
                "MedicationId"
            ).value =
                id;


            try {

                document.getElementById(
                    "Name"
                ).value =
                    JSON.parse(name);

            }
            catch {

                document.getElementById(
                    "Name"
                ).value =
                    name;

            }


            document.getElementById(
                "MedicationCategoryId"
            ).value =
                categoryId;


            document.getElementById(
                "medicationForm"
            ).action =
                "@Url.Action("Edit", "Medications", new { area = "Administrator" })";


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById(
                        "medicationModal"
                    )
                );


            modal.show();

        }


        /* =========================================================
           DELETE
           ========================================================= */

        function confirmDelete(id, name) {

            let medicationName =
                name;


            try {

                medicationName =
                    JSON.parse(name);

            }
            catch {
                // Use original value.
            }


            document.getElementById(
                "deleteMedicationName"
            ).textContent =
                medicationName;


            document.getElementById(
                "deleteMedicationForm"
            ).action =
                "@Url.Action("Delete", "Medications", new { area = "Administrator" })/" + id;


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById(
                        "deleteMedicationModal"
                    )
                );


            modal.show();

        }

    </script>

}
