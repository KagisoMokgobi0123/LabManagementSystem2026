@using NMB_HLabSys.Areas.Administrator.Models

@{
    ViewData["Title"] = "Medical Conditions";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";

    var categories = ViewBag.ConditionCategories as IEnumerable<ConditionCategoryModel>
                     ?? Enumerable.Empty<ConditionCategoryModel>();
}

<div class="container-fluid py-4">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1" style="color:#052f4a;">
                <i class="fa-solid fa-notes-medical me-2"
                   style="color:#0284c7;"></i>

                Medical Conditions
            </h4>

            <p class="text-muted mb-0" style="font-size:13px;">
                Manage medical conditions and their categories.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary px-3"
                data-bs-toggle="modal"
                data-bs-target="#conditionModal"
                onclick="openAddModal()">

            <i class="fa-solid fa-plus me-1"></i>
            Add Condition

        </button>

    </div>


    <!-- =====================================================
         TABLE CARD
         ===================================================== -->

    <div class="card border-0 shadow-sm"
         style="border-radius:12px;">

        <div class="card-body p-0">

            <!-- TABLE TOOLBAR -->

            <div class="p-3 border-bottom">

                <div class="row g-2 align-items-center">

                    <div class="col-md-6">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>

                            <input type="text"
                                   id="conditionSearch"
                                   class="form-control"
                                   placeholder="Search medical conditions..."
                                   autocomplete="off" />

                        </div>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <span class="text-muted"
                              style="font-size:12px;">

                            <i class="fa-solid fa-circle-info me-1"></i>
                            Click a row to view details.

                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="conditionsTable">

                    <thead style="background:#f8fafc;">

                        <tr>

                            <th class="px-4 py-3"
                                style="width:100px; cursor:pointer;"
                                onclick="sortTable(0)">

                                ID

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3"
                                style="cursor:pointer;"
                                onclick="sortTable(1)">

                                Condition

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3"
                                style="cursor:pointer;">

                                Category

                            </th>

                            <th class="py-3 text-center"
                                style="width:180px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <tbody id="conditionTableBody">

                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var condition in Model)
                            {
                                var category =
                                    categories.FirstOrDefault(
                                        x => x.ConditionCategoryId == condition.ConditionCategoryId);

                                var categoryName =
                                    category?.Name ?? "Uncategorized";

                                <tr class="condition-row"
                                    data-id="@condition.ConditionId"
                                    data-name="@condition.Name"
                                    data-category-id="@condition.ConditionCategoryId"
                                    data-category="@categoryName"
                                    style="cursor:pointer;">

                                    <td class="px-4 fw-semibold text-muted">
                                        @condition.ConditionId
                                    </td>

                                    <td>
                                        <span class="fw-semibold"
                                              style="color:#334155;">

                                            @condition.Name

                                        </span>
                                    </td>

                                    <td>

                                        <span class="badge rounded-pill"
                                              style="background:#e0f2fe; color:#075985; font-size:11px;">

                                            <i class="fa-solid fa-folder-tree me-1"></i>

                                            @categoryName

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                title="Edit"
                                                onclick="event.stopPropagation(); openEditModal('@condition.ConditionId', '@Html.Raw(condition.Name.Replace("'", "\\'"))', '@condition.ConditionCategoryId')">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>


                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                onclick="event.stopPropagation(); confirmDelete('@condition.ConditionId', '@Html.Raw(condition.Name.Replace("'", "\\'"))')">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center py-5 text-muted">

                                    <i class="fa-solid fa-notes-medical d-block mb-2"
                                       style="font-size:28px;"></i>

                                    No medical conditions found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD / EDIT MODAL
     ========================================================= -->

<div class="modal fade"
     id="conditionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#052f4a,#075985); color:#fff;">

                <div>

                    <h5 class="modal-title mb-1"
                        id="conditionModalTitle">

                        Add Medical Condition

                    </h5>

                    <small style="color:rgba(255,255,255,.65);">
                        Maintain medical conditions
                    </small>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form id="conditionForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <input type="hidden"
                           id="ConditionId"
                           name="ConditionId" />


                    <!-- CONDITION NAME -->

                    <div class="mb-3">

                        <label for="Name"
                               class="form-label fw-semibold"
                               style="font-size:13px;">

                            Condition Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               placeholder="Enter medical condition"
                               maxlength="150"
                               required />

                    </div>


                    <!-- CATEGORY -->

                    <div class="mb-3">

                        <label for="ConditionCategoryId"
                               class="form-label fw-semibold"
                               style="font-size:13px;">

                            Condition Category

                        </label>

                        <select id="ConditionCategoryId"
                                name="ConditionCategoryId"
                                class="form-select"
                                required>

                            <option value="">
                                Select category
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.ConditionCategoryId">
                                    @category.Name
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-footer bg-light">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="saveConditionButton">

                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Save Condition

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     VIEW DETAILS MODAL
     ========================================================= -->

<div class="modal fade"
     id="conditionDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#052f4a,#075985); color:#fff;">

                <h5 class="modal-title">

                    <i class="fa-solid fa-notes-medical me-2"></i>
                    Condition Details

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body p-4">

                <div class="mb-3">

                    <small class="text-muted d-block mb-1">
                        Condition ID
                    </small>

                    <div class="fw-semibold"
                         id="detailsConditionId">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block mb-1">
                        Condition Name
                    </small>

                    <div class="fw-semibold"
                         style="color:#052f4a;"
                         id="detailsConditionName">
                    </div>

                </div>


                <div>

                    <small class="text-muted d-block mb-1">
                        Category
                    </small>

                    <div class="fw-semibold"
                         id="detailsConditionCategory">
                    </div>

                </div>

            </div>


            <div class="modal-footer bg-light">

                <button type="button"
                        class="btn btn-light border"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     DELETE MODAL
     ========================================================= -->

<div class="modal fade"
     id="deleteConditionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header"
                 style="background:#991b1b; color:#fff;">

                <h5 class="modal-title">

                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Delete Condition

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form id="deleteConditionForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <input type="hidden"
                           id="deleteConditionId"
                           name="id" />

                    <p class="mb-2">
                        Are you sure you want to delete this medical condition?
                    </p>

                    <div class="p-3 rounded"
                         style="background:#fef2f2; color:#991b1b;">

                        <i class="fa-solid fa-notes-medical me-2"></i>

                        <strong id="deleteConditionName"></strong>

                    </div>

                    <small class="text-muted d-block mt-3">
                        This action cannot be undone if the condition is not
                        referenced elsewhere in the system.
                    </small>

                </div>


                <div class="modal-footer bg-light">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Condition

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <style>

        .table thead th {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            border-bottom: 1px solid #e2e8f0;
        }

        .table tbody td {
            font-size: 13px;
            border-color: #eef2f7;
        }

        .table-hover tbody tr:hover {
            background-color: #f8fbff;
        }

        .form-control,
        .form-select {
            border-color: #dbe3ec;
            border-radius: 8px;
            font-size: 13px;
            padding: 9px 12px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0284c7;
                box-shadow: 0 0 0 .2rem rgba(2,132,199,.12);
            }

        .btn {
            border-radius: 7px;
            font-size: 13px;
        }

        .modal-content {
            overflow: hidden;
        }

        .condition-row {
            transition: background-color .15s ease;
        }

    </style>

}


@section Scripts {

    <script>

        let currentSortColumn = -1;
        let sortAscending = true;


        /* =====================================================
           SEARCH
           ===================================================== */

        document
            .getElementById("conditionSearch")
            .addEventListener("keyup", function () {

                const searchValue =
                    this.value.toLowerCase().trim();

                const rows =
                    document.querySelectorAll(
                        "#conditionTableBody .condition-row"
                    );

                rows.forEach(function (row) {

                    const text =
                        row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(searchValue)
                            ? ""
                            : "none";

                });

            });


        /* =====================================================
           SORT
           ===================================================== */

        function sortTable(columnIndex) {

            const table =
                document.getElementById(
                    "conditionsTable"
                );

            const tbody =
                table.querySelector("tbody");

            const rows =
                Array.from(
                    tbody.querySelectorAll(".condition-row")
                );


            if (currentSortColumn === columnIndex) {

                sortAscending =
                    !sortAscending;

            }
            else {

                currentSortColumn =
                    columnIndex;

                sortAscending = true;

            }


            rows.sort(function (a, b) {

                let valueA =
                    a.children[columnIndex]
                        .innerText
                        .trim()
                        .toLowerCase();

                let valueB =
                    b.children[columnIndex]
                        .innerText
                        .trim()
                        .toLowerCase();


                if (columnIndex === 0) {

                    valueA =
                        parseInt(valueA) || 0;

                    valueB =
                        parseInt(valueB) || 0;

                    return sortAscending
                        ? valueA - valueB
                        : valueB - valueA;
                }


                return sortAscending
                    ? valueA.localeCompare(valueB)
                    : valueB.localeCompare(valueA);

            });


            rows.forEach(function (row) {

                tbody.appendChild(row);

            });

        }


        /* =====================================================
           ROW DETAILS
           ===================================================== */

        document.addEventListener(
            "click",
            function (event) {

                const row =
                    event.target.closest(
                        ".condition-row"
                    );

                if (!row)
                    return;

                document.getElementById(
                    "detailsConditionId"
                ).innerText =
                    row.dataset.id;

                document.getElementById(
                    "detailsConditionName"
                ).innerText =
                    row.dataset.name;

                document.getElementById(
                    "detailsConditionCategory"
                ).innerText =
                    row.dataset.category;


                const modal =
                    new bootstrap.Modal(
                        document.getElementById(
                            "conditionDetailsModal"
                        )
                    );

                modal.show();

            }
        );


        /* =====================================================
           ADD
           ===================================================== */

        function openAddModal() {

            document.getElementById(
                "conditionModalTitle"
            ).innerText =
                "Add Medical Condition";

            document.getElementById(
                "ConditionId"
            ).value = "";

            document.getElementById(
                "Name"
            ).value = "";

            document.getElementById(
                "ConditionCategoryId"
            ).value = "";


            document.getElementById(
                "conditionForm"
            ).action =
                "@Url.Action("Create", "Conditions", new { area = "Administrator" })";

        }


        /* =====================================================
           EDIT
           ===================================================== */

        function openEditModal(id, name, categoryId) {

            document.getElementById(
                "conditionModalTitle"
            ).innerText =
                "Edit Medical Condition";

            document.getElementById(
                "ConditionId"
            ).value =
                id;

            document.getElementById(
                "Name"
            ).value =
                name;

            document.getElementById(
                "ConditionCategoryId"
            ).value =
                categoryId;


            document.getElementById(
                "conditionForm"
            ).action =
                "@Url.Action("Edit", "Conditions", new { area = "Administrator" })";


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "conditionModal"
                    )
                );

            modal.show();

        }


        /* =====================================================
           DELETE
           ===================================================== */

        function confirmDelete(id, name) {

            document.getElementById(
                "deleteConditionId"
            ).value =
                id;

            document.getElementById(
                "deleteConditionName"
            ).innerText =
                name;


            document.getElementById(
                "deleteConditionForm"
            ).action =
                "@Url.Action("Delete", "Conditions", new { area = "Administrator" })";


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "deleteConditionModal"
                    )
                );

            modal.show();

        }

    </script>

}
