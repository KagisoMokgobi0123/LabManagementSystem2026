@model IEnumerable<NMB_HLabSys.Areas.Administrator.Models.MedicationCategory>

@{
    ViewData["Title"] = "Medication Categories";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container-fluid px-4 py-4">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1 fw-bold text-dark">
                Medication Categories
            </h4>

            <div class="text-muted small">
                Manage categories used to organize medications.
            </div>
        </div>

        <button type="button"
                class="btn btn-primary shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#medicationCategoryModal"
                onclick="openCreateModal()">

            <i class="fa-solid fa-plus me-2"></i>
            Add Category

        </button>

    </div>


    <!-- =========================================================
         CONTENT CARD
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <!-- =================================================
                 TABLE TOOLBAR
                 ================================================= -->

            <div class="p-3 border-bottom">

                <div class="row g-3 align-items-center">

                    <div class="col-md-6">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="fa-solid fa-magnifying-glass text-muted"></i>
                            </span>

                            <input type="text"
                                   id="categorySearch"
                                   class="form-control"
                                   placeholder="Search medication categories..."
                                   autocomplete="off" />

                        </div>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <span class="text-muted small">
                            <span id="categoryCount">
                                @(Model?.Count() ?? 0)
                            </span>
                            categories
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="medicationCategoryTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4"
                                style="width: 100px; cursor:pointer;"
                                data-sort="id">

                                ID

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th style="cursor:pointer;"
                                data-sort="name">

                                Category Name

                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="text-end px-4"
                                style="width: 150px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var category in Model)
                            {
                                <tr class="category-row"
                                    data-id="@category.MedicationCategoryId"
                                    data-name="@category.Name?.ToLower()">

                                    <td class="px-4 fw-semibold text-muted">
                                        @category.MedicationCategoryId
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @category.Name
                                        </div>
                                    </td>

                                    <td class="text-end px-4">

                                        <div class="btn-group btn-group-sm"
                                             role="group">

                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit"
                                                    data-name="@category.Name"
                                                    onclick="openEditModal(@category.MedicationCategoryId, this.dataset.name)">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Delete"
                                                    data-name="@category.Name"
                                                    onclick="confirmDelete(@category.MedicationCategoryId, this.dataset.name)">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyRow">

                                <td colspan="3"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-folder-open fa-2x mb-3 opacity-50"></i>

                                        <div class="fw-semibold">
                                            No medication categories found.
                                        </div>

                                        <div class="small">
                                            Add a category to get started.
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



<!-- =============================================================
     ADD / EDIT MODAL
     ============================================================= -->

<div class="modal fade"
     id="medicationCategoryModal"
     tabindex="-1"
     aria-labelledby="medicationCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <form id="medicationCategoryForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header border-0">

                    <div>

                        <h5 class="modal-title fw-bold"
                            id="medicationCategoryModalLabel">

                            Add Medication Category

                        </h5>

                        <div class="small text-muted">
                            Enter the medication category details.
                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="MedicationCategoryId"
                           name="MedicationCategoryId"
                           value="0" />


                    <div class="mb-3">

                        <label for="Name"
                               class="form-label fw-semibold">

                            Category Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter category name"
                               required />

                        <div class="form-text">
                            Example: Antibiotics, Analgesics, Antihypertensives.
                        </div>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-2"></i>

                        <span id="submitButtonText">
                            Save Category
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =============================================================
     DELETE MODAL
     ============================================================= -->

<div class="modal fade"
     id="deleteCategoryModal"
     tabindex="-1"
     aria-labelledby="deleteCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content border-0 shadow-lg">

            <form id="deleteCategoryForm"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteCategoryId" name="id" value="0" />

                <div class="modal-body text-center p-4">

                    <div class="mb-3">

                        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle"
                             style="width:60px;height:60px;background:#fef2f2;color:#dc2626;">

                            <i class="fa-solid fa-trash"></i>

                        </div>

                    </div>

                    <h5 class="fw-bold mb-2">
                        Delete Category?
                    </h5>

                    <p class="text-muted small mb-0">

                        Are you sure you want to delete
                        <strong id="deleteCategoryName"></strong>?

                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-2"></i>
                        Delete

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Styles {

    <style>

        .card {
            border-radius: 12px;
            overflow: hidden;
        }

        .table {
            font-size: 13px;
        }

            .table thead th {
                color: #475569;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .3px;
                text-transform: uppercase;
                white-space: nowrap;
                border-bottom: 1px solid #e2e8f0;
            }

            .table tbody td {
                border-color: #eef2f7;
                color: #475569;
            }

        .table-hover tbody tr:hover {
            background-color: #f8fafc;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            border-color: #0284c7;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #0369a1, #075985);
                border-color: #0369a1;
            }

        .form-control,
        .input-group-text {
            border-color: #dbe3ec;
        }

            .form-control:focus {
                border-color: #38bdf8;
                box-shadow: 0 0 0 .2rem rgba(14,165,233,.12);
            }

        .btn-group .btn {
            width: 34px;
            height: 32px;
        }

        .category-row {
            transition: background-color .15s ease;
        }

        [data-sort] {
            user-select: none;
        }

            [data-sort]:hover {
                color: #0284c7 !important;
            }

        .modal-content {
            border-radius: 14px;
        }

    </style>

}



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const searchInput =
                    document.getElementById("categorySearch");

                const table =
                    document.getElementById("medicationCategoryTable");

                const count =
                    document.getElementById("categoryCount");


                /* =================================================
                   SEARCH
                   ================================================= */

                if (searchInput) {

                    searchInput.addEventListener(
                        "input",
                        function () {

                            const search =
                                this.value
                                    .toLowerCase()
                                    .trim();

                            const rows =
                                table.querySelectorAll(
                                    "tbody .category-row"
                                );

                            let visible =
                                0;


                            rows.forEach(
                                function (row) {

                                    const name =
                                        row.dataset.name || "";

                                    const id =
                                        row.dataset.id || "";

                                    const matches =
                                        name.includes(search) ||
                                        id.includes(search);

                                    row.style.display =
                                        matches
                                            ? ""
                                            : "none";

                                    if (matches)
                                        visible++;
                                }
                            );


                            if (count)
                                count.textContent =
                                    visible;
                        }
                    );

                }


                /* =================================================
                   SORTING
                   ================================================= */

                let sortDirection = {};


                document
                    .querySelectorAll("[data-sort]")
                    .forEach(
                        function (header) {

                            header.addEventListener(
                                "click",
                                function () {

                                    const sort =
                                        this.dataset.sort;

                                    sortDirection[sort] =
                                        !sortDirection[sort];

                                    const ascending =
                                        sortDirection[sort];

                                    const tbody =
                                        table.querySelector(
                                            "tbody"
                                        );

                                    const rows =
                                        Array.from(
                                            tbody.querySelectorAll(
                                                ".category-row"
                                            )
                                        );


                                    rows.sort(
                                        function (a, b) {

                                            let valueA;
                                            let valueB;


                                            if (sort === "id") {

                                                valueA =
                                                    parseInt(
                                                        a.dataset.id
                                                    );

                                                valueB =
                                                    parseInt(
                                                        b.dataset.id
                                                    );

                                                return ascending
                                                    ? valueA - valueB
                                                    : valueB - valueA;
                                            }


                                            valueA =
                                                a.dataset.name || "";

                                            valueB =
                                                b.dataset.name || "";


                                            return ascending
                                                ? valueA.localeCompare(valueB)
                                                : valueB.localeCompare(valueA);

                                        }
                                    );


                                    rows.forEach(
                                        function (row) {

                                            tbody.appendChild(row);

                                        }
                                    );

                                }
                            );

                        }
                    );

            }
        );


        /* =========================================================
           CREATE
           ========================================================= */

        function openCreateModal() {

            document.getElementById(
                "medicationCategoryModalLabel"
            ).textContent =
                "Add Medication Category";


            document.getElementById(
                "submitButtonText"
            ).textContent =
                "Save Category";


            document.getElementById(
                "MedicationCategoryId"
            ).value =
                "0";


            document.getElementById(
                "Name"
            ).value =
                "";


            document.getElementById(
                "medicationCategoryForm"
            ).action =
                "@Url.Action("Create", "MedicationCategories", new { area = "Administrator" })";

        }


        /* =========================================================
           EDIT
           ========================================================= */

        function openEditModal(id, name) {

            document.getElementById(
                "medicationCategoryModalLabel"
            ).textContent =
                "Edit Medication Category";


            document.getElementById(
                "submitButtonText"
            ).textContent =
                "Update Category";


            document.getElementById(
                "MedicationCategoryId"
            ).value =
                id;


            document.getElementById("Name").value = name || "";


            document.getElementById(
                "medicationCategoryForm"
            ).action =
                "@Url.Action("Edit", "MedicationCategories", new { area = "Administrator" })";


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById(
                        "medicationCategoryModal"
                    )
                );

            modal.show();

        }


        /* =========================================================
           DELETE
           ========================================================= */

        function confirmDelete(id, name) {

            const categoryName = name || "";


            document.getElementById(
                "deleteCategoryName"
            ).textContent =
                categoryName;


            document.getElementById("deleteCategoryId").value = id;
            document.getElementById(
                "deleteCategoryForm"
            ).action =
                "@Url.Action("Delete", "MedicationCategories", new { area = "Administrator" })";


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById(
                        "deleteCategoryModal"
                    )
                );

            modal.show();

        }

    </script>

}
