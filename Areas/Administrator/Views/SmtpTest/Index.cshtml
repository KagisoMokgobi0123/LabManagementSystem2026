@{
    ViewData["Title"] = "SMTP Test";
    Layout = "_AdministratorLayout";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                NMB-HLabSys Gmail SMTP Test
            </h4>
        </div>

        <div class="card-body p-4">

            <p class="text-muted mb-4">
                Test the Gmail SMTP connection by sending
                a demonstration PDF attachment.

                No patient information or clinical results
                will be included.
            </p>

            <div class="alert alert-info">
                <strong>Test Information</strong>

                <p class="mb-0 mt-2">
                    This test sends an email using the
                    configured technician Gmail account.

                    The recipient should be an email
                    address you control.
                </p>
            </div>

            <!-- Explicit action URL prevents incorrect POST routing -->
            <form method="post"
                  action="@Url.Action("Send", "SmtpTest", new { area = "Administrator" })">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label for="recipientEmail"
                           class="form-label fw-semibold">
                        Test Recipient Email
                    </label>

                    <input type="email"
                           id="recipientEmail"
                           name="recipientEmail"
                           class="form-control"
                           placeholder="Enter recipient Gmail address"
                           autocomplete="email"
                           required />

                    <small class="text-muted">
                        Enter an email address that you can access.
                    </small>

                </div>

                <div class="d-flex align-items-center gap-3">

                    <button type="submit"
                            id="sendTestButton"
                            class="btn btn-primary">
                        Send Test Email
                    </button>

                    <a href="@Url.Action("Index", "Home", new { area = "Administrator" })"
                       class="btn btn-outline-secondary">
                        Back to Dashboard
                    </a>

                </div>

            </form>

            <hr class="my-4" />

            <div class="text-muted small">
                <strong>Expected attachment:</strong>
                NMB-HLabSys-SMTP-Test.pdf

                <p class="mb-0 mt-2">
                    This is a development-only SMTP test.
                    It does not modify laboratory records.
                </p>
            </div>

        </div>
    </div>

</div>
