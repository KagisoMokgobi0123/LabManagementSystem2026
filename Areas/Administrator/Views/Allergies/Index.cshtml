@model IEnumerable<NMB_HLabSys.Areas.Administrator.Models.Allergy>

@{
    ViewData["Title"] = "Allergies";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1" style="color:#052f4a;">
                Allergies
            </h4>

            <p class="text-muted mb-0" style="font-size:13px;">
                Manage the allergies available in the laboratory system.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary px-4"
                data-bs-toggle="modal"
                data-bs-target="#allergyModal"
                onclick="openCreateModal()">

            <i class="fa-solid fa-plus me-2"></i>
            Add Allergy

        </button>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         TABLE CARD
         ========================================================= -->

    <div class="card border-0 shadow-sm"
         style="border-radius:12px;">

        <div class="card-body p-0">

            <!-- TABLE TOOLBAR -->

            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom">

                <div>
                    <span class="fw-semibold"
                          style="color:#334155; font-size:14px;">

                        Allergy List

                    </span>

                    <span class="badge ms-2"
                          style="background:#e0f2fe; color:#075985;"
                          id="recordCount">

                        @Model.Count()

                    </span>
                </div>


                <div class="mt-2 mt-md-0"
                     style="width:280px;">

                    <div class="input-group input-group-sm">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                        </span>

                        <input type="text"
                               id="allergySearch"
                               class="form-control"
                               placeholder="Search allergies..."
                               autocomplete="off" />

                    </div>

                </div>

            </div>


            <!-- TABLE -->

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="allergiesTable">

                    <thead style="background:#f8fafc;">

                        <tr>

                            <th class="px-4 py-3"
                                style="width:80px; cursor:pointer;"
                                data-sort="id">

                                #
                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3"
                                style="cursor:pointer;"
                                data-sort="name">

                                Allergy
                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3"
                                style="cursor:pointer;"
                                data-sort="category">

                                Category
                                <i class="fa-solid fa-sort ms-1 text-muted"></i>

                            </th>

                            <th class="py-3 text-center"
                                style="width:150px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <tbody id="allergiesTableBody">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var allergy in Model)
                            {
                                <tr class="allergy-row"
                                    data-id="@allergy.AllergyId"
                                    data-name="@allergy.Name"
                                    data-category="@allergy.Category?.Name">

                                    <td class="px-4 text-muted">
                                        @allergy.AllergyId
                                    </td>

                                    <td>

                                        <div class="fw-semibold"
                                             style="color:#334155;">

                                            @allergy.Name

                                        </div>

                                    </td>

                                    <td>

                                        @if (allergy.Category != null)
                                        {
                                            <span class="badge"
                                                  style="background:#e0f2fe; color:#075985;">

                                                @allergy.Category.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Uncategorised
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group btn-group-sm"
                                             role="group">

                                            <!-- VIEW -->

                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="View"
                                                    onclick="viewAllergy(
                                                '@allergy.AllergyId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(allergy.Name ?? ""))',
                                                '@allergy.AllergyCategoryId'
                                                )">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>


                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit"
                                                    onclick="editAllergy(
                                                '@allergy.AllergyId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(allergy.Name ?? ""))',
                                                '@allergy.AllergyCategoryId'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>


                                            <!-- DELETE -->

                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Delete"
                                                    onclick="deleteAllergy(
                                                '@allergy.AllergyId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(allergy.Name ?? ""))'
                                                )">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyRow">

                                <td colspan="4"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-triangle-exclamation fa-2x mb-3"></i>

                                        <div>
                                            No allergies have been added yet.
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     ADD / EDIT MODAL
     ============================================================= -->

<div class="modal fade"
     id="allergyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <form id="allergyForm"
                  method="post"
                  asp-area="Administrator"
                  asp-controller="Allergies"
                  asp-action="Create">

                @Html.AntiForgeryToken()

                <div class="modal-header border-0 px-4 pt-4">

                    <div>

                        <h5 class="modal-title fw-bold"
                            id="allergyModalTitle"
                            style="color:#052f4a;">

                            Add Allergy

                        </h5>

                        <small class="text-muted">
                            Add an allergy to the system.
                        </small>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body px-4">

                    <input type="hidden"
                           id="AllergyId"
                           name="AllergyId"
                           value="0" />


                    <div class="mb-3">

                        <label for="Name"
                               class="form-label fw-semibold">

                            Allergy Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               placeholder="Enter allergy name"
                               maxlength="200"
                               required />

                    </div>


                    <div class="mb-3">

                        <label for="AllergyCategoryId"
                               class="form-label fw-semibold">

                            Category

                        </label>

                        <select id="AllergyCategoryId"
                                name="AllergyCategoryId"
                                class="form-select"
                                required>

                            <option value="">
                                Select category
                            </option>

                            @if (ViewBag.AllergyCategories != null)
                            {
                                foreach (var category in ViewBag.AllergyCategories)
                                {
                                    <option value="@category.AllergyCategoryId">
                                        @category.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-footer border-0 px-4 pb-4">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        <span id="saveButtonText">
                            Save Allergy
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     VIEW MODAL
     ============================================================= -->

<div class="modal fade"
     id="viewAllergyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <div class="modal-header border-0 px-4 pt-4">

                <div>

                    <h5 class="modal-title fw-bold"
                        style="color:#052f4a;">

                        Allergy Details

                    </h5>

                    <small class="text-muted">
                        Allergy information
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body px-4">

                <div class="mb-3">

                    <label class="text-muted small">
                        Allergy
                    </label>

                    <div class="fw-semibold"
                         id="viewAllergyName">
                    </div>

                </div>


                <div class="mb-3">

                    <label class="text-muted small">
                        Category
                    </label>

                    <div class="fw-semibold"
                         id="viewAllergyCategory">
                    </div>

                </div>


                <div>

                    <label class="text-muted small">
                        Allergy ID
                    </label>

                    <div class="fw-semibold"
                         id="viewAllergyId">
                    </div>

                </div>

            </div>


            <div class="modal-footer border-0 px-4 pb-4">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE MODAL
     ============================================================= -->

<div class="modal fade"
     id="deleteAllergyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow"
             style="border-radius:14px;">

            <form method="post"
                  asp-area="Administrator"
                  asp-controller="Allergies"
                  asp-action="Delete">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteAllergyId"
                       name="id" />


                <div class="modal-header border-0 px-4 pt-4">

                    <h5 class="modal-title fw-bold text-danger">

                        Delete Allergy

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body px-4">

                    <p class="mb-0">

                        Are you sure you want to delete

                        <strong id="deleteAllergyName"></strong>?

                    </p>

                </div>


                <div class="modal-footer border-0 px-4 pb-4">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-2"></i>

                        Delete

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <style>

        #allergiesTable thead th {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        #allergiesTable tbody td {
            font-size: 13px;
            color: #475569;
        }

        #allergiesTable tbody tr {
            transition: background .15s ease;
        }

            #allergiesTable tbody tr:hover {
                background: #f8fafc;
            }

        .btn-outline-primary {
            border-color: #0284c7;
            color: #0284c7;
        }

            .btn-outline-primary:hover {
                background: #0284c7;
                border-color: #0284c7;
                color: #fff;
            }

        .form-control:focus,
        .form-select:focus {
            border-color: #0284c7;
            box-shadow: 0 0 0 .2rem rgba(2,132,199,.12);
        }

    </style>

}


@section Scripts {

    <script>

        let currentSortColumn = "id";
        let currentSortDirection = "asc";


        /* =========================================================
           CREATE
           ========================================================= */

        function openCreateModal() {

            const form =
                document.getElementById("allergyForm");

            form.action =
                "@Url.Action("Create", "Allergies", new { area = "Administrator" })";

            document.getElementById("allergyModalTitle")
                .innerText = "Add Allergy";

            document.getElementById("saveButtonText")
                .innerText = "Save Allergy";

            document.getElementById("AllergyId")
                .value = "0";

            document.getElementById("Name")
                .value = "";

            document.getElementById("AllergyCategoryId")
                .value = "";

        }


        /* =========================================================
           VIEW
           ========================================================= */

        function viewAllergy(id, name, categoryId) {

            document.getElementById("viewAllergyId")
                .innerText = id;

            document.getElementById("viewAllergyName")
                .innerText = name;

            const category =
                document.querySelector(
                    '#AllergyCategoryId option[value="' +
                    categoryId +
                    '"]'
                );

            document.getElementById("viewAllergyCategory")
                .innerText =
                category
                    ? category.textContent.trim()
                    : "Uncategorised";

            new bootstrap.Modal(
                document.getElementById("viewAllergyModal")
            ).show();

        }


        /* =========================================================
           EDIT
           ========================================================= */

        function editAllergy(id, name, categoryId) {

            const form =
                document.getElementById("allergyForm");

            form.action =
                "@Url.Action("Edit", "Allergies", new { area = "Administrator" })";

            document.getElementById("allergyModalTitle")
                .innerText = "Edit Allergy";

            document.getElementById("saveButtonText")
                .innerText = "Update Allergy";

            document.getElementById("AllergyId")
                .value = id;

            document.getElementById("Name")
                .value = name;

            document.getElementById("AllergyCategoryId")
                .value = categoryId;

            new bootstrap.Modal(
                document.getElementById("allergyModal")
            ).show();

        }


        /* =========================================================
           DELETE
           ========================================================= */

        function deleteAllergy(id, name) {

            document.getElementById("deleteAllergyId")
                .value = id;

            document.getElementById("deleteAllergyName")
                .innerText = name;

            new bootstrap.Modal(
                document.getElementById("deleteAllergyModal")
            ).show();

        }


        /* =========================================================
           SEARCH
           ========================================================= */

        document.getElementById("allergySearch")
            .addEventListener(
                "input",
                function () {

                    const search =
                        this.value.toLowerCase().trim();

                    const rows =
                        document.querySelectorAll(
                            "#allergiesTableBody .allergy-row"
                        );

                    let visibleCount = 0;

                    rows.forEach(function (row) {

                        const name =
                            row.dataset.name
                                .toLowerCase();

                        const category =
                            (
                                row.dataset.category || ""
                            ).toLowerCase();

                        const id =
                            row.dataset.id
                                .toLowerCase();

                        const matches =
                            name.includes(search) ||
                            category.includes(search) ||
                            id.includes(search);

                        row.style.display =
                            matches ? "" : "none";

                        if (matches)
                            visibleCount++;

                    });

                    document.getElementById("recordCount")
                        .innerText = visibleCount;

                }
            );


        /* =========================================================
           SORTING
           ========================================================= */

        document.querySelectorAll(
            "#allergiesTable thead th[data-sort]"
        ).forEach(function (header) {

            header.addEventListener(
                "click",
                function () {

                    const column =
                        this.dataset.sort;

                    if (
                        currentSortColumn === column
                    ) {

                        currentSortDirection =
                            currentSortDirection === "asc"
                                ? "desc"
                                : "asc";

                    }
                    else {

                        currentSortColumn =
                            column;

                        currentSortDirection =
                            "asc";

                    }

                    sortAllergies();

                }
            );

        });


        function sortAllergies() {

            const tbody =
                document.getElementById(
                    "allergiesTableBody"
                );

            const rows =
                Array.from(
                    tbody.querySelectorAll(
                        ".allergy-row"
                    )
                );

            rows.sort(function (a, b) {

                let valueA;
                let valueB;

                if (
                    currentSortColumn === "id"
                ) {

                    valueA =
                        parseInt(a.dataset.id);

                    valueB =
                        parseInt(b.dataset.id);

                }
                else if (
                    currentSortColumn === "name"
                ) {

                    valueA =
                        a.dataset.name.toLowerCase();

                    valueB =
                        b.dataset.name.toLowerCase();

                }
                else {

                    valueA =
                        (
                            a.dataset.category || ""
                        ).toLowerCase();

                    valueB =
                        (
                            b.dataset.category || ""
                        ).toLowerCase();

                }

                if (valueA < valueB)
                    return currentSortDirection === "asc"
                        ? -1
                        : 1;

                if (valueA > valueB)
                    return currentSortDirection === "asc"
                        ? 1
                        : -1;

                return 0;

            });


            rows.forEach(function (row) {

                tbody.appendChild(row);

            });


            updateSortIcons();

        }


        function updateSortIcons() {

            document.querySelectorAll(
                "#allergiesTable thead th[data-sort] i"
            ).forEach(function (icon) {

                icon.className =
                    "fa-solid fa-sort ms-1 text-muted";

            });


            const activeHeader =
                document.querySelector(
                    '#allergiesTable thead th[data-sort="' +
                    currentSortColumn +
                    '"]'
                );

            if (!activeHeader)
                return;

            const icon =
                activeHeader.querySelector("i");

            if (!icon)
                return;

            icon.className =
                currentSortDirection === "asc"
                    ? "fa-solid fa-sort-up ms-1 text-primary"
                    : "fa-solid fa-sort-down ms-1 text-primary";

        }

    </script>

}
