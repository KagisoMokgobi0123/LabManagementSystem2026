                                    information required by the system.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================================
             SYSTEM DATA
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    Supporting System Data
                </h4>

                <p class="dashboard-subtitle">
                    Maintain supporting reference information used by
                    NMB-HLabSys
                </p>

            </div>


            <div class="card-body">

                <div class="row">


                    <div class="col-md-4">

                        <a href="/Administrator/SampleTypes/Index"
                           class="quick-action">

                            <div class="quick-action-icon">

                                <i class="fa-solid fa-vial"></i>

