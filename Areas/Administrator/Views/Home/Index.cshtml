                                <i class="fa-solid fa-user-shield"></i>

                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Administrator Profile
                                </div>

                                <div class="quick-action-text">
                                    View your administrator account
                                    information
                                </div>

                            </div>

                            <i class="fa-solid fa-chevron-right
                                quick-action-arrow">
                            </i>

                        </a>

                    </div>


                    <div class="col-md-4">

                        <a href="/Administrator/Profile/ChangePassword"
                           class="quick-action">

                            <div class="quick-action-icon">

                                <i class="fa-solid fa-key"></i>

                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Account Security
                                </div>

                                <div class="quick-action-text">
                                    Change your administrator
                                    account password
                                </div>

                            </div>

                            <i class="fa-solid fa-chevron-right
                                quick-action-arrow">
                            </i>

                        </a>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================================
             ACCOUNT & SECURITY
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    My Account & Security
                </h4>

                <p class="dashboard-subtitle">
                    Manage your Administrator profile and account security
                </p>

            </div>


            <div class="card-body">

                <div class="row align-items-center">


                    <div class="col-md-6">

                        <div class="profile-summary">

                            <div class="profile-avatar">
                                @administratorInitial
                            </div>

                            <div>

                                <div class="profile-name">
                                    @administratorName
                                </div>

                                <div class="profile-role">
                                    System Administrator
                                </div>

                                <div class="profile-email">
                                    @administratorEmail
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6
                        text-md-right
                        mt-3 mt-md-0">

                        <a href="/Administrator/Profile/Index"
                           class="btn
                            btn-outline-primary
                            btn-sm
                            mr-2">

                            <i class="fa-solid fa-user mr-1"></i>

                            My Profile

                        </a>


                        <a href="/Administrator/Profile/ChangePassword"
                           class="btn
                            btn-outline-secondary
                            btn-sm
                            mr-2">

                            <i class="fa-solid fa-key mr-1"></i>

                            Change Password

                        </a>


                        <form action="/Administrator/Profile/Logout"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn
                                btn-outline-danger
                                btn-sm">

                                <i class="fa-solid fa-right-from-bracket mr-1"></i>

                                Secure Logout

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>