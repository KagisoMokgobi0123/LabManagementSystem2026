                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Medication classifications
                                </div>

                            </div>


                            <div class="stat-icon icon-purple">

                                <i class="fa-solid fa-capsules"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>



        <!-- =====================================================
             ADMINISTRATION ACTIONS
             ===================================================== -->

        <div class="row">

            <div class="col-lg-8">

                <div class="dashboard-card">

                    <div class="card-header">

                        <h4 class="dashboard-title">
                            Administration Actions
                        </h4>

                        <p class="dashboard-subtitle">
                            Maintain the clinical reference information
                            used throughout the system
                        </p>

                    </div>


                    <div class="card-body">

                        <div class="row">


                            <!-- CONDITIONS -->

                            <div class="col-md-6">

                                <a href="/Administrator/MedicalConditions/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-notes-medical"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Medical Conditions
                                        </div>

                                        <div class="quick-action-text">
                                            Add, edit and maintain medical
                                            conditions available to patient records
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>



                            <!-- ALLERGIES -->

                            <div class="col-md-6">

                                <a href="/Administrator/Allergies/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-triangle-exclamation"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Allergies
                                        </div>

                                        <div class="quick-action-text">
                                            Maintain allergy information
                                            used by patient medical records
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>



                            <!-- MEDICATIONS -->

                            <div class="col-md-6">

                                <a href="/Administrator/Medications/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-pills"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Medications
                                        </div>

                                        <div class="quick-action-text">
                                            Add and maintain medications
                                            available throughout the system
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>



                            <!-- CONDITION CATEGORIES -->

                            <div class="col-md-6">

                                <a href="/Administrator/MedicalConditionCategories/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-layer-group"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Condition Categories
                                        </div>

                                        <div class="quick-action-text">
                                            Organise medical conditions
                                            into appropriate categories
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>



                            <!-- ALLERGY CATEGORIES -->

                            <div class="col-md-6">

                                <a href="/Administrator/AllergyCategories/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-tags"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Allergy Categories
                                        </div>

                                        <div class="quick-action-text">
                                            Maintain the categories used
                                            to classify allergies
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>



                            <!-- MEDICATION CATEGORIES -->

                            <div class="col-md-6">

                                <a href="/Administrator/MedicationCategories/Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fa-solid fa-capsules"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Medication Categories
                                        </div>

                                        <div class="quick-action-text">
                                            Maintain medication
                                            classification information
                                        </div>

                                    </div>

                                    <i class="fa-solid fa-chevron-right
                                        quick-action-arrow">
                                    </i>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 RESPONSIBILITIES
                 ================================================= -->

            <div class="col-lg-4">

                <div class="dashboard-card">

                    <div class="card-header">

                        <h4 class="dashboard-title">
                            Administrator Responsibilities
                        </h4>

                        <p class="dashboard-subtitle">
                            Core reference-data management
                        </p>

                    </div>


                    <div class="card-body">


                        <div class="responsibility-item">

                            <div class="responsibility-icon">

                                <i class="fa-solid fa-notes-medical"></i>

                            </div>

                            <div>

                                <div class="responsibility-title">
                                    Medical Conditions
                                </div>

                                <div class="responsibility-text">
                                    Maintain categorised medical
                                    condition lists.
                                </div>

                            </div>

                        </div>


                        <div class="responsibility-item">

                            <div class="responsibility-icon">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                            </div>

                            <div>

                                <div class="responsibility-title">
