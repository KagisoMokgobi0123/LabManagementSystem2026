                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Medical Conditions
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Conditions maintained in the system
                                </div>

                            </div>


                            <div class="stat-icon icon-blue">

                                <i class="fa-solid fa-notes-medical"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>



            <!-- ALLERGIES -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a href="/Administrator/Allergies/Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Allergies
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Allergy records maintained
                                </div>

                            </div>


                            <div class="stat-icon icon-orange">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>



            <!-- MEDICATIONS -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a href="/Administrator/Medications/Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Medications
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Medication records maintained
                                </div>

                            </div>


                            <div class="stat-icon icon-green">

                                <i class="fa-solid fa-pills"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>



        <!-- =====================================================
             CATEGORY STATISTICS
             ===================================================== -->

        <div class="row">


            <div class="col-xl-4 col-md-6 mb-4">

                <a href="/Administrator/MedicalConditionCategories/Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Condition Categories
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Medical condition classifications
                                </div>

                            </div>


                            <div class="stat-icon icon-cyan">

                                <i class="fa-solid fa-layer-group"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>



            <div class="col-xl-4 col-md-6 mb-4">

                <a href="/Administrator/AllergyCategories/Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Allergy Categories
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Allergy classifications
                                </div>

                            </div>


                            <div class="stat-icon icon-purple">

                                <i class="fa-solid fa-tags"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>



            <div class="col-xl-4 col-md-6 mb-4">

                <a href="/Administrator/MedicationCategories/Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
