@model NMB_HLabSys.Areas.Technician.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";

    var successMessage = TempData["SuccessMessage"]?.ToString();
    var infoMessage = TempData["InfoMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
}

<style>
    .password-page {
        min-height: 100vh;
        padding: 40px 0;
        background: #f4f7fb;
    }

    .password-card {
        overflow: hidden;
        max-width: 620px;
        margin: auto;
        border: 0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 5px 25px rgba(15, 23, 42, .08);
    }

    .password-header {
        padding: 25px;
        background: linear-gradient( 135deg, #073b5c, #075985, #0284c7 );
        color: #fff;
    }

    .password-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        margin-bottom: 14px;
        border-radius: 12px;
        background: rgba(255,255,255,.15);
        font-size: 20px;
    }

    .password-header h3 {
        margin-bottom: 5px;
        font-size: 21px;
        font-weight: 700;
    }

    .password-header p {
        margin: 0;
        color: rgba(255,255,255,.8);
        font-size: 12px;
    }

    .password-body {
        padding: 28px;
    }

    .form-label {
        margin-bottom: 6px;
        color: #334155;
        font-size: 12px;
        font-weight: 600;
    }

    .password-input {
        height: 43px;
        border: 1px solid #dbe3ec;
        border-radius: 8px;
        font-size: 13px;
    }

        .password-input:focus {
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2,132,199,.10);
        }

    .password-requirements {
        margin-bottom: 20px;
        padding: 14px;
        border-radius: 9px;
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        line-height: 1.8;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 8px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 12px;
    }

    .password-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .password-submit {
        background: #0284c7;
        border-color: #0284c7;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 18px;
    }

        .password-submit:hover {
            background: #0369a1;
            border-color: #0369a1;
        }

        .password-submit:disabled {
            opacity: .7;
            cursor: not-allowed;
        }
</style>

<div class="password-page">
    <div class="container-fluid">

        <div class="password-card">

            <!-- HEADER -->
            <div class="password-header">

                <div class="password-header-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h3>Change Password</h3>

                <p>
                    Update the password used to access your
                    Administrator account.
                </p>

            </div>

            <!-- BODY -->
            <div class="password-body">

                <!-- Fallback message if SweetAlert2 cannot load -->
                <div id="passwordFeedback" class="alert" role="alert" style="display:none;"></div>

                <form id="changePasswordForm"
                      action="@Url.Action("ChangePassword", "Profile", new { area = "Administrator" })"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-3">
                    </div>

                    <!-- CURRENT PASSWORD -->
                    <div class="form-group">

                        <label for="CurrentPassword"
                               class="form-label">
                            Current Password
                        </label>

                        <input id="CurrentPassword" name="CurrentPassword"
                               required
                               type="password"
                               class="form-control password-input"
                               placeholder="Enter current password"
                               autocomplete="current-password" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="form-group">

                        <label for="NewPassword"
                               class="form-label">
                            New Password
                        </label>

                        <input id="NewPassword" name="NewPassword"
                               required
                               type="password"
                               class="form-control password-input"
                               placeholder="Enter new password"
                               autocomplete="new-password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="form-group">

                        <label for="ConfirmPassword"
                               class="form-label">
                            Confirm New Password
                        </label>

                        <input id="ConfirmPassword" name="ConfirmPassword"
                               required
                               type="password"
                               class="form-control password-input"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- PASSWORD REQUIREMENTS -->
                    <div class="password-requirements">

                        <strong>
                            <i class="fas fa-shield-alt mr-1"></i>
                            Password Requirements
                        </strong>

                        <div class="mt-2">
                            <i class="fas fa-check-circle mr-1"></i>
                            At least 8 characters
                        </div>

                        <div>
                            <i class="fas fa-check-circle mr-1"></i>
                            At least one uppercase letter (A-Z)
                        </div>

                        <div>
                            <i class="fas fa-check-circle mr-1"></i>
                            At least one lowercase letter (a-z)
                        </div>

                        <div>
                            <i class="fas fa-check-circle mr-1"></i>
                            At least one number (0-9)
                        </div>

                        <div>
                            <i class="fas fa-check-circle mr-1"></i>
                            At least one special character (!, @@, #, etc.)
                        </div>

                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="password-actions">

                        <button type="submit"
                                id="changePasswordBtn"
                                class="btn btn-primary password-submit">

                            <i class="fas fa-key mr-1"></i>
                            Change Password

                        </button>

                        <a href="/Administrator/Profile/Index"
                           class="btn btn-outline-secondary btn-sm">

                            <i class="fas fa-arrow-left mr-1"></i>
                            Back to Profile

                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- SweetAlert2: load once. Remove this line if already loaded in ~/Views/Shared/_AdministratorLayout.cshtml. -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.getElementById("changePasswordForm");
            const button = document.getElementById("changePasswordBtn");
            const feedback = document.getElementById("passwordFeedback");
            if (!form || !button) return;

            const serverSuccess = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage));
            const serverInfo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(infoMessage));
            const serverError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage));

            function showMessage(icon, title, message) {
                if (typeof window.Swal !== "undefined") {
                    return Swal.fire({
                        icon: icon,
                        title: title,
                        text: message,
                        confirmButtonColor: "#0284c7"
                    });
                }

                // Accessible fallback without browser alert()/confirm().
                feedback.className = "alert " +
                    (icon === "success" ? "alert-success" :
                        icon === "info" ? "alert-info" : "alert-danger");
                feedback.textContent = title + ": " + message;
                feedback.style.display = "block";
                feedback.scrollIntoView({ behavior: "smooth", block: "center" });
                return Promise.resolve();
            }

            if (serverSuccess) {
                showMessage("success", "Password Changed", serverSuccess);
            } else if (serverError) {
                showMessage("error", "Password Change Failed", serverError);
            } else if (serverInfo) {
                showMessage("info", "Information", serverInfo);
            } else {
                // Show model validation failures returned by the controller.
                const validation = document.querySelector(".validation-summary-errors");
                const items = validation
                    ? Array.from(validation.querySelectorAll("li"))
                        .map(li => li.textContent.trim()).filter(Boolean)
                    : [];
                if (items.length) {
                    showMessage("error", "Please Check Your Details", items.join(" "));
                }
            }

            // Handle validation ourselves so messages are SweetAlert2, not native browser tooltips.
            form.noValidate = true;
            let submitting = false;

            form.addEventListener("submit", async function(event) {
                event.preventDefault();
                if (submitting) return;

                const current = form.elements.namedItem("CurrentPassword")?.value ?? "";
                const next = form.elements.namedItem("NewPassword")?.value ?? "";
                const confirmation = form.elements.namedItem("ConfirmPassword")?.value ?? "";

                if (!current || !next || !confirmation) {
                    await showMessage("error", "Missing Information", "Please complete all password fields.");
                    return;
                }

                const strong = next.length >= 8 && /[A-Z]/.test(next) &&
                    /[a-z]/.test(next) && /[0-9]/.test(next) &&
                    /[^A-Za-z0-9]/.test(next);

                if (!strong) {
                    await showMessage("error", "Weak Password",
                        "Use at least 8 characters, including uppercase, lowercase, a number and a special character.");
                    return;
                }

                if (next !== confirmation) {
                    await showMessage("error", "Passwords Do Not Match",
                        "The new password and confirmation do not match.");
                    return;
                }

                if (current === next) {
                    await showMessage("error", "Choose a Different Password",
                        "Your new password must be different from your current password.");
                    return;
                }

                if (typeof window.Swal === "undefined") {
                    await showMessage("error", "Confirmation Unavailable",
                        "SweetAlert2 could not load. Please check your connection or install it locally before trying again.");
                    return;
                }

                const result = await Swal.fire({
                    icon: "question",
                    title: "Confirm Password Change",
                    text: "Are you sure you want to change your password?",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Change Password",
                    cancelButtonText: "Cancel",
                    confirmButtonColor: "#0284c7"
                });

                if (!result.isConfirmed) return;

                submitting = true;
                button.disabled = true;
                button.textContent = "Updating...";

                // Native submission preserves antiforgery and avoids re-triggering this handler.
                HTMLFormElement.prototype.submit.call(form);
            });
        });
    </script>
}
