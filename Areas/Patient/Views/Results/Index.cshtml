@using NMB_HLabSys.Areas.Doctor.Models
@model List<TestRequestsModel>
@{
    Layout = "_PatientLayout";
    ViewData["Title"] = "My Results";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">My Test Results</h4>
            <p class="text-muted mb-0" style="font-size:0.88rem;">Results released by your doctor</p>
        </div>
        <a href="/Patient/Home/Index" class="btn btn-outline-secondary btn-sm">← Back to Dashboard</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="fas fa-file-medical fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No Results Available</h5>
                <p class="text-muted" style="font-size:0.88rem;">
                    Results will appear here once your doctor releases them.
                </p>
            </div>
        </div>
    }
    else
    {
        @foreach (var r in Model)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <strong style="color:#075985;">@r.RequestNumber</strong>
                        <span class="text-muted ms-2" style="font-size:0.85rem;">@r.RequestDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <span class="badge bg-success">@r.Status</span>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0" style="font-size:0.88rem;">
                        <strong>Clinical Notes:</strong> @r.ClinicalNotes
                    </p>
                </div>
            </div>
        }
    }
</div>