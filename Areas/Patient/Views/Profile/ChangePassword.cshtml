@{
    Layout = "_PatientLayout";
    ViewBag.Title = "Change Password";
    var postUrl = "/Patient/Profile/ChangePassword";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Change Password</h4>
            <p class="text-muted mb-0" style="font-size:0.88rem;">Choose a new password. You stay signed in afterwards.</p>
        </div>
        <a href="@Url.Action("Index", "Profile", new { area = "Patient"})" class = "btn btn-outline-secondary btn-sm" > &larr; Back to Profile</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form method="post" action="@postUrl" id="pwForm" autocomplete="off" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="currentPassword" class="form-label fw-semibold">Current password</label>
                            <div class="input-group">
                                <input type="password" id="currentPassword" name="currentPassword" class="form-control" autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary" data-target="currentPassword"><i class="fas fa-eye"></i></button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label fw-semibold">New password</label>
                            <div class="input-group">
                                <input type="password" id="newPassword" name="newPassword" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-target="newPassword"><i class="fas fa-eye"></i></button>
                            </div>
                            <div class="mt-2" style="font-size:0.82rem;">
                                <div id="rLen" class="text-muted"><span>○</span> At least 8 characters</div>
                                <div id="rUpper" class="text-muted"><span>○</span> One uppercase letter (A-Z)</div>
                                <div id="rNum" class="text-muted"><span>○</span> One number (0-9)</div>
                                <div id="rSpecial" class="text-muted"><span>○</span> One special character (! # $ %)</div>
                                <div id="rDiff" class="text-muted"><span>○</span> Different from your current password</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label fw-semibold">Confirm new password</label>
                            <div class="input-group">
                                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-target="confirmPassword"><i class="fas fa-eye"></i></button>
                            </div>
                            <div id="matchMsg" class="small mt-1"></div>
                        </div>

                        <button type="submit" id="pwSubmit" class="btn btn-primary w-100" disabled>Update password</button>
                        <div class="text-muted small mt-2" id="pwHint">Fill in all fields and meet every rule to enable the button.</div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="fas fa-shield-halved text-primary me-2"></i>Keeping your account safe</h6>
                    <ul class="text-muted mb-0" style="font-size:0.88rem;">
                        <li class="mb-2">Use a password you don't use on other websites.</li>
                        <li class="mb-2">Never share it. The laboratory will never ask for your password.</li>
                        <li>Your password is stored securely.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function el(id) { return document.getElementById(id); }
    var cur = el('currentPassword'), nw = el('newPassword'), cf = el('confirmPassword');
    var btn = el('pwSubmit'), hint = el('pwHint'), match = el('matchMsg');

    function mark(id, ok) {
        var row = el(id);
        row.className = ok ? 'text-success' : 'text-muted';
        row.querySelector('span').textContent = ok ? '✓' : '○';
    }

    function check() {
        var v = nw.value;
        var okLen = v.length >= 8, okUpper = /[A-Z]/.test(v), okNum = /[0-9]/.test(v);
        var okSpecial = /[^A-Za-z0-9]/.test(v), okDiff = v.length > 0 && v !== cur.value;

        mark('rLen', okLen); mark('rUpper', okUpper); mark('rNum', okNum);
        mark('rSpecial', okSpecial); mark('rDiff', okDiff);

        var same = cf.value.length > 0 && cf.value === v;
        if (cf.value.length === 0) { match.textContent = ''; }
        else if (same) { match.className = 'small mt-1 text-success'; match.textContent = '✓ Passwords match'; }
        else { match.className = 'small mt-1 text-danger'; match.textContent = '✗ Passwords do not match'; }

        var ready = cur.value.length > 0 && okLen && okUpper && okNum && okSpecial && okDiff && same;
        btn.disabled = !ready;
        hint.style.visibility = ready ? 'hidden' : 'visible';
    }

    [cur, nw, cf].forEach(function (i) { i.addEventListener('input', check); });

    document.querySelectorAll('[data-target]').forEach(function (b) {
        b.addEventListener('click', function () {
            var input = el(b.getAttribute('data-target'));
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            b.querySelector('i').className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        });
    });

    el('pwForm').addEventListener('submit', function (e) {
        if (btn.disabled) { e.preventDefault(); return; }
        btn.disabled = true; btn.textContent = 'Updating...';
    });

    check();
})();
</script>
}