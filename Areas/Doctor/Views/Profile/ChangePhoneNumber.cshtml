
@model NMB_HLabSys.Areas.Technician.Models.UpdatePhoneNumberViewModel

@{
    ViewData["Title"] = "Change Phone Number";
    Layout = "_DoctorLayout";
}

<style>
    .phone-page {
        padding: 35px 0 60px;
        background: #f4f7fb;
        min-height: 100vh;
    }

    .phone-container {
        max-width: 650px;
        margin: 0 auto;
    }

    .phone-card {
        background: #fff;
        border: 0;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .phone-header {
        padding: 25px 30px;
        background: linear-gradient(135deg, #073b5c, #0284c7);
        color: #fff;
    }

    .phone-header h4 {
        margin: 0;
        font-weight: 700;
    }

    .phone-header p {
        margin: 7px 0 0;
        font-size: 13px;
        opacity: .9;
    }

    .phone-body {
        padding: 30px;
    }

    .phone-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e0f2fe;
        color: #0284c7;
        font-size: 24px;
    }

    .form-label {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .form-control {
        min-height: 46px;
        border: 1px solid #dbe3ec;
        border-radius: 9px;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: #0284c7;
        box-shadow: 0 0 0 .15rem rgba(2, 132, 199, .12);
    }

    .phone-help {
        margin-top: 7px;
        color: #64748b;
        font-size: 12px;
    }
</style>

<div class="phone-page">
    <div class="container">
        <div class="phone-container">

            <div class="mb-3">
                <a asp-area="Doctor"
                   asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i>
                    Back to Profile
                </a>
            </div>

            <div class="phone-card">
                <div class="phone-header">
                   
                    <p>
                        Update the phone number associated with your Doctor account.
                    </p>
                </div>

                <div class="phone-body">

                    <div class="phone-icon">
                        <i class="fas fa-mobile-alt" aria-hidden="true"></i>
                    </div>

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="fas fa-check-circle mr-2"></i>
                            @successMessage
                        </div>
                    }

                    @if (TempData["InfoMessage"] is string infoMessage)
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle mr-2"></i>
                            @infoMessage
                        </div>
                    }

                    <form asp-area="Doctor"
                          asp-controller="Profile"
                          asp-action="ChangePhoneNumber"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="form-group">
                            <label asp-for="PhoneNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="e.g. 0712345678"
                                   autocomplete="tel"
                                   aria-describedby="phoneHelp" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small">
                            </span>

                            <div id="phoneHelp" class="phone-help">
                                <i class="fas fa-info-circle mr-1"></i>
                                Enter the phone number you want associated
                                with your account.
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-block mt-4">
                            <i class="fas fa-save mr-1"></i>
                            Update Phone Number
                        </button>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
