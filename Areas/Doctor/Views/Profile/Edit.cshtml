@model NMB_HLabSys.Areas.Doctor.ViewModels.DoctorProfileEditViewModel
@{ ViewData["Title"] = "Edit Profile"; Layout = "_DoctorLayout"; }
<div class="container py-4"><div class="mb-3"><a asp-action="Index">← My profile</a><h2 class="mt-2">Edit profile</h2><p class="text-muted">Update your display name. Sign-in email changes require a separate verification workflow and are read-only here.</p></div>
@if(TempData["InfoMessage"] != null){<div class="alert alert-info">@TempData["InfoMessage"]</div>}
<form asp-action="Edit" method="post" class="card card-body shadow-sm" style="max-width:650px"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="form-group"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name"/><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="form-group"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" autocomplete="family-name"/><span asp-validation-for="LastName" class="text-danger"></span></div><div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" readonly/><small class="form-text text-muted">Contact an administrator if your sign-in email needs to change.</small></div><div class="d-flex justify-content-end"><a asp-action="Index" class="btn btn-light mr-2">Cancel</a><button type="submit" class="btn btn-primary">Save profile</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
