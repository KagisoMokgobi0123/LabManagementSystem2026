@using NMB_HLabSys.Areas.Doctor.Models
@model TestRequestsModel
@{
    ViewData["Title"] = "Test Request Details";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-primary-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Test Request Details</h2>
                <h5 class="text-white op-7 mb-2">@Model.RequestNumber</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-action="Dashboard" class="btn btn-white btn-border btn-round mr-2">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </a>
                @if (Model.Status == "Completed" || Model.Status == "ReleasedByDoctor")
                {
                    <a asp-area="Doctor" asp-controller="Results" asp-action="ReleaseResults"
                       asp-route-requestId="@Model.TestRequestId"
                       class="btn btn-success btn-round">
                        <i class="fa fa-share mr-1"></i> View & Release Results
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Message"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="row">
        <!-- Request Info -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <div class="card-title"><i class="fa fa-file-medical mr-2"></i> Request Information</div>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <tr><th width="40%">Request Number:</th><td><strong>@Model.RequestNumber</strong></td></tr>
                        <tr><th>Date:</th><td>@Model.RequestDate.ToString("dd MMM yyyy HH:mm")</td></tr>
                        <tr>
                            <th>Urgency:</th>
                            <td>
                                @{var urgClass = Model.Urgency == Urgency.Stat ? "badge-danger" :
               Model.Urgency == Urgency.Urgent ? "badge-warning" : "badge-info";
var urgLabel = Model.Urgency == Urgency.Stat ? "STAT" :
               Model.Urgency == Urgency.Urgent ? "Urgent" : "Routine";
                                }
                                <span class="badge @urgClass">@urgLabel</span>
                            </td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                @{
                                    var stClass = Model.Status == "Completed" ? "badge-success" :
                                                  Model.Status == "Cancelled" ? "badge-danger" :
                                                  Model.Status == "InProgress" ? "badge-warning" :
                                                  Model.Status == "ReleasedByDoctor" ? "badge-primary" : "badge-info";
                                }
                                <span class="badge @stClass badge-lg">@Model.Status</span>
                            </td>
                        </tr>
                        <tr><th>Clinical Notes:</th><td>@(string.IsNullOrEmpty(Model.ClinicalNotes) ? "—" : Model.ClinicalNotes)</td></tr>
                        @if (!string.IsNullOrEmpty(Model.CancelReason))
                        {
                            <tr><th>Cancel Reason:</th><td class="text-danger">@Model.CancelReason</td></tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <!-- Patient Info -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <div class="card-title"><i class="fa fa-user mr-2"></i> Patient Information</div>
                </div>
                <div class="card-body">
                    @if (Model.Patient != null)
                    {
                        <table class="table table-borderless table-sm">
                            <tr><th width="40%">Name:</th><td>@Model.Patient.FullName</td></tr>
                            <tr><th>SA ID:</th><td><code>@Model.Patient.IDNumber</code></td></tr>
                           
                            <tr><th>Email:</th><td>@(Model.Patient.Email ?? "—")</td></tr>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Patient information not available.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Test Types -->
    <div class="card">
        <div class="card-header">
            <div class="card-title"><i class="fa fa-vials mr-2"></i> Requested Tests</div>
        </div>
        <div class="card-body">
            @if (Model.TestRequestItems != null && Model.TestRequestItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Test Name</th>
                                <th>Sample Type</th>
                                <th>Normal Range</th>
                                <th>Result</th>
                                <th>Status</th>
                                <th>Completed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TestRequestItems)
                            {
                                <tr>
                                    <td><strong>@item.TestType?.Name</strong></td>
                                    <td>@(item.TestType?.SampleType?.Name ?? "—")</td>
                                    <td>@item.TestType?.NormalMin – @item.TestType?.NormalMax @item.TestType?.MeasurementUnit</td>
                                    <td>
                                        @if (item.ResultValue.HasValue)
                                        {
                                            var isAbnormal = item.ResultValue < item.TestType?.NormalMin ||
                                                             item.ResultValue > item.TestType?.NormalMax;
                                            <span class="badge @(isAbnormal ? "badge-danger" : "badge-success")">
                                                @item.ResultValue @item.TestType?.MeasurementUnit
                                                @(isAbnormal ? " ⚠" : "")
                                            </span>
                                        }
                                        else { <span class="text-muted">Pending</span> }
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">@item.Status</span>
                                    </td>
                                    <td>@(item.CompletionDateTime?.ToString("dd MMM HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No test items found.</p>
            }
        </div>
    </div>

    <!-- Samples -->
    <div class="card">
        <div class="card-header">
            <div class="card-title"><i class="fa fa-barcode mr-2"></i> Samples</div>
        </div>
        <div class="card-body">
            @if (Model.Samples != null && Model.Samples.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Barcode</th>
                                <th>Sample Type</th>
                                <th>Collected At</th>
                                <th>Received</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Samples)
                            {
                                <tr>
                                    <td><code>@s.Barcode</code></td>
                                    <td>@(s.SampleType?.Name ?? "—")</td>
                                    <td>@s.CollectedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @if (s.Status == "Received")
                                        {
                                            <span class="badge badge-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">Not yet received</span>
                                        }
                                    </td>
                                    <td><span class="badge badge-info">@s.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No samples recorded.</p>
            }
        </div>
    </div>

    <!-- Cancel Action -->
    @if (Model.Status == "Submitted" || Model.Status == "SamplesReceived")
    {
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <div class="card-title text-white">
                    <i class="fa fa-exclamation-triangle mr-2"></i> Cancel Test Request
                </div>
            </div>
            <div class="card-body">
                <p>This request can be cancelled because its status is <strong>@Model.Status</strong>.</p>
                <form asp-action="Cancel" asp-route-id="@Model.TestRequestId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="font-weight-bold">Cancellation Reason <span class="text-danger">*</span></label>
                        <textarea name="cancelReason" class="form-control" rows="2"
                                  placeholder="Provide a reason for cancellation" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger btn-round"
                            onclick="return confirm('Are you sure you want to cancel this request?')">
                        <i class="fa fa-times mr-1"></i> Cancel Request
                    </button>
                </form>
            </div>
        </div>
    }
</div>
