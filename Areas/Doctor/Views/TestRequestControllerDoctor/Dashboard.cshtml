@using NMB_HLabSys.Areas.Doctor.Models
@model List<TestRequestsModel>
@{
    ViewData["Title"] = "Test Requests";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-primary-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Test Requests</h2>
                <h5 class="text-white op-7 mb-2">All test requests submitted by you</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-action="Create" class="btn btn-secondary btn-round">
                    <i class="fa fa-plus mr-1"></i> New Test Request
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Message"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Status Filter Tabs -->
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-pills nav-secondary" id="statusTabs">
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")"
                       asp-action="TrackStatus">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == "Submitted" ? "active" : "")"
                       asp-action="TrackStatus" asp-route-statusFilter="Submitted">Submitted</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == "SamplesReceived" ? "active" : "")"
                       asp-action="TrackStatus" asp-route-statusFilter="SamplesReceived">Samples Received</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == "InProgress" ? "active" : "")"
                       asp-action="TrackStatus" asp-route-statusFilter="InProgress">In Progress</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == "Completed" ? "active" : "")"
                       asp-action="TrackStatus" asp-route-statusFilter="Completed">Completed</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.StatusFilter == "Cancelled" ? "active" : "")"
                       asp-action="TrackStatus" asp-route-statusFilter="Cancelled">Cancelled</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa fa-flask fa-3x text-muted mb-3"></i>
                    <h5>No test requests found.</h5>
                    <a asp-action="Create" class="btn btn-primary btn-round">Create Test Request</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Urgency</th>
                                <th>Tests</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model)
                            {
                                <tr>
                                    <td><strong>@req.RequestNumber</strong></td>
                                    <td>@(req.Patient != null ? req.Patient.FullName : "—")</td>
                                    <td>@req.RequestDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            var urgClass = req.Urgency == Urgency.Stat ? "badge-danger" :
                                                           req.Urgency == Urgency.Urgent ? "badge-warning" : "badge-info";
                                            var urgLabel = req.Urgency == Urgency.Stat ? "STAT" :
                                                           req.Urgency == Urgency.Urgent ? "Urgent" : "Routine";
                                        }
                                        <span class="badge @urgClass">@urgLabel</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">
                                            @(req.TestRequestItems?.Count ?? 0) test(s)
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var stClass = req.Status == "Completed" ? "badge-success" :
                                                          req.Status == "Cancelled" ? "badge-danger" :
                                                          req.Status == "InProgress" ? "badge-warning" :
                                                          req.Status == "ReleasedByDoctor" ? "badge-primary" : "badge-info";
                                        }
                                        <span class="badge @stClass">@req.Status</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@req.TestRequestId"
                                           class="btn btn-sm btn-info btn-round mr-1" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        @if (req.Status == "Submitted" || req.Status == "SamplesReceived")
                                        {
                                            <button type="button" class="btn btn-sm btn-danger btn-round"
                                                    data-toggle="modal" data-target="#cancelModal_@req.TestRequestId"
                                                    title="Cancel Request">
                                                <i class="fa fa-times"></i>
                                            </button>

                                            <!-- Cancel Modal -->
                                            <div class="modal fade" id="cancelModal_@req.TestRequestId" tabindex="-1" role="dialog">
                                                <div class="modal-dialog" role="document">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Cancel Test Request</h5>
                                                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                                        </div>
                                                        <form asp-action="Cancel" asp-route-id="@req.TestRequestId" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-body">
                                                                <p>You are about to cancel request <strong>@req.RequestNumber</strong>. Please provide a reason.</p>
                                                                <div class="form-group">
                                                                    <label class="font-weight-bold">Cancellation Reason <span class="text-danger">*</span></label>
                                                                    <textarea name="cancelReason" class="form-control" rows="3"
                                                                              placeholder="Enter reason for cancellation" required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                                <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
