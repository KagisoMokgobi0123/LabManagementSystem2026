@{
    var user = Context.User;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var patientOpen = currentController == "PatientManagement";
    var testOpen = currentController == "TestRequestControllerDoctor";
    var resultsOpen = currentController == "Results";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — NMB-HLabSys</title>

    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/atlantis.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        .badge-lg { font-size: 0.85rem; padding: 0.4em 0.7em; }
        .test-type-card { transition: all 0.2s; }
        .test-type-card:hover { border-color: #1a6fc4 !important; }
        .test-type-card.selected { border-color: #1a6fc4 !important; background: #eaf2ff; }
        @@media print {
            .sidebar, .main-header, .btn, .custom-template { display: none !important; }
            .main-panel { margin-left: 0 !important; }
        }
    </style>
</head>
<body>
<div class="wrapper">

    <!-- Logo Header -->
    <div class="main-header">
        <div class="logo-header" data-background-color="blue">
            <a href="#" class="logo">
                <img src="~/assets/img/logo.svg" alt="NMB-HLabSys" class="navbar-brand" style="height:36px;" />
            </a>
            <button class="navbar-toggler sidenav-toggler ml-auto" type="button">
                <span class="navbar-toggler-icon"><i class="icon-menu"></i></span>
            </button>
            <button class="topbar-toggler more"><i class="icon-options-vertical"></i></button>
            <div class="nav-toggle">
                <button class="btn btn-toggle toggle-sidebar"><i class="icon-menu"></i></button>
            </div>
        </div>

        <!-- Navbar -->
        <nav class="navbar navbar-header navbar-expand-lg" data-background-color="blue2">
            <div class="container-fluid">
                <ul class="navbar-nav topbar-nav ml-md-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Doctor" asp-controller="DoctorDashboard" asp-action="Alerts"
                           title="View Alerts">
                            <i class="fa fa-bell"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown hidden-caret">
                        <a class="dropdown-toggle profile-pic" data-toggle="dropdown" href="#" aria-expanded="false">
                            <div class="avatar-sm">
                                <span class="avatar-title rounded-circle bg-primary">
                                    <i class="fa fa-user-md"></i>
                                </span>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-user animated fadeIn">
                            <div class="dropdown-user-scroll scrollbar-outer">
                                <li>
                                    <div class="user-box">
                                        <div class="u-text">
                                            <h4>@(user.Identity?.Name ?? "Doctor")</h4>
                                            <p class="text-muted">Doctor</p>
                                        </div>
                                    </div>
                                </li>
                                <li>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="fa fa-key mr-2"></i> Change Password
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa fa-sign-out-alt mr-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </div>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
    <!-- End Header -->

    <!-- Sidebar -->
    <div class="sidebar sidebar-style-2">
        <div class="sidebar-wrapper scrollbar scrollbar-inner">
            <div class="sidebar-content">

                <div class="user">
                    <div class="avatar-sm float-left mr-2">
                        <span class="avatar-title rounded-circle bg-primary">
                            <i class="fa fa-user-md"></i>
                        </span>
                    </div>
                    <div class="info">
                        <span>
                            @(user.Identity?.Name ?? "Doctor")
                            <span class="user-level">Doctor</span>
                        </span>
                    </div>
                </div>

                <ul class="nav nav-primary">

                    <!-- Dashboard -->
                    <li class="nav-item @(currentController == "DoctorDashboard" && currentAction == "Dashboard" ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="DoctorDashboard" asp-action="Dashboard">
                            <i class="fas fa-home"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                        <h4 class="text-section">Patients</h4>
                    </li>

                    <!-- Patient Management -->
                    <li class="nav-item @(patientOpen ? "active" : "")">
                        <a data-toggle="collapse" href="#patientMenu"
                           class="@(!patientOpen ? "collapsed" : "")"
                           aria-expanded="@(patientOpen ? "true" : "false")">
                            <i class="fas fa-users"></i>
                            <p>Patients</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse @(patientOpen ? "show" : "")" id="patientMenu">
                            <ul class="nav nav-collapse">
                                <li class="@(currentAction == "Index" && patientOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Index">
                                        <span class="sub-item">My Patients</span>
                                    </a>
                                </li>
                                <li class="@(currentAction == "Search" && patientOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Search">
                                        <span class="sub-item">Search Patient</span>
                                    </a>
                                </li>
                                <li class="@(currentAction == "Create" && patientOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Create">
                                        <span class="sub-item">Register Patient</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                        <h4 class="text-section">Test Requests</h4>
                    </li>

                    <!-- Test Requests -->
                    <li class="nav-item @(testOpen ? "active" : "")">
                        <a data-toggle="collapse" href="#testMenu"
                           class="@(!testOpen ? "collapsed" : "")"
                           aria-expanded="@(testOpen ? "true" : "false")">
                            <i class="fas fa-flask"></i>
                            <p>Test Requests</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse @(testOpen ? "show" : "")" id="testMenu">
                            <ul class="nav nav-collapse">
                                <li class="@(currentAction == "Dashboard" && testOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="Dashboard">
                                        <span class="sub-item">All Requests</span>
                                    </a>
                                </li>
                                <li class="@(currentAction == "Create" && testOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="Create">
                                        <span class="sub-item">New Request</span>
                                    </a>
                                </li>
                                <li class="@(currentAction == "TrackStatus" && testOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="TrackStatus">
                                        <span class="sub-item">Track Status</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                        <h4 class="text-section">Results</h4>
                    </li>

                    <!-- Results -->
                    <li class="nav-item @(resultsOpen ? "active" : "")">
                        <a data-toggle="collapse" href="#resultsMenu"
                           class="@(!resultsOpen ? "collapsed" : "")"
                           aria-expanded="@(resultsOpen ? "true" : "false")">
                            <i class="fas fa-chart-bar"></i>
                            <p>Results</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse @(resultsOpen ? "show" : "")" id="resultsMenu">
                            <ul class="nav nav-collapse">
                                <li class="@(currentAction == "ViewResults" && resultsOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="Results" asp-action="ViewResults">
                                        <span class="sub-item">View Results</span>
                                    </a>
                                </li>
                                <li class="@(currentAction == "ViewAbnormal" && resultsOpen ? "active" : "")">
                                    <a asp-area="Doctor" asp-controller="Results" asp-action="ViewAbnormal">
                                        <span class="sub-item">Abnormal Results</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <!-- Alerts -->
                    <li class="nav-item @(currentController == "DoctorDashboard" && currentAction == "Alerts" ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="DoctorDashboard" asp-action="Alerts">
                            <i class="fas fa-bell"></i>
                            <p>Alerts</p>
                        </a>
                    </li>

                    <!-- Consents -->
                    <li class="nav-item @(currentController == "PatientConsent" ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="PatientConsent" asp-action="Index">
                            <i class="fas fa-lock-open"></i>
                            <p>Patient Consents</p>
                        </a>
                    </li>

                    <li class="nav-section">
                        <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                        <h4 class="text-section">Reports</h4>
                    </li>

                    <!-- Reports -->
                    <li class="nav-item @(currentController == "DoctorReport" ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="DoctorReport" asp-action="Index">
                            <i class="fas fa-file-pdf"></i>
                            <p>Generate Reports</p>
                        </a>
                    </li>

                    <!-- Sign Out -->
                    <li class="mx-4 mt-3">
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-block btn-round">
                                <i class="fa fa-sign-out-alt mr-2"></i> Sign Out
                            </button>
                        </form>
                    </li>

                </ul>
            </div>
        </div>
    </div>
    <!-- End Sidebar -->

    <div class="main-panel">
        <div class="content">
            @RenderBody()
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="copyright ml-auto">
                    NMB-HLabSys &copy; @DateTime.Now.Year — Nelson Mandela Bay Haematology Laboratory
                </div>
            </div>
        </footer>
    </div>

</div>

<!-- Scripts -->
<script src="~/assets/js/core/jquery.3.2.1.min.js"></script>
<script src="~/assets/js/core/popper.min.js"></script>
<script src="~/assets/js/core/bootstrap.min.js"></script>
<script src="~/assets/js/atlantis.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>