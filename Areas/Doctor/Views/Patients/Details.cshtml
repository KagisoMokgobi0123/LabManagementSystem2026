@model NMB_HLabSys.Areas.Patient.Models.PatientModel
@using NMB_HLabSys.Areas.Doctor.Models
@{ ViewData["Title"] = "Patient Record"; Layout = "_DoctorLayout"; var requests = ViewBag.Requests as List<TestRequestsModel> ?? new(); }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2>@Model.FullName</h2><p class="text-muted mb-0">Patient record · @Model.IDNumber</p></div><div><a class="btn btn-primary" asp-controller="TestRequests" asp-action="Create" asp-route-idNumber="@Model.IDNumber">New test request</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
<div class="row"><div class="col-lg-5"><div class="card mb-3"><div class="card-header font-weight-bold">Patient details</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-5">Date of birth</dt><dd class="col-sm-7">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd><dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@Model.ContactNumber</dd><dt class="col-sm-5">Email</dt><dd class="col-sm-7">@Model.Email</dd><dt class="col-sm-5">Address</dt><dd class="col-sm-7">@Model.Address, @Model.Suburb, @Model.City, @Model.Province @Model.PostalCode</dd></dl></div></div>
<div class="card mb-3"><div class="card-header font-weight-bold">Medical conditions</div><div class="card-body">@if(Model.NoKnownMedicalConditions){<span class="text-muted">No known medical conditions reported</span>}else if(!Model.PatientConditions.Any()){<span class="text-muted">Not recorded</span>}else{<ul class="mb-0">@foreach(var x in Model.PatientConditions){<li>@x.MedicalCondition?.ConditionName</li>}</ul>}</div></div><div class="card mb-3"><div class="card-header font-weight-bold">Allergies</div><div class="card-body">@if(Model.NoKnownAllergies){<span class="text-muted">No known allergies reported</span>}else if(!Model.PatientAllergies.Any()){<span class="text-muted">Not recorded</span>}else{<ul class="mb-0">@foreach(var x in Model.PatientAllergies){<li>@x.Allergy?.AllergyName @if(!string.IsNullOrWhiteSpace(x.Severity)){<span class="text-muted">(@x.Severity)</span>}</li>}</ul>}</div></div><div class="card mb-3"><div class="card-header font-weight-bold">Current medications</div><div class="card-body">@if(Model.NoCurrentMedications){<span class="text-muted">No current medications reported</span>}else if(!Model.PatientMedications.Any()){<span class="text-muted">Not recorded</span>}else{<ul class="mb-0">@foreach(var x in Model.PatientMedications){<li>@x.Medication?.MedicationName @if(!string.IsNullOrWhiteSpace(x.Dosage)){<span>— @x.Dosage</span>}</li>}</ul>}</div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header font-weight-bold">Previous test requests</div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Request</th><th>Date</th><th>Status</th><th>Tests</th><th></th></tr></thead><tbody>@foreach(var r in requests){<tr><td>@r.RequestNumber</td><td>@r.RequestDate.ToString("dd MMM yyyy HH:mm")</td><td>@r.Status</td><td>@r.EffectiveTestTypes.Count</td><td><a asp-controller="TestRequests" asp-action="Details" asp-route-id="@r.TestRequestId">View</a></td></tr>}@if(!requests.Any()){<tr><td colspan="5" class="text-muted text-center py-4">No previous requests found.</td></tr>}</tbody></table></div></div></div></div></div>
