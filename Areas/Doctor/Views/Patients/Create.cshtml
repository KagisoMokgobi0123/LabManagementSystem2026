@model NMB_HLabSys.Areas.Doctor.ViewModels.PatientCreateViewModel
@using NMB_HLabSys.Areas.Administrator.Models
@{ ViewData["Title"] = "Add Patient"; Layout = "_DoctorLayout"; var conditions = ViewBag.MedicalConditions as List<MedicalCondition> ?? new(); var allergies = ViewBag.Allergies as List<Allergy> ?? new(); var medications = ViewBag.Medications as List<Medication> ?? new(); }
<div class="container py-4"><div class="mb-3"><a asp-action="Index" class="text-muted">← Patients</a><h2 class="mt-2">Add patient</h2><p class="text-muted">Date of birth is derived from the valid South African ID number.</p></div>
<form asp-action="Create" method="post" class="card card-body shadow-sm"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<h5>Personal details</h5><div class="form-row"><div class="form-group col-md-6"><label asp-for="Name"></label><input asp-for="Name" class="form-control" autocomplete="given-name"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="form-group col-md-6"><label asp-for="Surname"></label><input asp-for="Surname" class="form-control" autocomplete="family-name"/><span asp-validation-for="Surname" class="text-danger"></span></div></div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="IDNumber"></label><input asp-for="IDNumber" class="form-control" maxlength="13" inputmode="numeric" autocomplete="off"/><small class="form-text text-muted">13 digits. The date of birth field will populate automatically.</small><span asp-validation-for="IDNumber" class="text-danger"></span></div><div class="form-group col-md-6"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" class="form-control" readonly/><span asp-validation-for="DateOfBirth" class="text-danger"></span></div></div>
<div class="form-row"><div class="form-group col-md-6"><label asp-for="ContactNumber"></label><input asp-for="ContactNumber" class="form-control" autocomplete="tel"/><span asp-validation-for="ContactNumber" class="text-danger"></span></div><div class="form-group col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div></div>
<h5 class="mt-3">Address</h5><div class="form-group"><label asp-for="Address"></label><input asp-for="Address" class="form-control"/><span asp-validation-for="Address" class="text-danger"></span></div><div class="form-row"><div class="form-group col-md-3"><label asp-for="Suburb"></label><input asp-for="Suburb" class="form-control"/></div><div class="form-group col-md-3"><label asp-for="City"></label><input asp-for="City" class="form-control"/><span asp-validation-for="City" class="text-danger"></span></div><div class="form-group col-md-3"><label asp-for="Province"></label><select asp-for="Province" class="form-control"><option>Eastern Cape</option><option>Western Cape</option><option>Northern Cape</option><option>Free State</option><option>Gauteng</option><option>KwaZulu-Natal</option><option>Limpopo</option><option>Mpumalanga</option><option>North West</option></select><span asp-validation-for="Province" class="text-danger"></span></div><div class="form-group col-md-3"><label asp-for="PostalCode"></label><input asp-for="PostalCode" class="form-control" maxlength="4" inputmode="numeric"/><span asp-validation-for="PostalCode" class="text-danger"></span></div></div>
<hr/><h5>Medical history</h5><p class="text-muted">Choose from the administrator-managed lists. You can select multiple entries.</p>
<div class="form-group"><label>Medical conditions</label><div class="custom-control custom-checkbox mb-2"><input asp-for="NoKnownMedicalConditions" class="custom-control-input no-known" id="NoKnownMedicalConditions"/><label asp-for="NoKnownMedicalConditions" class="custom-control-label">No known medical conditions reported</label></div><div class="row condition-options">@foreach(var x in conditions){<div class="col-md-6 mb-2"><label class="border rounded p-2 d-flex align-items-start w-100 h-100"><input type="checkbox" name="MedicalConditionIds" value="@x.MedicalConditionId" class="mr-2 mt-1" @(Model.MedicalConditionIds.Contains(x.MedicalConditionId)?"checked":"")/><span>@x.Name</span></label></div>}@if(!conditions.Any()){<div class="col-12 text-muted">No active medical conditions are configured by the administrator.</div>}</div><span asp-validation-for="MedicalConditionIds" class="text-danger"></span></div>
<div class="form-group"><label>Allergies</label><div class="custom-control custom-checkbox mb-2"><input asp-for="NoKnownAllergies" class="custom-control-input no-known" id="NoKnownAllergies"/><label asp-for="NoKnownAllergies" class="custom-control-label">No known allergies reported</label></div><div class="row allergy-options">@foreach(var x in allergies){<div class="col-md-6 mb-2"><label class="border rounded p-2 d-flex align-items-start w-100 h-100"><input type="checkbox" name="AllergyIds" value="@x.AllergyId" class="mr-2 mt-1" @(Model.AllergyIds.Contains(x.AllergyId)?"checked":"")/><span>@x.Name</span></label></div>}@if(!allergies.Any()){<div class="col-12 text-muted">No active allergies are configured by the administrator.</div>}</div><span asp-validation-for="AllergyIds" class="text-danger"></span></div>
<div class="form-group"><label>Current medications</label><div class="custom-control custom-checkbox mb-2"><input asp-for="NoCurrentMedications" class="custom-control-input no-known" id="NoCurrentMedications"/><label asp-for="NoCurrentMedications" class="custom-control-label">No current medications reported</label></div><div class="row medication-options">@foreach(var x in medications){<div class="col-md-6 mb-2"><label class="border rounded p-2 d-flex align-items-start w-100 h-100"><input type="checkbox" name="MedicationIds" value="@x.MedicationId" class="mr-2 mt-1" @(Model.MedicationIds.Contains(x.MedicationId)?"checked":"")/><span>@x.Name</span></label></div>}@if(!medications.Any()){<div class="col-12 text-muted">No active medications are configured by the administrator.</div>}</div><span asp-validation-for="MedicationIds" class="text-danger"></span></div>
<div class="alert alert-info"><i class="fas fa-envelope mr-1"></i> A secure temporary password will be generated and emailed to the patient. They must change it after signing in.</div><div class="d-flex justify-content-end"><a asp-action="Index" class="btn btn-light mr-2">Cancel</a><button class="btn btn-primary" type="submit">Create patient and email login</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>
(function(){const id=document.getElementById('IDNumber'), dob=document.getElementById('DateOfBirth');function populate(){const v=(id.value||'').trim();if(!/^\d{13}$/.test(v)){dob.value='';return;}const yy=+v.slice(0,2),mm=+v.slice(2,4),dd=+v.slice(4,6),now=new Date(),cy=now.getFullYear()%100,century=now.getFullYear()-cy;let year=yy<=cy?century+yy:century-100+yy;const date=new Date(year,mm-1,dd);if(mm<1||mm>12||date.getFullYear()!==year||date.getMonth()!==mm-1||date.getDate()!==dd||date>new Date(now.getFullYear(),now.getMonth(),now.getDate())){dob.value='';return;}dob.value=year.toString().padStart(4,'0')+'-'+String(mm).padStart(2,'0')+'-'+String(dd).padStart(2,'0');}id.addEventListener('input',populate);populate();document.querySelectorAll('.no-known').forEach(flag=>{const cls=flag.id==='NoKnownMedicalConditions'?'.condition-options':flag.id==='NoKnownAllergies'?'.allergy-options':'.medication-options';function sync(){document.querySelectorAll(cls+' input[type=checkbox]').forEach(cb=>{cb.disabled=flag.checked;if(flag.checked)cb.checked=false;});}flag.addEventListener('change',sync);sync();});})();
</script> }
