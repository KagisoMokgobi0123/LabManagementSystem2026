@model NMB_HLabSys.Areas.Doctor.ViewModels.PatientCreateViewModel
@using NMB_HLabSys.Areas.Administrator.Models

@{
    ViewData["Title"] = "Add Patient";
    Layout = "_DoctorLayout";

    var conditions =
        ViewBag.MedicalConditions as List<MedicalCondition> ?? new();

    var allergies =
        ViewBag.Allergies as List<Allergy> ?? new();

    var medications =
        ViewBag.Medications as List<Medication> ?? new();
}

<div class="container py-4">
    <div class="mb-3">
        <a asp-action="Index" class="text-muted">
            &larr; Patients
        </a>

        <h2 class="mt-2">Add Patient</h2>

        <p class="text-muted">
            Enter the patient's details. Date of birth is derived from
            the South African ID number.
        </p>
    </div>

    <form asp-action="Create"
          asp-controller="Patients"
          asp-area="Doctor"
          method="post"
          class="card card-body shadow-sm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert"></div>

        <!-- PERSONAL DETAILS -->
        <h5>Personal details</h5>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Name"></label>
                <input asp-for="Name"
                       class="form-control"
                       autocomplete="given-name" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Surname"></label>
                <input asp-for="Surname"
                       class="form-control"
                       autocomplete="family-name" />
                <span asp-validation-for="Surname"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="IDNumber"></label>

                <input asp-for="IDNumber"
                       id="IDNumber"
                       class="form-control"
                       maxlength="13"
                       minlength="13"
                       pattern="[0-9]{13}"
                       inputmode="numeric"
                       autocomplete="off"
                       placeholder="Enter 13-digit ID number" />

                <small class="form-text text-muted">
                    Enter a valid 13-digit South African ID number.
                </small>

                <span asp-validation-for="IDNumber"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="DateOfBirth"></label>

                <input asp-for="DateOfBirth"
                       id="DateOfBirth"
                       type="date"
                       class="form-control"
                       readonly />

                <small class="form-text text-muted">
                    Automatically populated from the ID number.
                </small>

                <span asp-validation-for="DateOfBirth"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="ContactNumber"></label>

                <input asp-for="ContactNumber"
                       type="tel"
                       class="form-control"
                       maxlength="10"
                       minlength="10"
                       pattern="0[0-9]{9}"
                       inputmode="numeric"
                       autocomplete="tel"
                       placeholder="e.g. 0821234567" />

                <small class="form-text text-muted">
                    Enter exactly 10 digits, starting with 0.
                </small>

                <span asp-validation-for="ContactNumber"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>
        </div>

        <!-- ADDRESS -->
        <h5 class="mt-3">Address</h5>

        <div class="form-group">
            <label asp-for="Address"></label>

            <input asp-for="Address" class="form-control" />

            <span asp-validation-for="Address"
                  class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group col-md-3">
                <label asp-for="Suburb"></label>
                <input asp-for="Suburb" class="form-control" />
                <span asp-validation-for="Suburb"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="City"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="Province"></label>

                <select asp-for="Province" class="form-control">
                    <option value="Eastern Cape">Eastern Cape</option>
                    <option value="Western Cape">Western Cape</option>
                    <option value="Northern Cape">Northern Cape</option>
                    <option value="Free State">Free State</option>
                    <option value="Gauteng">Gauteng</option>
                    <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                    <option value="Limpopo">Limpopo</option>
                    <option value="Mpumalanga">Mpumalanga</option>
                    <option value="North West">North West</option>
                </select>

                <span asp-validation-for="Province"
                      class="text-danger"></span>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="PostalCode"></label>

                <input asp-for="PostalCode"
                       class="form-control"
                       maxlength="4"
                       minlength="4"
                       pattern="[0-9]{4}"
                       inputmode="numeric" />

                <span asp-validation-for="PostalCode"
                      class="text-danger"></span>
            </div>
        </div>

        <hr />

        <!-- MEDICAL HISTORY -->
        <h5>Medical history</h5>

        <p class="text-muted">
            Select the patient's medical conditions, allergies and
            current medications from the records configured by the
            administrator. Multiple entries can be selected.
        </p>

        <!-- MEDICAL CONDITIONS -->
        <div class="form-group">
            <label asp-for="MedicalConditionIds">
                Medical conditions
            </label>

            <div class="doctor-choice-grid" role="group" aria-label="Medical conditions">
                @foreach (var item in conditions)
                {
                    <label class="doctor-choice-card">
                        <input type="checkbox" name="MedicalConditionIds" value="@item.MedicalConditionId"
                               checked="@(Model.MedicalConditionIds.Contains(item.MedicalConditionId) ? "checked" : null)" />
                        <span>@item.Name</span>
                    </label>
                }
            </div>

            <small id="conditionsHelp"
                   class="form-text text-muted">
                Hold Ctrl on Windows or Command on Mac to select
                multiple entries.
            </small>

            <span asp-validation-for="MedicalConditionIds"
                  class="text-danger"></span>

            @if (!conditions.Any())
            {
                <small class="text-warning d-block mt-1">
                    No active medical conditions are available.
                    Ask the administrator to configure them.
                </small>
            }

            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="NoKnownMedicalConditions"
                       class="custom-control-input no-known"
                       id="NoKnownMedicalConditions" />

                <label asp-for="NoKnownMedicalConditions"
                       class="custom-control-label">
                    No known medical conditions reported
                </label>
            </div>

            <span asp-validation-for="NoKnownMedicalConditions"
                  class="text-danger"></span>
        </div>

        <!-- ALLERGIES -->
        <div class="form-group">
            <label asp-for="AllergyIds">Allergies</label>

            <div class="doctor-choice-grid" role="group" aria-label="Allergies">
                @foreach (var item in allergies)
                {
                    <label class="doctor-choice-card">
                        <input type="checkbox" name="AllergyIds" value="@item.AllergyId"
                               checked="@(Model.AllergyIds.Contains(item.AllergyId) ? "checked" : null)" />
                        <span>@item.Name</span>
                    </label>
                }
            </div>

            <small id="allergiesHelp"
                   class="form-text text-muted">
                Click each applicable allergy to select or deselect it. Multiple allergies can be selected.
            </small>

            <span asp-validation-for="AllergyIds"
                  class="text-danger"></span>

            @if (!allergies.Any())
            {
                <small class="text-warning d-block mt-1">
                    No active allergies are available.
                    Ask the administrator to configure them.
                </small>
            }

            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="NoKnownAllergies"
                       class="custom-control-input no-known"
                       id="NoKnownAllergies" />

                <label asp-for="NoKnownAllergies"
                       class="custom-control-label">
                    No known allergies reported
                </label>
            </div>

            <span asp-validation-for="NoKnownAllergies"
                  class="text-danger"></span>
        </div>

        <!-- MEDICATIONS -->
        <div class="form-group">
            <label asp-for="MedicationIds">
                Current medications
            </label>

            <div class="doctor-choice-grid" role="group" aria-label="Current medications">
                @foreach (var item in medications)
                {
                    <label class="doctor-choice-card">
                        <input type="checkbox" name="MedicationIds" value="@item.MedicationId"
                               checked="@(Model.MedicationIds.Contains(item.MedicationId) ? "checked" : null)" />
                        <span>@item.Name</span>
                    </label>
                }
            </div>

            <small id="medicationsHelp"
                   class="form-text text-muted">
                Click each medication to select or deselect it. Multiple medications can be selected.
            </small>

            <span asp-validation-for="MedicationIds"
                  class="text-danger"></span>

            @if (!medications.Any())
            {
                <small class="text-warning d-block mt-1">
                    No active medications are available.
                    Ask the administrator to configure them.
                </small>
            }

            <div class="custom-control custom-checkbox mt-2">
                <input asp-for="NoCurrentMedications"
                       class="custom-control-input no-known"
                       id="NoCurrentMedications" />

                <label asp-for="NoCurrentMedications"
                       class="custom-control-label">
                    No current medications reported
                </label>
            </div>

            <span asp-validation-for="NoCurrentMedications"
                  class="text-danger"></span>
        </div>

        <!-- LOGIN INFORMATION -->
        <div class="alert alert-info" role="note">
            <i class="fas fa-envelope mr-1"></i>
            A temporary password will be generated for the patient's
            account. Login instructions will be emailed to the address
            provided. The patient must change the temporary password
            after signing in.
        </div>

        <!-- ACTIONS -->
        <div class="d-flex justify-content-end">
            <a asp-action="Index"
               class="btn btn-light mr-2">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-user-plus mr-1"></i>
                Create patient and email login
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            "use strict";

            // Populate the date of birth from the ID number.
            const idInput = document.getElementById("IDNumber");
            const dobInput = document.getElementById("DateOfBirth");

            function populateDateOfBirth() {
                const value = (idInput.value || "").trim();

                if (!/^\d{13}$/.test(value)) {
                    dobInput.value = "";
                    return;
                }

                const yy = Number(value.substring(0, 2));
                const month = Number(value.substring(2, 4));
                const day = Number(value.substring(4, 6));

                const today = new Date();
                const currentYear = today.getFullYear();
                const currentCentury = currentYear -
                    (currentYear % 100);

                let year = currentCentury + yy;

                if (year > currentYear) {
                    year -= 100;
                }

                if (month < 1 || month > 12 ||
                    day < 1 || day > 31) {
                    dobInput.value = "";
                    return;
                }

                const date = new Date(year, month - 1, day);

                // Reject impossible dates, such as 31 February.
                if (date.getFullYear() !== year ||
                    date.getMonth() !== month - 1 ||
                    date.getDate() !== day ||
                    date > new Date(
                        today.getFullYear(),
                        today.getMonth(),
                        today.getDate())) {
                    dobInput.value = "";
                    return;
                }

                dobInput.value =
                    String(year).padStart(4, "0") + "-" +
                    String(month).padStart(2, "0") + "-" +
                    String(day).padStart(2, "0");
            }

            idInput.addEventListener("input", populateDateOfBirth);
            populateDateOfBirth();

            // Keep each "No known..." option mutually exclusive
            // with the corresponding multi-select dropdown.
            const selectionPairs = [
                {
                    checkbox: "NoKnownMedicalConditions",
                    select: "MedicalConditionIds"
                },
                {
                    checkbox: "NoKnownAllergies",
                    select: "AllergyIds"
                },
                {
                    checkbox: "NoCurrentMedications",
                    select: "MedicationIds"
                }
            ];

            selectionPairs.forEach(function (pair) {
                const checkbox =
                    document.getElementById(pair.checkbox);
                const select =
                    document.getElementById(pair.select);

                if (!checkbox || !select) {
                    return;
                }

                function syncSelection() {
                    select.disabled = checkbox.checked;

                    if (checkbox.checked) {
                        Array.from(select.options).forEach(
                            function (option) {
                                option.selected = false;
                            }
                        );
                    }
                }

                checkbox.addEventListener("change", syncSelection);
                syncSelection();
            });
        })();
    </script>
}
