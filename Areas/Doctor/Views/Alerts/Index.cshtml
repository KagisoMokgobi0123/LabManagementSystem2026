@model IEnumerable<TestRequestTestTypeModel>
@using NMB_HLabSys.Areas.Doctor.Models
@{ ViewData["Title"] = "Clinical Alerts"; Layout = "_DoctorLayout"; var requests = ViewBag.Requests as Dictionary<int,TestRequestsModel> ?? new(); }
<div class="container-fluid py-4"><h2>Clinical alerts</h2><p class="text-muted">Abnormal test results associated with your requests. Review results in the context of the patient's clinical presentation.</p><div class="alert alert-warning">Alerts support clinical review and do not replace professional judgement or local critical-result escalation procedures.</div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Completed</th><th>Patient</th><th>Request</th><th>Test</th><th>Result</th><th>Technician notes</th><th></th></tr></thead><tbody>@foreach(var x in Model){var req=requests.ContainsKey(x.TestRequestId)?requests[x.TestRequestId]:null;<tr><td>@x.CompletionDateTime?.ToString("dd MMM yyyy HH:mm")</td><td>@(req?.Patient?.FullName ?? "Patient")</td><td>@req?.RequestNumber</td><td>@x.TestType?.Name</td><td><span class="badge badge-danger">@x.ResultValue @x.TestType?.MeasurementUnitDetails?.Unit</span></td><td>@x.ResultNotes</td><td>@if(req != null && (req.Status=="Completed" || req.Status=="Released" || req.Status=="ReleasedByDoctor")){<a asp-controller="Results" asp-action="Details" asp-route-id="@req.TestRequestId">View result</a>}</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">No abnormal results have been recorded for your requests.</td></tr>}</tbody></table></div></div></div>
