@using NMB_HLabSys.Areas.Administrator.Models
@model Patient
@{
    ViewData["Title"] = "Search Patient";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-primary-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Search Patient</h2>
                <h5 class="text-white op-7 mb-2">Find a patient by SA ID Number</h5>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">
    <div class="card">
        <div class="card-header">
            <div class="card-title">Patient Search</div>
        </div>
        <div class="card-body">
            <form method="get" class="form-inline">
                <div class="form-group mr-3 flex-fill">
                    <label class="mr-2 font-weight-bold">SA ID Number:</label>
                    <input type="text" name="saIdNumber" class="form-control"
                           value="@ViewBag.SearchId" placeholder="Enter 13-digit SA ID number"
                           maxlength="13" style="min-width:250px;" />
                </div>
                <button type="submit" class="btn btn-primary btn-round">
                    <i class="fa fa-search mr-1"></i> Search
                </button>
            </form>
        </div>
    </div>

    @if (ViewBag.SearchId != null && Model == null)
    {
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle mr-2"></i>
            No patient found with ID number <strong>@ViewBag.SearchId</strong>.
            <a asp-action="Create" class="btn btn-sm btn-primary ml-3">Register New Patient</a>
        </div>
    }

    @if (Model != null)
    {
        <div class="card">
            <div class="card-header">
                <div class="card-head-row">
                    <div class="card-title">Patient Found</div>
                    <div class="card-tools">
                        <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor"
                           asp-action="Create" asp-route-patientId="@Model.PatientID"
                           class="btn btn-success btn-round btn-sm">
                            <i class="fa fa-flask mr-1"></i> Create Test Request
                        </a>
                        <a asp-action="EditMedicalHistory" asp-route-id="@Model.PatientID"
                           class="btn btn-warning btn-round btn-sm ml-2">
                            <i class="fa fa-heartbeat mr-1"></i> Edit Medical History
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr><th>Name:</th><td>@Model.Name @Model.Surname</td></tr>
                            <tr><th>SA ID:</th><td><code>@Model.IDNumber</code></td></tr>
                            <tr><th>Date of Birth:</th><td>@Model.DateOfBirth.ToString("dd MMM yyyy")</td></tr>
                            <tr><th>Cellphone:</th><td>@(Model.CellPhone ?? "—")</td></tr>
                            <tr><th>Email:</th><td>@(Model.Email ?? "—")</td></tr>
                            <tr><th>Home Address:</th><td>@(Model.HomeAddress ?? "—")</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <!-- Medical Conditions -->
                        <h6 class="fw-bold text-primary">Medical Conditions</h6>
                        @if (Model.PatientConditions != null && Model.PatientConditions.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var c in Model.PatientConditions)
                                {
                                    <li><span class="badge badge-warning mr-1">@c.MedicalCondition?.ConditionName</span></li>
                                }
                            </ul>
                        }
                        else { <p class="text-muted small">None recorded</p> }

                        <!-- Allergies -->
                        <h6 class="fw-bold text-danger mt-3">Allergies</h6>
                        @if (Model.PatientAllergies != null && Model.PatientAllergies.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var a in Model.PatientAllergies)
                                {
                                    <li><span class="badge badge-danger mr-1">@a.Allergy?.AllergyName</span></li>
                                }
                            </ul>
                        }
                        else { <p class="text-muted small">None recorded</p> }

                        <!-- Medications -->
                        <h6 class="fw-bold text-info mt-3">Current Medication</h6>
                        @if (Model.PatientMedications != null && Model.PatientMedications.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var m in Model.PatientMedications)
                                {
                                    <li><span class="badge badge-info mr-1">@m.Medication?.MedicationName</span></li>
                                }
                            </ul>
                        }
                        else { <p class="text-muted small">None recorded</p> }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
