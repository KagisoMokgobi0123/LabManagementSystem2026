@using NMB_HLabSys.Areas.Administrator.Models
@model List<Patient>
@{
    ViewData["Title"] = "My Patients";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-primary-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">My Patients</h2>
                <h5 class="text-white op-7 mb-2">Patients who have granted you access</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-action="Search" class="btn btn-white btn-border btn-round mr-2">
                    <i class="fa fa-search mr-1"></i> Search Patient
                </a>
                <a asp-action="Create" class="btn btn-secondary btn-round">
                    <i class="fa fa-user-plus mr-1"></i> Register Patient
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["Warning"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <div class="card-head-row">
                <div class="card-title">Patient List</div>
                <div class="card-tools">
                    <span class="badge badge-primary">@Model.Count patient(s)</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa fa-users fa-3x text-muted mb-3"></i>
                    <h5>No patients found.</h5>
                    <p class="text-muted">Register a new patient or search by SA ID number.</p>
                    <a asp-action="Create" class="btn btn-primary btn-round">Register Patient</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="patientsTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Surname</th>
                                <th>SA ID Number</th>
                                <th>Date of Birth</th>
                                <th>Cellphone</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td>@patient.Name</td>
                                    <td>@patient.Surname</td>
                                    <td><code>@patient.IDNumber</code></td>
                                    <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                                    <td>@(patient.CellPhone ?? "—")</td>
                                    <td>@(patient.Email ?? "—")</td>
                                    <td>
                                        <a asp-area="Doctor" asp-controller="DoctorDashboard"
                                           asp-action="PatientDetails" asp-route-id="@patient.PatientID"
                                           class="btn btn-sm btn-info btn-round mr-1" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a asp-action="EditMedicalHistory" asp-route-id="@patient.PatientID"
                                           class="btn btn-sm btn-warning btn-round mr-1" title="Edit Medical History">
                                            <i class="fa fa-heartbeat"></i>
                                        </a>
                                        <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor"
                                           asp-action="Create" asp-route-patientId="@patient.PatientID"
                                           class="btn btn-sm btn-success btn-round" title="New Test Request">
                                            <i class="fa fa-flask"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
