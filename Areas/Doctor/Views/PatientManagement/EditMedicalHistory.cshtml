@using NMB_HLabSys.ViewModels.Doctor
@model CreatePatientViewModel
@{
    ViewData["Title"] = "Edit Medical History";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-warning-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Edit Medical History</h2>
                <h5 class="text-white op-7 mb-2">@Model.Name @Model.Surname</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-action="Index" class="btn btn-white btn-border btn-round">
                    <i class="fa fa-arrow-left mr-1"></i> Back to Patients
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">
    <form asp-action="EditMedicalHistory" method="post">
        @Html.AntiForgeryToken()

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }

        <!-- Patient Info Summary -->
        <div class="card">
            <div class="card-header">
                <div class="card-title"><i class="fa fa-user mr-2"></i> Patient Summary</div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Name:</strong> @Model.Name @Model.Surname</div>
                    <div class="col-md-3"><strong>SA ID:</strong> <code>@Model.IDNumber</code></div>
                    <div class="col-md-3"><strong>DOB:</strong> @Model.DateOfBirth?.ToString("dd MMM yyyy")</div>
                    <div class="col-md-3"><strong>Email:</strong> @Model.Email</div>
                </div>
            </div>
        </div>

        <!-- Medical History -->
        <div class="card">
            <div class="card-header">
                <div class="card-title"><i class="fa fa-heartbeat mr-2"></i> Medical History</div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Medical Conditions -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="font-weight-bold text-warning">
                                <i class="fa fa-notes-medical mr-1"></i> Medical Conditions
                            </label>
                            <div class="border rounded p-3" style="max-height:250px;overflow-y:auto;">
                                @if (Model.AvailableConditions != null && Model.AvailableConditions.Any())
                                {
                                    foreach (var c in Model.AvailableConditions)
                                    {
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedConditionIds" value="@c.Value"
                                                   id="cond_@c.Value"
                                            @(Model.SelectedConditionIds.Contains(int.Parse(c.Value)) ? "checked" : "") />
                                            <label class="form-check-label" for="cond_@c.Value">@c.Text</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small">No conditions available in system.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Allergies -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="font-weight-bold text-danger">
                                <i class="fa fa-allergies mr-1"></i> Allergies
                            </label>
                            <div class="border rounded p-3" style="max-height:250px;overflow-y:auto;">
                                @if (Model.AvailableAllergies != null && Model.AvailableAllergies.Any())
                                {
                                    foreach (var a in Model.AvailableAllergies)
                                    {
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedAllergyIds" value="@a.Value"
                                                   id="allergy_@a.Value"
                                            @(Model.SelectedAllergyIds.Contains(int.Parse(a.Value)) ? "checked" : "") />
                                            <label class="form-check-label" for="allergy_@a.Value">@a.Text</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small">No allergies available in system.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Medications -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="font-weight-bold text-info">
                                <i class="fa fa-pills mr-1"></i> Current Medications
                            </label>
                            <div class="border rounded p-3" style="max-height:250px;overflow-y:auto;">
                                @if (Model.AvailableMedications != null && Model.AvailableMedications.Any())
                                {
                                    foreach (var m in Model.AvailableMedications)
                                    {
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedMedicationIds" value="@m.Value"
                                                   id="med_@m.Value"
                                            @(Model.SelectedMedicationIds.Contains(int.Parse(m.Value)) ? "checked" : "") />
                                            <label class="form-check-label" for="med_@m.Value">@m.Text</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small">No medications available in system.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mb-4">
            <a asp-action="Index" class="btn btn-default btn-round">
                <i class="fa fa-times mr-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-warning btn-round">
                <i class="fa fa-save mr-1"></i> Save Medical History
            </button>
        </div>
    </form>
</div>