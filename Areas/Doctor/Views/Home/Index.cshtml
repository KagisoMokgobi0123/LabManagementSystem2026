@model NMB_HLabSys.Areas.Doctor.ViewModels.DoctorDashboardViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_DoctorLayout";

    var currentUser = await UserManager.GetUserAsync(User);

    var doctorName = currentUser?.FullName ?? "Doctor";
    var doctorEmail = currentUser?.Email ?? "";

    var doctorInitial =
        !string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? currentUser.FirstName.Substring(0, 1).ToUpper()
            : "D";
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .doctor-dashboard {
        min-height: 100vh;
        background: #f4f7fb;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .doctor-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;
        background: linear-gradient( 135deg, #073b5c 0%, #075985 45%, #0284c7 100% );
    }

        .doctor-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: 220px;
            bottom: -190px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

        .doctor-hero::after {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -100px;
            top: -210px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

    .doctor-hero-content {
        position: relative;
        z-index: 2;
    }

    .doctor-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        margin-bottom: 14px;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50px;
        background: rgba(255,255,255,.13);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

    .doctor-hero h1 {
        margin-bottom: 7px;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
    }

    .doctor-hero p {
        max-width: 720px;
        margin: 0;
        color: rgba(255,255,255,.82);
        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s ease;
    }

        .hero-btn:hover {
            transform: translateY(-2px);
        }

    .hero-btn-primary {
        background: #fff;
        color: #075985 !important;
    }

    .hero-btn-outline {
        border: 1px solid rgba(255,255,255,.50);
        background: rgba(255,255,255,.08);
        color: #fff !important;
    }


    /* =========================================================
           PAGE INNER
           ========================================================= */

    .doctor-page-inner {
        position: relative;
        z-index: 5;
        margin-top: -48px;
        padding-bottom: 50px;
    }


    /* =========================================================
           STAT CARDS
           ========================================================= */

    .stat-card-link {
        display: block;
        height: 100%;
        color: inherit !important;
        text-decoration: none !important;
    }

    .stat-card {
        position: relative;
        height: 100%;
        padding: 20px;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .stat-card-link:hover .stat-card {
        transform: translateY(-4px);
        border-color: #bae6fd;
        box-shadow: 0 12px 30px rgba(15,23,42,.13);
    }

    .stat-card::after {
        content: "\f054";
        position: absolute;
        right: 20px;
        bottom: 17px;
        font-family: "Font Awesome 5 Free";
        font-size: 10px;
        font-weight: 900;
        color: #cbd5e1;
        opacity: 0;
        transform: translateX(-5px);
        transition: .2s ease;
    }

    .stat-card-link:hover .stat-card::after {
        opacity: 1;
        transform: translateX(0);
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }

    .stat-title {
        margin-bottom: 7px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .stat-number {
        margin: 0;
        color: #0f172a;
        font-size: 28px;
        font-weight: 700;
    }

    .stat-note {
        margin-top: 7px;
        padding-right: 10px;
        color: #94a3b8;
        font-size: 11px;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 11px;
        font-size: 17px;
    }

    .icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .icon-cyan {
        background: #cffafe;
        color: #0891b2;
    }

    .icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .icon-purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-red {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-yellow {
        background: #fef3c7;
        color: #d97706;
    }


    /* =========================================================
           DASHBOARD CARDS
           ========================================================= */

    .dashboard-card {
        margin-bottom: 24px;
        border: 0;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
    }

        .dashboard-card .card-header {
            padding: 18px 20px;
            border-bottom: 1px solid #eef2f7;
            background: transparent;
        }

        .dashboard-card .card-body {
            padding: 20px;
        }

    .dashboard-title {
        margin: 0;
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        margin-top: 4px;
        margin-bottom: 0;
        color: #94a3b8;
        font-size: 11px;
    }


    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .quick-action {
        display: flex;
        align-items: center;
        min-height: 78px;
        margin-bottom: 12px;
        padding: 15px;
        border: 1px solid #e8edf3;
        border-radius: 10px;
        background: #fff;
        color: inherit !important;
        text-decoration: none !important;
        transition: .2s ease;
    }

        .quick-action:hover {
            transform: translateY(-2px);
            border-color: #0284c7;
            background: #f8fcff;
            box-shadow: 0 6px 18px rgba(15,23,42,.06);
        }

    .quick-action-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        min-width: 42px;
        margin-right: 12px;
        border-radius: 10px;
        background: #e0f2fe;
        color: #0284c7;
    }

    .quick-action-title {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }

    .quick-action-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    .quick-action-arrow {
        margin-left: auto;
        padding-left: 10px;
        color: #cbd5e1;
    }


    /* =========================================================
           WORKFLOW
           ========================================================= */

    .workflow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .workflow-item {
        flex: 1;
        text-align: center;
    }

    .workflow-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin: auto;
        border-radius: 50%;
        background: #e0f2fe;
        color: #0284c7;
        font-size: 16px;
    }

    .workflow-title {
        margin-top: 8px;
        color: #334155;
        font-size: 11px;
        font-weight: 600;
    }

    .workflow-line {
        flex: .6;
        height: 2px;
        margin-top: -20px;
        background: #e2e8f0;
    }


    /* =========================================================
           ATTENTION
           ========================================================= */

    .attention-item {
        display: flex;
        align-items: flex-start;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
        color: inherit !important;
        text-decoration: none !important;
    }

        .attention-item:last-child {
            border-bottom: 0;
        }

    .attention-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 37px;
        height: 37px;
        min-width: 37px;
        margin-right: 11px;
        border-radius: 9px;
    }

    .attention-title {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
    }

    .attention-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }


    /* =========================================================
           RECENT REQUESTS TABLE
           Columns: Request # | Patient | Request Date | Urgency | Status | Action
           ========================================================= */

    .doctor-table {
        width: 100%;
        margin-bottom: 0;
        table-layout: fixed;
        border-collapse: collapse;
    }

    /* One consistent box model for every header and cell */
    .doctor-table th,
    .doctor-table td {
        box-sizing: border-box;
        display: table-cell !important;
        float: none !important;
        position: static !important;
        padding: 14px 16px !important;
        vertical-align: middle !important;
        text-align: left;
    }

    .doctor-table thead th {
        border-top: 0;
        border-bottom: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .doctor-table tbody td {
        border-top: 1px solid #f1f5f9;
        color: #334155;
        font-size: 12px;
        line-height: 1.4;
        overflow-wrap: break-word;
    }

    /* Column widths (total 100%) */
    .doctor-table .dt-col-request { width: 16%; }
    .doctor-table .dt-col-patient { width: 22%; }
    .doctor-table .dt-col-date    { width: 22%; }
    .doctor-table .dt-col-urgency { width: 12%; }
    .doctor-table .dt-col-status  { width: 16%; }
    .doctor-table .dt-col-action  { width: 12%; }

    /* Keep identifiers and dates on one line so rows stay level */
    .doctor-table .dt-cell-request,
    .doctor-table .dt-cell-date {
        white-space: nowrap;
    }

    /* Action column: header and button share the same centered axis */
    .doctor-table .dt-cell-action {
        text-align: center;
    }

        .doctor-table .dt-cell-action .btn {
            display: inline-block;
            min-width: 64px;
            margin: 0;
            white-space: nowrap;
        }

    /* Urgency and status are coloured inline text (see the span style in the markup).
       Guard: every cell stays a real table cell so columns can never merge. */
    .doctor-content table.doctor-table.table > thead > tr > th,
    .doctor-content table.doctor-table.table > tbody > tr > td,
    .doctor-main table.doctor-table.table > thead > tr > th,
    .doctor-main table.doctor-table.table > tbody > tr > td {
        display: table-cell !important;
        float: none !important;
        position: static !important;
    }

    @@media (max-width: 768px) {
        .doctor-table {
            min-width: 850px;
        }
    }

    /* =========================================================
           PROFILE
           ========================================================= */

    .profile-summary {
        display: flex;
        align-items: center;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        margin-right: 12px;
        border-radius: 50%;
        background: linear-gradient( 135deg, #075985, #0284c7 );
        color: #fff;
        font-weight: 700;
    }

    .profile-name {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }

    .profile-role,
    .profile-email {
        color: #64748b;
        font-size: 11px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media(max-width: 768px) {

        .doctor-hero {
            padding-top: 25px;
        }

            .doctor-hero h1 {
                font-size: 24px;
            }

        .hero-actions {
            margin-top: 20px;
        }

        .workflow {
            flex-direction: column;
            align-items: flex-start;
        }

        .workflow-item {
            display: flex;
            align-items: center;
            text-align: left;
        }

        .workflow-title {
            margin-top: 0;
            margin-left: 10px;
        }

        .workflow-line {
            flex: none;
            width: 2px;
            height: 20px;
            margin: 0 0 0 23px;
        }
    }


    .analytics-row {
        margin-bottom: 16px;
        color: #475569;
        font-size: 12px;
    }

    .analytics-track, .month-bar-track {
        background: #e2e8f0;
        border-radius: 7px;
        overflow: hidden;
    }

    .analytics-track {
        height: 10px;
    }

    .analytics-bar {
        height: 100%;
        min-width: 2px;
        border-radius: 7px;
        background: linear-gradient(90deg, #0284c7, #22d3ee);
    }

    .monthly-chart {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 8px;
        min-height: 190px;
        padding-top: 8px;
    }

    .month-column {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        color: #64748b;
        font-size: 10px;
        text-align: center;
    }

        .month-column strong {
            color: #0f172a;
            font-size: 11px;
        }

    .month-bar-track {
        display: flex;
        align-items: end;
        width: 100%;
        max-width: 30px;
        height: 120px;
    }

    .month-bar {
        width: 100%;
        min-height: 2px;
        border-radius: 5px 5px 0 0;
        background: linear-gradient(180deg, #22d3ee, #0369a1);
    }

    .month-column span {
        white-space: nowrap;
        transform: rotate(-25deg);
        transform-origin: center top;
    }

</style>


<div class="doctor-dashboard">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <div class="doctor-hero">

        <div class="container-fluid">

            <div class="doctor-hero-content">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <div class="doctor-badge">

                            <i class="fas fa-user-doctor"></i>

                            Doctor

                        </div>


                        <h1>
                            Welcome, Dr @doctorName
                        </h1>


                        <p>
                            Manage patient records, submit laboratory
                            test requests, track testing progress,
                            review verified results and release
                            laboratory reports to patients.
                        </p>

                    </div>


                    <div class="col-md-4">

                        <div class="hero-actions justify-content-md-end">

                            <a asp-area="Doctor"
                               asp-controller="TestRequests"
                               asp-action="Create"
                               class="hero-btn hero-btn-primary">

                                <i class="fas fa-plus"></i>

                                New Test Request

                            </a>


                            @* <a asp-area="Doctor"
                               asp-controller="Alerts"
                               asp-action="Index"
                               class="hero-btn hero-btn-outline">

                                <i class="fas fa-triangle-exclamation"></i>

                                View Alerts

                            </a> *@

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

    <div class="container-fluid doctor-page-inner">


        <!-- =====================================================
             STAT CARDS
             ===================================================== -->

        <div class="row">


            <!-- PATIENTS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="Patients"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    My Patients
                                </div>

                                <h2 class="stat-number">
                                    @Model.PatientCount
                                </h2>

                                <div class="stat-note">
                                    Registered patient records
                                </div>

                            </div>


                            <div class="stat-icon icon-blue">

                                <i class="fas fa-users"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- TEST REQUESTS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="TestRequests"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Test Requests
                                </div>

                                <h2 class="stat-number">
                                    @Model.TestRequestCount
                                </h2>

                                <div class="stat-note">
                                    Requests submitted by you
                                </div>

                            </div>


                            <div class="stat-icon icon-cyan">

                                <i class="fas fa-flask"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- RESULTS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="Results"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Completed Results
                                </div>

                                <h2 class="stat-number">
                                    @Model.CompletedResultsCount
                                </h2>

                                <div class="stat-note">
                                    Results ready for doctor review
                                </div>

                            </div>


                            <div class="stat-icon icon-green">

                                <i class="fas fa-file-circle-check"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- ABNORMAL -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="Alerts"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Abnormal Results
                                </div>

                                <h2 class="stat-number">
                                    @Model.AbnormalResultsCount
                                </h2>

                                <div class="stat-note">
                                    Recent abnormal-result alerts
                                </div>

                            </div>


                            <div class="stat-icon icon-red">

                                <i class="fas fa-triangle-exclamation"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>


        <!-- SECOND ROW -->

        <div class="row">


            <!-- SUBMITTED -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="TestRequests"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Submitted Requests
                                </div>

                                <h2 class="stat-number">
                                    @Model.SubmittedCount
                                </h2>

                                <div class="stat-note">
                                    Waiting for laboratory processing
                                </div>

                            </div>


                            <div class="stat-icon icon-blue">

                                <i class="fas fa-paper-plane"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- IN PROGRESS -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Doctor"
                   asp-controller="TestRequests"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    In Progress
                                </div>

                                <h2 class="stat-number">
                                    @Model.InProgressCount
                                </h2>

                                <div class="stat-note">
                                    Requests currently being processed
                                </div>

                            </div>


                            <div class="stat-icon icon-yellow">

                                <i class="fas fa-spinner"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- READY TO RELEASE -->

            <div class="col-xl-4 col-md-12 mb-4">

                <a asp-area="Doctor"
                   asp-controller="Results"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Ready to Release
                                </div>

                                <h2 class="stat-number">
                                    @Model.ReadyToReleaseCount
                                </h2>

                                <div class="stat-note">
                                    Results awaiting release to patients
                                </div>

                            </div>


                            <div class="stat-icon icon-purple">

                                <i class="fas fa-share-from-square"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>



        <!-- DATABASE-DRIVEN ANALYTICS -->
        <div class="row">
            <div class="col-lg-7">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h4 class="dashboard-title">Test Request Status Analytics</h4>
                        <p class="dashboard-subtitle">Distribution of requests submitted by your account</p>
                    </div>
                    <div class="card-body">
                        @if (Model.StatusChart.Count == 0)
                        {
                            <p class="text-muted mb-0">No request data is available for this doctor yet.</p>
                        }
                        else
                        {
                            var maxStatus = Math.Max(1, Model.StatusChart.Max(x => x.Count));
                            foreach (var item in Model.StatusChart)
                            {
                                <div class="analytics-row">
                                    <div class="d-flex justify-content-between mb-1"><span>@item.Label</span><strong>@item.Count</strong></div>
                                    <div class="analytics-track"><div class="analytics-bar" style="width:@((item.Count * 100.0 / maxStatus).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h4 class="dashboard-title">Six-Month Request Trend</h4>
                        <p class="dashboard-subtitle">Monthly requests created by your account</p>
                    </div>
                    <div class="card-body">
                        @{
                            var maxMonth = Math.Max(1, Model.MonthlyChart.Count == 0 ? 0 : Model.MonthlyChart.Max(x => x.Count));
                        }
                        <div class="monthly-chart" role="img" aria-label="Monthly test request counts for the last six months">
                            @foreach (var month in Model.MonthlyChart)
                            {
