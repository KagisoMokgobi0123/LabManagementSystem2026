                    <div class="col-md-4 text-md-right mt-2 mt-md-0">

                        <a asp-area="Doctor"
                           asp-controller="TestRequests"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm">

                            <i class="fas fa-list mr-1"></i>

                            View All Requests

                        </a>

                    </div>

                </div>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table doctor-table">

                        <colgroup>
                            <col class="dt-col-request" />
                            <col class="dt-col-patient" />
                            <col class="dt-col-date" />
                            <col class="dt-col-urgency" />
                            <col class="dt-col-status" />
                            <col class="dt-col-action" />
                        </colgroup>

                        <thead>

                            <tr>

                                <th>Request #</th>

                                <th>Patient</th>

                                <th>Request Date</th>

                                <th>Urgency</th>

                                <th>Status</th>

                                <th class="dt-cell-action">Action</th>

                            </tr>

                        </thead>


                        <tbody>
                            @if (Model.RecentRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-flask fa-2x mb-3 d-block"></i>
                                        No test requests have been submitted by your account yet.
                                        <div class="mt-3"><a asp-area="Doctor" asp-controller="TestRequests" asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus mr-1"></i>Create Test Request</a></div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var request in Model.RecentRequests)
                                {
                                    var statusColor = request.Status.Contains("cancel", StringComparison.OrdinalIgnoreCase) ? "#b91c1c" :
                                        request.Status.Contains("complete", StringComparison.OrdinalIgnoreCase) ? "#15803d" :
                                        request.Status.Contains("release", StringComparison.OrdinalIgnoreCase) ? "#047857" :
                                        request.Status.Contains("progress", StringComparison.OrdinalIgnoreCase) ? "#b45309" :
                                        request.Status.Contains("received", StringComparison.OrdinalIgnoreCase) ? "#0e7490" :
                                        request.Status.Contains("pending", StringComparison.OrdinalIgnoreCase) ? "#b45309" : "#0369a1";
                                    var urgencyColor = request.Urgency.ToString().Equals("Stat", StringComparison.OrdinalIgnoreCase) ? "#b91c1c" :
                                        request.Urgency.ToString().Equals("Urgent", StringComparison.OrdinalIgnoreCase) ? "#c2410c" : "#475569";
                                    <tr>
                                        <td class="dt-cell-request">@request.RequestNumber</td>
                                        <td>@request.PatientName</td>
                                        <td class="dt-cell-date">@request.RequestDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td><span style="color:@urgencyColor;font-weight:700">@request.Urgency</span></td>
                                        <td><span style="color:@statusColor;font-weight:700">@request.Status</span></td>
                                        <td class="dt-cell-action"><a asp-area="Doctor" asp-controller="TestRequests" asp-action="Details" asp-route-id="@request.TestRequestId" class="btn btn-outline-primary btn-sm">View</a></td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>

                </div>

            </div>

        </div>


