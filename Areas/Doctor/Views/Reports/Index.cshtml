@model NMB_HLabSys.Areas.Doctor.ViewModels.ReportFilterViewModel
@{ ViewData["Title"] = "Doctor Reports"; Layout = "_DoctorLayout"; }
<div class="container py-4"><h2>Doctor reports</h2><p class="text-muted">Generate a structured PDF report of your test requests. The exported document includes the generation time, applied filters, sorted records, repeated column headings and page numbering.</p><div asp-validation-summary="All" class="text-danger"></div><form asp-action="Index" method="get" class="card card-body mb-3"><div class="form-row"><div class="form-group col-md-4"><label asp-for="From">From date</label><input asp-for="From" type="date" class="form-control"/></div><div class="form-group col-md-4"><label asp-for="To">To date</label><input asp-for="To" type="date" class="form-control"/></div><div class="form-group col-md-4"><label asp-for="Status">Request status</label><select asp-for="Status" class="form-control"><option value="">All statuses</option>@foreach(var s in new[]{"Submitted","Samples Received","InProgress","Completed","Released","ReleasedByDoctor","Cancelled"}){<option value="@s">@s</option>}</select></div></div><button class="btn btn-outline-primary align-self-start">Preview report count</button></form>
<div class="card card-body"><div class="d-flex justify-content-between align-items-center flex-wrap"><div><h5 class="mb-1">Test request report</h5><p class="text-muted mb-0">Matching records: @ViewBag.Count</p></div><form asp-action="Download" method="get"><input type="hidden" asp-for="From"/><input type="hidden" asp-for="To"/><input type="hidden" asp-for="Status"/><button type="submit" class="btn btn-primary"><i class="fas fa-file-pdf mr-1"></i> Generate PDF</button></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
