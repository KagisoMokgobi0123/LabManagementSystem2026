@model NMB_HLabSys.Areas.Doctor.ViewModels.ReportFilterViewModel

@{
    ViewData["Title"] = "Doctor Reports";
    Layout = "_DoctorLayout";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="text-muted">
            Generate a PDF report of your test requests. The report includes
            the selected filters, generation time, sorted records, repeated
            column headings and page numbering.
        </p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="close" data-dismiss="alert"
                    aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Report filters</h5>
        </div>

        <div class="card-body">
            <form asp-area="Doctor"
                  asp-controller="Reports"
                  asp-action="Index"
                  method="get">

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="From">From date</label>
                        <input asp-for="From"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="From"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="To">To date</label>
                        <input asp-for="To"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="To"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-4">
                        <label asp-for="Status">Request status</label>
                        <select asp-for="Status" class="form-control">
                            <option value="">All statuses</option>
                            <option value="Submitted">Submitted</option>
                            <option value="Samples Received">Samples Received</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Released">Released</option>
                            <option value="ReleasedByDoctor">Released by Doctor</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row mt-2">
                    <div class="form-group col-md-4"><label asp-for="PatientIdNumber">Patient ID number (optional)</label><input asp-for="PatientIdNumber" class="form-control" maxlength="13" inputmode="numeric" placeholder="13-digit ID" /><span asp-validation-for="PatientIdNumber" class="text-danger"></span></div>
                    <div class="form-group col-md-4"><label asp-for="TestTypeId">Specific test (optional)</label><select asp-for="TestTypeId" class="form-control"><option value="">All tests</option>@if(ViewBag.TestTypes is IEnumerable<NMB_HLabSys.Areas.Manager.Models.TestTypeModel> testTypes){foreach(var t in testTypes){
                        <option value="@t.TestTypeId">@t.Name</option>
                    }
                }
            </select></div>
            <div class="form-group col-md-4"><label asp-for="Urgency">Urgency (optional)</label><select asp-for="Urgency" class="form-control"><option value="">All urgency levels</option><option value="Routine">Routine</option><option value="Urgent">Urgent</option><option value="Stat">Stat</option></select></div>
        </div>

        <button type="submit" class="btn btn-outline-primary">
            Preview report count
        </button>
    </form>
</div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Test request report</h5>
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div class="mb-3 mb-md-0">
                <p class="mb-1">
                    <strong>Matching records:</strong>
                    @(ViewBag.Count ?? 0)
                </p>
                <p class="text-muted mb-0">
                    Only records permitted by your account and the selected
                    filters should appear in the report.
                </p>
            </div>

            <form asp-area="Doctor"
                  asp-controller="Reports"
                  asp-action="Download"
                  method="get">

                <input type="hidden" asp-for="From" />
                <input type="hidden" asp-for="To" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="PatientIdNumber" />
                <input type="hidden" asp-for="TestTypeId" />
                <input type="hidden" asp-for="Urgency" />

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-file-pdf mr-1" aria-hidden="true"></i>
                    Generate PDF
                </button>
            </form>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
