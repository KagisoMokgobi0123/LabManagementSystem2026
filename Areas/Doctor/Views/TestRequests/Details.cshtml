@model NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel
@using NMB_HLabSys.Areas.Patient.Models
@{ ViewData["Title"] = "Request Details"; Layout = "_DoctorLayout"; var patient = ViewBag.PatientRecord as PatientModel; var pct = Model.Status switch { "Submitted" => 15, "Samples Received" or "SamplesReceived" => 35, "InProgress" => 65, "Completed" => 85, "Released" or "ReleasedByDoctor" => 100, _ => 0 }; }
<div class="container-fluid py-4"><div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><p class="text-muted mb-1">Test request</p><h2>@Model.RequestNumber</h2></div><div><a class="btn btn-outline-secondary" asp-action="Index">All requests</a>@if(Model.Status == "Submitted" && !Model.Samples.Any(s => s.IsReceived)){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.TestRequestId">Edit urgency / notes</a>}@if(Model.Status == "Submitted" || Model.Status == "Samples Received" || Model.Status == "SamplesReceived"){<button type="button" class="btn btn-outline-danger ml-1" id="openCancelDialog">Cancel request</button>}<a class="btn btn-primary" asp-controller="Results" asp-action="Index">View results</a></div></div>
<div id="cancelDialog" class="doctor-modal" style="display:none" role="dialog" aria-modal="true" aria-labelledby="cancelDialogTitle"><div class="doctor-modal-card"><h4 id="cancelDialogTitle">Cancel test request</h4><p>Please provide a reason. This will be recorded and included in the patient notification.</p><form asp-action="Cancel" asp-route-id="@Model.TestRequestId" method="post"><div class="form-group"><label for="cancellationReason">Cancellation reason <span class="text-danger">*</span></label><textarea id="cancellationReason" name="cancellationReason" class="form-control" maxlength="1000" rows="4" required></textarea><small class="form-text text-muted">Maximum 1000 characters.</small></div><div class="d-flex justify-content-end"><button type="button" class="btn btn-light mr-2" id="closeCancelDialog">Go back</button><button type="submit" class="btn btn-danger">Confirm cancellation</button></div></form></div></div>
<style>.doctor-modal{position:fixed;inset:0;z-index:2050;background:rgba(15,23,42,.58);display:flex;align-items:center;justify-content:center;padding:1rem}.doctor-modal-card{width:100%;max-width:520px;background:#fff;border-radius:12px;padding:1.5rem;box-shadow:0 20px 60px rgba(0,0,0,.25)}</style>
<script>(function(){const m=document.getElementById('cancelDialog'),o=document.getElementById('openCancelDialog'),c=document.getElementById('closeCancelDialog'),r=document.getElementById('cancellationReason');if(o)o.addEventListener('click',()=>{m.style.display='flex';r.focus()});if(c)c.addEventListener('click',()=>m.style.display='none');if(m)m.addEventListener('click',e=>{if(e.target===m)m.style.display='none'});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&m.style.display==='flex')m.style.display='none'});})();</script>
@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}@if(TempData["WarningMessage"] != null){<div class="alert alert-warning">@TempData["WarningMessage"]</div>}
<div class="row"><div class="col-lg-4"><div class="card mb-3"><div class="card-header font-weight-bold">Request overview</div><div class="card-body"><p><b>Patient:</b> @(patient?.FullName ?? Model.Patient?.FullName ?? "Patient")</p>@if(patient != null){<p><b>ID number:</b> @patient.IDNumber</p><p><b>Date of birth:</b> @patient.DateOfBirth.ToString("dd MMM yyyy")</p>}<p><b>Request date:</b> @Model.RequestDate.ToString("dd MMM yyyy HH:mm")</p><p><b>Urgency:</b> @Model.Urgency</p><p><b>Doctor:</b> @(Model.Doctor?.FullName ?? "—")</p><p><b>Status:</b> @(Model.Status == "SamplesReceived" ? "Samples Received" : Model.Status == "InProgress" ? "In progress" : Model.Status)</p><div class="progress mb-2" style="height:10px"><div class="progress-bar" role="progressbar" style="width:@pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div></div><small class="text-muted">Progress: @pct%</small><hr/><b>Clinical notes</b><p class="mb-0">@(string.IsNullOrWhiteSpace(Model.ClinicalNotes)?"No clinical notes supplied.":Model.ClinicalNotes)</p><hr/><b>Progress history</b><ul class="list-unstyled mt-2 mb-0"><li class="mb-2"><span class="badge badge-info">Created</span> Request submitted · @Model.RequestDate.ToString("dd MMM yyyy HH:mm")</li>@foreach(var sample in Model.Samples.Where(x => x.DateReceived.HasValue).OrderBy(x => x.DateReceived)){<li class="mb-2"><span class="badge badge-primary">Sample received</span> @(sample.SampleType?.Name ?? "Sample") · @sample.DateReceived?.ToString("dd MMM yyyy HH:mm")</li>}@foreach(var test in Model.RequestedTestTypes.Where(x => x.StartDateTime.HasValue || x.CompletionDateTime.HasValue).OrderBy(x => x.StartDateTime ?? x.CompletionDateTime)){if(test.StartDateTime.HasValue){<li class="mb-2"><span class="badge badge-warning">In progress</span> @test.TestType?.Name · @test.StartDateTime?.ToString("dd MMM yyyy HH:mm")</li>}if(test.CompletionDateTime.HasValue){<li class="mb-2"><span class="badge badge-success">Completed</span> @test.TestType?.Name · @test.CompletionDateTime?.ToString("dd MMM yyyy HH:mm")</li>}}</ul></div></div></div>
<div class="col-lg-8"><div class="card mb-3"><div class="card-header font-weight-bold">Requested tests</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Test</th><th>Required sample</th><th>Reference range</th><th>Test status</th></tr></thead><tbody>@if(Model.RequestedTestTypes.Any()){foreach(var rt in Model.RequestedTestTypes){var t=rt.TestType;<tr><td>@t?.Name</td><td>@(t?.SampleType?.Name ?? "Not specified")</td><td>@t?.NormalMin – @t?.NormalMax</td><td>@rt.Status</td></tr>}}else{foreach(var t in Model.TestTypes){<tr><td>@t.Name</td><td>@(t.SampleType?.Name ?? "Not specified")</td><td>@t.NormalMin – @t.NormalMax</td><td>Legacy request</td></tr>}}@if(!Model.EffectiveTestTypes.Any()){<tr><td colspan="4" class="text-muted">No tests linked to this request.</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header font-weight-bold">Samples and barcodes</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sample type</th><th>Barcode</th><th>Status</th><th>Received</th></tr></thead><tbody>@foreach(var s in Model.Samples){<tr><td>@(s.SampleType?.Name ?? "Sample")</td><td><code>@s.Barcode</code></td><td>@s.Status</td><td>@(s.IsReceived ? s.DateReceived?.ToString("dd MMM yyyy HH:mm") ?? "Yes" : "Awaiting receipt")</td></tr>}@if(!Model.Samples.Any()){<tr><td colspan="4" class="text-muted">No samples registered.</td></tr>}</tbody></table></div></div></div></div></div>
