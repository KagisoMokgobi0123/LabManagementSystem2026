@model IEnumerable<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>
@{ ViewData["Title"] = "Test Requests"; Layout = "_DoctorLayout"; var filter = ViewBag.StatusFilter as string; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Test requests</h2><p class="text-muted mb-0">Requests created by you, sorted newest first.</p></div><a class="btn btn-primary" asp-action="Create">Create request</a></div>
@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}@if(TempData["WarningMessage"] != null){<div class="alert alert-warning">@TempData["WarningMessage"]</div>}
<form method="get" class="form-inline mb-3"><label for="status" class="mr-2">Status</label><select id="status" name="status" class="form-control mr-2"><option value="">All statuses</option>@foreach(var s in new[]{"Pending","Submitted","Samples Received","InProgress","Completed","Released","ReleasedByDoctor","Cancelled"}){<option value="@s" selected="@(filter==s)">@s</option>}</select><button class="btn btn-outline-primary">Filter</button></form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Request number</th><th>Patient</th><th>Date</th><th>Urgency</th><th>Samples</th><th>Status / progress</th><th></th></tr></thead><tbody>
@foreach(var r in Model){var pct = r.Status switch { "Submitted" => 15, "Samples Received" or "SamplesReceived" => 35, "InProgress" => 65, "Completed" => 85, "Released" or "ReleasedByDoctor" => 100, _ => 0 }; <tr><td class="font-weight-bold">@r.RequestNumber</td><td>@(r.Patient?.FullName ?? "Patient record")</td><td>@r.RequestDate.ToString("dd MMM yyyy HH:mm")</td><td>@r.Urgency</td><td>@r.Samples.Count</td><td><div class="small mb-1">@(r.Status == "SamplesReceived" ? "Samples Received" : r.Status == "InProgress" ? "In progress" : r.Status)</div><div class="progress" style="height:6px;min-width:110px"><div class="progress-bar @(r.Status=="Cancelled"?"bg-danger":"bg-info")" style="width:@pct%"></div></div></td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.TestRequestId">View</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">No test requests match this filter.</td></tr>}
</tbody></table></div></div></div>
