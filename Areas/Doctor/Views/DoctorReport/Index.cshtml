@using NMB_HLabSys.Areas.Administrator.Models
@model List<DoctorReport>
@{
    ViewData["Title"] = "Doctor Reports";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-info-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Doctor Reports</h2>
                <h5 class="text-white op-7 mb-2">Generate PDF reports of test requests</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-action="Generate" class="btn btn-white btn-border btn-round">
                    <i class="fa fa-file-pdf mr-1"></i> Generate New Report
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Message"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Generate Form -->
    <div class="card">
        <div class="card-header">
            <div class="card-title"><i class="fa fa-filter mr-2"></i> Generate Report</div>
        </div>
        <div class="card-body">
            <form asp-action="Generate" method="post" class="form-inline">
                @Html.AntiForgeryToken()
                <div class="form-group mr-3">
                    <label class="font-weight-bold mr-2">From:</label>
                    <input type="date" name="dateFrom" class="form-control"
                           value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-group mr-3">
                    <label class="font-weight-bold mr-2">To:</label>
                    <input type="date" name="dateTo" class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <button type="submit" class="btn btn-primary btn-round">
                    <i class="fa fa-file-pdf mr-1"></i> Generate PDF Report
                </button>
            </form>
        </div>
    </div>

    <!-- Previous Reports -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">Previously Generated Reports</div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fa fa-file-pdf fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No reports generated yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date From</th>
                                <th>Date To</th>
                                <th>Generated At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>@r.DateFrom.ToString("dd MMM yyyy")</td>
                                    <td>@r.DateTo.ToString("dd MMM yyyy")</td>
                                    <td>@r.GeneratedAt.ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>