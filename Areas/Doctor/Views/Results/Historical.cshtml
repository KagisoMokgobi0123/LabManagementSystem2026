@model IEnumerable<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>
@using NMB_HLabSys.Areas.Patient.Models
@{
    ViewData["Title"] = "Historical Results"; Layout = "_DoctorLayout"; var results = ViewBag.Results as List<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel> ?? new();
}
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Historical results</h2><p class="text-muted mb-0">Search by patient ID. Consent is checked on every request.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
<form method="get" class="card card-body mb-3"><label for="idNumber">Patient ID number</label><div class="input-group"><input id="idNumber" name="idNumber" value="@ViewBag.IdNumber" class="form-control" maxlength="13" pattern="[0-9]{13}" required/><div class="input-group-append"><button class="btn btn-primary">Check access</button></div></div></form>
@if(ViewBag.Error != null){<div class="alert alert-warning">@ViewBag.Error</div>}
@if(ViewBag.PatientName != null){<h5>@ViewBag.PatientName</h5>}
@if(ViewBag.ConsentGranted == false){<div class="alert alert-warning">No active consent was found for this patient. Historical results remain hidden. Request permission from the results page.</div>}
@if(ViewBag.ConsentGranted == true){<div class="alert alert-success">Consent is active. Only the historical requests selected by the patient are listed.</div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Request</th><th>Date</th><th>Tests</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){var rs=results.Where(x=>x.TestRequestId==r.TestRequestId).ToList();<tr><td>@r.RequestNumber</td><td>@r.RequestDate.ToString("dd MMM yyyy")</td><td>@foreach(var x in rs){<div><b>@x.TestType?.Name</b>: @x.ResultValue @x.TestType?.MeasurementUnitDetails?.Unit @if(x.IsAbnormal){<span class="badge badge-danger">Abnormal</span>}<div class="small text-muted">@x.ResultNotes</div></div>}</td><td>@r.Status</td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted py-4">No completed, consented historical results were found.</td></tr>}</tbody></table></div></div>}
</div>
