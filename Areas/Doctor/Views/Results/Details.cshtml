@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>
@using NMB_HLabSys.Areas.Doctor.Models
@{ ViewData["Title"] = "Result Details"; Layout = "_DoctorLayout"; var request = ViewBag.Request as TestRequestsModel; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Results: @request?.RequestNumber</h2><p class="text-muted mb-0">Patient: @(request?.Patient?.FullName ?? "Patient") · @request?.RequestDate.ToString("dd MMM yyyy")</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to results</a></div><div class="alert alert-success">All associated test entries have completed. These results are available for clinical review.</div>
<div class="card"><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>Test</th><th>Result</th><th>Unit</th><th>Reference range</th><th>Flag</th><th>Technician notes</th><th>Completed</th></tr></thead><tbody>@foreach(var r in Model){var abnormal = r.IsAbnormal; <tr><td>@r.TestType?.Name</td><td>@(r.ResultValue?.ToString() ?? "—")</td><td>@r.TestType?.MeasurementUnitDetails?.Unit</td><td>@r.TestType?.NormalMin – @r.TestType?.NormalMax</td><td>@if(abnormal){<span class="badge badge-danger">Abnormal</span>}else{<span class="badge badge-success">Within range</span>}</td><td>@(string.IsNullOrWhiteSpace(r.ResultNotes)?"No technician notes recorded.":r.ResultNotes)</td><td>@r.CompletionDateTime?.ToString("dd MMM yyyy HH:mm")</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted">No completed result entries.</td></tr>}</tbody></table></div></div></div>
