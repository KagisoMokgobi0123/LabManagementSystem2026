@model IEnumerable<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>
@using NMB_HLabSys.Areas.Patient.Models
@using NMB_HLabSys.Areas.Patient.Models
@{ ViewData["Title"] = "Test Results"; Layout = "_DoctorLayout"; var results = ViewBag.Results as List<TestRequestTestTypeModel> ?? new(); var complete = ViewBag.RequestIdsWithCompleteSamples as HashSet<int> ?? new(); }
<div class="container-fluid py-4"><div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><h2>Completed test results</h2><p class="text-muted mb-0">Results are shown only when the request and all associated test entries are complete.</p></div><a asp-action="Historical" class="btn btn-outline-primary">Historical results / consent</a></div>
@if(TempData["InfoMessage"] != null){<div class="alert alert-info">@TempData["InfoMessage"]</div>}@if(TempData["ErrorMessage"] != null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}@if(TempData["SuccessMessage"] != null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["WarningMessage"] != null){<div class="alert alert-warning">@TempData["WarningMessage"]</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Request</th><th>Patient</th><th>Date</th><th>Tests completed</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var r in Model){var items=results.Where(x=>x.TestRequestId==r.TestRequestId && x.Status=="Completed").ToList();<tr><td>@r.RequestNumber</td><td>@(r.Patient?.FullName ?? "Patient")</td><td>@r.RequestDate.ToString("dd MMM yyyy")</td><td>@items.Count / @r.EffectiveTestTypes.Count</td><td>@r.Status</td><td>@if(complete.Contains(r.TestRequestId)){<a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@r.TestRequestId">View results</a>}else{<span class="text-muted small">Awaiting all test results</span>}</td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No completed requests are available yet.</td></tr>}</tbody></table></div></div>
<div class="card card-body mt-4"><h5>Request access to historical results</h5><p class="text-muted">Enter a patient's ID number. The patient must grant permission before any historical results are displayed.</p><form asp-action="RequestHistoricalConsent" method="post" class="form-inline"><input name="patientIdNumber" class="form-control mr-2 mb-2" maxlength="13" pattern="[0-9]{13}" required inputmode="numeric" placeholder="13-digit patient ID"/><button class="btn btn-outline-primary mb-2" type="submit">Request patient consent</button></form></div></div>
