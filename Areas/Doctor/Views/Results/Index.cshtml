@model IEnumerable<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>
@{
    ViewData["Title"] = "Test Results";
    Layout = "_DoctorLayout";
    var results = ViewBag.Results as List<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel> ?? new();
    var complete = ViewBag.RequestIdsWithCompleteSamples as HashSet<int> ?? new();
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div><h2>Completed test results</h2><p class="text-muted mb-0">Results are shown only after every required sample and every requested test is complete.</p></div>
        <a asp-action="Historical" class="btn btn-outline-primary">Search historical results</a>
    </div>
    @if (TempData["InfoMessage"] != null) { <div class="alert alert-info">@TempData["InfoMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["WarningMessage"] != null) { <div class="alert alert-warning">@TempData["WarningMessage"]</div> }
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover doctor-data-table mb-0">
                <colgroup><col style="width:18%" /><col style="width:25%" /><col style="width:16%" /><col style="width:15%" /><col style="width:12%" /><col style="width:14%" /></colgroup>
                <thead class="thead-light"><tr><th>Request</th><th>Patient</th><th>Date</th><th>Tests completed</th><th>Status</th><th class="text-right">Action</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    var items = results.Where(x => x.TestRequestId == r.TestRequestId && x.Status == "Completed").ToList();
                    var statusClass = r.Status.Contains("release", StringComparison.OrdinalIgnoreCase) ? "badge-status-released" : r.Status.Contains("complete", StringComparison.OrdinalIgnoreCase) ? "badge-status-completed" : "badge-status-progress";
                    <tr>
                        <td class="font-weight-bold text-nowrap">@r.RequestNumber</td>
                        <td>@(r.Patient?.FullName ?? "Patient")</td>
                        <td class="text-nowrap">@r.RequestDate.ToString("dd MMM yyyy")</td>
                        <td class="text-nowrap">@items.Count / @r.EffectiveTestTypes.Count</td>
                        <td><span class="badge @statusClass">@r.Status</span></td>
                        <td class="text-right">
                            @if (complete.Contains(r.TestRequestId)) { <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@r.TestRequestId">View results</a> }
                            else { <span class="small text-muted">Awaiting completion</span> }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No completed requests are available yet.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
