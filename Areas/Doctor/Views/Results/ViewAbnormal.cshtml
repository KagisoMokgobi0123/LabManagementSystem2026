@using NMB_HLabSys.Areas.Doctor.Models
@model List<TestRequestItem>
@{
    ViewData["Title"] = "Abnormal Results";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-danger-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Abnormal Results</h2>
                <h5 class="text-white op-7 mb-2">Results outside normal ranges</h5>
            </div>
            <div class="ml-md-auto">
                <a asp-action="ViewResults" class="btn btn-white btn-border btn-round">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    <!-- Filter -->
    <div class="card">
        <div class="card-body">
            <form method="get" class="form-inline">
                <label class="font-weight-bold mr-2">From Date:</label>
                <input type="date" name="fromDate" class="form-control mr-3"
                       value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                <button type="submit" class="btn btn-primary btn-round mr-2">
                    <i class="fa fa-filter mr-1"></i> Filter
                </button>
                <a asp-action="ViewAbnormal" class="btn btn-default btn-round">Reset (Last 5 Days)</a>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-head-row">
                <div class="card-title">
                    <i class="fa fa-exclamation-triangle text-danger mr-2"></i>
                    Abnormal Results from @(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("dd MMM yyyy") : "last 5 days")
                </div>
                <div class="card-tools">
                    <span class="badge badge-danger">@Model.Count result(s)</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa fa-check-circle fa-3x text-success mb-3"></i>
                    <h5>No abnormal results found for the selected period.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Request #</th>
                                <th>Test Name</th>
                                <th>Result</th>
                                <th>Normal Range</th>
                                <th>Deviation</th>
                                <th>Completed</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isHigh = item.ResultValue > item.TestType?.NormalMax;
                                <tr class="table-danger">
                                    <td>
                                        @(item.TestRequest?.Patient != null
                                            ? item.TestRequest.Patient.FullName
                                            : "—")
                                    </td>
                                    <td><strong>@item.TestRequest?.RequestNumber</strong></td>
                                    <td>@item.TestType?.Name</td>
                                    <td>
                                        <strong class="text-danger">
                                            @item.ResultValue @item.TestType?.MeasurementUnit
                                        </strong>
                                    </td>
                                    <td>@item.TestType?.NormalMin – @item.TestType?.NormalMax @item.TestType?.MeasurementUnit</td>
                                    <td>
                                        <span class="badge @(isHigh ? "badge-danger" : "badge-warning")">
                                            @(isHigh ? "▲ HIGH" : "▼ LOW")
                                        </span>
                                    </td>
                                    <td>@(item.CompletionDateTime?.ToString("dd MMM HH:mm") ?? "—")</td>
                                    <td>
                                        <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor"
                                           asp-action="Details" asp-route-id="@item.TestRequest?.TestRequestId"
                                           class="btn btn-sm btn-primary btn-round">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
