@using NMB_HLabSys.Areas.Doctor.Models
@model TestRequestsModel
@{
    ViewData["Title"] = "Release Results";
    Layout = "_DoctorLayout";
}

<div class="panel-header bg-success-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">View & Release Results</h2>
                <h5 class="text-white op-7 mb-2">@Model.RequestNumber — @(Model.Patient != null ? Model.Patient.FullName : "")</h5>
            </div>
            <div class="ml-md-auto">
                <a asp-action="ViewResults" class="btn btn-white btn-border btn-round">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    <!-- Results Table -->
    <div class="card">
        <div class="card-header">
            <div class="card-title"><i class="fa fa-vials mr-2"></i> Test Results</div>
        </div>
        <div class="card-body">
            @if (Model.TestRequestItems != null && Model.TestRequestItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Test</th>
                                <th>Result</th>
                                <th>Normal Range</th>
                                <th>MeasurementUnit</th>
                                <th>Flag</th>
                                <th>Notes</th>
                                <th>Completed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TestRequestItems)
                            {
                                var isAbnormal = item.ResultValue.HasValue && item.TestType != null &&
                                                 (item.ResultValue < item.TestType.NormalMin ||
                                                  item.ResultValue > item.TestType.NormalMax);
                                <tr class="@(isAbnormal ? "table-danger" : "")">
                                    <td><strong>@item.TestType?.Name</strong></td>
                                    <td>
                                        <strong class="@(isAbnormal ? "text-danger" : "text-success")">
                                            @(item.ResultValue?.ToString() ?? "Pending")
                                        </strong>
                                    </td>
                                    <td>@item.TestType?.NormalMin – @item.TestType?.NormalMax</td>
                                    <td>@item.TestType?.MeasurementUnit</td>
                                    <td>
                                        @if (isAbnormal)
                                        {
                                            <span class="badge badge-danger"><i class="fa fa-exclamation-triangle mr-1"></i> ABNORMAL</span>
                                        }
                                        else if (item.ResultValue.HasValue)
                                        {
                                            <span class="badge badge-success"><i class="fa fa-check mr-1"></i> Normal</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pending</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.ResultNotes) ? "—" : item.ResultNotes)</td>
                                    <td>@(item.CompletionDateTime?.ToString("dd MMM HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No results available.</p>
            }
        </div>
    </div>

    <!-- Release Form -->
    @if (Model.Status == "Completed")
    {
        <div class="card border-success">
            <div class="card-header">
                <div class="card-title text-success">
                    <i class="fa fa-share-square mr-2"></i> Release Results to Patient
                </div>
            </div>
            <div class="card-body">
                <form asp-action="ReleaseResults" asp-route-requestId="@Model.TestRequestId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="font-weight-bold">Note to Patient <span class="text-danger">*</span></label>
                        <textarea name="note" class="form-control" rows="3"
                                  placeholder="Add a note to the patient about these results..." required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Notification Type <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="notifyType" id="notifyEmail" value="0" checked />
                                <label class="form-check-label" for="notifyEmail">
                                    <i class="fa fa-envelope mr-1 text-primary"></i>
                                    Email results directly to patient
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="notifyType" id="notifyAppt" value="1" />
                                <label class="form-check-label" for="notifyAppt">
                                    <i class="fa fa-calendar mr-1 text-warning"></i>
                                    Ask patient to make an appointment
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="DownloadPDF" asp-route-requestId="@Model.TestRequestId"
                           class="btn btn-info btn-round">
                            <i class="fa fa-file-pdf mr-1"></i> Download PDF
                        </a>
                        <button type="submit" class="btn btn-success btn-round">
                            <i class="fa fa-paper-plane mr-1"></i> Release to Patient
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (Model.Status == "ReleasedByDoctor")
    {
        <div class="alert alert-success">
            <i class="fa fa-check-circle mr-2"></i>
            Results have already been released to the patient.
            <a asp-action="DownloadPDF" asp-route-requestId="@Model.TestRequestId"
               class="btn btn-sm btn-success ml-3">
                <i class="fa fa-file-pdf mr-1"></i> Download PDF
            </a>
        </div>
    }
</div>
