@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_DoctorLayout";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good Morning" :
                   hour < 17 ? "Good Afternoon" : "Good Evening";

    var userName = ViewBag.FullName ?? User.Identity?.Name ?? "Doctor";

    // Stats from recent requests
    var recentRequests = ViewBag.RecentRequests as List<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel> ?? new();
    var totalRecent = recentRequests.Count;
    var submitted = recentRequests.Count(r => r.Status == "Submitted");
    var inProgress = recentRequests.Count(r => r.Status == "InProgress");
    var completed = recentRequests.Count(r => r.Status == "Completed");
    var cancelled = recentRequests.Count(r => r.Status == "Cancelled");
    var released = recentRequests.Count(r => r.Status == "ReleasedByDoctor");
    var samplesReceived = recentRequests.Count(r => r.Status == "SamplesReceived");

    var statRequests = recentRequests.Count(r => r.Urgency == Urgency.Stat);
    var urgentRequests = recentRequests.Count(r => r.Urgency == Urgency.Urgent);
    var routineRequests = recentRequests.Count(r => r.Urgency == Urgency.Routine);

    double completionRate = totalRecent > 0 ? Math.Round((double)completed / totalRecent * 100, 1) : 0;
    double cancellationRate = totalRecent > 0 ? Math.Round((double)cancelled / totalRecent * 100, 1) : 0;
}

<div class="panel-header bg-primary-gradient">
    <div class="page-inner py-5">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
            <div>
                <h2 class="text-white pb-2 fw-bold">Doctor Dashboard</h2>
                <h5 class="text-white op-7 mb-2">@greeting, @userName</h5>
            </div>
            <div class="ml-md-auto py-2 py-md-0">
                <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Create"
                       class="btn btn-white btn-border btn-round mr-2">
                    <i class="fa fa-user-plus mr-1"></i> New Patient
                </a>
                <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="Create"
                       class="btn btn-secondary btn-round">
                    <i class="fa fa-plus mr-1"></i> New Test Request
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-inner mt--5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
            <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row mt--2">
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-primary bubble-shadow-small">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col col-stats ml-3 ml-sm-0">
                            <div class="numbers">
                                <p class="card-category">Total Patients</p>
                                <h4 class="card-title">@ViewBag.TotalPatients</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-warning bubble-shadow-small">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                        <div class="col col-stats ml-3 ml-sm-0">
                            <div class="numbers">
                                <p class="card-category">Pending Tests</p>
                                <h4 class="card-title">@ViewBag.PendingTests</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-success bubble-shadow-small">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                        <div class="col col-stats ml-3 ml-sm-0">
                            <div class="numbers">
                                <p class="card-category">Completed Tests</p>
                                <h4 class="card-title">@ViewBag.CompletedTests</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-danger bubble-shadow-small">
                                <i class="fas fa-bell"></i>
                            </div>
                        </div>
                        <div class="col col-stats ml-3 ml-sm-0">
                            <div class="numbers">
                                <p class="card-category">Active Alerts</p>
                                <h4 class="card-title">@ViewBag.ActiveAlerts</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row">

        <!-- Request Status Breakdown -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fa fa-chart-pie mr-2"></i> Request Status Breakdown
                    </div>
                    <div class="card-category">Based on your last 10 requests</div>
                </div>
                <div class="card-body">
                    @if (totalRecent == 0)
                    {
                        <p class="text-muted text-center py-3">No requests found.</p>
                    }
                    else
                    {
                        <canvas id="statusChart" height="220"></canvas>
                    }
                </div>
            </div>
        </div>

        <!-- Urgency Breakdown -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fa fa-exclamation-triangle mr-2"></i> Urgency Breakdown
                    </div>
                    <div class="card-category">Based on your last 10 requests</div>
                </div>
                <div class="card-body">
                    @if (totalRecent == 0)
                    {
                        <p class="text-muted text-center py-3">No requests found.</p>
                    }
                    else
                    {
                        <canvas id="urgencyChart" height="220"></canvas>
                    }
                </div>
            </div>
        </div>

        <!-- Completion Summary -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <i class="fa fa-tachometer-alt mr-2"></i> Performance Summary
                    </div>
                    <div class="card-category">Based on your last 10 requests</div>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="font-weight-bold">Completion Rate</span>
                        <span class="badge badge-success badge-lg">@completionRate%</span>
                    </div>
                    <div class="progress mb-4" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @completionRate%"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="font-weight-bold">Cancellation Rate</span>
                        <span class="badge badge-danger badge-lg">@cancellationRate%</span>
                    </div>
                    <div class="progress mb-4" style="height: 8px;">
                        <div class="progress-bar bg-danger" style="width: @cancellationRate%"></div>
                    </div>

                    <hr />

                    <div class="row text-center mt-3">
                        <div class="col-4">
                            <h5 class="text-info font-weight-bold">@submitted</h5>
                            <small class="text-muted">Submitted</small>
                        </div>
                        <div class="col-4">
                            <h5 class="text-warning font-weight-bold">@inProgress</h5>
                            <small class="text-muted">In Progress</small>
                        </div>
                        <div class="col-4">
                            <h5 class="text-success font-weight-bold">@released</h5>
                            <small class="text-muted">Released</small>
                        </div>
                    </div>

                    <div class="row text-center mt-3">
                        <div class="col-4">
                            <h5 class="text-primary font-weight-bold">@samplesReceived</h5>
                            <small class="text-muted">Samples In</small>
                        </div>
                        <div class="col-4">
                            <h5 class="text-success font-weight-bold">@completed</h5>
                            <small class="text-muted">Completed</small>
                        </div>
                        <div class="col-4">
                            <h5 class="text-danger font-weight-bold">@cancelled</h5>
                            <small class="text-muted">Cancelled</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Test Requests -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Recent Test Requests</div>
                        <div class="card-tools">
                            <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="Dashboard"
                                   class="btn btn-info btn-border btn-round btn-sm">
                                View All
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Patient</th>
                                    <th>Date</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentRequests.Any())
                                {
                                    foreach (var req in recentRequests)
                                    {
                                        <tr>
                                            <td><strong>@req.RequestNumber</strong></td>
                                            <td>@(req.Patient != null ? req.Patient.FullName : "—")</td>
                                            <td>@req.RequestDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @{
                                                    var urgencyClass = req.Urgency == Urgency.Stat ? "badge-danger" :
                                                                       req.Urgency == Urgency.Urgent ? "badge-warning" : "badge-info";
                                                    var urgencyLabel = req.Urgency == Urgency.Stat ? "STAT" :
                                                                       req.Urgency == Urgency.Urgent ? "Urgent" : "Routine";
                                                }
                                                <span class="badge @urgencyClass">@urgencyLabel</span>
                                            </td>
                                            <td>
                                                @{
                                                    var statusClass = req.Status == "Completed" ? "badge-success" :
                                                                      req.Status == "Cancelled" ? "badge-danger" :
                                                                      req.Status == "InProgress" ? "badge-warning" :
                                                                      req.Status == "ReleasedByDoctor" ? "badge-primary" : "badge-info";
                                                }
                                                <span class="badge @statusClass">@req.Status</span>
                                            </td>
                                            <td>
                                                <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor"
                                                       asp-action="Details" asp-route-id="@req.TestRequestId"
                                                       class="btn btn-sm btn-primary btn-round">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No recent requests found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-4">
            <div class="card card-primary">
                <div class="card-header">
                    <div class="card-title">Quick Actions</div>
                </div>
                <div class="card-body">
                    <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Create"
                           class="btn btn-white btn-block btn-round mb-2">
                        <i class="fa fa-user-plus mr-2"></i> Register New Patient
                    </a>
                    <a asp-area="Doctor" asp-controller="TestRequestControllerDoctor" asp-action="Create"
                           class="btn btn-white btn-block btn-round mb-2">
                        <i class="fa fa-flask mr-2"></i> Create Test Request
                    </a>
                    <a asp-area="Doctor" asp-controller="Results" asp-action="ViewResults"
                           class="btn btn-white btn-block btn-round mb-2">
                        <i class="fa fa-chart-bar mr-2"></i> View Results
                    </a>
                    <a asp-area="Doctor" asp-controller="DoctorDashboard" asp-action="Alerts"
                           class="btn btn-white btn-block btn-round">
                        <i class="fa fa-bell mr-2"></i> View Alerts
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">My Patients</div>
                    <div class="card-tools">
                        <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Index"
                           class="btn btn-info btn-border btn-round btn-sm">View All</a>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted">Manage your patient records, view medical history, and track test results.</p>
                    <a asp-area="Doctor" asp-controller="PatientManagement" asp-action="Search"
                           class="btn btn-primary btn-round">
                        <i class="fa fa-search mr-1"></i> Search Patient by ID
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script>
        // Status Pie Chart
        var statusCtx = document.getElementById('statusChart');
        if (statusCtx) {
        new Chart(statusCtx, {
        type: 'doughnut',
        data: {
        labels: ['Submitted', 'Samples Received', 'In Progress', 'Completed', 'Released', 'Cancelled'],
        datasets: [{
        data: [@submitted, @samplesReceived, @inProgress, @completed, @released, @cancelled],
        backgroundColor: ['#48ABF7', '#1572E8', '#FFAD46', '#31CE36', '#4CAF50', '#F25961'],
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: { position: 'bottom', labels: { padding: 10, font: { size: 11 } } }
        }
        }
        });
        }

        // Urgency Bar Chart
        var urgencyCtx = document.getElementById('urgencyChart');
        if (urgencyCtx) {
        new Chart(urgencyCtx, {
        type: 'bar',
        data: {
        labels: ['Routine', 'Urgent', 'STAT'],
        datasets: [{
        label: 'Requests',
        data: [@routineRequests, @urgentRequests, @statRequests],
        backgroundColor: ['#48ABF7', '#FFAD46', '#F25961'],
        borderRadius: 6,
        borderWidth: 0
        }]
        },
        options: {
        responsive: true,
        plugins: {
        legend: { display: false }
        },
        scales: {
        y: {
        beginAtZero: true,
        ticks: { stepSize: 1 }
        }
        }
        }
        });
        }
    </script>
}