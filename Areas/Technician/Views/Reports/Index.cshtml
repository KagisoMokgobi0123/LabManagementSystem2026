@model NMB_HLabSys.Areas.Technician.Controllers.TechnicianReportViewModel
@using System
@{
    ViewData["Title"] = "Technician Activity Reports";
    Layout = "_TechnicianLayout";
}
<style>
    .report-wrap {
        max-width: 1150px;
        margin: 20px auto;
        padding: 0 14px;
        font-family: Arial,sans-serif;
        color: #18304b
    }

    .report-controls, .report-paper {
        background: #fff;
        border: 1px solid #d9e3ef;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px #0f315010
    }

        .report-controls h2 {
            margin: 0 0 12px;
            color: #073b5c
        }

    .report-filters {
        display: flex;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap
    }

        .report-filters label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 5px
        }

        .report-filters input {
            padding: 10px;
            border: 1px solid #aab9c9;
            border-radius: 7px
        }

    .report-btn {
        padding: 11px 17px;
        background: #075985;
        color: white;
        border: 0;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 700
    }

        .report-btn.secondary {
            background: #146c43
        }

    .report-page {
        background: #fff;
        padding: 24px;
        box-sizing: border-box;
        min-height: 850px
    }

        .report-page + .report-page {
            break-before: page;
            page-break-before: always
        }

    .report-heading {
        border-bottom: 3px solid #075985;
        padding-bottom: 12px;
        margin-bottom: 18px
    }

        .report-heading h1 {
            color: #073b5c;
            margin: 0;
            font-size: 23px
        }

        .report-heading h2 {
            font-size: 17px;
            margin: 8px 0
        }

    .report-meta {
        font-size: 12px;
        line-height: 1.8;
        color: #42566b
    }

    .report-kpis {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin: 20px 0
    }

    .report-kpi {
        flex: 1;
        min-width: 120px;
        border: 1px solid #c9d9e7;
        background: #f4f8fc;
        padding: 14px;
        border-radius: 8px
    }

        .report-kpi b {
            font-size: 25px;
            display: block;
            color: #075985
        }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
        table-layout: fixed
    }

        .report-table th {
            background: #073b5c;
            color: white;
            text-align: left;
            padding: 8px 6px
        }

        .report-table td {
            border-bottom: 1px solid #dae4ee;
            padding: 7px 6px;
            overflow-wrap: anywhere;
            vertical-align: top
        }

        .report-table tr {
            break-inside: avoid;
            page-break-inside: avoid
        }

    .report-section-title {
        font-size: 15px;
        color: #073b5c;
        margin: 18px 0 12px
    }

    .report-muted {
        color: #6b7785
    }

    .report-flag {
        font-weight: 700
    }

        .report-flag.abnormal {
            color: #b42318
        }

    .report-footer {
        margin-top: 24px;
        border-top: 1px solid #d5e0ea;
        padding-top: 12px;
        font-size: 10px;
        color: #667
    }

    @@media print {
        .report-controls {
            display: none !important
        }

        .report-wrap {
            max-width: none;
            margin: 0;
            padding: 0
        }

        .report-paper {
            border: 0;
            box-shadow: none;
            padding: 0
        }

        .report-page {
            min-height: auto;
            padding: 12mm
        }

            .report-page + .report-page {
                break-before: page
            }
    }
</style>
<div class="report-wrap">
    <div class="report-controls">
        <h2>Technician Activity Report</h2>
        <p>Select a UTC completion-date range to preview your laboratory activity and download a PDF.</p>
        <form method="get" asp-area="Technician" asp-controller="Reports" asp-action="Index" class="report-filters">
            <div><label for="startDate">Start date</label><input id="startDate" name="startDate" type="date" required value="@Model.StartDate.ToString("yyyy-MM-dd")" /></div>
            <div><label for="endDate">End date</label><input id="endDate" name="endDate" type="date" required value="@Model.EndDate.ToString("yyyy-MM-dd")" /></div>
            <button class="report-btn" type="submit">Generate Preview</button>
            @if (Model.Generated)
            {
                <button class="report-btn secondary" type="button" id="downloadTechnicianPdf">Download PDF</button>
            }
        </form>
        <div asp-validation-summary="All" style="color:#b42318"></div>
    </div>
    @if (Model.Generated)
    {
        <div class="report-paper" id="technicianReport">
            <section class="report-page">
                <header class="report-heading"><h1>NMB-HLabSys</h1><h2>Technician Activity Report — Summary</h2></header>
                <div class="report-meta">
                    <strong>Technician:</strong> @Model.TechnicianName<br />
                    <strong>Reporting period (UTC):</strong> @Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")<br />
                    <strong>Generated (UTC):</strong> @Model.GeneratedUtc.ToString("dd MMM yyyy HH:mm")
                </div>
                <div class="report-kpis">
                    <div class="report-kpi"><b>@Model.Tests.Count</b>Total tests</div>
                    <div class="report-kpi"><b>@Model.CompletedCount</b>Completed</div>
                    <div class="report-kpi"><b>@Model.VerifiedCount</b>Verified status</div>
                    <div class="report-kpi"><b>@Model.AbnormalCount</b>Abnormal result flags</div>
                </div>
                <h3 class="report-section-title">Tests by category</h3>
                <table class="report-table">
                    <thead><tr><th>Test category</th><th>Number of tests</th></tr></thead>
                    <tbody>
                        @foreach (var group in Model.Tests.GroupBy(t => t.Category).OrderBy(g => g.Key))
                        {
                            <tr><td>@group.Key</td><td>@group.Count()</td></tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Tests.Any())
                {
                    <p>No completed or verified tests were found for this technician in the selected period. Try another date range.</p>
                }
                <p class="report-footer">Scope: completed or verified tests performed by the signed-in technician, based on the recorded UTC completion date. Verification status and result-level verification timestamps are displayed separately. This is an activity report, not a patient diagnostic report.</p>
            </section>
            <section class="report-page">
                <header class="report-heading"><h1>NMB-HLabSys</h1><h2>Technician Activity Report — Test Details</h2></header>
                <div class="report-meta">@Model.TechnicianName · @Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy") (UTC)</div>
                <h3 class="report-section-title">Completed tests and captured results</h3>
                <table class="report-table">
                    <thead><tr><th style="width:13%">Request</th><th style="width:17%">Test</th><th style="width:14%">Completed UTC</th><th style="width:10%">Status</th><th style="width:16%">Result</th><th style="width:9%">Unit</th><th style="width:12%">Range</th><th style="width:9%">Flag</th></tr></thead>
                    <tbody>
                        @foreach (var test in Model.Tests)
                        {
                            var entries = test.Results.Any() ? test.Results : new List<NMB_HLabSys.Areas.Technician.Controllers.TechnicianReportResult> { new NMB_HLabSys.Areas.Technician.Controllers.TechnicianReportResult { Name = "No captured result", Flag = "Not evaluated" } };
                            foreach (var r in entries)
                            {
                                var abnormal = r.IsAbnormal || r.Flag == "High" || r.Flag == "Low" || r.Flag == "Abnormal";
                                var range = r.Min.HasValue || r.Max.HasValue ? $"{(r.Min.HasValue ? r.Min.Value.ToString("0.####") : "–")} – {(r.Max.HasValue ? r.Max.Value.ToString("0.####") : "–")}" : "—";
                                <tr><td>@test.RequestNumber</td><td>@test.TestName<br /><span class="report-muted">@r.Name</span></td><td>@test.CompletedUtc?.ToString("dd MMM yyyy HH:mm")</td><td>@test.Status</td><td>@r.Value</td><td>@r.Unit</td><td>@range</td><td class="report-flag @(abnormal ? "abnormal" : "")">@r.Flag</td></tr>
                            }
                        }
                    </tbody>
                </table>
                <p class="report-footer">Reference intervals and flags reflect values stored in TestResults. Blank measurements or verification timestamps have not been invented. Report may continue onto additional PDF pages.</p>
            </section>
        </div>
    }
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('downloadTechnicianPdf');
        if (!btn) return;
        btn.addEventListener('click', async function() {
            if (typeof html2pdf === 'undefined') { alert('PDF library could not load. Check your internet connection.'); return; }
            btn.disabled = true; const original = btn.textContent; btn.textContent = 'Generating PDF...';
            try { await html2pdf().set({ margin: 5, filename: @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"Technician_Activity_{Model.StartDate:yyyyMMdd}_{Model.EndDate:yyyyMMdd}.pdf")), image: { type: 'jpeg', quality: 0.97 }, html2canvas: { scale: 1.7, useCORS: true, scrollY: 0 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }, pagebreak: { mode: ['css', 'legacy'], before: '.report-page + .report-page' } }).from(document.getElementById('technicianReport')).save(); }
            catch (e) { console.error(e); alert('Could not generate PDF. Please try again.'); }
            finally { btn.disabled = false; btn.textContent = original; }
        });
    });
</script>
