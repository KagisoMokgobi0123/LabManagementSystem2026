                                                                <option value="7">🫘 Stool</option>
                                                                <option value="8">🧠 CSF</option>
                                                                <option value="9">🫁 Sputum</option>
                                                                <option value="10">🦠 Swab</option>
                                                                <option value="11">💉 Blood Culture</option>
                                                                <option value="12">🧬 DNA Sample</option>
                                                                <option value="13">🔴 Whole Blood</option>
                                                                <option value="14">⚪ White Blood Cells</option>
