@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            let searchTimeout;
            
            // Show SweetAlert messages from TempData
            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sample Verified Successfully!',
                    html: `<div style="text-align: left;">
                        <p><strong>@TempData["Success"]</strong></p>
                        <hr/>
                        <p><i class="fa fa-hashtag"></i> <strong>Request Number:</strong> @TempData["RequestNumber"]</p>
                        <p><i class="fa fa-user"></i> <strong>Patient:</strong> @TempData["PatientName"]</p>
                        <p><i class="fa fa-barcode"></i> <strong>Barcode:</strong> @TempData["Barcode"]</p>
                    </div>`,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Continue'
                });
                </text>
            }
            
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Verification Failed',
                    text: '@TempData["Error"]',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'OK',
                    timer: 4000
                });
                </text>
            }
            
            // Search button click handler
            $('#searchRequestBtn').click(function() {
                let query = $('#RequestNumberSearch').val().trim();
                
                if (query.length < 2) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Search Error',
                        text: 'Please enter at least 2 characters to search',
                        confirmButtonColor: '#3085d6'
                    });
                    $('#RequestNumberSearch').focus();
                    return;
                }
                
                // Show loading state
                let searchBtn = $('#searchRequestBtn');
                searchBtn.html('<i class="fa fa-spinner fa-spin"></i> Searching...');
                searchBtn.prop('disabled', true);
                
                // Perform search
                $.ajax({
                    url: '@Url.Action("SearchTestRequests", "Sample")',
                    type: 'GET',
                    data: { term: query },
                    dataType: 'json',
                    success: function(data) {
                        displaySuggestions(data);
                        searchBtn.html('<i class="fa fa-search"></i> Search');
                        searchBtn.prop('disabled', false);
                    },
                    error: function() {
                        searchBtn.html('<i class="fa fa-search"></i> Search');
                        searchBtn.prop('disabled', false);
                        Swal.fire({
                            icon: 'error',
                            title: 'Search Failed',
                            text: 'An error occurred while searching. Please try again.',
                            confirmButtonColor: '#d33'
                        });
                    }
                });
            });
            
            // Enter key press in search box
            $('#RequestNumberSearch').keypress(function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#searchRequestBtn').click();
                }
            });
            
            // Display suggestions
            function displaySuggestions(requests) {
                let suggestionsList = $('#requestSuggestions');
                suggestionsList.empty();
                
                if (requests.length === 0) {
                    suggestionsList.html('<li class="list-group-item text-muted">No matching requests found</li>');
                    suggestionsList.show();
                    setTimeout(function() {
                        suggestionsList.fadeOut();
                    }, 3000);
                } else {
                    $.each(requests, function(index, request) {
                        let requestNumber = request.requestNumber;
                        let urgencyBadge = request.urgency === 'STAT' ? 'danger' : (request.urgency === 'Urgent' ? 'warning' : 'info');
                        suggestionsList.append(`
                            <li class="list-group-item list-group-item-action" 
                                data-id="${request.testRequestId}"
                                data-requestnumber="${requestNumber}"
                                data-patientname="${request.patientName}"
                                data-urgency="${request.urgency}"
                                data-status="${request.status}"
                                data-requestdate="${request.requestDate}"
                                data-clinicalnotes="${request.clinicalNotes || ''}"
                                style="cursor: pointer;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-primary">${requestNumber}</strong>
                                        <br/><small class="text-muted"><i class="fa fa-user"></i> Patient: ${request.patientName}</small>
                                    </div>
                                    <span class="badge badge-${urgencyBadge}">${request.urgency}</span>
                                </div>
                            </li>
                        `);
                    });
                    suggestionsList.show();
                }
            }
            
            // Handle suggestion click
            $(document).on('click', '#requestSuggestions .list-group-item', function() {
                let requestId = $(this).data('id');
                let requestNumber = $(this).data('requestnumber');
                let patientName = $(this).data('patientname');
                let urgency = $(this).data('urgency');
                let status = $(this).data('status');
                let requestDate = $(this).data('requestdate');
                let clinicalNotes = $(this).data('clinicalnotes');
                
                // Set values
                $('#TestRequestId').val(requestId);
                $('#RequestNumberSearch').val(requestNumber);
                $('#patientName').text(patientName);
                
                let urgencyClass = urgency === 'STAT' ? 'badge-danger' : (urgency === 'Urgent' ? 'badge-warning' : 'badge-info');
                $('#urgency').text(urgency).removeClass().addClass(`badge ${urgencyClass}`);
                $('#requestStatus').text(status);
                $('#requestDate').text(requestDate ? new Date(requestDate).toLocaleDateString() : 'N/A');
                $('#clinicalNotes').text(clinicalNotes || 'No clinical notes provided');
                
                // Show details and hide suggestions
                $('#requestDetails').show();
                $('#requestSuggestions').empty().hide();
                
                // Focus on barcode
                $('#Barcode').focus();
                
                // Remove any existing validation errors
                $('#validationSummary').hide();
            });
            
            // Close suggestions when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#RequestNumberSearch, #searchRequestBtn, #requestSuggestions').length) {
                    $('#requestSuggestions').empty().hide();
                }
            });
            
            // Reset form handler
            $('#resetBtn').click(function() {
                $('#TestRequestId').val('');
                $('#RequestNumberSearch').val('');
                $('#Barcode').val('');
                $('#SampleTypeId').val('');
                $('#requestSuggestions').empty().hide();
                $('#requestDetails').hide();
                $('#validationSummary').hide();
                $('#Barcode').focus();
            });
            
            // JS Validation before submit
            $('#verifySampleForm').on('submit', function(e) {
                let isValid = true;
                let errorMessage = '';
                
                // Clear previous validation
                $('#validationSummary').hide();
                $('.is-invalid').removeClass('is-invalid');
                
                // Validate Request Number (TestRequestId)
                let testRequestId = $('#TestRequestId').val();
                if (!testRequestId) {
                    isValid = false;
                    errorMessage = 'Please search and select a valid request number.';
                    $('#RequestNumberSearch').addClass('is-invalid');
                    $('#RequestNumberSearch').focus();
                } else {
                    $('#RequestNumberSearch').removeClass('is-invalid');
                }
                
                // Validate Barcode
                let barcode = $('#Barcode').val().trim();
                if (isValid && !barcode) {
                    isValid = false;
                    errorMessage = 'Please scan or enter the sample barcode.';
                    $('#Barcode').addClass('is-invalid');
                    $('#Barcode').focus();
                } else if (isValid && barcode.length < 3) {
                    isValid = false;
                    errorMessage = 'Barcode must be at least 3 characters long.';
                    $('#Barcode').addClass('is-invalid');
                    $('#Barcode').focus();
                } else {
                    $('#Barcode').removeClass('is-invalid');
                }
                
                // Validate Sample Type
                let sampleTypeId = $('#SampleTypeId').val();
                if (isValid && !sampleTypeId) {
                    isValid = false;
                    errorMessage = 'Please select the sample type.';
                    $('#SampleTypeId').addClass('is-invalid');
                    $('#SampleTypeId').focus();
                } else {
                    $('#SampleTypeId').removeClass('is-invalid');
                }
                
                // Show validation error if any
                if (!isValid) {
                    e.preventDefault();
                    $('#validationMessage').text(errorMessage);
                    $('#validationSummary').show();
                    
                    // Scroll to validation summary
                    $('html, body').animate({
                        scrollTop: $('#validationSummary').offset().top - 100
                    }, 500);
                    
                    return false;
                }
                
                // Show loading state on submit button
                let verifyBtn = $('#verifyBtn');
                verifyBtn.html('<i class="fa fa-spinner fa-spin"></i> Verifying...');
                verifyBtn.prop('disabled', true);
                
                return true;
            });
            
            // Real-time validation removal
            $('#RequestNumberSearch').on('input', function() {
                $(this).removeClass('is-invalid');
                $('#validationSummary').hide();
            });
            
            $('#Barcode').on('input', function() {
                $(this).removeClass('is-invalid');
                $('#validationSummary').hide();
            });
            
            $('#SampleTypeId').on('change', function() {
                $(this).removeClass('is-invalid');
                $('#validationSummary').hide();
            });
            
            // Auto-focus barcode if coming back with error
            if ($('#Barcode').val() === '') {
                $('#Barcode').focus();
            }
        });
    </script>
    
    <style>
        .list-group-item-action:hover {
            background-color: #f8f9fa;
            cursor: pointer;
            transform: translateX(5px);
            transition: all 0.2s ease;
        }
        
        .step-circle {
            transition: all 0.3s ease;
        }
        
        .step-circle:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .form-control-lg {
            font-size: 1.1rem;
        }
        
        #requestSuggestions {
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        
        .card {
            border-radius: 12px;
            overflow: hidden;
        }
        
        .btn {
            border-radius: 8px;
        }
        
        .is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
        
        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }
    </style>
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}