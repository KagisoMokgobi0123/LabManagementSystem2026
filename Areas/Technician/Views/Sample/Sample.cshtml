@using NMB_HLabSys.Areas.Technician.Models
@model SampleModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4><i class="fas fa-vial"></i> Receive & Verify Sample</h4>
        </div>
        <div class="card-body">
            <h5 class="text-muted">Request Number: <strong>@Model.RequestNumber</strong></h5>
            <hr />

            <form asp-action="Receive" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                @* Hidden fields for IDs *@
                <input type="hidden" asp-for="TestRequestId" />
                <input type="hidden" asp-for="TechnicianId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label font-weight-bold"></label>
                        <input asp-for="Barcode" class="form-control form-control-lg" placeholder="Scan or enter barcode" autofocus />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SampleType" class="form-label font-weight-bold"></label>
                        <select asp-for="SampleType" class="form-control form-control-lg">
                            <option value="">-- Select Sample Type --</option>
                            <option value="Whole Blood">Whole Blood (EDTA)</option>
                            <option value="Plasma">Plasma</option>
                            <option value="Serum">Serum</option>
                            <option value="Urine">Urine</option>
                        </select>
                        <span asp-validation-for="SampleType" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-check-circle"></i> Confirm Receipt
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
