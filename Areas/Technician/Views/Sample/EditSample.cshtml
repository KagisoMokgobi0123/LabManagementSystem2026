                    </div>
                    <!-- End Sidebar -->

                    <div class="main-panel">
                        <div class="content">
                            <div class="panel-header bg-primary-gradient">
                                <div class="page-inner py-5">
                                    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
                                        <div>
                                            <h2 class="text-white pb-2 fw-bold">Edit Sample</h2>
                                            <h5 class="text-white op-7 mb-2">Update sample information</h5>
                                        </div>
                                        <div class="ml-md-auto py-2 py-md-0">
                                            <a href="@Url.Action("Samples", "Sample", new { area = "Technician" })" class="btn btn-white btn-border btn-round mr-2">
                                                <i class="fa fa-list"></i> All Samples
                                            </a>
                                            <a href="@Url.Action("SampleDetails", "Sample", new { id = Model.SampleId })" class="btn btn-info btn-round mr-2">
                                                <i class="fa fa-eye"></i> View Details
                                            </a>
                                            <a href="@Url.Action("Dashboard", "Home", new { area = "Technician" })" class="btn btn-secondary btn-round">
                                                <i class="fa fa-home"></i> Dashboard
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
            
                            <div class="page-inner mt--5">
                                <div class="row mt--2">
                                    <div class="col-md-8 mx-auto">
                                        <div class="card">
                                            <div class="card-header bg-primary text-white">
                                                <h4 class="card-title text-white">
                                                    <i class="fa fa-edit"></i> Edit Sample
                                                </h4>
                                            </div>
                                            <div class="card-body">
                                                <form asp-action="EditSample" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" asp-for="SampleId" />
                                                    <input type="hidden" asp-for="TestRequestId" />
                                    
                                                    <div asp-validation-summary="model" class="text-danger"></div>

                                                    <!-- Request Information (Read-only) -->
                                                    <div class="card bg-light mb-4">
                                                        <div class="card-body">
                                                            <h5 class="card-title">Request Information</h5>
                                                            <hr />
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <div class="form-group">
                                                                        <label class="fw-bold">Request Number</label>
                                                                        <input type="text" class="form-control" value="@Model.RequestNumber" disabled />
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <div class="form-group">
                                                                        <label class="fw-bold">Patient Name</label>
                                                                        <input type="text" class="form-control" value="@Model.TestRequest?.Patient?.FullName" disabled />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Editable Fields -->
                                                    <div class="form-group mb-3">
                                                        <label asp-for="Barcode" class="fw-bold">
                                                            <i class="fa fa-barcode"></i> Barcode <span class="text-danger">*</span>
                                                        </label>
                                                        <input asp-for="Barcode" class="form-control" placeholder="Enter barcode" />
                                                        <span asp-validation-for="Barcode" class="text-danger"></span>
                                                    </div>

                                                    <div class="form-group mb-3">
                                                        <label asp-for="SampleTypeId" class="fw-bold">
                                                            <i class="fa fa-flask"></i> Sample Type <span class="text-danger">*</span>
                                                        </label>
                                                        <select asp-for="SampleTypeId" class="form-control" asp-items="@(ViewBag.SampleTypes as IEnumerable<SelectListItem>)">
                                                            <option value="">-- Select Sample Type --</option>
                                                        </select>
                                                        <span asp-validation-for="SampleTypeId" class="text-danger"></span>
                                                    </div>

                                                    <div class="form-group mb-3">
                                                        <label asp-for="Status" class="fw-bold">
                                                            <i class="fa fa-info-circle"></i> Status
                                                        </label>
                                                        <select asp-for="Status" class="form-control">
                                                            <option value="Pending">Pending</option>
                                                            <option value="Received">Received</option>
                                                            <option value="Processing">Processing</option>
                                                            <option value="Completed">Completed</option>
                                                            <option value="Rejected">Rejected</option>
                                                        </select>
                                                    </div>

                                                    <div class="form-group mb-3">
                                                        <div class="form-check">
                                                            <input type="checkbox" asp-for="IsReceived" class="form-check-input" />
                                                            <label asp-for="IsReceived" class="form-check-label fw-bold">
                                                                <i class="fa fa-check-circle"></i> Mark as Received
                                                            </label>
                                                        </div>
                                                        <small class="form-text text-muted">If checked, the date received will be updated to now.</small>
                                                    </div>

                                                    @if (Model.DateReceived > DateTime.MinValue)
                                                    {
                                                        <div class="form-group mb-3">
                                                            <label class="fw-bold">
                                                                <i class="fa fa-calendar"></i> Date Received
                                                            </label>
                                                            <input type="text" class="form-control" value="@Model.DateReceived.ToString("dd MMM yyyy HH:mm:ss")" disabled />
                                                        </div>
                                                    }

                                                    <hr />

                                                    <div class="text-center">
                                                        <button type="submit" class="btn btn-primary btn-lg px-5 me-3">
                                                            <i class="fa fa-save"></i> Save Changes
                                                        </button>
                                                        <a href="@Url.Action("SampleDetails", "Sample", new { id = Model.SampleId })" class="btn btn-secondary btn-lg px-5 me-3">
                                                            <i class="fa fa-times"></i> Cancel
                                                        </a>
                                                        <a href="@Url.Action("DeleteSample", "Sample", new { id = Model.SampleId })" class="btn btn-danger btn-lg px-5" onclick="return confirm('Are you sure you want to delete this sample?')">
                                                            <i class="fa fa-trash"></i> Delete
                                                        </a>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
        
                        <footer class="footer" data-background-color="blue">
                            <div class="container-fluid">
                                <nav class="pull-left">
                                    <ul class="nav">
                                        <li class="nav-item">
                                            <a class="nav-link" href="#">NelsonMandelaBayHematologyLab</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="#">Help</a>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="copyright ml-auto">
                                    2026, made with <i class="fa fa-heart heart text-danger"></i> by NelsonMandelaBayHLabSystem
                                </div>
                            </div>
                        </footer>
                    </div>
                </div>

                @section Scripts {
                    @{
                        await Html.RenderPartialAsync("_ValidationScriptsPartial");
                    }
    
                    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                    <script>
                        @if (TempData["Success"] != null)
                        {
                            <text>
                                Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: '@TempData["Success"]',
                                confirmButtonColor: '#28a745',
                                timer: 3000
                                });
                            </text>
                        }
        
                        @if (TempData["Error"] != null)
                        {
                            <text>
                                Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: '@TempData["Error"]',
                                confirmButtonColor: '#d33',
                                timer: 4000
                                });
                            </text>
                        }
                    </script>
                }