@model IEnumerable<NMB_HLabSys.Areas.Technician.ViewModels.SelectPatientTestViewModel>

@{
    ViewData["Title"] = "Select Patient Test";
    Layout = "_TechnicianLayout";

    var tests = Model?.ToList()
        ?? new List<NMB_HLabSys.Areas.Technician.ViewModels.SelectPatientTestViewModel>();
}

<style>
    .select-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 50px;
    }

    .select-hero {
        background: linear-gradient(135deg, #073b5c, #075985 48%, #0284c7);
        padding: 36px 0 80px;
        color: white;
    }

        .select-hero h1 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .select-hero p {
            color: rgba(255,255,255,.85);
            font-size: 14px;
            margin: 0;
        }

    .select-content {
        position: relative;
        margin-top: -43px;
    }

    .select-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 6px 24px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .select-card-head {
        padding: 20px 24px;
        border-bottom: 1px solid #e8eef5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

        .select-card-head h2 {
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

    .select-search {
        max-width: 370px;
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
    }

        .select-search:focus {
            outline: none;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2,132,199,.1);
        }

    .select-table {
        margin-bottom: 0;
        min-width: 1550px;
    }

        .select-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            white-space: nowrap;
            border-top: 0;
            padding: 14px;
        }

        .select-table td {
            vertical-align: middle;
            color: #334155;
            font-size: 13px;
            padding: 14px;
        }

        .select-table tbody tr:hover {
            background: #f8fcff;
        }

    .select-name {
        font-weight: 700;
        color: #075985;
    }

    .select-subtext {
        font-size: 11px;
        color: #64748b;
        margin-top: 4px;
    }

    .select-notes {
        max-width: 250px;
        min-width: 180px;
        white-space: normal;
        overflow-wrap: anywhere;
        line-height: 1.5;
    }

    .select-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 24px;
        padding: 6px 11px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        background: #e0f2fe;
        color: #0369a1;
    }

        .select-pill.success {
            background: #dcfce7;
            color: #166534;
        }

        .select-pill.warning {
            background: #fef3c7;
            color: #92400e;
        }

        .select-pill.danger {
            background: #fee2e2;
            color: #991b1b;
        }

    .select-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #0284c7;
        border: 0;
        color: white;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

        .select-btn:hover {
            background: #0369a1;
            color: white;
        }

        .select-btn:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .select-empty {
        padding: 55px 20px;
        text-align: center;
        color: #64748b;
    }

    .select-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #075985;
        background: white;
        padding: 10px 15px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none !important;
        font-size: 13px;
    }

        .select-back:hover {
            background: #e0f2fe;
            color: #075985;
        }

    .select-count {
        color: #64748b;
        font-size: 12px;
        padding: 14px 20px;
        border-top: 1px solid #e8eef5;
    }

    @@media (max-width: 768px) {
        .select-hero h1 {
            font-size: 23px;
        }

        .select-card-head {
            padding: 17px;
        }

        .select-search {
            max-width: 100%;
        }
    }
</style>

<div class="select-page">

    <!-- HERO -->
    <section class="select-hero">
        <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between"
             style="gap:16px;">

            <div>
                <h1>
                    <i class="fas fa-vial mr-2"></i>
                    Select Patient Test
                </h1>

                <p>
                    Select patient tests with received samples
                    that match your active Laboratory Manager assignments.
                </p>
            </div>

            <a class="select-back"
               asp-area="Technician"
               asp-controller="Tests"
               asp-action="Available">

                <i class="fas fa-arrow-left mr-1"></i>
                My Assigned Test Types
            </a>

        </div>
    </section>

    <!-- CONTENT -->
    <div class="container-fluid select-content">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">
                <i class="fas fa-check-circle mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="select-card">

            <!-- HEADER -->
            <div class="select-card-head">

                <div>
                    <h2>
                        <i class="fas fa-clipboard-list text-primary mr-2"></i>
                        Available Patient Tests

                        <span class="select-pill">
                            @tests.Count
                        </span>
                    </h2>

                    <small class="text-muted">
                        Only unclaimed tests with received samples are displayed.
                    </small>
                </div>

                <input id="selectSearch"
                       class="select-search"
                       type="search"
                       placeholder="Search patient, ID, doctor, request or test..."
                       aria-label="Search available patient tests" />

            </div>

            @if (tests.Any())
            {
                <div class="table-responsive">

                    <table id="selectTestsTable"
                           class="table select-table table-hover">

                        <thead>
                            <tr>
                                <th>Request Number</th>
                                <th>Patient</th>
                                <th>ID Number</th>
                                <th>Doctor Full Name</th>
                                <th>Doctor Username</th>
                                <th>Clinical Notes</th>
                                <th>Test Type</th>
                                <th>Priority</th>
                                <th>Turnaround</th>
                                <th>Request Status</th>
                                <th>Sample Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var test in tests)
                            {
                                var priority = test.Priority ?? "";
                                var requestStatus = test.RequestStatus ?? "";
                                var testStatus = test.TestStatus ?? "";

                                var priorityClass =
                                    priority.Equals("Stat", StringComparison.OrdinalIgnoreCase)
                                        ? "danger"
                                        : priority.Equals("Urgent", StringComparison.OrdinalIgnoreCase)
                                            ? "warning"
                                            : "";

                                <tr>

                                    <!-- REQUEST NUMBER -->
                                    <td>
                                        <span class="select-name">
                                            @test.RequestReference
                                        </span>
                                    </td>

                                    <!-- PATIENT FULL NAME -->
                                    <td>
                                        <span class="select-name">
                                            @test.PatientName
                                        </span>
                                    </td>

                                    <!-- PATIENT ID -->
                                    <td>
                                        @test.PatientIdNumber
                                    </td>

                                    <!-- DOCTOR FULL NAME -->
                                    <td>
                                        @test.DoctorFullName
                                    </td>

                                    <!-- DOCTOR USERNAME -->
                                    <td>
                                        @test.DoctorUsername
                                    </td>

                                    <!-- CLINICAL NOTES -->
                                    <td>
                                        <div class="select-notes">
                                            @test.ClinicalNotes
                                        </div>
                                    </td>

                                    <!-- TEST TYPE -->
                                    <td>
                                        <span class="select-name">
                                            @test.TestTypeName
                                        </span>
                                    </td>

                                    <!-- PRIORITY -->
                                    <td>
                                        <span class="select-pill @priorityClass">
                                            @priority
                                        </span>
                                    </td>

                                    <!-- TURNAROUND -->
                                    <td>
                                        <i class="far fa-clock text-muted mr-1"></i>
                                        @test.TurnaroundDisplay
                                    </td>

                                    <!-- REQUEST STATUS -->
                                    <td>
                                        <span class="select-pill @(requestStatus == "SamplesReceived" ? "success" : "")">
                                            @requestStatus
                                        </span>
                                    </td>

                                    <!-- TEST STATUS -->
                                    <td>
                                        <span class="select-pill @(testStatus == "SamplesReceived" ? "success" : "")">
                                            <i class="fas fa-check-circle"></i>
                                            @testStatus
                                        </span>
                                    </td>

                                    <!-- OPEN PERFORM TEST MODAL -->
                                    <td class="text-center">
                                        <button type="button"
                                                class="select-btn open-perform-modal"
                                                data-toggle="modal"
                                                data-target="#performTestModal"
                                                data-username="@test.DoctorUsername"
                                                data-request-status="@test.RequestStatus"
                                                data-test-id="@test.RequestedTestId"
                                                data-request="@test.RequestReference"
                                                data-patient="@test.PatientName"
                                                data-patient-id="@test.PatientIdNumber"
                                                data-doctor="@test.DoctorFullName"
                                                data-test="@test.TestTypeName"
                                                data-notes="@test.ClinicalNotes"
                                                data-priority="@test.Priority"
                                                data-turnaround="@test.TurnaroundDisplay"
                                                data-status="@test.TestStatus">
                                            <i class="fas fa-play-circle mr-1"></i>
                                            Select Test
                                        </button>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <div class="select-count"
                     id="selectVisibleCount"
                     aria-live="polite">
                    Showing @tests.Count available patient test(s).
                </div>
            }
            else
            {
                <div class="select-empty">

                    <i class="fas fa-clipboard-check fa-2x mb-3"></i>

                    <h5>No available patient tests</h5>

                    <p>
                        There are currently no unclaimed tests with
                        received samples matching your active assignments.
                    </p>

                </div>
            }

        </div>

    </div>

</div>

<!-- PERFORM TEST MODAL: styled to match Receive Patient Sample -->
<style>
    .perform-modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
    }

    .perform-modal-header {
        padding: 20px 24px;
        border: 0;
        background: linear-gradient(135deg,#073b5c 0%,#075985 50%,#0284c7 100%);
        color: white;
    }

    .perform-header-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        margin-right: 13px;
        border-radius: 10px;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .perform-modal-title {
        color: white;
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 2px;
    }

    .perform-modal-subtitle {
        color: rgba(255,255,255,.8);
        font-size: 11px;
    }

    .perform-close {
        border: 0;
        background: transparent;
        color: white;
        font-size: 27px;
        cursor: pointer;
        opacity: .85;
        line-height: 1;
    }

        .perform-close:hover {
            opacity: 1;
        }

    .perform-modal-body {
        padding: 24px;
        background: #f8fafc;
    }

    .perform-section {
        background: white;
        border: 1px solid #eef2f7;
        border-radius: 11px;
        box-shadow: 0 3px 12px rgba(15,23,42,.04);
        margin-bottom: 16px;
        overflow: hidden;
    }

    .perform-section-body {
        padding: 18px;
    }

    .perform-heading {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
    }

    .perform-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        min-width: 36px;
        margin-right: 10px;
        border-radius: 8px;
        font-size: 13px;
    }

    .perform-icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .perform-icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .perform-icon-orange {
        background: #fef3c7;
        color: #d97706;
    }

    .perform-section-title {
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
        margin: 0;
    }

    .perform-section-subtitle {
        color: #94a3b8;
        font-size: 10px;
        display: block;
        margin-top: 2px;
    }

    .perform-info-label {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .3px;
        margin-bottom: 5px;
    }

    .perform-info-value {
        display: block;
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .perform-request-number {
        color: #0369a1;
        font-size: 13px;
        font-weight: 700;
    }

    .perform-info-box {
        display: flex;
        align-items: center;
        min-height: 43px;
        padding: 9px 12px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #f8fafc;
        color: #334155;
        font-size: 12px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

        .perform-info-box i {
            width: 20px;
            margin-right: 7px;
            color: #0284c7;
            text-align: center;
        }

    .perform-notes {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        align-items: flex-start;
    }

    .perform-guidance {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
        border: 1px solid #bae6fd;
        border-radius: 7px;
        background: #f0f9ff;
        color: #0369a1;
        font-size: 11px;
        margin-bottom: 13px;
    }

    .perform-check-item {
        position: relative;
        display: block;
        margin: 0 0 9px;
        cursor: pointer;
    }

    .perform-check-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .perform-check-content {
        display: flex;
        align-items: center;
        padding: 12px 13px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: white;
        transition: .18s;
    }

    .perform-check-item:hover .perform-check-content {
        border-color: #7dd3fc;
        background: #f8fcff;
    }

    .perform-check-input:focus-visible + .perform-check-content {
        outline: 3px solid #7dd3fc;
        outline-offset: 2px;
    }

    .perform-check-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        min-width: 27px;
        margin-right: 11px;
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        color: transparent;
    }

    .perform-check-title {
        display: block;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
    }

    .perform-check-description {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-top: 2px;
    }

    .perform-check-input:checked + .perform-check-content {
        border-color: #22c55e;
        background: #f0fdf4;
    }

        .perform-check-input:checked + .perform-check-content .perform-check-icon {
            border-color: #22c55e;
            background: #22c55e;
            color: white;
        }

        .perform-check-input:checked + .perform-check-content .perform-check-title {
            color: #166534;
        }

    .perform-check-status {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        margin-top: 14px;
        border: 1px solid #fde68a;
        border-radius: 7px;
        background: #fffbeb;
        color: #92400e;
        font-size: 11px;
        font-weight: 600;
    }

        .perform-check-status.complete {
            border-color: #bbf7d0;
            background: #f0fdf4;
            color: #166534;
        }

    .perform-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 15px 20px;
        border-top: 1px solid #eef2f7;
        background: white;
    }

    #performSubmit:disabled {
        cursor: not-allowed;
        opacity: .55;
    }

    @@media(max-width:767px) {
        .perform-modal-body {
            padding: 15px;
        }

        .perform-section-body {
            padding: 14px;
        }

        .perform-modal-footer {
            flex-direction: column-reverse;
        }

            .perform-modal-footer .btn {
                width: 100%;
            }
    }
</style>

<div class="modal fade" id="performTestModal" tabindex="-1" role="dialog" aria-labelledby="performTestModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content perform-modal-content">
            <form asp-area="Technician" asp-controller="Tests" asp-action="Select" method="post" id="performTestForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="performTestId" name="testRequestTestTypeId" />
                <div class="modal-header perform-modal-header">
                    <div class="d-flex align-items-center">
                        <div class="perform-header-icon"><i class="fas fa-flask"></i></div>
                        <div>
                            <h5 class="perform-modal-title" id="performTestModalTitle">Perform Patient Test</h5>
                            <span class="perform-modal-subtitle">Verify patient and test information before beginning processing</span>
                        </div>
                    </div>
                    <button type="button" class="perform-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body perform-modal-body">
                    <div class="perform-section">
                        <div class="perform-section-body">
                            <div class="perform-heading"><div class="perform-section-icon perform-icon-blue"><i class="fas fa-file-medical"></i></div><div><h6 class="perform-section-title">Test Request</h6><span class="perform-section-subtitle">Patient and requesting doctor information</span></div></div>
                            <div class="row">
                                <div class="col-md-4 mb-3"><span class="perform-info-label">Request Number</span><span class="perform-info-value perform-request-number" id="performRequest"></span></div>
                                <div class="col-md-4 mb-3"><span class="perform-info-label">Patient</span><span class="perform-info-value" id="performPatient"></span></div>
                                <div class="col-md-4 mb-3"><span class="perform-info-label">Patient ID Number</span><span class="perform-info-value" id="performPatientId"></span></div>
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Requesting Doctor</span><span class="perform-info-value" id="performDoctor"></span></div>
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Doctor Username</span><span class="perform-info-value" id="performDoctorUsername"></span></div>
                                <div class="col-md-6"><span class="perform-info-label">Request Status</span><span class="perform-info-value" id="performRequestStatus"></span></div>
                            </div>
                        </div>
                    </div>
                    <div class="perform-section">
                        <div class="perform-section-body">
                            <div class="perform-heading"><div class="perform-section-icon perform-icon-green"><i class="fas fa-vial"></i></div><div><h6 class="perform-section-title">Laboratory Test Information</h6><span class="perform-section-subtitle">Test selected for processing</span></div></div>
                            <div class="row">
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Test Type</span><div class="perform-info-box"><i class="fas fa-flask"></i><span id="performTestType"></span></div></div>
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Sample / Test Status</span><div class="perform-info-box"><i class="fas fa-check-circle"></i><span id="performStatus"></span></div></div>
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Priority</span><div class="perform-info-box"><i class="fas fa-exclamation-circle"></i><span id="performPriority"></span></div></div>
                                <div class="col-md-6 mb-3"><span class="perform-info-label">Turnaround Time</span><div class="perform-info-box"><i class="far fa-clock"></i><span id="performTurnaround"></span></div></div>
                                <div class="col-12"><span class="perform-info-label">Clinical Notes</span><div class="perform-info-box perform-notes" id="performNotes"></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="perform-section">
                        <div class="perform-section-body">
                            <div class="perform-heading"><div class="perform-section-icon perform-icon-orange"><i class="fas fa-tasks"></i></div><div><h6 class="perform-section-title">Pre-Test Verification Checklist</h6><span class="perform-section-subtitle">All five checks are required before starting</span></div></div>
                            <div class="perform-guidance"><i class="fas fa-info-circle mt-1"></i><span>Check the actual request and physical sample against the displayed information. Tick each item only after verification.</span></div>
                            <label class="perform-check-item"><input class="perform-check-input perform-verify" type="checkbox" /><span class="perform-check-content"><span class="perform-check-icon"><i class="fas fa-check"></i></span><span><span class="perform-check-title">Patient Identity Verified</span><span class="perform-check-description">Patient name and ID match the test request and sample label</span></span></span></label>
                            <label class="perform-check-item"><input class="perform-check-input perform-verify" type="checkbox" /><span class="perform-check-content"><span class="perform-check-icon"><i class="fas fa-check"></i></span><span><span class="perform-check-title">Request Number Verified</span><span class="perform-check-description">Request reference matches the laboratory record</span></span></span></label>
                            <label class="perform-check-item"><input class="perform-check-input perform-verify" type="checkbox" /><span class="perform-check-content"><span class="perform-check-icon"><i class="fas fa-check"></i></span><span><span class="perform-check-title">Test Type Verified</span><span class="perform-check-description">Selected test matches the requested investigation</span></span></span></label>
                            <label class="perform-check-item"><input class="perform-check-input perform-verify" type="checkbox" /><span class="perform-check-content"><span class="perform-check-icon"><i class="fas fa-check"></i></span><span><span class="perform-check-title">Sample Readiness Verified</span><span class="perform-check-description">Correct physical sample is present and suitable for testing</span></span></span></label>
                            <label class="perform-check-item"><input class="perform-check-input perform-verify" type="checkbox" /><span class="perform-check-content"><span class="perform-check-icon"><i class="fas fa-check"></i></span><span><span class="perform-check-title">Clinical Instructions Reviewed</span><span class="perform-check-description">Clinical notes, priority, and turnaround requirements have been reviewed</span></span></span></label>
                            <div id="performCheckStatus" class="perform-check-status" role="status" aria-live="polite"><i id="performCheckIcon" class="fas fa-exclamation-triangle mr-2"></i><span id="performCheckText">0 of 5 items verified</span></div>
                        </div>
                    </div>
                    <div class="perform-guidance mb-0"><i class="fas fa-info-circle mt-1"></i><span>Confirming assigns the test to your technician account and changes its status to <strong>In Progress</strong>. Test results are captured later in the processing workflow.</span></div>
                </div>
                <div class="modal-footer perform-modal-footer">
                    <button type="button" class="btn btn-light" data-dismiss="modal"><i class="fas fa-times mr-1"></i>Cancel</button>
                    <button type="submit" id="performSubmit" class="btn btn-primary" disabled><span id="performNormal"><i class="fas fa-play-circle mr-1"></i>Confirm &amp; Start Test</span><span id="performLoading" class="d-none"><span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>Starting...</span></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            $('#selectSearch').on('input', function() {
                var query = (this.value || '').toLowerCase();
                var visible = 0;
                $('#selectTestsTable tbody tr').each(function() {
                    var match = $(this).text().toLowerCase().indexOf(query) !== -1;
                    $(this).toggle(match);
                    if (match) visible++;
                });
                $('#selectVisibleCount').text('Showing ' + visible + ' matching patient test(s).');
            });

            function updateVerification() {
                var total = $('.perform-verify').length;
                var checked = $('.perform-verify:checked').length;
                var complete = total === 5 && checked === total;
                $('#performCheckText').text(complete ? 'All 5 items verified — ready to start test' : checked + ' of 5 items verified');
                $('#performCheckStatus').toggleClass('complete', complete);
                $('#performCheckIcon').attr('class', complete ? 'fas fa-check-circle mr-2' : 'fas fa-exclamation-triangle mr-2');
                $('#performSubmit').prop('disabled', !complete);
            }

            $('.open-perform-modal').on('click', function() {
                var b = $(this);
                var values = {
                    performTestId: b.attr('data-test-id'),
                    performRequest: b.attr('data-request'),
                    performPatient: b.attr('data-patient'),
                    performPatientId: b.attr('data-patient-id'),
                    performDoctor: b.attr('data-doctor'),
                    performDoctorUsername: b.attr('data-username'),
                    performRequestStatus: b.attr('data-request-status'),
                    performTestType: b.attr('data-test'),
                    performNotes: b.attr('data-notes'),
                    performPriority: b.attr('data-priority'),
                    performTurnaround: b.attr('data-turnaround'),
                    performStatus: b.attr('data-status')
                };
                Object.keys(values).forEach(function(id) {
                    if (id === 'performTestId') $('#' + id).val(values[id] || '');
                    else $('#' + id).text(values[id] || 'Not available');
                });
                $('.perform-verify').prop('checked', false);
                $('#performNormal').removeClass('d-none');
                $('#performLoading').addClass('d-none');
                updateVerification();
            });

            $('.perform-verify').on('change', updateVerification);
            $('#performTestForm').on('submit', function(event) {
                if (!$('.perform-verify').length || $('.perform-verify:checked').length !== 5 || !$('#performTestId').val()) {
                    event.preventDefault();
                    updateVerification();
                    return false;
                }
                $('#performSubmit').prop('disabled', true);
                $('#performNormal').addClass('d-none');
                $('#performLoading').removeClass('d-none');
                // Normal POST; the existing controller handles redirect and errors.
            });
        });
    </script>
}
