@model NMB_HLabSys.Areas.Technician.Models.TestResultModel
@{
    Layout = null;
    var test = Model.TestRequestTestType;
}
<div class="modal fade" id="correctTestModal" tabindex="-1" role="dialog" aria-labelledby="correctTestModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" style="border:0;border-radius:14px;overflow:hidden">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#073b5c,#075985,#0284c7)">
                <div>
                    <h5 class="modal-title" id="correctTestModalTitle"><i class="fas fa-edit mr-2"></i>Correct Returned Test Result</h5>
                    <small>Original technician — correct the result and resubmit for independent verification</small>
                </div>
                <button type="button" class="close text-white js-close-correction" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <form action="@Url.Action("CaptureResults", "Tests", new { area = "Technician" })" method="post" id="correctTestForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="testRequestTestTypeId" value="@Model.TestRequestTestTypeId" />
                <div class="modal-body" style="background:#f8fafc;max-height:65vh;overflow-y:auto">
                    <div class="p-3 mb-3 bg-white rounded border">
                        <div class="font-weight-bold text-primary mb-2">Test Details</div>
                        <div><strong>Test:</strong> @(test?.TestType?.Name ?? Model.ResultName)</div>
                        <div><strong>Request:</strong> @(test?.TestRequest?.RequestNumber ?? "Not available")</div>
                        <div><strong>Status:</strong> @(test?.Status ?? "Unknown")</div>
                    </div>
                    <div class="p-3 mb-3 rounded border" style="background:#fff7ed;border-color:#fed7aa!important">
                        <div class="font-weight-bold mb-2" style="color:#9a3412"><i class="fas fa-comment-medical mr-1"></i>Verifier's Feedback</div>
                        <div style="white-space:pre-wrap;overflow-wrap:anywhere">@(string.IsNullOrWhiteSpace(Model.ReviewNotes) ? "No review notes were recorded. Consult Full History." : Model.ReviewNotes)</div>
                    </div>
                    <div class="p-3 bg-white rounded border">
                        <div class="font-weight-bold text-primary mb-3">Retake / Correct Result</div>
                        <div class="form-group">
                            <label for="correctResultValue">Corrected Result Value <span class="text-danger">*</span></label>
                            <input class="form-control" type="text" name="resultValue" id="correctResultValue" value="@Model.ResultValue" maxlength="200" required />
                        </div>
                        <div class="form-group mb-0">
                            <label for="correctResultNotes">Correction Notes</label>
                            <textarea class="form-control" id="correctResultNotes" name="notes" rows="4" maxlength="2000" placeholder="Describe the retest and correction">@Model.Notes</textarea>
                            <small class="text-muted">Saving a correction does not automatically verify or complete the test. The verification history is preserved.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light js-close-correction">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save Corrected Result</button>
                </div>
            </form>
        </div>
    </div>
</div>
