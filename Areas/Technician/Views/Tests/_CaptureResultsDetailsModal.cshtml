@model NMB_HLabSys.Areas.Technician.Models.TestResultModel

@using System.Globalization

@{
    Layout = null;

    var test = Model.TestRequestTestType;
    var testType = test?.TestType;
    var request = test?.TestRequest;
    var patient = request?.Patient;

    var isNumeric = decimal.TryParse(
        Model.ResultValue,
        NumberStyles.Number,
        CultureInfo.InvariantCulture,
        out var numericValue);

    bool? isAbnormal = null;

    if (isNumeric &&
        Model.ReferenceMin.HasValue &&
        Model.ReferenceMax.HasValue)
    {
        isAbnormal =
            numericValue < Model.ReferenceMin.Value ||
            numericValue > Model.ReferenceMax.Value;
    }

    var status = test?.Status ?? "Unknown";

    var needsReview = Model.RequiresReview ||
        string.Equals(
            status,
            "To Be Reviewed",
            StringComparison.OrdinalIgnoreCase);
}

<style>
    .crd-modal-content {
        border: 0;
        border-radius: 15px;
        overflow: hidden;
        background: #f4f7fb;
        box-shadow: 0 15px 45px rgba(15, 23, 42, .2);
    }

    .crd-header {
        background: linear-gradient(135deg, #073b5c, #075985, #0284c7);
        color: #fff;
        padding: 24px 27px;
        border: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .crd-header-main {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .crd-header-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.16);
        font-size: 22px;
    }

    .crd-header h5 {
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .crd-header p {
        font-size: 11px;
        color: rgba(255,255,255,.8);
        margin: 0;
    }

    .crd-close {
        color: #fff !important;
        opacity: .85;
        text-shadow: none;
        font-size: 27px;
        padding: 0;
        margin-left: 12px;
    }

    .crd-body {
        padding: 24px;
        max-height: 72vh;
        overflow-y: auto;
    }

    .crd-section {
        background: #fff;
        border: 1px solid #e6edf5;
        border-radius: 12px;
        margin-bottom: 17px;
        overflow: hidden;
    }

        .crd-section:last-child {
            margin-bottom: 0;
        }

    .crd-section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e8eef5;
        color: #075985;
        font-size: 13px;
        font-weight: 700;
    }

        .crd-section-heading i {
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #e0f2fe;
            color: #0369a1;
        }

    .crd-section-body {
        padding: 18px;
    }

    .crd-field {
        margin-bottom: 18px;
        min-width: 0;
    }

        .crd-field:last-child {
            margin-bottom: 0;
        }

    .crd-label {
        display: block;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .55px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .crd-value {
        color: #0f172a;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .crd-result-panel {
        border: 1px solid #dbeafe;
        background: linear-gradient(135deg, #eff6ff, #f0f9ff);
        border-radius: 11px;
        padding: 18px;
        height: 100%;
    }

    .crd-result-number {
        color: #075985;
        font-size: 27px;
        font-weight: 800;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    .crd-unit {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }

    .crd-range {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
    }

    .crd-status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: normal;
    }

    .crd-success {
        background: #dcfce7;
        color: #166534;
    }

    .crd-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .crd-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .crd-info {
        background: #e0f2fe;
        color: #075985;
    }

    .crd-neutral {
        background: #f1f5f9;
        color: #475569;
    }

    .crd-note {
        border-radius: 8px;
        padding: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 12px;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .crd-stock-item {
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        padding: 14px;
        margin-bottom: 10px;
    }

        .crd-stock-item:last-child {
            margin-bottom: 0;
        }

    .crd-footer {
        padding: 16px 24px;
        background: #fff;
        border-top: 1px solid #e8eef5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .crd-footer-note {
        color: #64748b;
        font-size: 11px;
    }

    .crd-footer .btn {
        border-radius: 8px;
        padding: 9px 17px;
        font-size: 12px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .crd-header {
            padding: 18px;
        }

            .crd-header h5 {
                font-size: 15px;
            }

        .crd-header-icon {
            width: 40px;
            height: 40px;
        }

        .crd-body {
            padding: 13px;
            max-height: 75vh;
        }

        .crd-section-body {
            padding: 14px;
        }

        .crd-footer {
            padding: 13px;
        }
    }
</style>

<div class="modal-content crd-modal-content">

    <!-- Modal header -->
    <div class="modal-header crd-header">
        <div class="crd-header-main">
            <div class="crd-header-icon">
                <i class="fas fa-flask"></i>
            </div>

            <div>
                <h5>
                    Captured Test Result Details
                </h5>
                <p>
                    Review laboratory results, verification and stock information
                </p>
            </div>
        </div>

        <button type="button"
                class="close crd-close"
                data-dismiss="modal"
                aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <!-- Modal body -->
    <div class="modal-body crd-body">

        <!-- Request and patient -->
        <section class="crd-section">
            <div class="crd-section-heading">
                <i class="fas fa-user-injured"></i>
                Patient and Test Request
            </div>

            <div class="crd-section-body">
                <div class="row">
                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Request Number</span>
                        <div class="crd-value">
                            @(request?.RequestNumber ?? "Unavailable")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Assignment ID</span>
                        <div class="crd-value">
                            @(test?.TestRequestTestTypeId.ToString()
                                ?? "Unavailable")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Patient Name</span>
                        <div class="crd-value">
                            @(patient?.FullName ?? "Patient unavailable")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Test Type</span>
                        <div class="crd-value">
                            @(testType?.Name ?? "Unknown test")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field mb-md-0">
                        <span class="crd-label">Test Status</span>
                        <div class="crd-value">@status</div>
                    </div>

                    <div class="col-md-6 crd-field mb-0">
                        <span class="crd-label">Captured Date and Time</span>
                        <div class="crd-value">
                            @Model.CapturedDateTime.ToString("dd MMM yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Result -->
        <section class="crd-section">
            <div class="crd-section-heading">
                <i class="fas fa-microscope"></i>
                Laboratory Result
            </div>

            <div class="crd-section-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="crd-result-panel">
                            <span class="crd-label">Captured Value</span>

                            <div class="crd-result-number">
                                @Model.ResultValue
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.MeasurementUnit))
                            {
                                <span class="crd-unit">
                                    @Model.MeasurementUnit
                                </span>
                            }

                            <hr />

                            <span class="crd-label">Result Name</span>
                            <div class="crd-value">@Model.ResultName</div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="crd-result-panel">
                            <span class="crd-label">Reference Range</span>

                            <div class="crd-range">
                                @if (Model.ReferenceMin.HasValue &&
                                     Model.ReferenceMax.HasValue)
                                {
                                    @Model.ReferenceMin.Value.ToString("0.##")
                                    @: –
                                    @Model.ReferenceMax.Value.ToString("0.##")
                                }
                                else
                                {
                                    @: Not recorded
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.MeasurementUnit))
                            {
                                <span class="crd-unit">
                                    @Model.MeasurementUnit
                                </span>
                            }

                            <hr />

                            <span class="crd-label">Evaluated Status</span>

                            @if (isAbnormal == true)
                            {
                                <span class="crd-status crd-danger">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>
                                    Outside Reference Range
                                </span>
                            }
                            else if (isAbnormal == false)
                            {
                                <span class="crd-status crd-success">
                                    <i class="fas fa-check-circle mr-1"></i>
                                    Within Reference Range
                                </span>
                            }
                            else
                            {
                                <span class="crd-status crd-neutral">
                                    Cannot evaluate numerically
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Stored Result Flag</span>
                        <div class="crd-value">
                            @(Model.ResultFlag ?? "Not recorded")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Result Record ID</span>
                        <div class="crd-value">@Model.TestResultId</div>
                    </div>

                    <div class="col-12 crd-field mb-0">
                        <span class="crd-label">Technician Notes</span>
                        <div class="crd-note">
                            @(string.IsNullOrWhiteSpace(Model.Notes)
                                ? "No technician notes recorded."
                                : Model.Notes)
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Verification -->
        <section class="crd-section">
            <div class="crd-section-heading">
                <i class="fas fa-clipboard-check"></i>
                Verification and Review
            </div>

            <div class="crd-section-body">
                <div class="row">
                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Verification Status</span>

                        @if (Model.VerifiedDateTime.HasValue)
                        {
                            <span class="crd-status crd-success">
                                <i class="fas fa-check-circle mr-1"></i>
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="crd-status crd-warning">
                                <i class="fas fa-clock mr-1"></i>
                                Not verified
                            </span>
                        }
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Verification Date</span>
                        <div class="crd-value">
                            @(Model.VerifiedDateTime.HasValue
                                ? Model.VerifiedDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not verified")
                        </div>
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Review Required</span>

                        @if (needsReview)
                        {
                            <span class="crd-status crd-warning">
                                <i class="fas fa-exclamation-circle mr-1"></i>
                                Review required
                            </span>
                        }
                        else
                        {
                            <span class="crd-status crd-success">
                                No review flagged
                            </span>
                        }
                    </div>

                    <div class="col-md-6 crd-field">
                        <span class="crd-label">Verified By</span>
                        <div class="crd-value">
                            @(Model.VerifiedByTechnician?.UserName
                                ?? "Not recorded")
                        </div>
                    </div>

                    <div class="col-12 crd-field mb-0">
                        <span class="crd-label">Review Notes</span>
                        <div class="crd-note">
                            @(string.IsNullOrWhiteSpace(Model.ReviewNotes)
                                ? "No review notes recorded."
                                : Model.ReviewNotes)
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Consumables -->
        <section class="crd-section">
            <div class="crd-section-heading">
                <i class="fas fa-boxes"></i>
                Consumables and Stock
            </div>

            <div class="crd-section-body">
                @{
                    var consumables = testType?.TestTypeConsumables?
                        .Where(tc =>
                            tc.Consumable != null &&
                            !tc.Consumable.IsDeleted)
                        .ToList();
                }

                @if (consumables != null && consumables.Any())
                {
                    foreach (var item in consumables)
                    {
                        var consumable = item.Consumable!;
                        <div class="crd-stock-item">
                            <div class="row align-items-center">
                                <div class="col-md-5 mb-2 mb-md-0">
                                    <span class="crd-label">Consumable</span>
                                    <div class="crd-value">
                                        @consumable.Name
                                    </div>
                                </div>

                                <div class="col-md-3 mb-2 mb-md-0">
                                    <span class="crd-label">Stock Remaining</span>
                                    <div class="crd-value">
                                        @consumable.QuantityOnHand units
                                    </div>
                                </div>

                                <div class="col-md-2 mb-2 mb-md-0">
                                    <span class="crd-label">Required</span>
                                    <div class="crd-value">
                                        @item.QuantityRequired
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <span class="crd-label">Stock Status</span>

                                    @if (consumable.QuantityOnHand <= 0)
                                    {
                                        <span class="crd-status crd-danger">
                                            Out of stock
                                        </span>
                                    }
                                    else if (consumable.QuantityOnHand
                                             <= consumable.ReorderLevel)
                                    {
                                        <span class="crd-status crd-warning">
                                            Low stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="crd-status crd-success">
                                            In stock
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small">
                        <i class="fas fa-info-circle mr-1"></i>
                        No active consumables are linked to this test type.
                    </div>
                }
            </div>
        </section>
    </div>

    <!-- Footer -->
    <div class="modal-footer crd-footer">
        <div class="crd-footer-note">
            <i class="fas fa-shield-alt mr-1"></i>
            NMB-HLabSys · Laboratory records
        </div>

        <button type="button"
                class="btn btn-secondary"
                data-dismiss="modal">
            <i class="fas fa-times mr-1"></i>
            Close
        </button>
    </div>
</div>
