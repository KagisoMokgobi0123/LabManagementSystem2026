@* Technician - Laboratory Test Details Modal *@

<style>
    #myTestDetailsModal .modal-content {
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 55px rgba(0,0,0,.18);
    }

    #myTestDetailsModal .modal-header {
        background: linear-gradient(135deg,#073b5c,#0284c7);
        color: white;
        padding: 22px 26px;
        border-bottom: 0;
    }

    #myTestDetailsModal .modal-title {
        font-weight: 700;
        font-size: 20px;
    }

    #myTestDetailsModal .modal-body {
        background: #f8fafc;
        padding: 25px;
    }

    .mtd-info {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px;
        height: 100%;
    }

    .mtd-info-label {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 8px;
    }

        .mtd-info-label i {
            color: #0284c7;
            margin-right: 7px;
            width: 16px;
        }

    .mtd-info-value {
        color: #0f172a;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .mtd-clinical-notes {
        background: #eff6ff;
        border-left: 4px solid #0284c7;
        border-radius: 10px;
        padding: 20px;
        margin-top: 10px;
    }

        .mtd-clinical-notes h6 {
            color: #075985;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .mtd-clinical-notes p {
            color: #334155;
            font-size: 13px;
            line-height: 1.7;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            margin-bottom: 0;
        }

    #myTestDetailsModal .modal-footer {
        background: white;
        border-top: 1px solid #e2e8f0;
        padding: 15px 25px;
    }
</style>

<div class="modal fade"
     id="myTestDetailsModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="myTestDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered"
         role="document">

        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title"
                        id="myTestDetailsModalLabel">
                        <i class="fas fa-flask mr-2"></i>
                        Laboratory Test Details
                    </h5>
                    <small>Selected patient test information</small>
                </div>

                <button type="button"
                        class="close js-close-test-modal"
                        data-dismiss="modal"
                        aria-label="Close"
                        style="color:white;opacity:1;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-file-medical"></i>
                                Request Number
                            </div>
                            <div id="mtdRequest" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-hashtag"></i>
                                Test Number
                            </div>
                            <div id="mtdTestId" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-user-injured"></i>
                                Patient
                            </div>
                            <div id="mtdPatient" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-vials"></i>
                                Test Type
                            </div>
                            <div id="mtdTestType" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-exclamation-circle"></i>
                                Urgency
                            </div>
                            <div id="mtdUrgency" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-tasks"></i>
                                Status
                            </div>
                            <div id="mtdStatus" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-play-circle"></i>
                                Started
                            </div>
                            <div id="mtdStarted" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-hourglass-half"></i>
                                Turnaround Time
                            </div>
                            <div id="mtdTat" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-calendar-check"></i>
                                Expected Completion
                            </div>
                            <div id="mtdDue" class="mtd-info-value"></div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="mtd-info">
                            <div class="mtd-info-label">
                                <i class="fas fa-clock"></i>
                                Deadline Status
                            </div>
                            <div id="mtdDeadline" class="mtd-info-value"></div>
                        </div>
                    </div>

                </div>

                <!-- PATIENT CLINICAL NOTES -->
                <div class="mtd-clinical-notes">

                    <h6>
                        <i class="fas fa-notes-medical mr-2"></i>
                        Patient Clinical Notes
                    </h6>

                    <p id="mtdClinicalNotes">
                        No clinical notes available.
                    </p>

                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary js-close-test-modal"
                        data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
