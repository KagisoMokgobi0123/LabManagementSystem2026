```cshtml
@model IEnumerable<NMB_HLabSys.Areas.Technician.Models.TestResultModel>

@using System.Globalization
@using NMB_HLabSys.Areas.Technician.Models

@{
    ViewData["Title"] = "Test Results";
    Layout = "_TechnicianLayout";

    var results = Model?.ToList() ?? new List<TestResultModel>();

    bool? IsResultAbnormal(TestResultModel result)
    {
        if (!decimal.TryParse(
            result.ResultValue,
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var value))
        {
            return null;
        }

        if (!result.ReferenceMin.HasValue ||
            !result.ReferenceMax.HasValue)
        {
            return null;
        }

        return value < result.ReferenceMin.Value ||
               value > result.ReferenceMax.Value;
    }

    var totalResults = results.Count;
    var verifiedResults = results.Count(r => r.VerifiedDateTime.HasValue);
    var abnormalResults = results.Count(r => IsResultAbnormal(r) == true);

    var reviewResults = results.Count(r =>
        r.RequiresReview ||
        string.Equals(
            r.TestRequestTestType?.Status,
            "To Be Reviewed",
            StringComparison.OrdinalIgnoreCase));
}

<style>
    .results-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 45px;
    }

    .results-hero {
        padding: 35px 0 78px;
        background: linear-gradient(135deg, #073b5c, #075985, #0284c7);
        color: #fff;
    }

    .results-hero h1 {
        font-size: 29px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .results-hero p {
        color: rgba(255,255,255,.82);
        font-size: 13px;
        margin: 0;
    }

    .results-content {
        position: relative;
        margin-top: -45px;
    }

    .results-summary {
        background: #fff;
        padding: 20px;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        height: 100%;
    }

    .results-summary .label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .results-summary .number {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 8px 0 0;
    }

    .results-card {
        margin-top: 24px;
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
        overflow: hidden;
    }

    .results-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #eef2f7;
    }

    .results-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .results-card-subtitle {
        font-size: 11px;
        color: #94a3b8;
        margin: 5px 0 0;
    }

    .results-search {
        height: 38px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
    }

    .results-table {
        margin: 0;
    }

    .results-table thead th {
        background: #f8fafc;
        border-top: 0;
        border-bottom: 1px solid #e2e8f0;
        padding: 13px;
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
        white-space: nowrap;
    }

    .results-table tbody td {
        padding: 14px 13px;
        vertical-align: middle;
        border-color: #f1f5f9;
        color: #334155;
        font-size: 12px;
    }

    .results-table tbody tr:hover {
        background: #f8fcff;
    }

    .result-main {
        display: block;
        color: #075985;
        font-weight: 700;
    }

    .result-sub {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-top: 4px;
    }

    .result-pill {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: normal;
    }

    .result-pill.normal,
    .result-pill.verified {
        background: #dcfce7;
        color: #166534;
    }

    .result-pill.abnormal {
        background: #fee2e2;
        color: #991b1b;
    }

    .result-pill.review {
        background: #fef3c7;
        color: #92400e;
    }

    .result-pill.pending {
        background: #e0f2fe;
        color: #0369a1;
    }

    .result-pill.not-evaluated {
        background: #f1f5f9;
        color: #475569;
    }

    .consumable-stock {
        display: block;
        color: #475569;
        font-size: 11px;
        margin-top: 4px;
    }

    .consumable-unavailable {
        display: inline-block;
        background: #f1f5f9;
        color: #64748b;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: 10px;
        white-space: nowrap;
    }

    .result-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .result-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 35px;
        width: 35px;
        height: 35px;
        border-radius: 8px;
        background: #e0f2fe;
        color: #0369a1;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background .2s ease, color .2s ease;
    }

    .result-action:hover {
        background: #0284c7;
        color: #fff;
        text-decoration: none;
    }

    .result-action-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

    .result-action-delete:hover {
        background: #dc2626;
        color: #fff;
    }

    .results-empty {
        text-align: center;
        padding: 55px 20px;
        color: #64748b;
    }

    /* Main result details modal */
    #CaptureResultsDetailsModal .modal-dialog {
        max-width: 850px;
    }

    #CaptureResultsDetailsModal .modal-content {
        border: 0;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 18px 55px rgba(15,23,42,.25);
    }

    #CaptureResultsDetailsModal .modal-header {
        padding: 22px 26px;
        border: 0;
        color: #fff;
        background: linear-gradient(135deg, #073b5c, #075985, #0284c7);
    }

    #CaptureResultsDetailsModal .modal-title {
        font-weight: 700;
        font-size: 18px;
    }

    #CaptureResultsDetailsModal .modal-header .close {
        color: #fff;
        text-shadow: none;
        opacity: .9;
        font-size: 28px;
    }

    #CaptureResultsDetailsModal .modal-body {
        background: #f8fafc;
        padding: 24px;
        max-height: 72vh;
        overflow-y: auto;
    }

    .detail-section {
        background: #fff;
        border: 1px solid #e8eef5;
        border-radius: 11px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .detail-section:last-child {
        margin-bottom: 0;
    }

    .detail-section-title {
        color: #075985;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eef2f7;
    }

    .detail-label {
        display: block;
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .detail-value {
        display: block;
        color: #0f172a;
        font-size: 13px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .detail-field {
        margin-bottom: 15px;
        min-width: 0;
    }

    .detail-result-value {
        font-size: 24px;
        font-weight: 800;
        color: #075985;
        overflow-wrap: anywhere;
    }

    .detail-note {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        color: #334155;
        font-size: 12px;
    }

    .detail-consumable {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 8px;
    }

    .detail-consumable:last-child {
        margin-bottom: 0;
    }

    .results-modal-footer {
        padding: 15px 24px;
        background: #fff;
        border-top: 1px solid #e8eef5;
    }

    .results-modal-footer .btn {
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        padding: 9px 16px;
    }

    #resultsTable_wrapper .dt-buttons {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 12px;
    }

    #resultsTable_wrapper .dt-buttons .btn {
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        padding: 7px 12px;
    }

    #resultsTable_wrapper .dataTables_length,
    #resultsTable_wrapper .dataTables_info,
    #resultsTable_wrapper .dataTables_paginate {
        color: #64748b;
        font-size: 11px;
    }

    #resultsTable_wrapper .dataTables_filter {
        display: none;
    }

    #resultsTable_wrapper .dataTables_length select {
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 4px 8px;
    }

    #resultsTable_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px !important;
    }

    @@media (max-width: 768px) {
        .results-hero h1 {
            font-size: 24px;
        }

        #CaptureResultsDetailsModal .modal-body {
            padding: 14px;
        }

        #CaptureResultsDetailsModal .modal-header {
            padding: 18px;
        }
    }
</style>

<div class="results-page">
    <section class="results-hero">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1>
                        <i class="fas fa-flask mr-2"></i>
                        Test Results
                    </h1>
                    <p>
                        Review laboratory measurements, patients,
                        reference ranges and remaining consumable stock.
                    </p>
                </div>

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="MyTests"
                   class="btn btn-light btn-sm mt-3">
                    <i class="fas fa-arrow-left mr-1"></i>
                    My Assigned Tests
                </a>
            </div>
        </div>
    </section>

    <div class="container-fluid results-content">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="results-summary">
                    <div class="label">Total Results</div>
                    <h2 class="number">@totalResults</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="results-summary">
                    <div class="label">Verified Results</div>
                    <h2 class="number">@verifiedResults</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="results-summary">
                    <div class="label">Abnormal Results</div>
                    <h2 class="number">@abnormalResults</h2>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="results-summary">
                    <div class="label">Require Review</div>
                    <h2 class="number">@reviewResults</h2>
                </div>
            </div>
        </div>

        <div class="results-card">
            <div class="results-card-header">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <h4 class="results-card-title">
                            <i class="fas fa-table text-primary mr-2"></i>
                            Laboratory Results Register
                        </h4>
                        <p class="results-card-subtitle">
                            Search results by request number, patient, test,
                            result, stock or status.
                        </p>
                    </div>

                    <div class="col-lg-5 mt-3 mt-lg-0">
                        <input id="resultsSearch"
                               type="search"
                               class="form-control results-search"
                               placeholder="Search laboratory results..."
                               aria-label="Search laboratory results" />
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table results-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th>Test Request</th>
                            <th>Captured</th>
                            <th>Test</th>
                            <th>Patient</th>
                            <th>Result Name</th>
                            <th>Result Value</th>
                            <th>Reference Range</th>
                            <th>Flag</th>
                            <th>Consumable Remaining</th>
                            <th>Test Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var result in results)
                        {
                            var test = result.TestRequestTestType;
                            var testType = test?.TestType;
                            var patient = test?.TestRequest?.Patient;
                            var status = test?.Status ?? "Unknown";
                            var abnormal = IsResultAbnormal(result);

                            var consumables = testType?.TestTypeConsumables?
                                .Where(tc =>
                                    tc.Consumable != null &&
                                    !tc.Consumable.IsDeleted)
                                .ToList();

                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(
                                        test?.TestRequest?.RequestNumber))
                                    {
                                        <span class="result-main">
                                            @test!.TestRequest!.RequestNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unavailable</span>
                                    }
                                </td>

                                <td>
                                    @result.CapturedDateTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(testType?.Name ?? "Unknown test")
                                    </span>
                                    <span class="result-sub">
                                        Assignment #@(test?.TestRequestTestTypeId)
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(patient?.FullName ?? "Patient unavailable")
                                    </span>
                                </td>

                                <td>@result.ResultName</td>

                                <td>
                                    <span class="result-main">@result.ResultValue</span>
                                    <span class="result-sub">
                                        @(result.MeasurementUnit ?? "Unit not recorded")
                                    </span>
                                </td>

                                <td>
                                    @if (result.ReferenceMin.HasValue &&
                                         result.ReferenceMax.HasValue)
                                    {
                                        <span>
                                            @result.ReferenceMin.Value.ToString("0.##")
                                            –
                                            @result.ReferenceMax.Value.ToString("0.##")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </td>

                                <td>
                                    @if (abnormal == true)
                                    {
                                        <span class="result-pill abnormal">ABNORMAL</span>
                                    }
                                    else if (abnormal == false)
                                    {
                                        <span class="result-pill normal">NORMAL</span>
                                    }
                                    else
                                    {
                                        <span class="result-pill not-evaluated">
                                            Not Evaluated
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (consumables != null && consumables.Any())
                                    {
                                        foreach (var item in consumables)
                                        {
                                            var consumable = item.Consumable!;

                                            <div class="mb-3">
                                                <span class="result-main">
                                                    @consumable.Name
                                                </span>

                                                <span class="consumable-stock">
                                                    @consumable.QuantityOnHand units remaining
                                                </span>

                                                @if (consumable.QuantityOnHand <= 0)
                                                {
                                                    <span class="result-pill abnormal">
                                                        OUT OF STOCK
                                                    </span>
                                                }
                                                else if (consumable.QuantityOnHand
                                                         <= consumable.ReorderLevel)
                                                {
                                                    <span class="result-pill review">
                                                        LOW STOCK
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="result-pill normal">
                                                        IN STOCK
                                                    </span>
                                                }

                                                <span class="result-sub">
                                                    Required per test: @item.QuantityRequired
                                                </span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="consumable-unavailable">
                                            No consumable linked
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (result.RequiresReview ||
                                        string.Equals(
                                            status,
                                            "To Be Reviewed",
                                            StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="result-pill review">
                                            Requires Review
                                        </span>
                                    }
                                    else if (result.VerifiedDateTime.HasValue)
                                    {
                                        <span class="result-pill verified">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="result-pill pending">@status</span>
                                    }
                                </td>

                                <td>
                                    <div class="result-actions">
                                        <button type="button"
                                                class="result-action js-view-result"
                                                data-result-id="@result.TestResultId"
                                                title="View result details"
                                                aria-label="View result details">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <a asp-area="Technician"
                                           asp-controller="Tests"
                                           asp-action="EditResult"
                                           asp-route-id="@result.TestResultId"
                                           class="result-action"
                                           title="Edit result"
                                           aria-label="Edit result">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-area="Technician"
                                              asp-controller="Tests"
                                              asp-action="DeleteResult"
                                              asp-route-id="@result.TestResultId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this result? Please ensure the required audit record is retained.');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="result-action result-action-delete"
                                                    title="Delete result"
                                                    aria-label="Delete result">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!results.Any())
                        {
                            <tr>
                                <td colspan="11" class="results-empty">
                                    <i class="fas fa-flask fa-2x mb-3"></i>
                                    <h5>No captured results found</h5>
                                    <p>Results you capture will appear here.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-3 py-3 text-muted small"
                 id="resultsCount"
                 aria-live="polite">
                Showing @totalResults result(s).
            </div>
        </div>
    </div>
</div>

<!-- Hidden result templates: details only, not another modal -->
<div class="d-none" id="resultDetailsTemplates" aria-hidden="true">
    @foreach (var result in results)
    {
        var test = result.TestRequestTestType;
        var testType = test?.TestType;
        var request = test?.TestRequest;
        var patient = request?.Patient;
        var abnormal = IsResultAbnormal(result);
        var status = test?.Status ?? "Unknown";

        var needsReview = result.RequiresReview ||
            string.Equals(
                status,
                "To Be Reviewed",
                StringComparison.OrdinalIgnoreCase);

        var consumables = testType?.TestTypeConsumables?
            .Where(tc => tc.Consumable != null && !tc.Consumable.IsDeleted)
            .ToList();

        <div id="resultDetailsTemplate-@result.TestResultId">
            <div class="detail-section">
                <h6 class="detail-section-title">
                    <i class="fas fa-file-medical-alt mr-2"></i>
                    Test Request and Patient
                </h6>

                <div class="row">
                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Request Number</span>
                        <span class="detail-value">
                            @(request?.RequestNumber ?? "Unavailable")
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Assignment ID</span>
                        <span class="detail-value">
                            @(test?.TestRequestTestTypeId.ToString() ?? "Unavailable")
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Patient</span>
                        <span class="detail-value">
                            @(patient?.FullName ?? "Patient unavailable")
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Test Type</span>
                        <span class="detail-value">
                            @(testType?.Name ?? "Unknown test")
                        </span>
                    </div>
                </div>
            </div>

            <div class="detail-section">
                <h6 class="detail-section-title">
                    <i class="fas fa-vials mr-2"></i>
                    Captured Result
                </h6>

                <div class="row">
                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Result Name</span>
                        <span class="detail-value">@result.ResultName</span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Captured Date and Time</span>
                        <span class="detail-value">
                            @result.CapturedDateTime.ToString("dd MMM yyyy HH:mm")
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Result Value</span>
                        <span class="detail-value detail-result-value">
                            @result.ResultValue
                            <small>@(result.MeasurementUnit ?? "")</small>
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Reference Range</span>
                        <span class="detail-value">
                            @if (result.ReferenceMin.HasValue &&
                                 result.ReferenceMax.HasValue)
                            {
                                @result.ReferenceMin.Value.ToString("0.##")
                                @: –
                                @result.ReferenceMax.Value.ToString("0.##")

                                @if (!string.IsNullOrWhiteSpace(result.MeasurementUnit))
                                {
                                    @: @result.MeasurementUnit
                                }
                            }
                            else
                            {
                                @: Not recorded
                            }
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Evaluated Result</span>
                        <span class="detail-value">
                            @if (abnormal == true)
                            {
                                <span class="result-pill abnormal">ABNORMAL</span>
                            }
                            else if (abnormal == false)
                            {
                                <span class="result-pill normal">NORMAL</span>
                            }
                            else
                            {
                                <span class="result-pill not-evaluated">
                                    Not Evaluated
                                </span>
                            }
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Stored Result Flag</span>
                        <span class="detail-value">
                            @(result.ResultFlag ?? "Not recorded")
                        </span>
                    </div>

                    <div class="col-12 detail-field">
                        <span class="detail-label">Technician Notes</span>
                        <div class="detail-note">
                            @(string.IsNullOrWhiteSpace(result.Notes)
                                ? "No notes recorded."
                                : result.Notes)
                        </div>
                    </div>
                </div>
            </div>

            <div class="detail-section">
                <h6 class="detail-section-title">
                    <i class="fas fa-clipboard-check mr-2"></i>
                    Verification and Review
                </h6>

                <div class="row">
                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Verification Status</span>
                        <span class="detail-value">
                            @if (result.VerifiedDateTime.HasValue)
                            {
                                <span class="result-pill verified">Verified</span>
                            }
                            else
                            {
                                <span class="result-pill pending">Not verified</span>
                            }
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Verified Date and Time</span>
                        <span class="detail-value">
                            @(result.VerifiedDateTime.HasValue
                                ? result.VerifiedDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not verified")
                        </span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Test Status</span>
                        <span class="detail-value">@status</span>
                    </div>

                    <div class="col-md-6 detail-field">
                        <span class="detail-label">Review Required</span>
                        <span class="detail-value">
                            @if (needsReview)
                            {
                                <span class="result-pill review">
                                    Yes — Review required
                                </span>
                            }
                            else
                            {
                                <span class="result-pill normal">No</span>
                            }
                        </span>
                    </div>

                    <div class="col-12 detail-field">
                        <span class="detail-label">Review Notes</span>
                        <div class="detail-note">
                            @(string.IsNullOrWhiteSpace(result.ReviewNotes)
                                ? "No review notes recorded."
                                : result.ReviewNotes)
                        </div>
                    </div>
                </div>
            </div>

            <div class="detail-section">
                <h6 class="detail-section-title">
                    <i class="fas fa-boxes mr-2"></i>
                    Linked Consumables and Current Stock
                </h6>

                @if (consumables != null && consumables.Any())
                {
                    foreach (var item in consumables)
                    {
                        var consumable = item.Consumable!;

                        <div class="detail-consumable">
                            <div class="row align-items-center">
                                <div class="col-md-5">
                                    <span class="detail-label">Consumable</span>
                                    <span class="detail-value">@consumable.Name</span>
                                </div>

                                <div class="col-md-3">
                                    <span class="detail-label">Stock Remaining</span>
                                    <span class="detail-value">
                                        @consumable.QuantityOnHand units
                                    </span>
                                </div>

                                <div class="col-md-2">
                                    <span class="detail-label">Required</span>
                                    <span class="detail-value">
                                        @item.QuantityRequired
                                    </span>
                                </div>

                                <div class="col-md-2">
                                    <span class="detail-label">Stock Status</span>

                                    @if (consumable.QuantityOnHand <= 0)
                                    {
                                        <span class="result-pill abnormal">
                                            Out of stock
                                        </span>
                                    }
                                    else if (consumable.QuantityOnHand
                                             <= consumable.ReorderLevel)
                                    {
                                        <span class="result-pill review">
                                            Low stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-pill normal">
                                            In stock
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">
                        No active consumables are linked to this test type.
                    </p>
                }
            </div>
        </div>
    }
</div>

<!-- Single modal instance for all result details -->
<div class="modal fade"
     id="CaptureResultsDetailsModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="CaptureResultsDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
         role="document">

        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="CaptureResultsDetailsModalLabel">
                        <i class="fas fa-flask mr-2"></i>
                        Captured Test Result Details
                    </h5>
                    <small class="text-white-50">
                        Laboratory result, verification and stock information
                    </small>
                </div>

                <button type="button"
                        class="close js-close-result-modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body" id="captureResultsDetailsBody">
                <div class="text-center text-muted py-5">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <p class="mb-0">Select a result to view its details.</p>
                </div>
            </div>

            <div class="results-modal-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    <i class="fas fa-shield-alt mr-1"></i>
                    For authorised laboratory use
                </small>

                <button type="button"
                        class="btn btn-secondary js-close-result-modal">
                    <i class="fas fa-times mr-1"></i>
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap4.min.css" />

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = null;

            // ==========================================
            // INITIALISE DATATABLE
            // ==========================================
            if (!$.fn.DataTable.isDataTable('#resultsTable')) {
                table = $('#resultsTable').DataTable({
                    processing: false,
                    autoWidth: false,
                    responsive: false,
                    pageLength: 10,

                    lengthMenu: [
                        [10, 25, 50, 100, -1],
                        [10, 25, 50, 100, "All"]
                    ],

                    paging: true,
                    pagingType: "full_numbers",
                    scrollX: true,
                    order: [[1, "desc"]],

                    columnDefs: [{
                        targets: 10,
                        orderable: false,
                        searchable: false
                    }],

                    dom:
                        "<'row align-items-center mb-3'" +
                        "<'col-lg-4 col-md-5'l>" +
                        "<'col-lg-8 col-md-7 text-md-right'B>" +
                        ">" +
                        "<'row'<'col-sm-12'tr>>" +
                        "<'row align-items-center mt-3'" +
                        "<'col-md-5'i>" +
                        "<'col-md-7'p>" +
                        ">",

                    buttons: [
                        {
                            extend: "copyHtml5",
                            text: '<i class="fas fa-copy mr-1"></i> Copy',
                            className: "btn btn-outline-secondary btn-sm",
                            title: "NMB-HLabSys - Laboratory Test Results",
                            exportOptions: {
                                columns: ':not(:last-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        return $(node).text()
                                            .replace(/\s+/g, ' ')
                                            .trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: "excelHtml5",
                            text: '<i class="fas fa-file-excel mr-1"></i> Excel',
                            className: "btn btn-success btn-sm",
                            title: "NMB-HLabSys - Laboratory Test Results",
                            filename: "NMB_HLabSys_Test_Results",
                            sheetName: "Test Results",
                            exportOptions: {
                                columns: ':not(:last-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        return $(node).text()
                                            .replace(/\s+/g, ' ')
                                            .trim();
                                    }
                                }
                            }
                        },
                        {
                            extend: "pdfHtml5",
                            text: '<i class="fas fa-file-pdf mr-1"></i> PDF',
                            className: "btn btn-danger btn-sm",
                            title: "NMB-HLabSys - Laboratory Test Results",
                            filename: "NMB_HLabSys_Test_Results",
                            orientation: "landscape",
                            pageSize: "A3",
                            exportOptions: {
                                columns: ':not(:last-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        return $(node).text()
                                            .replace(/\s+/g, ' ')
                                            .trim();
                                    }
                                }
                            },
                            customize: function (doc) {
                                doc.pageMargins = [20, 45, 20, 40];
                                doc.defaultStyle.fontSize = 7;
                                doc.styles.tableHeader.fontSize = 7;
                                doc.styles.tableHeader.bold = true;
                                doc.styles.title.fontSize = 16;
                                doc.styles.title.alignment = 'center';

                                doc.content.splice(1, 0, {
                                    text: 'Laboratory Test Results Report',
                                    alignment: 'center',
                                    fontSize: 10,
                                    margin: [0, 0, 0, 5]
                                }, {
                                    text: 'Generated: ' + new Date().toLocaleString(),
                                    alignment: 'center',
                                    fontSize: 8,
                                    margin: [0, 0, 0, 12]
                                });

                                var reportTable = doc.content.find(function (item) {
                                    return item.table;
                                });

                                if (reportTable) {
                                    reportTable.layout = 'lightHorizontalLines';

                                    var columnCount =
                                        reportTable.table.body[0].length;

                                    reportTable.table.widths =
                                        Array(columnCount).fill('*');
                                }

                                doc.footer = function (page, pages) {
                                    return {
                                        columns: [
                                            {
                                                text: 'NMB-HLabSys | Laboratory Test Results',
                                                alignment: 'left',
                                                margin: [20, 0, 0, 0]
                                            },
                                            {
                                                text: 'Page ' + page + ' of ' + pages,
                                                alignment: 'right',
                                                margin: [0, 0, 20, 0]
                                            }
                                        ],
                                        fontSize: 7,
                                        color: '#64748b'
                                    };
                                };
                            }
                        },
                        {
                            extend: "print",
                            text: '<i class="fas fa-print mr-1"></i> Print',
                            className: "btn btn-primary btn-sm",
                            title: "NMB-HLabSys - Laboratory Test Results",
                            messageTop:
                                "Laboratory Test Results Report — Generated: " +
                                new Date().toLocaleString(),
                            exportOptions: {
                                columns: ':not(:last-child)',
                                format: {
                                    body: function (data, row, column, node) {
                                        return $(node).text()
                                            .replace(/\s+/g, ' ')
                                            .trim();
                                    }
                                }
                            },
                            customize: function (win) {
                                $(win.document.body).css('font-size', '9pt');

                                $(win.document.body).find('h1')
                                    .css('text-align', 'center')
                                    .css('font-size', '16pt');

                                $(win.document.body).find('table')
                                    .addClass('compact')
                                    .css('font-size', '8pt')
                                    .css('width', '100%');

                                $(win.document.body).find('th')
                                    .css('background-color', '#e2e8f0')
                                    .css('color', '#0f172a');
                            }
                        }
                    ],

                    language: {
                        emptyTable: "No captured results found.",
                        zeroRecords: "No matching results found.",
                        info: "Showing _START_ to _END_ of _TOTAL_ results",
                        infoEmpty: "Showing 0 results",
                        infoFiltered: "(filtered from _MAX_ total results)",
                        lengthMenu: "Show _MENU_ results",
                        paginate: {
                            first: "First",
                            last: "Last",
                            next: "Next",
                            previous: "Previous"
                        }
                    },

                    drawCallback: function () {
                        updateResultsCount(this.api());
                    }
                });
            } else {
                table = $('#resultsTable').DataTable();
            }

            // ==========================================
            // SEARCH
            // ==========================================
            $('#resultsSearch')
                .off('input.resultsSearch')
                .on('input.resultsSearch', function () {
                    table.search(this.value).draw();
                });

            // ==========================================
            // UPDATE RESULTS COUNT
            // ==========================================
            function updateResultsCount(dataTable) {
                var info = dataTable.page.info();

                $('#resultsCount').text(
                    'Showing ' + info.recordsDisplay +
                    ' matching result(s) out of ' +
                    info.recordsTotal + ' total result(s).'
                );
            }

            updateResultsCount(table);

            // ==========================================
            // OPEN RESULT DETAILS
            // ==========================================
            $(document)
                .off('click.viewResult', '.js-view-result')
                .on('click.viewResult', '.js-view-result', function (event) {
                    event.preventDefault();

                    var resultId = $(this).attr('data-result-id');
                    var template =
                        $('#resultDetailsTemplate-' + resultId);

                    var $modal =
                        $('#CaptureResultsDetailsModal');

                    var $body =
                        $('#captureResultsDetailsBody');

                    if (!$modal.length || !$body.length) {
                        console.error(
                            'The result details modal or its body was not found.'
                        );
                        return;
                    }

                    if (template.length) {
                        $body.html(template.html());
                    } else {
                        $body.html(
                            '<div class="alert alert-warning mb-0">' +
                            'The details for this result could not be found.' +
                            '</div>'
                        );

                        console.error(
                            'Details template not found for result ID:',
                            resultId
                        );
                    }

                    if (typeof $.fn.modal !== 'function') {
                        console.error(
                            'Bootstrap jQuery modal plugin is unavailable. ' +
                            'Check the Bootstrap version in _TechnicianLayout.'
                        );
                        return;
                    }

                    $modal.modal('show');
                });

            // ==========================================
            // CLOSE MODAL
            // Explicit handler for both close buttons.
            // ==========================================
            $(document)
                .off('click.closeResultModal', '.js-close-result-modal')
                .on('click.closeResultModal', '.js-close-result-modal', function (event) {
                    event.preventDefault();

                    var $modal = $('#CaptureResultsDetailsModal');

                    if (!$modal.length) {
                        console.error(
                            'CaptureResultsDetailsModal was not found.'
                        );
                        return;
                    }

                    if (typeof $.fn.modal === 'function') {
                        $modal.modal('hide');
                    } else {
                        console.error(
                            'Bootstrap modal plugin is unavailable; ' +
                            'the modal cannot be closed through jQuery.'
                        );
                    }
                });

            // ==========================================
            // RESET CONTENT AFTER MODAL CLOSES
            // ==========================================
            $('#CaptureResultsDetailsModal')
                .off('hidden.bs.modal.resetResultDetails')
                .on('hidden.bs.modal.resetResultDetails', function () {
                    $('#captureResultsDetailsBody').html(
                        '<div class="text-center text-muted py-5">' +
                        '<i class="fas fa-info-circle fa-2x mb-3"></i>' +
                        '<p class="mb-0">' +
                        'Select a result to view its details.' +
                        '</p>' +
                        '</div>'
                    );
                });
        });
    </script>
}
