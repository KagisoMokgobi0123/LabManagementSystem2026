@model IEnumerable<NMB_HLabSys.Areas.Technician.Models.TestResultModel>

@{
    ViewData["Title"] = "Test Results";
    Layout = "_TechnicianLayout";

    var results = Model?.ToList()
        ?? new List<NMB_HLabSys.Areas.Technician.Models.TestResultModel>();

    // Populate these dictionaries in TestsController.Results().
    var remainingByResultId = ViewData["ConsumableRemainingByResultId"]
        as IDictionary<int, string> ?? new Dictionary<int, string>();
    var deletedResultIds = ViewData["DeletedResultIds"]
        as IEnumerable<int> ?? Enumerable.Empty<int>();
    var deletedIds = deletedResultIds.ToHashSet();

    var totalResults = results.Count;

    var verifiedResults = results.Count(r =>
        r.VerifiedDateTime.HasValue && !deletedIds.Contains(r.TestResultId));

    var abnormalResults = results.Count(r => r.IsAbnormal && !deletedIds.Contains(r.TestResultId));

    var reviewResults = results.Count(r => !deletedIds.Contains(r.TestResultId) && (
        r.RequiresReview ||
        string.Equals(
            r.TestRequestTestType?.Status,
            "To Be Reviewed",
            StringComparison.OrdinalIgnoreCase)));
}

<style>
    .results-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 45px;
    }

    .results-hero {
        padding: 35px 0 78px;
        background: linear-gradient(135deg, #073b5c, #075985, #0284c7);
        color: #fff;
    }

        .results-hero h1 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .results-hero p {
            color: rgba(255,255,255,.82);
            font-size: 13px;
            margin: 0;
        }

    .results-content {
        position: relative;
        margin-top: -45px;
    }

    /* Match the My Tests summary-card design and icon badges. */
    .results-summary {
        background: #fff;
        border-radius: 13px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .results-summary .label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }
    .results-summary .number {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .results-summary .symbol {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0f2fe;
        color: #0284c7;
        font-size: 19px;
    }
    .results-summary .symbol.green { background: #dcfce7; color: #15803d; }
    .results-summary .symbol.red { background: #fee2e2; color: #b91c1c; }
    .results-summary .symbol.orange { background: #ffedd5; color: #c2410c; }
    a.results-summary-link,
    a.results-summary-link:link,
    a.results-summary-link:visited,
    a.results-summary-link:hover,
    a.results-summary-link:focus {
        color: inherit !important;
        text-decoration: none !important;
        cursor: pointer;
    }
    a.results-summary-link { transition: transform .2s ease, box-shadow .2s ease; }
    a.results-summary-link:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(2,132,199,.18);
    }
    a.results-summary-link:focus-visible {
        outline: 3px solid #0284c7;
        outline-offset: 3px;
    }
    a.results-summary-link.is-active {
        box-shadow: 0 0 0 2px #0284c7, 0 4px 18px rgba(15,23,42,.07);
    }
    a.results-summary-link * { text-decoration: none !important; }

    .results-card {
        margin-top: 24px;
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
        overflow: hidden;
    }

    .results-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #eef2f7;
    }

    .results-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .results-card-subtitle {
        font-size: 11px;
        color: #94a3b8;
        margin: 5px 0 0;
    }

    .results-search {
        height: 38px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
    }

    .results-table {
        margin: 0;
    }

        .results-table thead th {
            background: #f8fafc;
            border-top: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 13px;
            color: #64748b;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .4px;
            white-space: nowrap;
        }

        .results-table tbody td {
            padding: 14px 13px;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: #334155;
            font-size: 12px;
        }

        .results-table tbody tr:hover {
            background: #f8fcff;
        }

    .result-main {
        display: block;
        color: #075985;
        font-weight: 700;
    }

    .result-sub {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-top: 4px;
    }

    .result-pill {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .result-pill.normal {
            background: #dcfce7;
            color: #166534;
        }

        .result-pill.abnormal {
            background: #fee2e2;
            color: #991b1b;
        }

        .result-pill.review {
            background: #fef3c7;
            color: #92400e;
        }

        .result-pill.verified {
            background: #dcfce7;
            color: #166534;
        }

        .result-pill.deleted {
            background: #fee2e2;
            color: #991b1b;
        }

        .result-pill.active {
            background: #e0f2fe;
            color: #075985;
        }

    .result-row-deleted {
        opacity: .72;
        background: #fff8f8;
    }

    .result-pill.pending {
        background: #e0f2fe;
        color: #0369a1;
    }

    .consumable-stock {
        display: block;
        color: #334155;
        font-weight: 700;
    }

    .consumable-unavailable {
        display: inline-block;
        background: #f1f5f9;
        color: #64748b;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: 10px;
        white-space: nowrap;
    }

    .result-action {
        gap: 6px;
        width: auto;
        min-width: 82px;
        padding: 0 11px;
        border: 0;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 35px;
        border-radius: 8px;
        background: #e0f2fe;
        color: #0369a1;
        text-decoration: none;
    }

    .result-action-delete {
        background: #fee2e2;
        color: #991b1b;
    }

    .result-action-complete {
        background: #dcfce7;
        color: #166534;
    }

    .result-action-delete:hover {
        background: #b91c1c;
        color: white;
    }

    .result-action-complete:hover {
        background: #15803d;
        color: white;
    }

    .result-actions {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 6px;
        width: max-content;
    }

        .result-actions > form {
            flex: 0 0 auto;
            margin: 0;
        }

        .result-actions .result-action {
            flex: 0 0 auto;
        }

    .results-table th:last-child,
    .results-table td:last-child {
        min-width: 375px;
        white-space: nowrap;
    }

    .result-action:hover {
        background: #0284c7;
        color: #fff;
        text-decoration: none;
    }

    .result-action-delete:hover {
        background: #b91c1c;
        color: #fff;
    }

    .result-action-complete:hover {
        background: #15803d;
        color: #fff;
    }

    .results-empty {
        text-align: center;
        padding: 55px 20px;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        .results-hero h1 {
            font-size: 24px;
        }
    }
</style>

<div class="results-page">
    <section class="results-hero">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1>
                        <i class="fas fa-flask mr-2"></i>
                        Test Results
                    </h1>
                    <p>
                        Review captured laboratory measurements,
                        patient information, flags and consumable stock.
                    </p>
                </div>

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="MyTests"
                   class="btn btn-light btn-sm mt-3">
                    <i class="fas fa-arrow-left mr-1"></i>
                    My Assigned Tests
                </a>
            </div>
        </div>
    </section>

    <div class="container-fluid results-content">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row">
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "all" })"
                   data-result-filter="all"
                   aria-label="Filter laboratory results: Total Results">
                    <div>
                        <div class="label">Total Results</div>
                        <h2 class="number">@totalResults</h2>
                    </div>
                    <div class="symbol" aria-hidden="true">
                        <i class="fas fa-flask"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "verified" })"
                   data-result-filter="verified"
                   aria-label="Filter laboratory results: Verified Results">
                    <div>
                        <div class="label">Verified Results</div>
                        <h2 class="number">@verifiedResults</h2>
                    </div>
                    <div class="symbol green" aria-hidden="true">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "abnormal" })"
                   data-result-filter="abnormal"
                   aria-label="Filter laboratory results: Abnormal Results">
                    <div>
                        <div class="label">Abnormal Results</div>
                        <h2 class="number">@abnormalResults</h2>
                    </div>
                    <div class="symbol red" aria-hidden="true">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "review" })"
                   data-result-filter="review"
                   aria-label="Filter laboratory results: Require Review">
                    <div>
                        <div class="label">Require Review</div>
                        <h2 class="number">@reviewResults</h2>
                    </div>
                    <div class="symbol orange" aria-hidden="true">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                </a>
            </div>
        </div>

        <div class="results-card">
            <div class="results-card-header">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <h4 class="results-card-title">
                            <i class="fas fa-table text-primary mr-2"></i>
                            Laboratory Results Register
                        </h4>
                        <p class="results-card-subtitle">
                            Search by result, test, patient, flag or status.
                            Consumable balances and soft-deleted records are shown when supplied by the controller.
                        </p>
                    </div>

                    <div class="col-lg-5 mt-3 mt-lg-0">
                        <input id="resultsSearch"
                               type="search"
                               class="form-control results-search"
                               placeholder="Search laboratory results..."
                               aria-label="Search laboratory results" />
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table results-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th>Result ID</th>
                            <th>Test</th>
                            <th>Patient</th>
                            <th>Result Name</th>
                            <th>Result Value</th>
                            <th>Reference Range</th>
                            <th>Flag</th>
                            <th>Consumable Remaining</th>
                            <th>Test Status</th>
                            <th>Record Status</th>
                            <th>Captured</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var result in results)
                        {
                            var test = result.TestRequestTestType;
                            var testType = test?.TestType;
                            var patient = test?.TestRequest?.Patient;
                            var status = test?.Status ?? "Unknown";
                            var isDeleted = deletedIds.Contains(result.TestResultId);
                            var canModifyResult = !isDeleted
                                && !result.VerifiedDateTime.HasValue
                                && string.IsNullOrWhiteSpace(result.VerifiedByTechnicianId)
                                && (string.Equals(status, "In Progress", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(status, "To Be Reviewed", StringComparison.OrdinalIgnoreCase));
                            var hasStock = remainingByResultId.TryGetValue(result.TestResultId, out var stockText);

                            <tr class="@(isDeleted ? "result-row-deleted" : "")"
                                data-result-verified="@(result.VerifiedDateTime.HasValue && !isDeleted ? "true" : "false")"
                                data-result-abnormal="@(result.IsAbnormal && !isDeleted ? "true" : "false")"
                                data-result-review="@((result.RequiresReview || string.Equals(status, "To Be Reviewed", StringComparison.OrdinalIgnoreCase)) && !isDeleted ? "true" : "false")">
                                <td>
                                    <span class="result-main">
                                        #@result.TestResultId
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(testType?.Name ?? "Unknown test")
                                    </span>
                                    <span class="result-sub">
                                        Test assignment #@(test?.TestRequestTestTypeId)
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(patient?.FullName ?? "Patient unavailable")
                                    </span>
                                </td>

                                <td>@result.ResultName</td>

                                <td>
                                    <span class="result-main">
                                        @result.ResultValue
                                    </span>
                                    <span class="result-sub">
                                        @(result.MeasurementUnit ?? "Unit not recorded")
                                    </span>
                                </td>

                                <td>
                                    @if (result.ReferenceMin.HasValue ||
                                         result.ReferenceMax.HasValue)
                                    {
                                        <span>
                                            @(result.ReferenceMin?.ToString("0.##") ?? "—")
                                            to
                                            @(result.ReferenceMax?.ToString("0.##") ?? "—")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </td>

                                <td>
                                    @if (result.IsAbnormal)
                                    {
                                        <span class="result-pill abnormal">
                                            ABNORMAL
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-pill normal">
                                            NORMAL
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (hasStock)
                                    {
                                        <span class="consumable-stock">@stockText</span>
                                    }
                                    else
                                    {
                                        <span class="consumable-unavailable"
                                              title="No consumable balance was supplied for this result.">
                                            Not available
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (result.RequiresReview ||
                                         string.Equals(
                                             status,
                                             "To Be Reviewed",
                                             StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="result-pill review">
                                            Requires Review
                                        </span>
                                    }
                                    else if (result.VerifiedDateTime.HasValue)
                                    {
                                        <span class="result-pill verified">
                                            Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-pill pending">
                                            @status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="result-pill @(isDeleted ? "deleted" : "active")">
                                        @(isDeleted ? "Soft Deleted" : "Active")
                                    </span>
                                </td>

                                <td>
                                    @result.CapturedDateTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                               
                                <td>
                                    <div class="result-actions">
                                        <button type="button"
                                                class="result-action js-result-modal"
                                                data-url="@Url.Action("ResultDetails", "Tests", new { area = "Technician", id = result.TestResultId })"
                                                data-result-id="@result.TestResultId"
                                                data-modal-title="View Result"
                                                title="View result" aria-label="View result">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </button>

                                        @if (canModifyResult)
                                        {
                                            <button type="button"
                                                    class="result-action js-result-modal"
                                                    data-url="@Url.Action("EditResult", "Tests", new { area = "Technician", id = result.TestResultId })"
                                                    data-result-id="@result.TestResultId"
                                                    data-modal-title="Edit Result"
                                                    title="Edit result" aria-label="Edit result">
                                                <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                            </button>

                                            <form asp-area="Technician" asp-controller="Tests"
                                                  asp-action="DeleteResult" asp-route-id="@result.TestResultId"
                                                  method="post" class="d-inline"
                                                  onsubmit="return confirm('Soft delete this result? The audit history must be retained.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="result-action result-action-delete"
                                                        title="Soft delete result" aria-label="Delete result">
                                                    <i class="fas fa-trash-alt" aria-hidden="true"></i> Delete
                                                </button>
                                            </form>

                                         
                                            @* The href is the POST destination; JS opens confirmation modal. *@
                                            @if (test != null)
                                            {
                                                <a href="@Url.Action("CompleteTest", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })"
                                                   class="result-action result-action-complete js-complete-test"
                                                   data-clinical-url="@Url.Action("CompleteTestClinicalContext", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })"
                                                   data-patient="@(patient?.FullName ?? "Patient unavailable")"
                                                   data-test="@(testType?.Name ?? "Unknown test")"
                                                   data-result-name="@result.ResultName"
                                                   data-result="@result.ResultValue"
                                                   data-unit="@result.MeasurementUnit"
                                                   data-range="@(result.ReferenceMin?.ToString("0.##") ?? "—") to @(result.ReferenceMax?.ToString("0.##") ?? "—")"
                                                   data-flag="@(result.IsAbnormal ? "ABNORMAL" : "NORMAL")"
                                                   data-status="@status"
                                                   data-assignment-id="@test.TestRequestTestTypeId"
                                                   title="Review and complete this test"
                                                   aria-label="Complete test @test.TestRequestTestTypeId">
                                                    <i class="fas fa-check-circle" aria-hidden="true"></i> Complete
                                                </a>
                                            }

                                        }
                                    </div>
                                </td>

                            </tr>
                        }

                        @if (!results.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="12" class="results-empty">
                                    <i class="fas fa-flask fa-2x mb-3"></i>
                                    <h5>No captured results found</h5>
                                    <p>
                                        Results you capture will appear in this table.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-3 py-3 text-muted small"
                 id="resultsCount"
                 aria-live="polite">
                Showing @totalResults result(s).
            </div>
        </div>
    </div>
</div>

@* AJAX modal shell: partial views are loaded into .modal-content, matching Receive Samples. *@
<div class="modal fade" id="testResultModal" tabindex="-1" role="dialog"
     aria-label="Test result information" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" id="testResultModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <p class="mt-3 text-muted mb-0">Loading test result information...</p>
            </div>
        </div>
    </div>
</div>

@* Modal is outside the table and rendered only once. *@
@await Html.PartialAsync("_CompleteTestModal")

@section Scripts {
    <script>
        $(function() {
            // Complete link: show a confirmation modal, never submit on first click.
            $(document).on('click', '.js-complete-test', function(event) {
                event.preventDefault();
                const $link = $(this);
                const url = $link.attr('href');
                if (!url || url === '#') {
                    alert('The completion endpoint is unavailable.');
                    return;
                }
                const fields = {
                    '#completePatient': 'patient',
                    '#completeTestName': 'test',
                    '#completeResultName': 'result-name',
                    '#completeResult': 'result',
                    '#completeUnit': 'unit',
                    '#completeRange': 'range',
                    '#completeFlag': 'flag',
                    '#completeStatus': 'status',
                    '#completeAssignmentId': 'assignment-id'
                };
                Object.keys(fields).forEach(function(selector) {
                    $(selector).text($link.attr('data-' + fields[selector]) || '—');
                });
                // Load clinical history from the server, not from untrusted table attributes.
                const clinicalUrl = $link.attr('data-clinical-url');
                const clinicalSelectors = ['#completeConditions', '#completeAllergies', '#completeMedications', '#completeClinicalNotes'];
                clinicalSelectors.forEach(s => $(s).text('—'));
                $('#completeClinicalLoading').removeClass('d-none');
                $('#completeClinicalError').addClass('d-none').text('');
                $('#completeSubmitButton').prop('disabled', true);
                if (!clinicalUrl) {
                    $('#completeClinicalLoading').addClass('d-none');
                    $('#completeClinicalError').removeClass('d-none').text('Clinical information endpoint is missing.');
                } else {
                    $.getJSON(clinicalUrl)
                        .done(function(data) {
                            // Avoid showing stale clinical details if another test was selected.
                            if ($('#completeTestForm').attr('action') !== url) return;
                            $('#completeConditions').text(data.medicalConditions || 'Not recorded');
                            $('#completeAllergies').text(data.allergies || 'Not recorded');
                            $('#completeMedications').text(data.medications || 'Not recorded');
                            $('#completeClinicalNotes').text(data.clinicalNotes || 'Not recorded');
                            $('#completeSubmitButton').prop('disabled', false);
                        })
                        .fail(function() {
                            if ($('#completeTestForm').attr('action') !== url) return;
                            $('#completeClinicalError').removeClass('d-none')
                                .text('Unable to load clinical information. Submission is disabled until this is resolved.');
                        })
                        .always(function() { $('#completeClinicalLoading').addClass('d-none'); });
                }
                $('#completeTestForm').attr('action', url);
                const modalElement = document.getElementById('completeTestModal');
                if (!modalElement) {
                    alert('Complete Test modal was not rendered. Check _CompleteTestModal.cshtml.');
                    return;
                }
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
                } else if ($.fn.modal) {
                    $('#completeTestModal').modal('show');
                } else {
                    alert('Bootstrap modal JavaScript is missing. Check _TechnicianLayout.cshtml.');
                }
            });

            $('#completeTestForm').on('submit', function() {
                if (!this.action) return false;
                $('#completeSubmitButton').prop('disabled', true);
            });
            $('#completeTestModal').on('hidden.bs.modal', function() {
                $('#completeTestForm').removeAttr('action');
                $('#completeSubmitButton').prop('disabled', false);
            });

            const $modal = $('#testResultModal');
            const $content = $('#testResultModalContent');
            let activeRequest = null;
            let requestSequence = 0;

            function showLoading(title) {
                $content.html(`
                            <div class="modal-body text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <h6 class="mt-3 mb-1">Loading...</h6>
                                <p class="text-muted mb-0"></p>
                            </div>`);
                $content.find('.text-muted').text(title || 'Loading test result information...');
            }

            $(document).on('click', '.js-result-modal', function(event) {
                event.preventDefault();
                const $button = $(this);
                const url = $button.attr('data-url');
                const title = $button.attr('data-modal-title') || 'Test result';

                if (!url) return;
                if (activeRequest) activeRequest.abort();
                const sequence = ++requestSequence;
                $button.prop('disabled', true);
                showLoading(title);
                $modal.modal('show');

                activeRequest = $.ajax({ url: url, method: 'GET', cache: false })
                    .done(function(html) {
                        if (sequence !== requestSequence) return;
                        // The existing _ViewResultsModal / _EditResultsModal partial
                        // should render .modal-header, .modal-body and (if needed) .modal-footer.
                        $content.html(html);
                    })
                    .fail(function(xhr, status) {
                        if (sequence !== requestSequence || status === 'abort') return;
                        let message = 'Unable to load this result. Please try again.';
                        if (xhr.status === 401) message = 'Your session has expired. Please sign in again.';
                        else if (xhr.status === 403) message = 'You are not authorised to view this result.';
                        else if (xhr.status === 404) message = 'Result endpoint or record not found. URL: ' + url;
                        else if (xhr.status === 409) message = xhr.responseText || 'This result cannot be edited in its current state.';
                        else if (xhr.status === 0) message = 'Unable to reach the server. Check your connection.';
                        $content.html('<div class="modal-body"><div class="alert alert-danger mb-3" role="alert"></div>' +
                            '<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button></div>');
                        $content.find('.alert').text(message);
                    })
                    .always(function() {
                        $button.prop('disabled', false);
                        if (sequence === requestSequence) activeRequest = null;
                    });
            });

            $modal.on('hidden.bs.modal', function() {
                ++requestSequence;
                if (activeRequest) activeRequest.abort();
                activeRequest = null;
                showLoading('Loading test result information...');
            });

            // The existing EditResult POST returns a redirect to TestResults.
            // Use normal form submission so anti-forgery, TempData and redirects work.
            $(document).on('submit', '#editTestResultForm', function(event) {
                if (!this.checkValidity()) return;
                const $button = $(this).find('#saveResultChanges');
                if ($button.prop('disabled')) { event.preventDefault(); return; }
                $button.prop('disabled', true);
                $button.find('.save-result-normal').addClass('d-none');
                $button.find('.save-result-loading').removeClass('d-none');
            });

            // Summary cards filter this register without requiring new controller actions.
            // Query-string URLs also work when the page is opened in a new tab.
            const $rows = $('#resultsTable tbody tr').not('.empty-row');
            const allowedFilters = ['all', 'verified', 'abnormal', 'review'];
            const queryParams = new URLSearchParams(window.location.search);
            let activeFilter = queryParams.get('resultFilter') || 'all';
            if (!allowedFilters.includes(activeFilter)) activeFilter = 'all';

            function applyResultFilters() {
                const query = ($('#resultsSearch').val() || '').trim().toLowerCase();
                let visible = 0;
                $rows.each(function() {
                    const matchesStatus = activeFilter === 'all' ||
                        this.getAttribute('data-result-' + activeFilter) === 'true';
                    const matchesSearch = $(this).text().toLowerCase().includes(query);
                    const show = matchesStatus && matchesSearch;
                    $(this).toggle(show);
                    if (show) visible++;
                });
                $('.results-summary-link').each(function() {
                    const selected = this.getAttribute('data-result-filter') === activeFilter;
                    $(this).toggleClass('is-active', selected)
                           .attr('aria-current', selected ? 'true' : null);
                });
                $('#resultsCount').text('Showing ' + visible + ' matching result(s).');
            }

            $(document).on('click', '.results-summary-link', function(event) {
                // Allow Ctrl+click, middle-click, etc. to use the real MVC URL.
                if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.which !== 1) return;
                event.preventDefault();
                activeFilter = this.getAttribute('data-result-filter') || 'all';
                const url = new URL(this.href, window.location.href);
                window.history.pushState({ resultFilter: activeFilter }, '', url);
                applyResultFilters();
                document.getElementById('resultsTable').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            $(window).on('popstate', function() {
                const params = new URLSearchParams(window.location.search);
                activeFilter = params.get('resultFilter') || 'all';
                if (!allowedFilters.includes(activeFilter)) activeFilter = 'all';
                applyResultFilters();
            });
            $('#resultsSearch').on('input', applyResultFilters);
            applyResultFilters();
        });
    </script>
}
