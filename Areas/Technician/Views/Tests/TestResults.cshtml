@model IEnumerable<NMB_HLabSys.Areas.Technician.Models.TestResultModel>

@{
    ViewData["Title"] = "Test Results";
    Layout = "_TechnicianLayout";

    // This register displays captured quantitative measurements only.
    // Qualitative descriptions and placeholders are excluded from the table and totals.
    var results = (Model ?? Enumerable.Empty<NMB_HLabSys.Areas.Technician.Models.TestResultModel>())
        .Where(r => !string.IsNullOrWhiteSpace(r.ResultValue) &&
            (decimal.TryParse(r.ResultValue.Trim(),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out _) ||
             decimal.TryParse(r.ResultValue.Trim(),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.CurrentCulture, out _)))
        .ToList();

    // Populate these dictionaries in TestsController.Results().
    var remainingByResultId = ViewData["ConsumableRemainingByResultId"]
        as IDictionary<int, string> ?? new Dictionary<int, string>();
    var deletedResultIds = ViewData["DeletedResultIds"]
        as IEnumerable<int> ?? Enumerable.Empty<int>();
    var deletedIds = deletedResultIds.ToHashSet();

    var techniciansByRequestId = ViewData["TechniciansByRequestId"]
        as IDictionary<int, string> ?? new Dictionary<int, string>();

    var totalResults = results.Count;

    var verifiedResults = results.Count(r =>
        r.VerifiedDateTime.HasValue && !deletedIds.Contains(r.TestResultId));

    var abnormalResults = results.Count(r => !deletedIds.Contains(r.TestResultId) &&
        (r.IsAbnormal || string.Equals(r.ResultFlag, "Abnormal", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(r.ResultFlag, "High", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(r.ResultFlag, "Low", StringComparison.OrdinalIgnoreCase)));

    var reviewResults = results.Count(r => !deletedIds.Contains(r.TestResultId) && (
        r.RequiresReview ||
        string.Equals(
            r.TestRequestTestType?.Status,
            "To Be Reviewed",
            StringComparison.OrdinalIgnoreCase)));
}

<style>
    .results-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 45px;
    }

    .results-hero {
        padding: 35px 0 78px;
        background: linear-gradient(135deg, #073b5c, #075985, #0284c7);
        color: #fff;
    }

        .results-hero h1 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .results-hero p {
            color: rgba(255,255,255,.82);
            font-size: 13px;
            margin: 0;
        }

    .results-content {
        position: relative;
        margin-top: -45px;
    }

    /* Match the My Tests summary-card design and icon badges. */
    .results-summary {
        background: #fff;
        border-radius: 13px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .results-summary .label {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }
    .results-summary .number {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .results-summary .symbol {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0f2fe;
        color: #0284c7;
        font-size: 19px;
    }
    .results-summary .symbol.green { background: #dcfce7; color: #15803d; }
    .results-summary .symbol.red { background: #fee2e2; color: #b91c1c; }
    .results-summary .symbol.orange { background: #ffedd5; color: #c2410c; }
    a.results-summary-link,
    a.results-summary-link:link,
    a.results-summary-link:visited,
    a.results-summary-link:hover,
    a.results-summary-link:focus {
        color: inherit !important;
        text-decoration: none !important;
        cursor: pointer;
    }
    a.results-summary-link { transition: transform .2s ease, box-shadow .2s ease; }
    a.results-summary-link:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(2,132,199,.18);
    }
    a.results-summary-link:focus-visible {
        outline: 3px solid #0284c7;
        outline-offset: 3px;
    }
    a.results-summary-link.is-active {
        box-shadow: 0 0 0 2px #0284c7, 0 4px 18px rgba(15,23,42,.07);
    }
    a.results-summary-link * { text-decoration: none !important; }

    .results-card {
        margin-top: 24px;
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
        overflow: hidden;
    }

    .results-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #eef2f7;
    }

    .results-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .results-card-subtitle {
        font-size: 11px;
        color: #94a3b8;
        margin: 5px 0 0;
    }

    .results-search {
        height: 38px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
    }

    .results-scroll-top { overflow-x: auto; overflow-y: hidden; height: 18px; margin: 0 16px; scrollbar-width: auto; }
    .results-scroll-top-inner { height: 1px; }
    .results-scroll-bottom { overflow-x: auto; overflow-y: auto; width: 100%; }
    .results-table { min-width: 1700px;
        margin: 0;
    }

        .results-table thead th {
            background: #f8fafc;
            border-top: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 13px;
            color: #64748b;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .4px;
            white-space: nowrap;
        }

        .results-table tbody td {
            padding: 14px 13px;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: #334155;
            font-size: 12px;
        }

        .results-table tbody tr:hover {
            background: #f8fcff;
        }

    .result-main {
        display: block;
        color: #075985;
        font-weight: 700;
    }

    .result-sub {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-top: 4px;
    }

    .result-pill {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .result-pill.normal {
            background: #dcfce7;
            color: #166534;
        }

        .result-pill.abnormal {
            background: #fee2e2;
            color: #991b1b;
        }

        .result-pill.review {
            background: #fef3c7;
            color: #92400e;
        }

        .result-pill.verified {
            background: #dcfce7;
            color: #166534;
        }

        .result-pill.deleted {
            background: #fee2e2;
            color: #991b1b;
        }

        .result-pill.active {
            background: #e0f2fe;
            color: #075985;
        }

    .result-row-deleted {
        opacity: .72;
        background: #fff8f8;
    }

    .result-pill.pending {
        background: #e0f2fe;
        color: #0369a1;
    }

    .consumable-pill-group { display:flex; flex-wrap:wrap; gap:6px; min-width:190px; }
    .consumable-pill { display:inline-flex; align-items:center; padding:6px 11px; border-radius:50rem; font-size:11px; font-weight:700; line-height:1.45; white-space:normal; border:1px solid transparent; }
    .consumable-pill.c-blue { background:#dbeafe; color:#1d4ed8; border-color:#bfdbfe; }
    .consumable-pill.c-green { background:#dcfce7; color:#166534; border-color:#bbf7d0; }
    .consumable-pill.c-orange { background:#ffedd5; color:#9a3412; border-color:#fed7aa; }
    .consumable-pill.c-purple { background:#f3e8ff; color:#6b21a8; border-color:#e9d5ff; }
    .consumable-pill.c-teal { background:#ccfbf1; color:#115e59; border-color:#99f6e4; }
    .consumable-pill.c-pink { background:#fce7f3; color:#9d174d; border-color:#fbcfe8; }
    .consumable-stock {
        display: block;
        color: #334155;
        font-weight: 700;
    }

    .consumable-unavailable {
        display: inline-block;
        background: #f1f5f9;
        color: #64748b;
        padding: 5px 8px;
        border-radius: 7px;
        font-size: 10px;
        white-space: nowrap;
    }

    .result-action { cursor: pointer; position: relative; z-index: 2;
        gap: 6px;
        width: auto;
        min-width: 82px;
        padding: 0 11px;
        border: 0;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 35px;
        border-radius: 8px;
        background: #e0f2fe;
        color: #0369a1;
        text-decoration: none;
    }

    .result-action-edit { background: #fff3df; color: #a95400; }
    .result-action-edit:hover { background: #d97706; color: #fff; }

    .result-action-delete {
        background: #fee2e2;
        color: #991b1b;
    }

    .result-action-complete {
        background: #dcfce7;
        color: #166534;
    }

    .result-action-delete:hover {
        background: #b91c1c;
        color: white;
    }

    .result-action-complete:hover {
        background: #15803d;
        color: white;
    }

    .result-actions { position: relative; z-index: 1;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 12px;
        width: max-content;
    }

        .result-actions > form {
            flex: 0 0 auto;
            margin: 0;
        }

        .result-actions .result-action {
            flex: 0 0 auto;
        }

    .results-table th:last-child,
    .results-table td:last-child {
        min-width: 480px;
        white-space: nowrap;
    }

    .result-action:hover {
        background: #0284c7;
        color: #fff;
        text-decoration: none;
    }

    .result-action-delete:hover {
        background: #b91c1c;
        color: #fff;
    }

    .result-action-complete:hover {
        background: #15803d;
        color: #fff;
    }

    .results-empty {
        text-align: center;
        padding: 55px 20px;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        .results-hero h1 {
            font-size: 24px;
        }
    }

    /* Register tools and pagination match the Receive Samples table. */
    .results-table-tools { padding: 14px 18px 5px; }
    .results-table-tools .dt-buttons { display:flex; gap:7px; flex-wrap:wrap; }
    .results-table-tools .dt-button { border-radius:7px !important; font-size:12px; font-weight:650; margin:0 !important; }
    .results-table-tools .btn-copy-visible, .results-table-tools .btn-copy-visible:hover { background:#475569 !important; border-color:#475569 !important; color:#fff !important; }
    .results-table-tools .dataTables_length select { width:auto; display:inline-block; margin:0 5px; }
    .results-table-footer { padding:12px 18px 18px; }
    .results-table-footer .pagination { flex-wrap:wrap; }
    .results-table thead th { cursor:pointer; }
    .results-table thead th:last-child { cursor:default; }
</style>

<div class="results-page">
    <section class="results-hero">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1>
                        <i class="fas fa-flask mr-2"></i>
                        Test Results
                    </h1>
                    <p>
                        Review captured quantitative laboratory measurements,
                        patient information, flags and consumable stock.
                    </p>
                </div>

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="MyTests"
                   class="btn btn-light btn-sm mt-3">
                    <i class="fas fa-arrow-left mr-1"></i>
                    My Assigned Tests
                </a>
            </div>
        </div>
    </section>

    <div class="container-fluid results-content">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row">
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "all" })"
                   data-result-filter="all"
                   aria-label="Filter laboratory results: Total Results">
                    <div>
                        <div class="label">Total Results</div>
                        <h2 class="number">@totalResults</h2>
                    </div>
                    <div class="symbol" aria-hidden="true">
                        <i class="fas fa-flask"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "verified" })"
                   data-result-filter="verified"
                   aria-label="Filter laboratory results: Verified Results">
                    <div>
                        <div class="label">Verified Results</div>
                        <h2 class="number">@verifiedResults</h2>
                    </div>
                    <div class="symbol green" aria-hidden="true">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "abnormal" })"
                   data-result-filter="abnormal"
                   aria-label="Filter laboratory results: Abnormal Results">
                    <div>
                        <div class="label">Abnormal Results</div>
                        <h2 class="number">@abnormalResults</h2>
                    </div>
                    <div class="symbol red" aria-hidden="true">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </a>
            </div>
            <div class="col-xl-3 col-md-6 mb-3">
                <a class="results-summary results-summary-link"
                   href="@Url.Action("Results", "Tests", new { area = "Technician", resultFilter = "review" })"
                   data-result-filter="review"
                   aria-label="Filter laboratory results: Require Review">
                    <div>
                        <div class="label">Require Review</div>
                        <h2 class="number">@reviewResults</h2>
                    </div>
                    <div class="symbol orange" aria-hidden="true">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                </a>
            </div>
        </div>

        <form id="resultAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

        <div class="results-card">
            <div class="results-card-header">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <h4 class="results-card-title">
                            <i class="fas fa-table text-primary mr-2"></i>
                            Laboratory Results Register
                        </h4>
                        <p class="results-card-subtitle">
                            Search numeric results by request number, result, test, patient, flag or status.
                            Current consumable stock balances are shown for each test type.
                        </p>
                    </div>

                    <div class="col-lg-5 mt-3 mt-lg-0">
                        <input id="resultsSearch"
                               type="search"
                               class="form-control results-search"
                               placeholder="Search laboratory results..."
                               aria-label="Search laboratory results" />
                    </div>
                </div>
            </div>

            <div class="results-table-tools" id="resultsTableTools"></div>
            <div class="results-scroll-top" id="resultsScrollTop" aria-label="Horizontal scroll for results table" tabindex="0"><div class="results-scroll-top-inner" id="resultsScrollTopInner"></div></div>
            <div class="results-scroll-bottom" id="resultsScrollBottom">
                <table class="table results-table" id="resultsTable">
                    <thead>
                        <tr>
                            <th>Request Number</th>
                            <th>Test</th>
                            <th>Patient</th>
                            <th>Performed By</th>
                            <th>Result Name</th>
                            <th>Result Value</th>
                            <th>Measurement Unit</th>
                            <th>Reference Range</th>
                            <th>Flag</th>
                            <th>Consumables / Current Stock</th>
                            <th>Test Status</th>
                            <th>Record Status</th>
                            <th>Captured</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var result in results)
                        {
                            var test = result.TestRequestTestType;
                            var testType = test?.TestType;
                            var patient = test?.TestRequest?.Patient;
                            var status = test?.Status ?? "Unknown";
                            var performingTechnician = result.Technician?.FullName
                                ?? test?.Technician?.FullName
                                ?? "Not assigned";
                            var requestId = test?.TestRequestId ?? 0;
                            var requestTeam = techniciansByRequestId.TryGetValue(requestId, out var teamNames)
                                ? teamNames : "No assigned technicians";
                            var isDeleted = deletedIds.Contains(result.TestResultId) || test?.IsDeleted == true;
                            // Same UTC deadline rule used by TestsController.IsPastTestDeadline.
                            var isOverdue = test?.StartDateTime.HasValue == true
                                && test.TestType != null
                                && test.TestType.TurnAroundTimeHours > 0
                                && DateTime.UtcNow > DateTime.SpecifyKind(test.StartDateTime.Value, DateTimeKind.Utc)
                                    .AddHours(test.TestType.TurnAroundTimeHours);
                            var overdueDeadline = isOverdue
                                ? DateTime.SpecifyKind(test!.StartDateTime!.Value, DateTimeKind.Utc)
                                    .AddHours(test.TestType!.TurnAroundTimeHours)
                                : (DateTime?)null;
                            var canModifyResult = !isDeleted
                                && !result.VerifiedDateTime.HasValue
                                && string.IsNullOrWhiteSpace(result.VerifiedByTechnicianId)
                                && (string.Equals(status, "In Progress", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(status, "To Be Reviewed", StringComparison.OrdinalIgnoreCase));
                            var hasStock = remainingByResultId.TryGetValue(result.TestResultId, out var stockText);
                            var stockColors = new[] { "c-blue", "c-green", "c-orange", "c-purple", "c-teal", "c-pink" };
                            var stockColor = stockColors[(int)((uint)(test?.TestTypeId ?? 0) % (uint)stockColors.Length)];
                             // Quantitative values come from stored records; no synthetic UI values.
                             var displayValue = result.ResultValue?.Trim() ?? "Not recorded";
                             var displayUnit = string.IsNullOrWhiteSpace(result.MeasurementUnit)
                                 ? "Unit not recorded" : result.MeasurementUnit;
                             var hasRange = result.ReferenceMin.HasValue || result.ReferenceMax.HasValue;
                             var validRange = hasRange && !(result.ReferenceMin == 0m && result.ReferenceMax == 0m);
                             var displayRange = validRange
                                 ? $"{(result.ReferenceMin?.ToString("0.##") ?? "—")} to {(result.ReferenceMax?.ToString("0.##") ?? "—")}" 
                                 : "Not recorded";
                             var storedFlag = result.ResultFlag?.Trim() ?? "";
                             var isNormal = storedFlag.Equals("Normal", StringComparison.OrdinalIgnoreCase);
                             var isAbnormal = result.IsAbnormal ||
                                 storedFlag.Equals("Abnormal", StringComparison.OrdinalIgnoreCase) ||
                                 storedFlag.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                 storedFlag.Equals("Low", StringComparison.OrdinalIgnoreCase);
                             var displayFlag = isAbnormal
                                 ? (storedFlag.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                    storedFlag.Equals("Low", StringComparison.OrdinalIgnoreCase)
                                    ? storedFlag.ToUpperInvariant() : "ABNORMAL")
                                 : (isNormal ? "NORMAL" : "NOT EVALUATED");
                             var flagClass = isAbnormal ? "abnormal" : (isNormal ? "normal" : "review");
                             var isFlagAbnormal = isAbnormal;


                            <tr class="@(isDeleted ? "result-row-deleted" : "")" data-result-id="@result.TestResultId"
                                data-result-verified="@(result.VerifiedDateTime.HasValue && !isDeleted ? "true" : "false")"
                                data-result-abnormal="@(isFlagAbnormal && !isDeleted ? "true" : "false")"
                                data-result-review="@((result.RequiresReview || string.Equals(status, "To Be Reviewed", StringComparison.OrdinalIgnoreCase)) && !isDeleted ? "true" : "false")">
                                <td>
                                    <span class="result-main">
                                        @(test?.TestRequest?.RequestNumber ?? "Not available")
                                    </span>
                                    <span class="result-sub" title="Technicians assigned to tests within this request">
                                        Request team: @requestTeam
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(testType?.Name ?? "Unknown test")
                                    </span>
                                    <span class="result-sub">
                                        Test assignment #@(test?.TestRequestTestTypeId)
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">
                                        @(patient?.FullName ?? "Patient unavailable")
                                    </span>
                                </td>

                                <td>
                                    <span class="result-main">@performingTechnician</span>
                                    <span class="result-sub">Test performer</span>
                                </td>

                                <td>@result.ResultName</td>

                                                                <td>
                                    <span class="result-main">@displayValue</span>
                                </td>

                                <td>
                                    <span class="@(displayUnit == "Unit not recorded" ? "text-muted" : "")">@displayUnit</span>
                                </td>

                                <td>
                                    <span class="@(displayRange == "Not recorded" ? "text-muted" : "")">@displayRange</span>
                                </td>

                                <td>
                                    <span class="result-pill @flagClass">@displayFlag</span>
                                </td>
<td>
                                    @if (hasStock)
                                    {
                                        <div class="consumable-pill-group">
                                            @foreach (var consumableText in (stockText ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge rounded-pill consumable-pill @stockColor" title="Current stock and quantity required per test">
                                                    <i class="fas fa-vial mr-1" aria-hidden="true"></i>
                                                    @consumableText.Trim()
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="consumable-unavailable"
                                              title="No consumables configured for this test, or stock data unavailable.">
                                            No stock configuration
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (isOverdue && !isDeleted)
                                    {
                                        <span class="result-pill deleted" title="The turnaround deadline has passed">Overdue</span>
                                    }
                                    else if (result.RequiresReview ||
                                         string.Equals(
                                             status,
                                             "To Be Reviewed",
                                             StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="result-pill review">
                                            Requires Review
                                        </span>
                                    }
                                    else if (result.VerifiedDateTime.HasValue)
                                    {
                                        <span class="result-pill verified">
                                            Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-pill pending">
                                            @status
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="result-pill @(isDeleted ? "deleted" : "active")">
                                        @(isDeleted ? "De-Activated" : "Active")
                                    </span>
                                </td>

                                <td>
                                    @result.CapturedDateTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                               
                                <td>
                                    <div class="result-actions">
                                        <button type="button"
                                                class="result-action js-result-modal"
                                                data-url="@Url.Action("ResultDetails", "Tests", new { area = "Technician", id = result.TestResultId })"
                                                data-result-id="@result.TestResultId"
                                                data-modal-title="View Result"
                                                title="View result" aria-label="View result">
                                            <i class="fas fa-eye" aria-hidden="true"></i> View
                                        </button>

                                        @if (canModifyResult)
                                        {
                                            <button type="button"
                                                    class="result-action result-action-edit @(isOverdue ? "js-overdue-result" : "js-result-modal")"
                                                    data-request-number="@(test?.TestRequest?.RequestNumber ?? "N/A")"
                                                    data-test-name="@(testType?.Name ?? "Unknown test")"
                                                    data-deadline="@(overdueDeadline?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "")"
                                                    data-url="@Url.Action("EditResult", "Tests", new { area = "Technician", id = result.TestResultId })"
                                                    data-result-id="@result.TestResultId"
                                                    data-modal-title="Edit Result"
                                                    title="Edit result" aria-label="Edit result">
                                                <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                            </button>

                                            <button type="button"
                                                    class="result-action result-action-delete js-deactivate-result"
                                                    data-result-id="@result.TestResultId"
                                                    data-request-number="@(test?.TestRequest?.RequestNumber ?? "N/A")"
                                                    data-test-name="@(testType?.Name ?? "Unknown test")"
                                                    data-url="@Url.Action("DeactivateResultTest", "Tests", new { area = "Technician", id = result.TestResultId })"
                                                    title="De-activate test" aria-label="De-activate test">
                                                <i class="fas fa-ban" aria-hidden="true"></i> De-Activate
                                            </button>

                                            @* The href is the POST destination; JS opens confirmation modal. *@
                                            @if (test != null)
                                            {
                                                <a href="@Url.Action("CompleteTest", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })"
                                                   class="result-action result-action-complete js-complete-test"
                                                   data-clinical-url="@Url.Action("CompleteTestClinicalContext", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })"
                                                   data-patient="@(patient?.FullName ?? "Patient unavailable")"
                                                   data-test="@(testType?.Name ?? "Unknown test")"
                                                   data-result-name="@result.ResultName"
                                                   data-result="@displayValue"
                                                   data-unit="@displayUnit"
                                                   data-range="@displayRange"
                                                   data-flag="@displayFlag"
                                                   data-status="@status"
                                                   data-assignment-id="@test.TestRequestTestTypeId"
                                                   title="Review and complete this test"
                                                   aria-label="Complete test @test.TestRequestTestTypeId">
                                                    <i class="fas fa-check-circle" aria-hidden="true"></i> Complete
                                                </a>
                                            }

                                        }
                                    </div>
                                </td>

                            </tr>
                        }

                        @if (!results.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="14" class="results-empty">
                                    <i class="fas fa-flask fa-2x mb-3"></i>
                                    <h5>No numeric results found</h5>
                                    <p>
                                        Captured numeric results will appear in this table.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="results-table-footer" id="resultsTableFooter"></div>
            <div class="px-3 py-3 text-muted small"
                 id="resultsCount"
                 aria-live="polite">
                Showing @totalResults result(s).
            </div>
        </div>
    </div>
</div>

@* AJAX modal shell: partial views are loaded into .modal-content, matching Receive Samples. *@
<div class="modal fade" id="testResultModal" tabindex="-1" role="dialog"
     aria-label="Test result information" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" id="testResultModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <p class="mt-3 text-muted mb-0">Loading test result information...</p>
            </div>
        </div>
    </div>
</div>

@* Modal is outside the table and rendered only once. *@
@await Html.PartialAsync("_CompleteTestModal")

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function() {
            // An overdue test remains visible but the Edit action shows a warning instead.
            $(document).on('click', '.js-overdue-result', function(event) {
                event.preventDefault();
                event.stopImmediatePropagation();
                const button = $(this);
                const requestNumber = button.attr('data-request-number') || 'N/A';
                const testName = button.attr('data-test-name') || 'Selected test';
                const deadline = button.attr('data-deadline') || 'the scheduled turnaround time';
                const message = `Request ${requestNumber} (${testName}) passed its deadline (${deadline}). The technician cannot edit this result. Please contact the laboratory manager for an authorised extension.`;
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon:'warning', title:'Test Overdue - Editing Locked', text:message,
                        confirmButtonText:'Understood', confirmButtonColor:'#075985' });
                } else { alert(message); }
            });

            // Match Receive Samples: button click, SweetAlert2 reason, AJAX POST, audit handled server-side.
            $(document).on('click', '.js-deactivate-result', async function(event) {
                event.preventDefault();
                const button = $(this);
                if (button.prop('disabled')) return;
                if (typeof Swal === 'undefined') {
                    alert('SweetAlert2 is not loaded. Please contact the administrator.');
                    return;
                }

                const resultId = Number(button.attr('data-result-id'));
                const requestNumber = button.attr('data-request-number') || 'N/A';
                const testName = button.attr('data-test-name') || 'Selected test';
                const url = button.attr('data-url');
                if (!Number.isInteger(resultId) || resultId <= 0 || !url) {
                    await Swal.fire({ icon: 'error', title: 'Invalid Test', text: 'Result ID or endpoint is missing.' });
                    return;
                }

                const confirmation = await Swal.fire({
                    icon: 'warning',
                    title: 'De-Activate Test?',
                    text: `Request: ${requestNumber} | Test: ${testName}. A reason is mandatory and will be recorded in the audit trail.`,
                    input: 'textarea',
                    inputLabel: 'Reason for de-activation (required)',
                    inputPlaceholder: 'Explain why this test must be de-activated...',
                    inputAttributes: { maxlength: '500', 'aria-label': 'Reason for de-activation' },
                    inputValidator: value => {
                        if (!value || !value.trim()) return 'Please provide a reason for de-activation.';
                        if (value.trim().length > 500) return 'The reason must not exceed 500 characters.';
                    },
                    showCancelButton: true,
                    confirmButtonText: 'Yes, De-Activate',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc2626',
                    showLoaderOnConfirm: true,
                    allowOutsideClick: () => !Swal.isLoading(),
                    preConfirm: async value => {
                        try {
                            const token = $('input[name="__RequestVerificationToken"]').first().val();
                            const response = await $.ajax({
                                url: url,
                                type: 'POST',
                                data: {
                                    id: resultId,
                                    reason: value.trim(),
                                    __RequestVerificationToken: token
                                }
                            });
                            if (!response || !response.success) {
                                Swal.showValidationMessage(response?.message || 'De-activation failed.');
                                return false;
                            }
                            return response;
                        } catch (xhr) {
                            const message = xhr.responseJSON?.message ||
                                (xhr.status === 401 || xhr.status === 403
                                    ? 'Your session has expired or you are not authorized.'
                                    : 'Unable to de-activate the test. Please try again.');
                            Swal.showValidationMessage(message);
                            return false;
                        }
                    }
                });

                if (confirmation.isConfirmed && confirmation.value?.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Test De-Activated',
                        text: confirmation.value.message || 'The test and audit record were saved.',
                        confirmButtonText: 'OK'
                    });
                    window.location.reload();
                }
            });

            // Cross-version Bootstrap modal close controls (Bootstrap 4 and 5).
            $(document).on('click', '#testResultModal [data-dismiss="modal"], #testResultModal [data-bs-dismiss="modal"]', function(event) {
                event.preventDefault();
                const element = $(this).closest('.modal')[0];
                if (!element) return;
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(element).hide();
                } else if ($.fn.modal) {
                    $(element).modal('hide');
                }
            });

            // Complete link: show a confirmation modal, never submit on first click.
            $(document).on('click', '.js-complete-test', function(event) {
                event.preventDefault();
                const $link = $(this);
                const url = $link.attr('href');
                if (!url || url === '#') {
                    alert('The completion endpoint is unavailable.');
                    return;
                }
                const fields = {
                    '#completePatient': 'patient',
                    '#completeTestName': 'test',
                    '#completeResultName': 'result-name',
                    '#completeResult': 'result',
                    '#completeUnit': 'unit',
                    '#completeRange': 'range',
                    '#completeFlag': 'flag',
                    '#completeStatus': 'status',
                    '#completeAssignmentId': 'assignment-id'
                };
                Object.keys(fields).forEach(function(selector) {
                    $(selector).text($link.attr('data-' + fields[selector]) || '—');
                });
                // Load clinical history from the server, not from untrusted table attributes.
                const clinicalUrl = $link.attr('data-clinical-url');
                const clinicalSelectors = ['#completeConditions', '#completeAllergies', '#completeMedications', '#completeClinicalNotes'];
                clinicalSelectors.forEach(s => $(s).text('—'));
                $('#completeClinicalLoading').removeClass('d-none');
                $('#completeClinicalError').addClass('d-none').text('');
                $('#completeSubmitButton').prop('disabled', true);
                if (!clinicalUrl) {
                    $('#completeClinicalLoading').addClass('d-none');
                    $('#completeClinicalError').removeClass('d-none').text('Clinical information endpoint is missing.');
                } else {
                    $.getJSON(clinicalUrl)
                        .done(function(data) {
                            // Avoid showing stale clinical details if another test was selected.
                            if ($('#completeTestForm').attr('action') !== url) return;
                            $('#completeConditions').text(data.medicalConditions || 'Not recorded');
                            $('#completeAllergies').text(data.allergies || 'Not recorded');
                            $('#completeMedications').text(data.medications || 'Not recorded');
                            $('#completeClinicalNotes').text(data.clinicalNotes || 'Not recorded');
                            $('#completeSubmitButton').prop('disabled', false);
                        })
                        .fail(function() {
                            if ($('#completeTestForm').attr('action') !== url) return;
                            $('#completeClinicalError').removeClass('d-none')
                                .text('Unable to load clinical information. Submission is disabled until this is resolved.');
                        })
                        .always(function() { $('#completeClinicalLoading').addClass('d-none'); });
                }
                $('#completeTestForm').attr('action', url);
                const modalElement = document.getElementById('completeTestModal');
                if (!modalElement) {
                    alert('Complete Test modal was not rendered. Check _CompleteTestModal.cshtml.');
                    return;
                }
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
                } else if ($.fn.modal) {
                    $('#completeTestModal').modal('show');
                } else {
                    alert('Bootstrap modal JavaScript is missing. Check _TechnicianLayout.cshtml.');
                }
            });

            $('#completeTestForm').on('submit', function() {
                if (!this.action) return false;
                $('#completeSubmitButton').prop('disabled', true);
            });
            $('#completeTestModal').on('hidden.bs.modal', function() {
                $('#completeTestForm').removeAttr('action');
                $('#completeSubmitButton').prop('disabled', false);
            });

            // Synchronise the upper and lower horizontal scrollbars.
            const topScroller = document.getElementById('resultsScrollTop');
            const bottomScroller = document.getElementById('resultsScrollBottom');
            const topInner = document.getElementById('resultsScrollTopInner');
            const resultsTable = document.getElementById('resultsTable');
            if (topScroller && bottomScroller && topInner && resultsTable) {
                let syncing = false;
                const updateScrollWidth = () => {
                    topInner.style.width = Math.max(resultsTable.scrollWidth, bottomScroller.clientWidth + 1) + 'px';
                    topScroller.scrollLeft = bottomScroller.scrollLeft;
                };
                topScroller.addEventListener('scroll', () => {
                    if (syncing) return;
                    syncing = true;
                    bottomScroller.scrollLeft = topScroller.scrollLeft;
                    syncing = false;
                });
                bottomScroller.addEventListener('scroll', () => {
                    if (syncing) return;
                    syncing = true;
                    topScroller.scrollLeft = bottomScroller.scrollLeft;
                    syncing = false;
                });
                updateScrollWidth();
                window.addEventListener('resize', updateScrollWidth);
                if (window.ResizeObserver) new ResizeObserver(updateScrollWidth).observe(resultsTable);
            }

            const $modal = $('#testResultModal');
            const $content = $('#testResultModalContent');
            let activeRequest = null;
            let requestSequence = 0;

            function showLoading(title) {
                $content.html(`
                            <div class="modal-body text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <h6 class="mt-3 mb-1">Loading...</h6>
                                <p class="text-muted mb-0"></p>
                            </div>`);
                $content.find('.text-muted').text(title || 'Loading test result information...');
            }

            $(document).on('click', '.js-result-modal', function(event) {
                event.preventDefault();
                const $button = $(this);
                const url = $button.attr('data-url');
                const title = $button.attr('data-modal-title') || 'Test result';

                if (!url || url === '#') {
                    alert('The result endpoint is unavailable. Check TestsController ResultDetails/EditResult actions.');
                    return;
                }
                if (activeRequest) activeRequest.abort();
                const sequence = ++requestSequence;
                $button.prop('disabled', true);
                showLoading(title);
                const resultModalElement = $modal[0];
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(resultModalElement).show();
                } else if (typeof $.fn.modal === 'function') {
                    $modal.modal('show');
                } else {
                    $content.html('<div class="modal-body"><div class="alert alert-warning">Bootstrap modal JavaScript is not loaded. Please check _TechnicianLayout.cshtml.</div></div>');
                    $button.prop('disabled', false);
                    return;
                }

                activeRequest = $.ajax({ url: url, method: 'GET', cache: false })
                    .done(function(html) {
                        if (sequence !== requestSequence) return;
                        // The existing _ViewResultsModal / _EditResultsModal partial
                        // should render .modal-header, .modal-body and (if needed) .modal-footer.
                        $content.html(html);
                    })
                    .fail(function(xhr, status) {
                        if (sequence !== requestSequence || status === 'abort') return;
                        let message = 'Unable to load this result. Please try again.';
                        if (xhr.status === 401) message = 'Your session has expired. Please sign in again.';
                        else if (xhr.status === 403) message = 'You are not authorised to view this result.';
                        else if (xhr.status === 404) message = 'Result endpoint or record not found. URL: ' + url;
                        else if (xhr.status === 409) message = xhr.responseText || 'This result cannot be edited in its current state.';
                        else if (xhr.status === 0) message = 'Unable to reach the server. Check your connection.';
                        $content.html('<div class="modal-body"><div class="alert alert-danger mb-3" role="alert"></div>' +
                            '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>');
                        $content.find('.alert').text(message);
                    })
                    .always(function() {
                        $button.prop('disabled', false);
                        if (sequence === requestSequence) activeRequest = null;
                    });
            });

            $modal.on('hidden.bs.modal', function() {
                ++requestSequence;
                if (activeRequest) activeRequest.abort();
                activeRequest = null;
                showLoading('Loading test result information...');
            });

            // Save Edit Result via AJAX; never navigate to a POST-only endpoint.
            $(document).on('submit', '#editTestResultForm', function(event) {
                event.preventDefault();
                const form = this;
                if (!form.checkValidity()) { form.reportValidity(); return; }
                const $button = $(form).find('#saveResultChanges');
                if ($button.prop('disabled')) return;
                $button.prop('disabled', true);
                $button.find('.save-result-normal').addClass('d-none');
                $button.find('.save-result-loading').removeClass('d-none');
                $.ajax({
                    url: form.action,
                    type: 'POST',
                    data: $(form).serialize(),
                    dataType: 'json'
                }).done(function(response) {
                    if (response.success) {
                        window.location.reload();
                    } else {
                        alert(response.message || 'Unable to save result.');
                    }
                }).fail(function(xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || ('Save failed (HTTP ' + xhr.status + ').');
                    if (typeof Swal !== 'undefined') Swal.fire({icon:'warning', title:'Unable to Edit Result', text:message});
                    else alert(message);
                }).always(function() {
                    $button.prop('disabled', false);
                    $button.find('.save-result-normal').removeClass('d-none');
                    $button.find('.save-result-loading').addClass('d-none');
                });
            });

            // DataTables paging, sorting and export; custom summary filters remain active.
            const allowedFilters = ['all', 'verified', 'abnormal', 'review'];
            const queryParams = new URLSearchParams(window.location.search);
            let activeFilter = queryParams.get('resultFilter') || 'all';
            if (!allowedFilters.includes(activeFilter)) activeFilter = 'all';
            let resultsDataTable = null;
            const $resultTable = $('#resultsTable');
            const hasData = $resultTable.find('tbody tr:not(.empty-row)').length > 0;

            function updateSummarySelection() {
                $('.results-summary-link').each(function() {
                    const selected = this.getAttribute('data-result-filter') === activeFilter;
                    $(this).toggleClass('is-active', selected)
                           .attr('aria-current', selected ? 'true' : null);
                });
            }

            if (hasData && $.fn.DataTable) {
                $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                    if (settings.nTable !== $resultTable[0]) return true;
                    if (activeFilter === 'all') return true;
                    const row = settings.aoData[dataIndex]?.nTr;
                    return row?.getAttribute('data-result-' + activeFilter) === 'true';
                });
                resultsDataTable = $resultTable.DataTable({
                    processing: true,
                    autoWidth: false,
                    pageLength: 10,
                    lengthMenu: [[10,25,50,100,-1],[10,25,50,100,'All']],
                    pagingType: 'full_numbers',
                    order: [[12,'desc']],
                    columnDefs: [{targets:13, orderable:false, searchable:false}],
                    // Keep existing upper/lower horizontal scrollers, not DataTables scrollX.
                    dom: 'lBrtip',
                    buttons: [
                        { extend:'copyHtml5', text:'<i class="fas fa-copy mr-1"></i> Copy',
                          className:'btn btn-secondary btn-sm btn-copy-visible',
                          title:'NMB-HLabSys - Laboratory Test Results', exportOptions:{columns:':not(:last-child)',modifier:{search:'applied',order:'applied'}} },
                        { extend:'csvHtml5', text:'<i class="fas fa-file-csv mr-1"></i> CSV',
                          className:'btn btn-info btn-sm', filename:'NMB-HLabSys_Test_Results',
                          exportOptions:{columns:':not(:last-child)',modifier:{search:'applied',order:'applied'}} },
                        { extend:'excelHtml5', text:'<i class="fas fa-file-excel mr-1"></i> Excel',
                          className:'btn btn-success btn-sm', filename:'NMB-HLabSys_Test_Results',
                          title:'NMB-HLabSys - Laboratory Test Results',
                          exportOptions:{columns:':not(:last-child)',modifier:{search:'applied',order:'applied'}} },
                        { extend:'pdfHtml5', text:'<i class="fas fa-file-pdf mr-1"></i> PDF',
                          className:'btn btn-danger btn-sm', filename:'NMB-HLabSys_Test_Results',
                          title:'NMB-HLabSys - Laboratory Test Results', orientation:'landscape', pageSize:'A3',
                          exportOptions:{columns:':not(:last-child)',modifier:{search:'applied',order:'applied'}},
                          customize:function(doc) { doc.defaultStyle.fontSize=7; doc.styles.tableHeader.fontSize=7; doc.pageMargins=[20,25,20,25]; } },
                        { extend:'print', text:'<i class="fas fa-print mr-1"></i> Print',
                          className:'btn btn-primary btn-sm', title:'NMB-HLabSys - Laboratory Test Results',
                          exportOptions:{columns:':not(:last-child)',modifier:{search:'applied',order:'applied'}} }
                    ],
                    language:{emptyTable:'No laboratory results found.'}
                });
                const $wrapper = $(resultsDataTable.table().container());
                $('#resultsTableTools').append($wrapper.find('.dataTables_length'), $wrapper.find('.dt-buttons'));
                $('#resultsTableFooter').append($wrapper.find('.dataTables_info'), $wrapper.find('.dataTables_paginate'));
                resultsDataTable.on('draw', function() {
                    $('#resultsCount').text('Showing ' + resultsDataTable.rows({search:'applied'}).count() + ' matching result(s).');
                    $('#resultsScrollTopInner').width(Math.max(document.getElementById('resultsTable').scrollWidth, document.getElementById('resultsScrollBottom').clientWidth + 1));
                });
            }

            function applyResultFilters() {
                const query = ($('#resultsSearch').val() || '').trim();
                updateSummarySelection();
                if (resultsDataTable) {
                    resultsDataTable.search(query).draw();
                } else {
                    let visible = 0;
                    $('#resultsTable tbody tr').not('.empty-row').each(function() {
                        const matchStatus = activeFilter === 'all' || this.getAttribute('data-result-' + activeFilter) === 'true';
                        const show = matchStatus && $(this).text().toLowerCase().includes(query.toLowerCase());
                        $(this).toggle(show);
                        if (show) visible++;
                    });
                    $('#resultsCount').text('Showing ' + visible + ' matching result(s).');
                }
            }
            $(document).on('click', '.results-summary-link', function(event) {
                if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.which !== 1) return;
                event.preventDefault();
                activeFilter = this.getAttribute('data-result-filter') || 'all';
                const url = new URL(this.href, window.location.href);
                window.history.pushState({resultFilter:activeFilter}, '', url);
                applyResultFilters();
                document.getElementById('resultsTable').scrollIntoView({behavior:'smooth',block:'start'});
            });
            $(window).on('popstate', function() {
                activeFilter = new URLSearchParams(window.location.search).get('resultFilter') || 'all';
                if (!allowedFilters.includes(activeFilter)) activeFilter = 'all';
                applyResultFilters();
            });
            $('#resultsSearch').on('input', applyResultFilters);
            applyResultFilters();
        });
    </script>
}
