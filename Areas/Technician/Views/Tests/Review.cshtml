@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>
@using System.Linq

@{
    ViewData["Title"] = "Tests for Review";
    Layout = "_TechnicianLayout";

    var tests = Model?.ToList() ?? new List<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>();
    var total = tests.Count;
    var pendingVerificationCount = tests.Count(t => t.Status == "Completed" && !t.IsDeleted);
    var returnedCount = tests.Count(t => t.Status == "To Be Reviewed" && !t.IsDeleted);
    var savedResults = ViewData["SavedResults"] as IEnumerable<NMB_HLabSys.Areas.Technician.Models.TestResultModel>
        ?? Enumerable.Empty<NMB_HLabSys.Areas.Technician.Models.TestResultModel>();
    var resultByTest = savedResults.GroupBy(r => r.TestRequestTestTypeId)
        .ToDictionary(g => g.Key, g => g.First());
}

<style>
    .review-page {
        background: #f4f7fb;
        min-height: 100vh;
        padding: 30px 18px 60px;
    }

    .review-wrap {
        max-width: 1250px;
        margin: 0 auto;
    }

    .review-hero {
        background: linear-gradient(120deg,#123b73,#2375bd);
        color: #fff;
        border-radius: 17px;
        padding: 27px 30px;
        margin-bottom: 22px;
        box-shadow: 0 10px 26px rgba(21,72,131,.14);
    }

        .review-hero h1 {
            font-size: 1.65rem;
            font-weight: 750;
            margin: 0 0 8px;
        }

        .review-hero p {
            color: #e0edfb;
            margin: 0;
        }

    .review-stats {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .review-stat {
        background: #fff;
        border: 1px solid #e2eaf3;
        border-radius: 13px;
        padding: 19px 22px;
        box-shadow: 0 4px 16px rgba(31,62,104,.05);
    }

    .review-stat-label {
        font-size: .85rem;
        color: #60748d;
        font-weight: 650;
    }

    .review-stat-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: #123b73;
        margin-top: 5px;
    }

    .review-card {
        background: #fff;
        border: 1px solid #e2eaf3;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(31,62,104,.05);
    }

    .review-card-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 20px 22px;
        border-bottom: 1px solid #e9eff6;
    }

        .review-card-header h2 {
            font-size: 1.1rem;
            color: #1c477a;
            font-weight: 750;
            margin: 0;
        }

    .review-filters {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

        .review-filters input, .review-filters select {
            min-height: 40px;
            border: 1px solid #cbd7e6;
            border-radius: 8px;
            padding: 8px 11px;
            color: #253b53;
            background: #fff;
        }

        .review-filters input {
            min-width: 210px;
        }

    .review-table-wrap {
        overflow-x: auto;
    }

    .review-table {
        width: 100%;
        border-collapse: collapse;
    }

        .review-table th {
            background: #f7f9fc;
            color: #526981;
            font-size: .78rem;
            letter-spacing: .025em;
            text-transform: uppercase;
            text-align: left;
            padding: 14px 16px;
            white-space: nowrap;
        }

        .review-table td {
            padding: 17px 16px;
            border-top: 1px solid #edf1f6;
            color: #273a50;
            vertical-align: middle;
            font-size: .9rem;
        }

        .review-table tr:hover td {
            background: #fafcff;
        }

    .review-primary {
        font-weight: 750;
        color: #1c477a;
    }

    .review-sub {
        color: #73849a;
        font-size: .8rem;
        margin-top: 4px;
    }

    .review-status {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        background: #fff1d6;
        color: #865c00;
        font-size: .76rem;
        font-weight: 750;
        white-space: nowrap;
    }

        .review-status.completed {
            background: #e7f2ff;
            color: #155a91;
        }

        .review-status.returned {
            background: #fff1d6;
            color: #865c00;
        }

    .review-urgency {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #edf2f8;
        color: #43566b;
        font-weight: 700;
        font-size: .77rem;
    }

    .review-urgency-high {
        background: #fee8e8;
        color: #ad2630;
    }

    .review-urgency-urgent {
        background: #fee8e8;
        color: #ad2630;
    }

    .review-urgency-stat {
        background: #fee8e8;
        color: #ad2630;
    }

    .review-action {
        display: inline-block;
        padding: 9px 13px;
        background: #176ab0;
        color: #fff !important;
        border-radius: 8px;
        text-decoration: none !important;
        font-weight: 700;
        white-space: nowrap;
    }

        .review-action:hover {
            background: #10548e;
        }

    .review-note {
        background: #eff6ff;
        border-left: 4px solid #0284c7;
        padding: 12px 14px;
        border-radius: 8px;
        color: #334155;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-width: 340px;
    }

        .review-note.missing {
            background: #fff7ed;
            border-color: #f59e0b;
        }

    .review-action.view { background: #0e7490; }
    .review-action.deactivate { background: #b91c1c; border: 0; cursor: pointer; }
    .review-action.deactivate:hover { background: #991b1b; }
    .review-action:disabled { opacity: .6; cursor: not-allowed; }
    .review-actions {
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        gap: 9px;
        min-width: 145px;
    }

    .review-actions .review-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 39px;
        box-sizing: border-box;
        text-align: center;
    }

    .review-actions .review-status {
        text-align: center;
    }

    .review-action.verify {
        background: #16834b;
        border: 0;
        cursor: pointer;
    }

        .review-action.verify:hover {
            background: #11693c;
        }

    .review-action.secondary {
        background: #eaf2fb;
        color: #155a91 !important;
    }

        .review-action.secondary:hover {
            background: #d6e8f8;
        }

    .review-empty {
        text-align: center;
        padding: 55px 20px;
        color: #667b92;
    }

        .review-empty i {
            font-size: 2.2rem;
            color: #8eabc7;
            margin-bottom: 14px;
        }

    .review-footer {
        padding: 13px 20px;
        border-top: 1px solid #edf1f6;
        color: #6b7d90;
        font-size: .84rem;
    }

    @@media(max-width:650px) {
        .review-page {
            padding: 18px 10px 40px;
        }

        .review-hero {
            padding: 22px;
        }

        .review-stats {
            grid-template-columns: 1fr;
        }

        .review-filters, .review-filters input, .review-filters select {
            width: 100%;
        }
    }
</style>

<div class="review-page">
    <div class="review-wrap">
        <header class="review-hero">
            <h1><i class="fas fa-clipboard-check mr-2"></i> Tests for Review</h1>
            <p>Independently verify completed tests from other technicians, or correct tests returned to you.</p>
        </header>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
        }

        <div class="review-stats">
            <div class="review-stat">
                <div class="review-stat-label">Awaiting Your Verification</div>
                <div class="review-stat-value">@pendingVerificationCount</div>
            </div>
            <div class="review-stat">
                <div class="review-stat-label">Returned for Correction</div>
                <div class="review-stat-value">@returnedCount</div>
            </div>
            <div class="review-stat">
                <div class="review-stat-label">Total in Queue</div>
                <div class="review-stat-value">@total</div>
            </div>
        </div>

        <section class="review-card" aria-labelledby="review-list-title">
            <div class="review-card-header">
                <h2 id="review-list-title"><i class="fas fa-list-alt mr-2"></i> Review Queue</h2>
                <div class="review-filters">
                    <input id="reviewSearch" type="search" placeholder="Search tests or requests" aria-label="Search review queue" />
                    <select id="urgencyFilter" aria-label="Filter by urgency">
                        <option value="">All urgency levels</option>
                    </select>
                    <select id="statusFilter" aria-label="Filter by test status">
                        <option value="">All statuses</option>
                        <option value="Completed">Completed — Verify</option>
                        <option value="To Be Reviewed">To Be Reviewed — Correct</option>
                    </select>
                </div>
            </div>

            @if (!tests.Any())
            {
                <div class="review-empty">
                    <div><i class="fas fa-check-circle" aria-hidden="true"></i></div>
                    <h3 style="font-size:1.1rem;color:#244b74">No tests awaiting action</h3>
                    <p>No completed tests are currently available for independent verification, and none of your tests have been returned for correction.</p>
                </div>
            }
            else
            {
                <div class="review-table-wrap">
                    <table class="review-table">
                        <thead>
                            <tr>
                                <th>Request</th>
                                <th>Test / Category</th>
                                <th>Urgency</th>
                                <th>Started</th>
                                <th>Status</th>
                                <th>Verifier Feedback</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="reviewRows">
                            @foreach (var test in tests)
                            {
                                resultByTest.TryGetValue(test.TestRequestTestTypeId, out var savedResult);
                                var feedback = savedResult?.ReviewNotes;
                                var isCompleted = test.Status == "Completed";
                                var isDeactivated = test.IsDeleted;
                                var urgency = test.TestRequest?.Urgency.ToString() ?? "Not specified";
                                var urgencyClass = urgency.Trim().ToLowerInvariant().Replace(" ", "-");
                                var searchText = $"{test.TestRequest?.RequestNumber} {test.TestType?.Name} {test.TestType?.TestCategory?.Description} {urgency} {feedback} {test.Status}";
                                <tr class="review-row" data-search="@searchText.ToLowerInvariant()" data-urgency="@urgency" data-status="@test.Status">
                                    <td>
                                        <div class="review-primary">@(test.TestRequest?.RequestNumber ?? "N/A")</div>
                                        <div class="review-sub">Test #@test.TestRequestTestTypeId</div>
                                    </td>
                                    <td>
                                        <div class="review-primary">@(test.TestType?.Name ?? "Unknown test")</div>
                                        <div class="review-sub">@(test.TestType?.TestCategory?.Description ?? "Category not specified")</div>
                                    </td>
                                    <td><span class="review-urgency review-urgency-@urgencyClass">@urgency</span></td>
                                    <td>@(test.StartDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not started")</td>
                                    <td><span class="review-status @(isDeactivated ? "returned" : (isCompleted ? "completed" : "returned"))">@(isDeactivated ? "De-Activated" : test.Status)</span></td>
                                    <td>
                                        <div class="review-note @(string.IsNullOrWhiteSpace(feedback) ? "missing" : "")">
                                            @(isCompleted ? "Awaiting independent verification." : (string.IsNullOrWhiteSpace(feedback) ? "No verifier note recorded. Check the history." : feedback))
                                        </div>
                                    </td>
                                    <td>
                                        <div class="review-actions">
                                            <button type="button" class="review-action view js-view-review"
                                                    data-request="@(test.TestRequest?.RequestNumber ?? "N/A")"
                                                    data-test="@(test.TestType?.Name ?? "Unknown test")"
                                                    data-category="@(test.TestType?.TestCategory?.Description ?? "N/A")"
                                                    data-urgency="@urgency"
                                                    data-status="@(isDeactivated ? "De-Activated" : test.Status)"
                                                    data-started="@(test.StartDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not started")"
                                                    data-feedback="@(feedback ?? "No verifier feedback recorded")"
                                                    data-result="@(savedResult?.ResultValue ?? "No result recorded")"
                                                    data-notes="@(savedResult?.Notes ?? "No notes recorded")">
                                                <i class="fas fa-eye mr-1"></i> View
                                            </button>
                                            @if (isDeactivated)
                                            {
                                                <span class="review-status returned">De-Activated</span>
                                            }
                                            else if (isCompleted)
                                            {
                                                <button type="button" class="review-action verify js-open-verify"
                                                        data-url="@Url.Action("VerifyTestModal", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })">
                                                    <i class="fas fa-user-check mr-1"></i> Verify Test
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="review-action js-open-correction"
                                                        data-url="@Url.Action("CorrectTestModal", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })">
                                                    <i class="fas fa-edit mr-1"></i> Correct Result
                                                </button>
                                            }
                                            @if (!isCompleted && !isDeactivated)
                                            {
                                                <button type="button" class="review-action deactivate js-review-deactivate"
                                                        data-id="@test.TestRequestTestTypeId"
                                                        data-test="@(test.TestType?.Name ?? "Test")">
                                                    <i class="fas fa-ban mr-1"></i> De-Activate
                                                </button>
                                            }
                                            <a class="review-action secondary"
                                               href="@Url.Action("VerificationHistory", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })">
                                                <i class="fas fa-history mr-1"></i> Full History
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="reviewNoMatches" class="review-empty" style="display:none">
                    No tests match your search or urgency filter.
                </div>
                <div class="review-footer"><span id="reviewCount">@total</span> test(s) shown</div>
            }
        </section>
    </div>
</div>

<div class="modal fade" id="reviewDetailsModal" tabindex="-1" role="dialog" aria-labelledby="reviewDetailsTitle" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-centered" role="document"><div class="modal-content">
  <div class="modal-header" style="background:#176ab0;color:white"><h5 class="modal-title" id="reviewDetailsTitle">Test Details</h5><button type="button" class="close text-white js-close-review-dialog" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
  <div class="modal-body"><dl class="row mb-0">
   <dt class="col-sm-4">Request</dt><dd class="col-sm-8" id="rvRequest"></dd>
   <dt class="col-sm-4">Test</dt><dd class="col-sm-8" id="rvTest"></dd>
   <dt class="col-sm-4">Category</dt><dd class="col-sm-8" id="rvCategory"></dd>
   <dt class="col-sm-4">Urgency</dt><dd class="col-sm-8" id="rvUrgency"></dd>
   <dt class="col-sm-4">Status</dt><dd class="col-sm-8" id="rvStatus"></dd>
   <dt class="col-sm-4">Started</dt><dd class="col-sm-8" id="rvStarted"></dd>
   <dt class="col-sm-4">Result</dt><dd class="col-sm-8" id="rvResult"></dd>
   <dt class="col-sm-4">Result notes</dt><dd class="col-sm-8" id="rvNotes" style="white-space:pre-wrap"></dd>
   <dt class="col-sm-4">Verifier feedback</dt><dd class="col-sm-8" id="rvFeedback" style="white-space:pre-wrap"></dd>
  </dl></div>
  <div class="modal-footer"><button type="button" class="btn btn-secondary js-close-review-dialog">Close</button></div>
 </div></div>
</div>
<div class="modal fade" id="reviewDeactivateModal" tabindex="-1" role="dialog" aria-labelledby="reviewDeactivateTitle" aria-hidden="true">
 <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content">
  <div class="modal-header bg-danger text-white"><h5 class="modal-title" id="reviewDeactivateTitle">De-Activate Returned Test</h5><button type="button" class="close text-white js-close-review-dialog" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
  <form id="reviewDeactivateForm" action="@Url.Action("DeactivateReviewTest", "Tests", new { area = "Technician" })" method="post">
   @Html.AntiForgeryToken()
   <input type="hidden" name="testRequestTestTypeId" id="reviewDeactivateId" />
   <div class="modal-body"><p id="reviewDeactivateName"></p><label for="reviewDeactivateReason">Reason for de-activation <span class="text-danger">*</span></label><textarea id="reviewDeactivateReason" name="reason" class="form-control" maxlength="500" rows="3" required></textarea><small class="text-muted">This action is recorded in the audit trail. Only your returned tests can be de-activated.</small><div class="alert alert-danger mt-3 d-none" id="reviewDeactivateError" role="alert"></div></div>
   <div class="modal-footer"><button type="button" class="btn btn-light js-close-review-dialog">Cancel</button><button type="submit" class="btn btn-danger" id="reviewDeactivateSubmit">De-Activate</button></div>
  </form>
 </div></div>
</div>
<script>
(function(){
 function showModal(el){ if(window.bootstrap?.Modal){bootstrap.Modal.getOrCreateInstance(el).show();}else if(window.jQuery?.fn?.modal){window.jQuery(el).modal('show');}else{el.style.display='block';el.classList.add('show');el.removeAttribute('aria-hidden');document.body.classList.add('modal-open');} }
 function hideModal(el){if(window.bootstrap?.Modal){bootstrap.Modal.getOrCreateInstance(el).hide();}else if(window.jQuery?.fn?.modal){window.jQuery(el).modal('hide');}else{el.style.display='none';el.classList.remove('show');el.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');}}
 document.addEventListener('click',function(e){
  const view=e.target.closest('.js-view-review');
  if(view){e.preventDefault();const fields={rvRequest:'request',rvTest:'test',rvCategory:'category',rvUrgency:'urgency',rvStatus:'status',rvStarted:'started',rvResult:'result',rvNotes:'notes',rvFeedback:'feedback'};Object.entries(fields).forEach(([id,key])=>document.getElementById(id).textContent=view.dataset[key]||'—');showModal(document.getElementById('reviewDetailsModal'));return;}
  const deactivate=e.target.closest('.js-review-deactivate');
  if(deactivate){e.preventDefault();document.getElementById('reviewDeactivateId').value=deactivate.dataset.id;document.getElementById('reviewDeactivateName').textContent='De-activate '+(deactivate.dataset.test||'this test')+'?';document.getElementById('reviewDeactivateReason').value='';document.getElementById('reviewDeactivateError').classList.add('d-none');showModal(document.getElementById('reviewDeactivateModal'));return;}
  const close=e.target.closest('.js-close-review-dialog');if(close){e.preventDefault();hideModal(close.closest('.modal'));}
 });
 document.getElementById('reviewDeactivateForm').addEventListener('submit',async function(e){
  e.preventDefault();const form=this;const reason=document.getElementById('reviewDeactivateReason');if(!reason.value.trim()){reason.focus();return;}
  const submit=document.getElementById('reviewDeactivateSubmit');const error=document.getElementById('reviewDeactivateError');submit.disabled=true;error.classList.add('d-none');
  try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}});const body=await response.json().catch(()=>null);if(!response.ok||!body?.success)throw new Error(body?.message||'De-activation failed (HTTP '+response.status+').');window.location.reload();}
  catch(ex){error.textContent=ex.message;error.classList.remove('d-none');submit.disabled=false;}
 });
})();
</script>
<div id="verifyModalHost"></div>
<div id="correctionModalHost"></div>

<script>
    (function() {
        const search = document.getElementById('reviewSearch');
        const filter = document.getElementById('urgencyFilter');
        const statusFilter = document.getElementById('statusFilter');
        const rows = Array.from(document.querySelectorAll('.review-row'));
        const count = document.getElementById('reviewCount');
        const empty = document.getElementById('reviewNoMatches');
        if (!search || !filter || !rows.length) return;

        const levels = [...new Set(rows.map(row => row.dataset.urgency))].sort();
        levels.forEach(level => {
            const option = document.createElement('option');
            option.value = level;
            option.textContent = level;
            filter.appendChild(option);
        });

        function refresh() {
            const query = search.value.trim().toLowerCase();
            const urgency = filter.value;
            const status = statusFilter.value;
            let visible = 0;
            rows.forEach(row => {
                const matches = (!query || row.dataset.search.includes(query)) &&
                    (!urgency || row.dataset.urgency === urgency) &&
                    (!status || row.dataset.status === status);
                row.hidden = !matches;
                if (matches) visible++;
            });
            if (count) count.textContent = visible;
            if (empty) empty.style.display = visible ? 'none' : 'block';
        }
        search.addEventListener('input', refresh);
        filter.addEventListener('change', refresh);
        statusFilter.addEventListener('change', refresh);
    })();
</script>

<script>
    (function() {
        const host = document.getElementById('verifyModalHost');
        if (!host) return;
        function closeModal() {
            const modal = host.querySelector('#verifyTestModal');
            if (!modal) return;
            if (window.bootstrap && window.bootstrap.Modal) {
                const instance = window.bootstrap.Modal.getInstance(modal);
                if (instance) instance.hide();
            } else if (window.jQuery && window.jQuery.fn.modal) {
                window.jQuery(modal).modal('hide');
            } else {
                modal.style.display = 'none';
                modal.classList.remove('show');
                document.body.classList.remove('modal-open');
            }
        }
        // Checklist is loaded dynamically with the verification modal.
        document.addEventListener('change', function(event) {
            if (!event.target.matches('#verifyModalHost .vt-check')) return;
            const modal = host.querySelector('#verifyTestModal');
            if (!modal) return;
            const checks = Array.from(modal.querySelectorAll('.vt-check'));
            checks.forEach(c => c.closest('.vt-check-row')?.classList.toggle('checked', c.checked));
            const checked = checks.filter(c => c.checked).length;
            modal.querySelector('#vtCheckedCount').textContent = checked;
            const ready = checks.length === 5 && checked === 5;
            modal.querySelector('[data-decision="Verify"]').disabled = !ready;
            const status = modal.querySelector('#vtVerificationStatus');
            status.classList.toggle('ready', ready);
            status.textContent = ready ? 'All 5 checks complete. Ready to verify.' : 'Complete all 5 checks to verify.';
        });
        document.addEventListener('click', async function(event) {
            const trigger = event.target.closest('.js-open-verify');
            if (trigger) {
                event.preventDefault();
                trigger.disabled = true;
                try {
                    const response = await fetch(trigger.dataset.url, { credentials: 'same-origin' });
                    if (!response.ok) throw new Error('Unable to load verification form (HTTP ' + response.status + ').');
                    host.innerHTML = await response.text();
                    const modal = host.querySelector('#verifyTestModal');
                    if (!modal) throw new Error('Verification modal was not found in the response.');
                    if (window.bootstrap && window.bootstrap.Modal) {
                        window.bootstrap.Modal.getOrCreateInstance(modal).show();
                    } else if (window.jQuery && window.jQuery.fn.modal) {
                        window.jQuery(modal).modal('show');
                    } else {
                        modal.style.display = 'block';
                        modal.classList.add('show');
                        document.body.classList.add('modal-open');
                    }
                } catch (error) {
                    alert(error.message);
                } finally {
                    trigger.disabled = false;
                }
                return;
            }
            const decisionButton = event.target.closest('#verifyModalHost .js-verify-decision');
            if (decisionButton) {
                event.preventDefault();
                const form = host.querySelector('#verifyTestForm');
                const notes = host.querySelector('#verifyTestNotes');
                const decision = decisionButton.dataset.decision;
                if (!form || !notes) return;
                if (decision === 'Verify' && !Array.from(host.querySelectorAll('.vt-check')).every(c => c.checked)) {
                    alert('Complete all five verification checks before verifying this test.');
                    return;
                }
                if (decision === 'ReturnForReview' && !notes.value.trim()) {
                    notes.classList.add('is-invalid');
                    notes.focus();
                    return;
                }
                notes.classList.remove('is-invalid');
                host.querySelector('#verifyTestDecision').value = decision;
                form.requestSubmit ? form.requestSubmit() : form.submit();
                return;
            }
            if (event.target.closest('#verifyModalHost .js-close-verify-modal')) {
                closeModal();
            }
        });
    })();
</script>

<script>
    (function() {
        const host = document.getElementById('correctionModalHost');
        if (!host) return;
        function closeCorrection() {
            const modal = host.querySelector('#correctTestModal');
            if (!modal) return;
            if (window.bootstrap?.Modal) {
                window.bootstrap.Modal.getInstance(modal)?.hide();
            } else if (window.jQuery?.fn?.modal) {
                window.jQuery(modal).modal('hide');
            } else {
                modal.style.display = 'none';
                modal.classList.remove('show');
                document.body.classList.remove('modal-open');
            }
        }
        document.addEventListener('click', async function(event) {
            const trigger = event.target.closest('.js-open-correction');
            if (trigger) {
                event.preventDefault();
                trigger.disabled = true;
                try {
                    const response = await fetch(trigger.dataset.url, { credentials: 'same-origin' });
                    if (!response.ok) throw new Error('Unable to load correction form (HTTP ' + response.status + ').');
                    host.innerHTML = await response.text();
                    const modal = host.querySelector('#correctTestModal');
                    if (!modal) throw new Error('Correction modal was not found in the response.');
                    if (window.bootstrap?.Modal) {
                        window.bootstrap.Modal.getOrCreateInstance(modal).show();
                    } else if (window.jQuery?.fn?.modal) {
                        window.jQuery(modal).modal('show');
                    } else {
                        modal.style.display = 'block';
                        modal.classList.add('show');
                        document.body.classList.add('modal-open');
                    }
                } catch (error) { alert(error.message); }
                finally { trigger.disabled = false; }
                return;
            }
            if (event.target.closest('#correctionModalHost .js-close-correction')) {
                event.preventDefault();
                closeCorrection();
            }
        });
    })();
</script>
