@model NMB_HLabSys.Areas.Technician.Models.TestResultModel
@{ Layout = null;
   var test = Model.TestRequestTestType;
   var request = test?.TestRequest;
   var range = (Model.ReferenceMin?.ToString("0.##") ?? "—") + " to " + (Model.ReferenceMax?.ToString("0.##") ?? "—");
}
<style>
.result-modal-header{padding:20px 24px;border:0;background:linear-gradient(135deg,#073b5c,#075985,#0284c7);color:#fff}
.result-modal-icon{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-right:13px;border-radius:10px;background:rgba(255,255,255,.15);font-size:18px}
.result-modal-heading{font-size:17px;font-weight:700;color:#fff;margin:0 0 3px}
.result-modal-subheading{font-size:11px;color:rgba(255,255,255,.8)}
.result-modal-close{border:0;background:transparent;color:#fff;font-size:27px;line-height:1;cursor:pointer}
.result-modal-body{padding:24px;background:#f8fafc;max-height:65vh;overflow-y:auto}
.result-modal-section{background:#fff;border:1px solid #eef2f7;border-radius:11px;padding:18px;margin-bottom:16px;box-shadow:0 3px 12px rgba(15,23,42,.04)}
.result-modal-section-title{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:16px}
.result-modal-label{display:block;font-size:10px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.3px;margin-bottom:5px}
.result-modal-value{font-size:12px;font-weight:600;color:#334155;overflow-wrap:anywhere}
.result-modal-info{border:1px solid #e2e8f0;border-radius:7px;background:#f8fafc;padding:10px 12px}
.result-modal-footer{padding:15px 20px;border-top:1px solid #eef2f7;background:#fff;display:flex;justify-content:flex-end;gap:8px}
.result-modal-pill{display:inline-block;padding:5px 10px;border-radius:50px;font-size:11px;font-weight:700;background:#e0f2fe;color:#0369a1}
.result-modal-pill.alert-pill{background:#fee2e2;color:#991b1b}
@@media(max-width:767px){.result-modal-body{padding:15px}.result-modal-section{padding:14px}}
</style>
<div class="modal-header result-modal-header">
 <div class="d-flex align-items-center"><div class="result-modal-icon"><i class="fas fa-eye"></i></div>
  <div><h5 class="result-modal-heading" id="testResultModalLabel">Laboratory Result Details</h5><div class="result-modal-subheading">Read-only laboratory result information</div></div></div>
 <button type="button" class="result-modal-close" data-dismiss="modal" aria-label="Close">&times;</button>
</div>
<div class="modal-body result-modal-body">
 <div class="result-modal-section"><h6 class="result-modal-section-title"><i class="fas fa-file-medical text-primary mr-2"></i>Test Request</h6>
  <div class="row">
   <div class="col-md-4 mb-3"><span class="result-modal-label">Request Number</span><span class="result-modal-value">@(request?.RequestNumber ?? "N/A")</span></div>
   <div class="col-md-4 mb-3"><span class="result-modal-label">Patient</span><span class="result-modal-value">@(request?.Patient?.FullName ?? "N/A")</span></div>
   <div class="col-md-4 mb-3"><span class="result-modal-label">Requesting Doctor</span><span class="result-modal-value">@(request?.Doctor?.FullName ?? "N/A")</span></div>
   <div class="col-md-6"><span class="result-modal-label">Test Type</span><span class="result-modal-value">@(test?.TestType?.Name ?? "N/A")</span></div>
   <div class="col-md-6"><span class="result-modal-label">Test Status</span><span class="result-modal-pill">@(test?.Status ?? "Unknown")</span></div>
  </div>
 </div>
 <div class="result-modal-section"><h6 class="result-modal-section-title"><i class="fas fa-flask text-primary mr-2"></i>Captured Result</h6>
  <div class="row">
   <div class="col-md-6 mb-3"><span class="result-modal-label">Result ID</span><div class="result-modal-info result-modal-value">#@Model.TestResultId</div></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Result Name</span><div class="result-modal-info result-modal-value">@Model.ResultName</div></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Value</span><div class="result-modal-info result-modal-value">@Model.ResultValue @(Model.MeasurementUnit ?? "")</div></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Reference Range</span><div class="result-modal-info result-modal-value">@range</div></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Flag</span><span class="result-modal-pill @(Model.IsAbnormal ? "alert-pill" : "")">@(Model.ResultFlag ?? (Model.IsAbnormal ? "Abnormal" : "Normal"))</span></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Captured At (UTC)</span><span class="result-modal-value">@Model.CapturedDateTime.ToString("dd MMM yyyy HH:mm")</span></div>
   <div class="col-12"><span class="result-modal-label">Result Notes</span><div class="result-modal-info result-modal-value" style="white-space:pre-wrap">@(Model.Notes ?? "No notes recorded")</div></div>
  </div>
 </div>
 <div class="result-modal-section"><h6 class="result-modal-section-title"><i class="fas fa-user-check text-primary mr-2"></i>Verification</h6>
  <div class="row">
   <div class="col-md-6 mb-3"><span class="result-modal-label">Verification Status</span><span class="result-modal-pill">@(Model.VerifiedDateTime.HasValue ? "Verified" : Model.RequiresReview ? "Requires Review" : "Not Verified")</span></div>
   <div class="col-md-6 mb-3"><span class="result-modal-label">Verified At (UTC)</span><span class="result-modal-value">@(Model.VerifiedDateTime?.ToString("dd MMM yyyy HH:mm") ?? "—")</span></div>
   <div class="col-12 mb-3"><span class="result-modal-label">Verification Notes</span><div class="result-modal-info result-modal-value">@(Model.VerificationNotes ?? "No verification notes")</div></div>
   @if(Model.RequiresReview){<div class="col-12"><span class="result-modal-label">Review Notes</span><div class="result-modal-info result-modal-value">@(Model.ReviewNotes ?? "No review notes")</div></div>}
  </div>
 </div>
</div>
<div class="modal-footer result-modal-footer">
 <a asp-area="Technician" asp-controller="Tests" asp-action="VerificationHistory" asp-route-id="@Model.TestRequestTestTypeId" class="btn btn-outline-primary btn-sm"><i class="fas fa-history mr-1"></i>Verification History</a>
 <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Close</button>
</div>
