@model IEnumerable<NMB_HLabSys.Areas.Technician.ViewModels.TechnicianAssignmentRowViewModel>
@{
    ViewData["Title"] = "My Manager-Assigned Test Types";
    Layout = "_TechnicianLayout";
    var testTypes = Model?.ToList() ?? new List<NMB_HLabSys.Areas.Technician.ViewModels.TechnicianAssignmentRowViewModel>();
    var managerNames = ViewBag.ManagerNamesByTestType as Dictionary<int, string> ?? new Dictionary<int, string>();
    var requestNumbers = ViewBag.RequestNumbersByTestType as Dictionary<int, List<string>> ?? new Dictionary<int, List<string>>();
    var deadlineRows = ViewBag.DeadlineRowsByTestType as Dictionary<int, List<string[]>> ?? new Dictionary<int, List<string[]>>();
    var assignmentDates = ViewBag.AssignmentDatesByTestType as Dictionary<int, DateTime> ?? new Dictionary<int, DateTime>();
    var requestTechnicians = ViewBag.TechniciansByTestTypeRequest as Dictionary<int, Dictionary<string, List<string>>>
        ?? new Dictionary<int, Dictionary<string, List<string>>>();
}
<style>
    .assigned-page { min-height:100vh; background:#f4f7fb; padding-bottom:55px; }
    .assigned-hero { background:linear-gradient(135deg,#073b5c,#075985,#0284c7); color:white; padding:40px 24px 75px; }
    .assigned-hero h1 { font-size:29px; font-weight:750; margin:0 0 8px; color:white; }
    .assigned-hero p { font-size:13px; color:rgba(255,255,255,.85); margin:0; }
    .assigned-body { position:relative; margin-top:-42px; padding:0 18px; }
    .assigned-card { background:white; border-radius:13px; box-shadow:0 5px 22px rgba(15,23,42,.09); overflow:hidden; margin-bottom:22px; }
    .assigned-stat { padding:23px 26px; }
    .assigned-stat .count { font-size:31px; font-weight:750; color:#075985; }
    .assigned-stat .label { font-size:12px; font-weight:650; color:#64748b; }
    .assigned-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px; padding:22px 24px; border-bottom:1px solid #e2e8f0; }
    .assigned-head h2 { font-size:17px; font-weight:750; color:#0f172a; margin:0; }
    .assigned-head p { color:#64748b; font-size:12px; margin:5px 0 0; }
    .assigned-search { max-width:330px; width:100%; border:1px solid #cbd5e1; border-radius:8px; padding:10px 12px; font-size:12px; }
    .assigned-table { width:100%; border-collapse:separate; border-spacing:0; table-layout:auto; }
    .assigned-table th:nth-child(1) { min-width:155px; }
    .assigned-table th:nth-child(2) { min-width:165px; }
    .assigned-table th:nth-child(3) { min-width:175px; }
    .assigned-table th:nth-child(4), .assigned-table th:nth-child(5) { min-width:105px; }
    .assigned-table th:nth-child(6) { min-width:135px; }
    .assigned-table th:nth-child(7) { min-width:135px; }
    .assigned-table th:nth-child(8) { min-width:180px; }
    .assigned-table th:nth-child(9) { min-width:195px; }
    .deadline-overdue { display:inline-block; padding:5px 9px; border-radius:6px; background:#fee2e2; color:#991b1b; font-weight:750; font-size:11px; }
    .deadline-ok { display:inline-block; padding:5px 9px; border-radius:6px; background:#e0f2fe; color:#075985; font-weight:700; font-size:11px; }
    .deadline-table { width:100%; border-collapse:collapse; font-size:12px; }
    .deadline-table th,.deadline-table td { padding:9px 7px; border-bottom:1px solid #e2e8f0; text-align:left; vertical-align:top; }
    .deadline-table th { color:#475569; background:#f8fafc; }
    .assigned-table td { vertical-align:middle; }
    .assigned-table .name { max-width:200px; line-height:1.55; }
    .assigned-table .assignment-row:hover td { background:#f7fbff; }
    .assigned-meta { display:flex; flex-direction:column; gap:5px; }
    .assigned-muted { color:#94a3b8; font-size:11px; }
    .assigned-count-pill { display:inline-flex; align-items:center; gap:6px; border-radius:7px; padding:6px 9px; background:#eff6ff; color:#075985; font-size:11px; font-weight:750; width:max-content; }
    .assigned-count-pill.team-pill { background:#f5f3ff; color:#6d28d9; }
    .assigned-preview { font-size:11px; color:#64748b; line-height:1.5; overflow-wrap:anywhere; }
    .assigned-more { font-size:11px; font-weight:700; color:#0369a1; border:0; background:transparent; padding:0; text-align:left; cursor:pointer; width:max-content; }
    .assigned-more:hover { text-decoration:underline; }
    .assigned-actions { display:grid!important; grid-template-columns:repeat(2,minmax(0,1fr)); min-width:190px!important; max-width:220px; gap:7px!important; }
    .assigned-action { justify-content:center; white-space:nowrap; }
    .assigned-foot { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
    .assigned-help { font-size:11px; color:#94a3b8; }
    @@media (max-width:1200px) { .assigned-table { min-width:1120px; } }
    @@media (max-width:600px) {
        .assigned-hero { padding:28px 15px 68px; }
        .assigned-hero h1 { font-size:23px; }
        .assigned-body { padding:0 10px; }
        .assigned-head { padding:18px 15px; }
        .assigned-search { max-width:none; }
        .assigned-table { min-width:1050px; }
    }
    .assigned-table th { background:#f8fafc; font-size:11px; text-transform:uppercase; letter-spacing:.35px; color:#64748b; padding:14px; white-space:nowrap; }
    .assigned-table td { border-top:1px solid #edf2f7; padding:16px 14px; font-size:12px; color:#334155; }
    .assigned-table tr:hover td { background:#f8fcff; }
    .assigned-table .name { font-weight:750; color:#075985; }
    .assigned-active { background:#dcfce7; color:#166534; font-size:11px; font-weight:700; border-radius:18px; padding:6px 10px; white-space:nowrap; }
    .assigned-view { display:inline-flex; align-items:center; gap:6px; padding:8px 12px; border-radius:7px; background:#e0f2fe; color:#0369a1; font-weight:650; text-decoration:none!important; }
    .assigned-view:hover { background:#0284c7; color:white; }
    .request-number { display:inline-block; background:#eff6ff; color:#075985; border-radius:6px; padding:5px 8px; margin:2px 4px 2px 0; font-size:11px; font-weight:650; }
    .request-team { margin-bottom:8px; }
    .request-team .team-number { font-weight:700; color:#075985; }
    .request-team .team-name { display:block; font-size:11px; color:#334155; margin:3px 0; }
    .assigned-actions { display:flex; flex-wrap:wrap; gap:6px; min-width:255px; }
    .assigned-action { border:0; border-radius:7px; padding:7px 9px; font-size:11px; font-weight:650; cursor:pointer; text-decoration:none!important; display:inline-flex; align-items:center; gap:5px; }
    .action-details { background:#e0f2fe; color:#075985; }
    .action-requests { background:#f1f5f9; color:#334155; }
    .action-team { background:#ede9fe; color:#5b21b6; }
    .action-select { background:#dcfce7; color:#166534; }
    .assigned-action:hover { filter:brightness(.94); }
    .assigned-modal[hidden] { display:none!important; }
    .assigned-modal { position:fixed; inset:0; z-index:1055; display:flex; align-items:center; justify-content:center; padding:16px; background:rgba(15,23,42,.65); }
    .assigned-modal-panel { background:white; border-radius:12px; width:min(650px,100%); max-height:85vh; overflow:auto; box-shadow:0 20px 60px rgba(0,0,0,.25); }
    .assigned-modal-header { padding:18px 22px; background:#075985; color:white; display:flex; justify-content:space-between; align-items:center; }
    .assigned-modal-header h3 { font-size:17px; margin:0; color:white; }
    .assigned-modal-close { border:0; background:transparent; color:white; font-size:24px; cursor:pointer; }
    .assigned-modal-content { padding:22px; }
    .assigned-modal-content dt { font-weight:700; color:#334155; margin-top:10px; }
    .assigned-modal-content dd { margin:3px 0 12px; }
    .assigned-empty { text-align:center; color:#64748b; padding:50px 18px!important; }
    .assigned-foot { padding:13px 24px; font-size:12px; color:#64748b; border-top:1px solid #edf2f7; }
</style>
<div class="assigned-page">
    <div class="assigned-hero">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center flex-wrap" style="gap:16px">
                <div>
                    <h1><i class="fas fa-user-shield mr-2"></i> My Manager-Assigned Test Types</h1>
                    <p>Only test types authorized for you by the Laboratory Manager are displayed here. You can perform multiple authorized tests; other technicians can independently perform different tests within the same patient request.</p>
                </div>
                <a asp-area="Technician" asp-controller="Home" asp-action="Index" class="btn btn-light btn-sm">Dashboard</a>
            </div>
        </div>
    </div>
    <div class="container-fluid assigned-body">
        @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
        @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
        <div class="assigned-card assigned-stat">
            <div class="label">Active Test Types Assigned by Manager</div>
            <div class="count">@testTypes.Count</div>
            <div class="label">Your authorization list — not patient-request tests</div>
        </div>
        <div class="assigned-card">
            <div class="assigned-head">
                <div>
                    <h2>Authorized Laboratory Test Types</h2>
                    <p>Only active manager authorizations appear. Request numbers are shown for unclaimed tests or tests assigned to you. For requests you participate in, see the technicians performing its different tests.</p>
                </div>
                <input id="assignedSearch" type="search" class="assigned-search" placeholder="Search test type, request, category or manager..." aria-label="Search assigned test types" />
            </div>
            <div class="table-responsive" style="overflow-x:auto">
                <table class="assigned-table" id="managerAssignmentsTable">
                    <thead><tr>
                        <th>Test Type</th><th>Associated Request Number(s)</th><th>Technicians Per Request</th><th>Category</th><th>Sample Type</th><th>Manager Full Name</th><th>Authorization Status</th><th>Test Deadlines</th><th>Action</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var test in testTypes)
                    {
                        <tr class="assignment-row">
                            <td class="name">@test.Name</td>
                            <td>
                                @if (requestNumbers.TryGetValue(test.TestTypeId, out var numbers) && numbers.Any())
                                {
                                    <div class="assigned-meta">
                                        <span class="assigned-count-pill"><i class="fas fa-file-medical"></i> @numbers.Count request@(numbers.Count == 1 ? "" : "s")</span>
                                        <span class="assigned-preview">Latest shown: @numbers.Last()</span>
                                        <button type="button" class="assigned-more" data-modal-target="requests-@test.TestTypeId">
                                            View all requests <i class="fas fa-arrow-right ml-1"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="assigned-muted">No associated requests</span>
                                }
                            </td>
                            <td>
                                @if (requestTechnicians.TryGetValue(test.TestTypeId, out var perRequest) && perRequest.Any())
                                {
                                    var participatingNames = perRequest.Values.SelectMany(names => names).Distinct().ToList();
                                    <div class="assigned-meta">
                                        <span class="assigned-count-pill team-pill"><i class="fas fa-users"></i> @participatingNames.Count technician@(participatingNames.Count == 1 ? "" : "s")</span>
                                        <span class="assigned-preview">Across @perRequest.Count request@(perRequest.Count == 1 ? "" : "s")</span>
                                        <button type="button" class="assigned-more" data-modal-target="team-@test.TestTypeId">
                                            View request teams <i class="fas fa-arrow-right ml-1"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="assigned-muted">No team information</span>
                                }
                            </td>
                            <td>@(test.Category ?? "Not specified")</td>
                            <td>@(test.SampleType ?? "Not specified")</td>
                            <td>@(managerNames.TryGetValue(test.TestTypeId, out var manager) ? manager : "Manager not recorded")</td>
                            <td><span class="assigned-active"><i class="fas fa-check-circle mr-1"></i> Manager Assigned</span></td>
                            <td>
                                @if (deadlineRows.TryGetValue(test.TestTypeId, out var deadlines) && deadlines.Any())
                                {
                                    var overdueCount = deadlines.Count(x => x[4] == "Overdue");
                                    <div class="assigned-meta">
                                        @if (overdueCount > 0)
                                        {
                                            <span class="deadline-overdue"><i class="fas fa-exclamation-triangle mr-1"></i> @overdueCount overdue</span>
                                        }
                                        else
                                        {
                                            <span class="deadline-ok">No overdue tests</span>
                                        }
                                        <button type="button" class="assigned-more" data-modal-target="deadlines-@test.TestTypeId">View expected completion</button>
                                    </div>
                                }
                                else { <span class="assigned-muted">No test deadlines</span> }
                            </td>
                            <td>
                                <div class="assigned-actions">
                                    <button type="button" class="assigned-action action-details" data-modal-target="details-@test.TestTypeId" title="View authorization details"><i class="fas fa-eye"></i> Details</button>
                                    <button type="button" class="assigned-action action-requests" data-modal-target="requests-@test.TestTypeId" title="View associated requests"><i class="fas fa-clipboard-list"></i> Requests</button>
                                    <button type="button" class="assigned-action action-team" data-modal-target="team-@test.TestTypeId" title="View participating technicians"><i class="fas fa-users"></i> Technicians</button>
                                    <a asp-area="Technician" asp-controller="Tests" asp-action="Select" asp-route-testTypeId="@test.TestTypeId" class="assigned-action action-select" title="Select an eligible patient test"><i class="fas fa-flask"></i> Select Test</a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!testTypes.Any())
                    {
                        <tr class="empty-row"><td colspan="9" class="assigned-empty">No active test types have been assigned to you by the Laboratory Manager.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="assigned-foot"><span id="assignedCount">Showing @testTypes.Count authorized test type(s).</span><span class="assigned-help"><i class="fas fa-info-circle mr-1"></i> Select “View all requests” or “View request teams” for the full details.</span></div>
        </div>
    </div>

    @foreach (var test in testTypes)
    {
        var hasRequests = requestNumbers.TryGetValue(test.TestTypeId, out var numbersForModal) && numbersForModal.Any();
        var hasTeams = requestTechnicians.TryGetValue(test.TestTypeId, out var teamsForModal) && teamsForModal.Any();
        <div class="assigned-modal" id="deadlines-@test.TestTypeId" role="dialog" aria-modal="true" aria-label="Test deadlines for @test.Name" hidden>
            <div class="assigned-modal-panel" style="width:min(850px,100%)">
                <div class="assigned-modal-header"><h3>Expected Completion — @test.Name</h3><button type="button" class="assigned-modal-close" aria-label="Close dialog">&times;</button></div>
                <div class="assigned-modal-content">
                    <p class="text-muted">Deadlines are calculated separately for each test from its UTC start time and turnaround time.</p>
                    @if (deadlineRows.TryGetValue(test.TestTypeId, out var details) && details.Any())
                    {
                        <div class="table-responsive"><table class="deadline-table">
                            <thead><tr><th>Request</th><th>Started</th><th>Turnaround</th><th>Expected completion</th><th>Deadline status</th></tr></thead>
                            <tbody>
                            @foreach (var entry in details)
                            {
                                <tr>
                                    <td>@entry[0]</td><td>@entry[1]</td><td>@entry[2]</td><td>@entry[3]</td>
                                    <td>@if (entry[4] == "Overdue") { <span class="deadline-overdue">Overdue</span> } else { <span class="deadline-ok">@entry[4]</span> }</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                    }
                    else { <p class="text-muted">No associated test deadlines available.</p> }
                </div>
            </div>
        </div>
        <div class="assigned-modal" id="details-@test.TestTypeId" role="dialog" aria-modal="true" aria-label="Assignment details for @test.Name" hidden>
            <div class="assigned-modal-panel">
                <div class="assigned-modal-header"><h3>Assignment Details — @test.Name</h3><button type="button" class="assigned-modal-close" aria-label="Close dialog">&times;</button></div>
                <div class="assigned-modal-content">
                    <dl>
                        <dt>Test Type</dt><dd>@test.Name</dd>
                        <dt>Category</dt><dd>@(test.Category ?? "Not specified")</dd>
                        <dt>Sample Type</dt><dd>@(test.SampleType ?? "Not specified")</dd>
                        <dt>Laboratory Manager</dt><dd>@(managerNames.TryGetValue(test.TestTypeId, out var assignedManager) ? assignedManager : "Manager not recorded")</dd>
                        <dt>Assigned Date (UTC)</dt><dd>@(assignmentDates.TryGetValue(test.TestTypeId, out var assignedOn) ? assignedOn.ToString("dd MMM yyyy HH:mm") : "Not recorded")</dd>
                        <dt>Authorization Status</dt><dd><span class="assigned-active">Manager Assigned</span></dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="assigned-modal" id="requests-@test.TestTypeId" role="dialog" aria-modal="true" aria-label="Associated requests for @test.Name" hidden>
            <div class="assigned-modal-panel">
                <div class="assigned-modal-header"><h3>Associated Requests — @test.Name</h3><button type="button" class="assigned-modal-close" aria-label="Close dialog">&times;</button></div>
                <div class="assigned-modal-content">
                    @if (hasRequests)
                    {
                        <p>Requests with an unclaimed test of this authorized type, or a test assigned to you:</p>
                        <div style="display:flex; flex-wrap:wrap; gap:6px;">
                            @foreach (var number in numbersForModal!) { <span class="request-number">@number</span> }
                        </div>
                    }
                    else { <p class="text-muted">No associated requests currently visible to you.</p> }
                </div>
            </div>
        </div>
        <div class="assigned-modal" id="team-@test.TestTypeId" role="dialog" aria-modal="true" aria-label="Request technicians for @test.Name" hidden>
            <div class="assigned-modal-panel">
                <div class="assigned-modal-header"><h3>Technicians Per Request — @test.Name</h3><button type="button" class="assigned-modal-close" aria-label="Close dialog">&times;</button></div>
                <div class="assigned-modal-content">
                    @if (hasTeams)
                    {
                        <p class="text-muted">Other technicians are shown only for requests you already participate in.</p>
                        @foreach (var entry in teamsForModal!.OrderBy(x => x.Key))
                        {
                            <div class="request-team" style="padding:12px 14px;border:1px solid #e2e8f0;border-radius:9px;margin-bottom:10px;background:#f8fafc"><strong class="team-number">@entry.Key</strong>
                                @if (entry.Value.Any())
                                {
                                    @foreach (var technicianName in entry.Value) { <span class="team-name"><i class="fas fa-user mr-1"></i>@technicianName</span> }
                                }
                                else { <span class="team-name text-muted">No technicians shown for this request</span> }
                            </div>
                        }
                    }
                    else { <p class="text-muted">No request team information currently available.</p> }
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
    <script>
        (function () {
            var search = document.getElementById('assignedSearch');
            var rows = Array.from(document.querySelectorAll('#managerAssignmentsTable .assignment-row'));
            var count = document.getElementById('assignedCount');
            var dialogs = Array.from(document.querySelectorAll('.assigned-modal'));
            var previousFocus = null;
            function closeDialog(dialog) {
                dialog.hidden = true;
                document.body.style.overflow = '';
                if (previousFocus) previousFocus.focus();
            }
            document.querySelectorAll('[data-modal-target]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var dialog = document.getElementById(button.getAttribute('data-modal-target'));
                    if (!dialog) return;
                    previousFocus = button;
                    dialog.hidden = false;
                    document.body.style.overflow = 'hidden';
                    dialog.querySelector('.assigned-modal-close').focus();
                });
            });
            dialogs.forEach(function (dialog) {
                dialog.querySelector('.assigned-modal-close').addEventListener('click', function () { closeDialog(dialog); });
                dialog.addEventListener('click', function (event) { if (event.target === dialog) closeDialog(dialog); });
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    var active = dialogs.find(function (dialog) { return !dialog.hidden; });
                    if (active) closeDialog(active);
                }
            });
            if (!search) return;
            search.addEventListener('input', function () {
                var q = search.value.trim().toLowerCase(), visible = 0;
                rows.forEach(function (row) {
                    var show = row.textContent.toLowerCase().includes(q);
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                count.textContent = 'Showing ' + visible + ' authorized test type(s).';
            });
        })();
    </script>
}
