@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>

@{
    ViewData["Title"] = "Verified Results";
    Layout = "_TechnicianLayout";

    var tests = Model?.ToList()
        ?? new List<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>();
}

<style>
    .vr-hero {
        background: linear-gradient(120deg, #103a76, #1976c9);
        color: #fff;
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 24px;
    }

    .vr-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(18,49,85,.08);
        padding: 22px;
        margin-bottom: 22px;
    }

    .vr-table th {
        background: #eff5fb;
        color: #29486a;
        font-weight: 700;
        border-top: 0;
    }

    .vr-table td {
        vertical-align: middle;
    }

    .vr-pill {
        display: inline-block;
        border-radius: 30px;
        padding: 5px 11px;
        background: #dff5e8;
        color: #176b3b;
        font-size: .82rem;
        font-weight: 700;
    }

    .vr-count {
        background: #1769b2;
        color: #fff;
        padding: 8px 13px;
        border-radius: 9px;
        font-size: .85rem;
        font-weight: 700;
    }

    .vr-btn {
        display: inline-block;
        padding: 9px 14px;
        border: 1px solid #1769b2;
        border-radius: 9px;
        color: #1769b2;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

        .vr-btn:hover {
            background: #1769b2;
            color: #fff;
            text-decoration: none;
        }

    .vr-empty {
        padding: 36px 20px;
        text-align: center;
        color: #728398;
    }

        .vr-empty i {
            font-size: 2rem;
            margin-bottom: 12px;
            color: #1976c9;
        }

    .vr-search {
        max-width: 460px;
    }

    @@media (max-width: 768px) {
        .vr-hero {
            padding: 20px;
        }

        .vr-card {
            padding: 15px;
        }
    }
</style>

<div class="container-fluid py-4">
    <div class="vr-hero">
        <h2 class="mb-2">
            <i class="fas fa-check-circle mr-2"></i>
            Verified Laboratory Results
        </h2>
        <p class="mb-0">
            View independently verified tests and their audit histories.
            Verified results are read-only.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="vr-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <h4 class="mb-2">
                <i class="fas fa-clipboard-check mr-2 text-primary"></i>
                Verified Tests
            </h4>
            <span class="vr-count">@tests.Count test(s)</span>
        </div>

        @if (tests.Any())
        {
            <div class="form-group vr-search">
                <label for="verifiedSearch">Search verified tests</label>
                <input id="verifiedSearch"
                       class="form-control"
                       type="search"
                       autocomplete="off"
                       placeholder="Request number, test name or test ID"
                       aria-controls="verifiedResultsTable" />
            </div>

            <div class="table-responsive">
                <table class="table table-hover vr-table" id="verifiedResultsTable">
                    <thead>
                        <tr>
                            <th scope="col">Request Number</th>
                            <th scope="col">Test ID</th>
                            <th scope="col">Test Type</th>
                            <th scope="col">Completed At</th>
                            <th scope="col">Status</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in tests)
                        {
                            <tr class="verified-row">
                                <td><strong>@(item.TestRequest?.RequestNumber ?? "—")</strong></td>
                                <td>@item.TestRequestTestTypeId</td>
                                <td>@(item.TestType?.Name ?? "Unknown test")</td>
                                <td>@(item.CompletionDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                                <td><span class="vr-pill"><i class="fas fa-check-circle mr-1"></i>Verified</span></td>
                                <td>
                                    <a class="vr-btn"
                                       asp-area="Technician"
                                       asp-controller="Tests"
                                       asp-action="VerificationHistory"
                                       asp-route-id="@item.TestRequestTestTypeId"
                                       aria-label="View verification history for test @item.TestRequestTestTypeId">
                                        <i class="fas fa-history mr-1"></i>
                                        View History
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="vr-empty" id="noSearchResults" style="display:none;" role="status">
                <i class="fas fa-search d-block"></i>
                <h5>No Matching Results</h5>
                <p class="mb-0">No verified tests match your search.</p>
            </div>
        }
        else
        {
            <div class="vr-empty" role="status">
                <i class="fas fa-clipboard-check d-block"></i>
                <h5>No Verified Results</h5>
                <p class="mb-0">No verified tests are available to you yet.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            "use strict";
            const search = document.getElementById("verifiedSearch");
            const rows = document.querySelectorAll("#verifiedResultsTable tbody .verified-row");
            const noMatches = document.getElementById("noSearchResults");
            if (!search || !noMatches) return;

            search.addEventListener("input", function() {
                const term = this.value.trim().toLowerCase();
                let visible = 0;
                rows.forEach(function(row) {
                    const matches = row.textContent.toLowerCase().includes(term);
                    row.style.display = matches ? "" : "none";
                    if (matches) visible++;
                });
                noMatches.style.display = visible === 0 ? "block" : "none";
            });
        })();
    </script>
}
