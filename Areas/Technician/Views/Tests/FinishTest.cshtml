@model NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel

@{
    ViewData["Title"] = "Finish Test";
    Layout = "_TechnicianLayout";

    var testName = Model.TestType?.Name ?? "Unknown Test";
    var requestNumber = Model.TestRequest?.RequestNumber ?? "N/A";
    var status = Model.Status ?? "Unknown";
    var started = Model.StartDateTime?.ToString("dd MMM yyyy, HH:mm")
                  ?? "Not recorded";

    bool canFinish = status == "In Progress"
                     || status == "To Be Reviewed";
}

<style>
    .finish-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding: 35px 20px 70px;
    }

    .finish-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .finish-header {
        background: linear-gradient(135deg, #073b5c, #0284c7);
        padding: 30px;
        border-radius: 15px;
        color: #fff;
        margin-bottom: 25px;
    }

        .finish-header h2 {
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .finish-header p {
            margin: 0;
            color: #dbeafe;
            font-size: 13px;
        }

    .finish-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
    }

    .finish-card-heading {
        padding: 23px 26px;
        border-bottom: 1px solid #e2e8f0;
        color: #073b5c;
        font-size: 17px;
        font-weight: 800;
    }

    .finish-card-body {
        padding: 28px;
    }

    .finish-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        margin-bottom: 25px;
    }

    .finish-info-label {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 7px;
    }

    .finish-info-value {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        overflow-wrap: anywhere;
    }

    .finish-badge {
        display: inline-block;
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .finish-warning {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 18px;
        color: #92400e;
        font-size: 13px;
        line-height: 1.8;
        margin-bottom: 25px;
    }

    .finish-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .finish-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
    }

    .finish-btn-back {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        color: #334155;
    }

    .finish-btn-submit {
        background: #16a34a;
        border: 1px solid #16a34a;
        color: white;
    }

        .finish-btn-submit:hover {
            background: #15803d;
        }

        .finish-btn-submit:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    @@media (max-width: 600px) {
        .finish-info-grid {
            grid-template-columns: 1fr;
        }

        .finish-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .finish-btn {
            width: 100%;
        }
    }
</style>

<div class="finish-page">
    <div class="finish-container">

        <div class="finish-header">
            <h2>
                <i class="fas fa-check-circle me-2"></i>
                Finish Laboratory Test
            </h2>

            <p>
                Review the test details before confirming completion.
            </p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="finish-card">

            <div class="finish-card-heading">
                <i class="fas fa-flask me-2"></i>
                Test Completion Summary
            </div>

            <div class="finish-card-body">

                <div class="finish-info-grid">

                    <div>
                        <div class="finish-info-label">
                            Request Number
                        </div>
                        <div class="finish-info-value">
                            @requestNumber
                        </div>
                    </div>

                    <div>
                        <div class="finish-info-label">
                            Test ID
                        </div>
                        <div class="finish-info-value">
                            #@Model.TestRequestTestTypeId
                        </div>
                    </div>

                    <div>
                        <div class="finish-info-label">
                            Test Name
                        </div>
                        <div class="finish-info-value">
                            @testName
                        </div>
                    </div>

                    <div>
                        <div class="finish-info-label">
                            Current Status
                        </div>
                        <div class="finish-info-value">
                            <span class="finish-badge">
                                @status
                            </span>
                        </div>
                    </div>

                    <div>
                        <div class="finish-info-label">
                            Test Started
                        </div>
                        <div class="finish-info-value">
                            @started
                        </div>
                    </div>

                    <div>
                        <div class="finish-info-label">
                            Completion Time
                        </div>
                        <div class="finish-info-value">
                            Automatically recorded upon confirmation
                        </div>
                    </div>

                </div>

                <div class="finish-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Before completing this test:</strong>

                    <ul class="mb-0 mt-2">
                        <li>Ensure all required measurement results are captured.</li>
                        <li>Verify result values and laboratory notes.</li>
                        <li>Review any abnormal result flags.</li>
                        <li>Confirm the results are ready for submission.</li>
                    </ul>
                </div>

                <div class="finish-actions">

                    <a asp-area="Technician"
                       asp-controller="Tests"
                       asp-action="CaptureResults"
                       asp-route-id="@Model.TestRequestTestTypeId"
                       class="finish-btn finish-btn-back">

                        <i class="fas fa-arrow-left"></i>
                        Back to Results

                    </a>

                    @if (canFinish)
                    {
                        <form asp-area="Technician"
                              asp-controller="Tests"
                              asp-action="FinishTest"
                              asp-route-id="@Model.TestRequestTestTypeId"
                              method="post"
                              id="finishTestForm">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    id="finishTestButton"
                                    class="finish-btn finish-btn-submit">

                                <i class="fas fa-check-double"></i>
                                Confirm & Finish Test

                            </button>

                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="finish-btn finish-btn-submit"
                                disabled>
                            Test Cannot Be Completed
                        </button>
                    }

                </div>

            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById("finishTestForm")
        ?.addEventListener("submit", function(event) {

            if (!confirm(
                "Are you sure you want to complete this laboratory test?"
            )) {
                event.preventDefault();
                return;
            }

            document.getElementById("finishTestButton").disabled = true;
        });
</script>
