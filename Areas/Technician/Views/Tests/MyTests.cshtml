@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>
@using NMB_HLabSys.Areas.Doctor.Models
@using System.Linq
@{
    ViewData["Title"] = "My Tests";
    Layout = "_TechnicianLayout";

    var tests = Model?
        .GroupBy(x => x.TestRequestTestTypeId)
        .Select(group => group.First())
        .ToList()
        ?? new List<NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel>();
    var now = DateTime.UtcNow;
    var inProgress = tests.Count(x => x.Status == "In Progress");
    var completed = tests.Count(x => x.Status == "Completed");
    var toReview = tests.Count(x => x.Status == "To Be Reviewed");
    var overdue = tests.Count(x => x.Status == "In Progress" && x.StartDateTime.HasValue &&
        x.TestType != null && x.StartDateTime.Value.AddHours(x.TestType.TurnAroundTimeHours) < now);
}

<style>
    .mytests-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 55px
    }

    .mytests-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;
        background: linear-gradient(135deg,#073b5c 0%,#075985 45%,#0284c7 100%)
    }

        .mytests-hero:before {
            content: "";
            position: absolute;
            width: 340px;
            height: 340px;
            right: -90px;
            top: -220px;
            border-radius: 50%;
            background: rgba(255,255,255,.07)
        }

        .mytests-hero h1 {
            color: #fff;
            font-size: 30px;
            font-weight: 700;
            margin: 0 0 8px
        }

        .mytests-hero p {
            color: rgba(255,255,255,.83);
            font-size: 14px;
            margin: 0
        }

    .mytests-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 30px;
        padding: 7px 13px;
        margin-bottom: 14px
    }

    .mytests-hero-link {
        display: inline-flex;
        gap: 7px;
        align-items: center;
        padding: 10px 16px;
        border-radius: 8px;
        background: #fff;
        color: #075985 !important;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important
    }

    .mytests-content {
        position: relative;
        z-index: 2;
        margin-top: -48px
    }

    .mytests-summary {
        background: #fff;
        border-radius: 13px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

        .mytests-summary .label {
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 7px
        }

        .mytests-summary .number {
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
            margin: 0
        }

        .mytests-summary .symbol {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 11px;
            background: #e0f2fe;
            color: #0284c7;
            font-size: 19px
        }

            .mytests-summary .symbol.green {
                background: #dcfce7;
                color: #15803d
            }

            .mytests-summary .symbol.orange {
                background: #ffedd5;
                color: #c2410c
            }

            .mytests-summary .symbol.red {
                background: #fee2e2;
                color: #b91c1c
            }

    .mytests-card {
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
        margin-top: 24px;
        overflow: hidden
    }

    .mytests-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #eef2f7
    }

    .mytests-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin: 0
    }

    .mytests-card-subtitle {
        font-size: 11px;
        color: #94a3b8;
        margin: 4px 0 0
    }

    .mytests-filter {
        height: 37px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
        color: #334155
    }

    .mytests-table {
        margin: 0
    }

        .mytests-table thead th {
            background: #f8fafc;
            border-top: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 13px;
            color: #64748b;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            white-space: nowrap
        }

        .mytests-table tbody td {
            padding: 14px 13px;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: #334155;
            font-size: 12px
        }

        .mytests-table tbody tr:hover {
            background: #f8fcff
        }

    .mytests-main {
        display: block;
        color: #075985;
        font-weight: 700
    }

    .mytests-sub {
        display: block;
        color: #94a3b8;
        font-size: 10px;
        margin-top: 4px
    }

    .mytests-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 30px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap
    }

        .mytests-pill.progress {
            background: #e0f2fe;
            color: #0369a1
        }

        .mytests-pill.completed {
            background: #dcfce7;
            color: #166534
        }

        .mytests-pill.review {
            background: #ffedd5;
            color: #9a3412
        }

        .mytests-pill.verified {
            background: #f1f5f9;
            color: #475569
        }

        .mytests-pill.overdue {
            background: #fee2e2;
            color: #b91c1c
        }

        .mytests-pill.ontime {
            background: #ecfdf5;
            color: #047857
        }

        .mytests-pill.urgent {
            background: #ffedd5;
            color: #c2410c
        }

        .mytests-pill.stat {
            background: #fee2e2;
            color: #b91c1c
        }

        .mytests-pill.routine {
            background: #e0f2fe;
            color: #0369a1
        }

    .mytests-detail {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 7px;
        background: #0284c7;
        color: #fff !important;
        text-decoration: none !important;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap
    }

    .mytests-detail {
        border: 0;
        cursor: pointer;
    }

        .mytests-detail:hover {
            background: #0369a1
        }

    .mytests-empty {
        text-align: center;
        padding: 65px 20px
    }

        .mytests-empty i {
            font-size: 28px;
            color: #0284c7;
            margin-bottom: 16px
        }

        .mytests-empty h5 {
            font-size: 15px;
            font-weight: 700;
            color: #334155
        }

        .mytests-empty p {
            font-size: 12px;
            color: #94a3b8
        }

    @@media(max-width:768px) {
        .mytests-hero h1 {
            font-size: 24px
        }

        .mytests-hero-link {
            margin-top: 16px
        }
    }

    /* Clickable summary cards: no underlines in any state */
    a.mytests-card-link,
    a.mytests-card-link:link,
    a.mytests-card-link:visited,
    a.mytests-card-link:hover,
    a.mytests-card-link:active,
    a.mytests-card-link:focus {
        display: block;
        height: 100%;
        color: inherit !important;
        text-decoration: none !important;
        cursor: pointer;
    }

        a.mytests-card-link *,
        a.mytests-card-link:hover *,
        a.mytests-card-link:focus * {
            text-decoration: none !important;
        }

        a.mytests-card-link .mytests-summary {
            transition: transform .2s ease, box-shadow .2s ease;
        }

        a.mytests-card-link:hover .mytests-summary {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(2,132,199,.18);
        }

        a.mytests-card-link:focus-visible {
            outline: 3px solid #0284c7;
            outline-offset: 3px;
            border-radius: 13px;
        }

    /* Table actions */
    .mytests-actions { display:flex; justify-content:flex-end; align-items:center; gap:8px; flex-wrap:wrap; }
    .mytests-perform { display:inline-flex; align-items:center; gap:6px; padding:8px 12px;
        border-radius:7px; background:#15803d; color:#fff !important; font-size:11px;
        font-weight:600; text-decoration:none !important; white-space:nowrap; }
    .mytests-perform:hover, .mytests-perform:focus { background:#166534; color:#fff !important; text-decoration:none !important; }
</style>

<div class="mytests-page">
    <section class="mytests-hero">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="mytests-eyebrow"><i class="fas fa-flask"></i> Technician Workspace</div>
                    <h1>My Laboratory Tests</h1>
                    <p>Monitor your selected tests, turnaround deadlines, and results awaiting attention.</p>
                </div>
                <div class="col-md-4 text-md-right">
                    <a href="/Technician/Tests/Available" class="mytests-hero-link"><i class="fas fa-plus-circle"></i> Available Tests</a>
                </div>
            </div>
        </div>
    </section>

    <div class="container-fluid mytests-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
        }

      
        <div class="row">

            <!-- IN PROGRESS -->
            <div class="col-lg-3 col-sm-6 mb-3">
                <a href="/Technician/Tests/MyTests?status=In%20Progress#myTestsTable"
                   class="mytests-card-link" aria-label="View InProgress tests">
                    <div class="mytests-summary">
                        <div>
                            <div class="label">In Progress</div>
                            <p class="number">@inProgress</p>
                        </div>
                        <div class="symbol">
                            <i class="fas fa-spinner"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- COMPLETED -->
            <div class="col-lg-3 col-sm-6 mb-3">
                <a href="/Technician/Tests/MyTests?status=Completed#myTestsTable"
                   class="mytests-card-link" aria-label="View Completed tests">
                    <div class="mytests-summary">
                        <div>
                            <div class="label">Completed</div>
                            <p class="number">@completed</p>
                        </div>
                        <div class="symbol green">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- TO BE REVIEWED -->
            <div class="col-lg-3 col-sm-6 mb-3">
                <a href="/Technician/Tests/MyTests?status=To%20Be%20Reviewed#myTestsTable"
                   class="mytests-card-link" aria-label="View ToBeReviewed tests">
                    <div class="mytests-summary">
                        <div>
                            <div class="label">To Be Reviewed</div>
                            <p class="number">@toReview</p>
                        </div>
                        <div class="symbol orange">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- OVERDUE -->
            <div class="col-lg-3 col-sm-6 mb-3">
                <a href="/Technician/Tests/Overdue"
                   class="mytests-card-link" aria-label="View Overdue tests">
                    <div class="mytests-summary">
                        <div>
                            <div class="label">Overdue</div>
                            <p class="number">@overdue</p>
                        </div>
                        <div class="symbol red">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                    </div>
                </a>
            </div>

        </div>


        <div class="mytests-card">
            <div class="mytests-card-header">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-2 mb-lg-0">
                        <h2 class="mytests-card-title">Assigned Workload</h2>
                        <p class="mytests-card-subtitle">@tests.Count test(s) assigned to you</p>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-sm-7 mb-2 mb-sm-0"><input id="myTestsSearch" class="form-control mytests-filter" type="search" placeholder="Search request, patient, or test..." aria-label="Search my tests" /></div>
                            <div class="col-sm-5"><select id="myTestsStatus" class="form-control mytests-filter" aria-label="Filter by status"><option value="">All statuses</option><option value="In Progress">In Progress</option><option value="Completed">Completed</option><option value="To Be Reviewed">To Be Reviewed</option><option value="Verified">Verified</option></select></div>
                        </div>
                    </div>
                </div>
            </div>
            @if (tests.Any())
            {
                <div class="table-responsive">
                    <table class="table mytests-table" id="myTestsTable">
                        <thead><tr><th>Request #</th><th>Test / Patient</th><th>Urgency</th><th>Started</th><th>Expected Completion</th><th>Progress</th><th class="text-right">Action</th></tr></thead>
                        <tbody>
                            @foreach (var item in tests)
                            {
                                var urgency = item.TestRequest?.Urgency.ToString() ?? "Routine";
                                var urgencyClass = urgency == "Stat" ? "stat" : urgency == "Urgent" ? "urgent" : "routine";
                                DateTime? due = item.StartDateTime.HasValue && item.TestType != null
                                    ? item.StartDateTime.Value.AddHours(item.TestType.TurnAroundTimeHours)
                                    : (DateTime?)null;
                                var isOverdue = item.Status == "In Progress" && due.HasValue && due.Value < now;
                                var statusClass = item.Status == "In Progress" ? "progress" : item.Status == "Completed" ? "completed" : item.Status == "To Be Reviewed" ? "review" : "verified";
                                <tr data-status="@item.Status">
                                    <td><span class="mytests-main">@(item.TestRequest?.RequestNumber ?? "N/A")</span><span class="mytests-sub">Test #@item.TestRequestTestTypeId</span></td>
                                    <td><span class="mytests-main">@(item.TestType?.Name ?? "Unknown test")</span><span class="mytests-sub">@(item.TestRequest?.Patient?.FullName ?? "Patient unavailable")</span></td>
                                    <td><span class="mytests-pill @urgencyClass">@urgency</span></td>
                                    <td>@(item.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not started")</td>
                                    <td>
                                        @if (due.HasValue)
                                        {
                                            <span class="mytests-main">@due.Value.ToString("dd MMM yyyy HH:mm")</span>
                                            <span class="mytests-sub">TAT: @item.TestType!.TurnAroundTimeHours hour(s)</span>
                                            @if (isOverdue)
                                            {
                                                <span class="mytests-pill overdue mt-1"><i class="fas fa-exclamation-triangle"></i> Overdue</span>
                                            }
                                            else if (item.Status == "In Progress")
                                            {
                                                <span class="mytests-pill ontime mt-1">Within deadline</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not available</span>
                                        }
                                    </td>
                                    <td><span class="mytests-pill @statusClass">@item.Status</span></td>
                                    <td class="text-right">
                                        <div class="mytests-actions">
                                            @if (item.Status == "In Progress" || item.Status == "To Be Reviewed")
                                            {
                                                <a href="/Technician/Tests/CaptureResults/@item.TestRequestTestTypeId"
                                                   class="mytests-perform"
                                                   aria-label="Perform test @item.TestRequestTestTypeId">
                                                    <i class="fas fa-flask" aria-hidden="true"></i> Perform Test
                                                </a>
                                            }
                                        <button type="button"
                                                class="mytests-detail js-test-details"
                                                data-request="@(item.TestRequest?.RequestNumber ?? "N/A")"
                                                data-testid="@item.TestRequestTestTypeId"
                                                data-patient="@(item.TestRequest?.Patient?.FullName ?? "Patient unavailable")"
                                                data-testtype="@(item.TestType?.Name ?? "Unknown test")"
                                                data-urgency="@urgency"
                                                data-status="@item.Status"
                                                data-started="@(item.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not started")"
                                                data-tat="@(item.TestType != null ? $"{item.TestType.TurnAroundTimeHours} hours" : "Not set")"
                                                data-due="@(due?.ToString("dd MMM yyyy HH:mm") ?? "Not available")"
                                                data-deadline="@(isOverdue ? "Overdue" : item.Status == "Completed" || item.Status == "Verified" ? "Finished" : due.HasValue ? "Within deadline" : "Not available")"
                                                 data-clinicalnotes="@(item.TestRequest?.GetType().GetProperty("ClinicalNotes")?.GetValue(item.TestRequest)?.ToString() ?? "No clinical notes available.")">
                                            <i class="fas fa-eye"></i> View Details
                                        </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="myTestsNoMatches" class="mytests-empty" style="display:none"><i class="fas fa-search"></i><h5>No matching tests</h5><p>Try a different search or status filter.</p></div>
            }
            else
            {
                <div class="mytests-empty"><i class="fas fa-flask"></i><h5>No Tests Selected Yet</h5><p>Choose a test from Available Tests to begin processing.</p><a href="/Technician/Tests/Available" class="mytests-detail mt-3">Browse Available Tests</a></div>
            }
        </div>
    </div>
</div>


@* Reusable read-only modal. Populate fields using the data attributes on MyTests buttons. *@
<div class="modal fade" id="myTestDetailsModal" tabindex="-1" role="dialog"
     aria-labelledby="myTestDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="myTestDetailsModalLabel"><i class="fas fa-flask mr-2" aria-hidden="true"></i> Laboratory Test Details</h5>
                    <small>Selected patient test information</small>
                </div>
                <button type="button" class="close js-close-test-modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-file-medical" aria-hidden="true"></i> Request Number</div><div class="mtd-info-value" id="mtdRequest">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-hashtag" aria-hidden="true"></i> Test Number</div><div class="mtd-info-value" id="mtdTestId">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-user-injured" aria-hidden="true"></i> Patient</div><div class="mtd-info-value" id="mtdPatient">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-vials" aria-hidden="true"></i> Test Type</div><div class="mtd-info-value" id="mtdTestType">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> Urgency</div><div class="mtd-info-value" id="mtdUrgency">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-tasks" aria-hidden="true"></i> Status</div><div class="mtd-info-value" id="mtdStatus">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-play-circle" aria-hidden="true"></i> Started</div><div class="mtd-info-value" id="mtdStarted">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-hourglass-half" aria-hidden="true"></i> Turnaround Time</div><div class="mtd-info-value" id="mtdTat">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-calendar-check" aria-hidden="true"></i> Expected Completion</div><div class="mtd-info-value" id="mtdDue">Not available</div></div></div>
                    <div class="col-md-6 mb-3"><div class="mtd-info"><div class="mtd-info-label"><i class="fas fa-clock" aria-hidden="true"></i> Deadline Status</div><div class="mtd-info-value" id="mtdDeadline">Not available</div></div></div>
                </div>
                <section class="mtd-clinical-notes" aria-labelledby="mtdClinicalNotesHeading">
                    <h6 id="mtdClinicalNotesHeading"><i class="fas fa-notes-medical mr-2" aria-hidden="true"></i> Patient Clinical Notes</h6>
                    <p id="mtdClinicalNotes">No clinical notes available.</p>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary js-close-test-modal"><i class="fas fa-times mr-1" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>



<style>

    #myTestDetailsModal .modal-header { background: linear-gradient(135deg,#073b5c,#0284c7); color: #fff; padding: 22px 26px; border-bottom: 0; display:flex; justify-content:space-between; align-items:flex-start; }
    #myTestDetailsModal .modal-title { font-size:20px; font-weight:700; }
    #myTestDetailsModal .modal-body { background:#f8fafc; padding:25px; }
    #myTestDetailsModal .modal-footer { background:#fff; border-top:1px solid #e2e8f0; padding:15px 25px; }
    #myTestDetailsModal .mtd-info { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:15px; height:100%; }
    #myTestDetailsModal .mtd-info-label { color:#64748b; font-size:12px; font-weight:700; margin-bottom:8px; }
    #myTestDetailsModal .mtd-info-label i { color:#0284c7; margin-right:7px; width:16px; }
    #myTestDetailsModal .mtd-info-value { color:#0f172a; font-size:14px; font-weight:600; overflow-wrap:anywhere; }
    #myTestDetailsModal .mtd-clinical-notes { background:#eff6ff; border-left:4px solid #0284c7; border-radius:10px; padding:20px; margin-top:10px; }
    #myTestDetailsModal .mtd-clinical-notes h6 { color:#075985; font-weight:700; margin-bottom:12px; }
    #myTestDetailsModal .mtd-clinical-notes p { color:#334155; font-size:13px; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; margin:0; }

    /* Standalone modal: does not depend on Bootstrap JavaScript. */
    #myTestDetailsModal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 10550;
        overflow-y: auto;
        padding: 24px 12px;
        background: rgba(15,23,42,.62);
        opacity: 1;
    }

        #myTestDetailsModal.mytests-modal-open {
            display: block !important;
        }

        #myTestDetailsModal .modal-dialog {
            margin: 30px auto;
            max-width: 800px;
            transform: none;
            pointer-events: auto;
        }

        #myTestDetailsModal .modal-content {
            background: #fff;
            box-shadow: 0 24px 65px rgba(0,0,0,.25);
        }

        #myTestDetailsModal .modal-header .close {
            color: #fff;
            opacity: 1;
            font-size: 28px;
        }

        #myTestDetailsModal .modal-body strong {
            display: block;
            margin-bottom: 5px;
            color: #334155;
            font-size: 12px;
        }

        #myTestDetailsModal .modal-body .text-muted {
            overflow-wrap: anywhere;
        }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('myTestDetailsModal');
        if (!modal) return;
        let previousFocus = null;
        const fields = {
            mtdRequest: 'request', mtdTestId: 'testid', mtdPatient: 'patient',
            mtdTestType: 'testtype', mtdUrgency: 'urgency', mtdStatus: 'status',
            mtdStarted: 'started', mtdTat: 'tat', mtdDue: 'due', mtdDeadline: 'deadline',
            mtdClinicalNotes: 'clinicalnotes'
        };
        function closeModal() {
            modal.classList.remove('mytests-modal-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (previousFocus) previousFocus.focus();
        }
        document.querySelectorAll('.js-test-details').forEach(function(button) {
            button.addEventListener('click', function() {
                Object.entries(fields).forEach(function(entry) {
                    const el = document.getElementById(entry[0]);
                    if (el) el.textContent = button.dataset[entry[1]] || 'Not available';
                });
                previousFocus = button;
                modal.classList.add('mytests-modal-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                const close = modal.querySelector('.js-close-test-modal');
                if (close) close.focus();
            });
        });
        modal.querySelectorAll('.js-close-test-modal').forEach(function(button) {
            button.addEventListener('click', closeModal);
        });
        modal.addEventListener('click', function(event) {
            if (event.target === modal) closeModal();
        });
        document.addEventListener('keydown', function(event) {
            if (!modal.classList.contains('mytests-modal-open')) return;
            if (event.key === 'Escape') closeModal();
            if (event.key === 'Tab') {
                const focusable = Array.from(modal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled])'));
                if (!focusable.length) return;
                const first = focusable[0], last = focusable[focusable.length - 1];
                if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
                else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
            }
        });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const search = document.getElementById('myTestsSearch');
        const status = document.getElementById('myTestsStatus');
        const table = document.getElementById('myTestsTable');
        const empty = document.getElementById('myTestsNoMatches');
        if (!search || !status || !table) return;
        function filterTests() {
            const query = search.value.trim().toLowerCase();
            const selected = status.value;
            let count = 0;
            table.querySelectorAll('tbody tr').forEach(function(row) {
                const visible = row.textContent.toLowerCase().includes(query) &&
                    (!selected || row.dataset.status === selected);
                row.style.display = visible ? '' : 'none';
                if (visible) count++;
            });
            if (empty) empty.style.display = count ? 'none' : 'block';
        }
        const selectedStatus = new URLSearchParams(window.location.search).get('status');
        if (selectedStatus && Array.from(status.options).some(o => o.value === selectedStatus)) {
            status.value = selectedStatus;
        }
        filterTests();
        search.addEventListener('input', filterTests);
        status.addEventListener('change', filterTests);
    });
</script>
