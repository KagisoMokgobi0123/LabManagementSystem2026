@model IEnumerable<NMB_HLabSys.Areas.Technician.ViewModels.SelectPatientTestViewModel>

@{
    ViewData["Title"] = "Select Patient Test";
    Layout = "_TechnicianLayout";

    var managerNames = ViewBag.AssigningManagerNames as Dictionary<int, string> ?? new Dictionary<int, string>();

    var tests = Model?.ToList()
        ?? new List<NMB_HLabSys.Areas.Technician.ViewModels.SelectPatientTestViewModel>();
}

<style>
    .select-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 50px;
    }

    .select-hero {
        background: linear-gradient(135deg, #073b5c, #075985 48%, #0284c7);
        padding: 36px 0 80px;
        color: white;
    }

        .select-hero h1 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .select-hero p {
            color: rgba(255,255,255,.85);
            font-size: 14px;
            margin: 0;
        }

    .select-content {
        position: relative;
        margin-top: -43px;
    }

    .select-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 6px 24px rgba(15,23,42,.08);
        overflow: hidden;
    }

    .select-card-head {
        padding: 20px 24px;
        border-bottom: 1px solid #e8eef5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

        .select-card-head h2 {
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

    .select-search {
        max-width: 370px;
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 13px;
    }

        .select-search:focus {
            outline: none;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2,132,199,.1);
        }

    .select-table {
        margin-bottom: 0;
        min-width: 1550px;
    }

        .select-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            white-space: nowrap;
            border-top: 0;
            padding: 14px;
        }

        .select-table td {
            vertical-align: middle;
            color: #334155;
            font-size: 13px;
            padding: 14px;
        }

        .select-table tbody tr:hover {
            background: #f8fcff;
        }

    .select-name {
        font-weight: 700;
        color: #075985;
    }

    .select-subtext {
        font-size: 11px;
        color: #64748b;
        margin-top: 4px;
    }

    .select-notes {
        max-width: 250px;
        min-width: 180px;
        white-space: normal;
        overflow-wrap: anywhere;
        line-height: 1.5;
    }

    .select-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 24px;
        padding: 6px 11px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        background: #e0f2fe;
        color: #0369a1;
    }

        .select-pill.success {
            background: #dcfce7;
            color: #166534;
        }

        .select-pill.warning {
            background: #fef3c7;
            color: #92400e;
        }

        .select-pill.danger {
            background: #fee2e2;
            color: #991b1b;
        }

    .select-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #0284c7;
        border: 0;
        color: white;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

        .select-btn:hover {
            background: #0369a1;
            color: white;
        }

        .select-btn:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .select-action-buttons {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: stretch;
        gap: 8px;
        min-width: 145px;
    }

        .select-action-buttons .select-btn {
            width: 100%;
        }

    .clinical-context-value {
        white-space: pre-line;
        overflow-wrap: anywhere;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px;
        min-height: 45px;
    }

    .select-btn.edit-test {
        background: #d97706;
    }

        .select-btn.edit-test:hover {
            background: #b45309;
        }

    .select-empty {
        padding: 55px 20px;
        text-align: center;
        color: #64748b;
    }

    .select-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #075985;
        background: white;
        padding: 10px 15px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none !important;
        font-size: 13px;
    }

        .select-back:hover {
            background: #e0f2fe;
            color: #075985;
        }

    .select-count {
        color: #64748b;
        font-size: 12px;
        padding: 14px 20px;
        border-top: 1px solid #e8eef5;
    }

    @@media (max-width: 768px) {
        .select-hero h1 {
            font-size: 23px;
        }

        .select-card-head {
            padding: 17px;
        }

        .select-search {
            max-width: 100%;
        }
    }

    .dt-buttons .btn-copy-visible, .dt-buttons .btn-copy-visible:hover {
        color: #fff !important;
        background: #475569 !important;
        border-color: #475569 !important;
    }

    .dt-buttons .btn {
        margin: 2px;
    }
</style>

<div class="select-page">

    <!-- HERO -->
    <section class="select-hero">
        <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between"
             style="gap:16px;">

            <div>
                <h1>
                    <i class="fas fa-vial mr-2"></i>
                    Select Patient Test
                </h1>

                <p>
                    Select patient tests with received samples
                    that match your active Laboratory Manager assignments.
                </p>
            </div>

            <a asp-area="Technician"
               asp-controller="Tests"
               asp-action="Available"
               class="select-back"
               title="Back to My Assigned Test Types">
                <i class="fas fa-arrow-left mr-1"></i>
                <span>My Assigned Test Types</span>
            </a>

        </div>
    </section>

    <!-- CONTENT -->
    <div class="container-fluid select-content">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">
                <i class="fas fa-check-circle mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="select-card">

            <!-- HEADER -->
            <div class="select-card-head">

                <div>
                    <h2>
                        <i class="fas fa-clipboard-list text-primary mr-2"></i>
                        Available Patient Tests

                        <span class="select-pill">
                            @tests.Count
                        </span>
                    </h2>

                    <small class="text-muted">
                        Unclaimed tests with received samples are displayed, including de-activated records for audit visibility.
                    </small>
                </div>

                <input id="selectSearch"
                       class="select-search"
                       type="search"
                       placeholder="Search patient, ID, doctor, request or test..."
                       aria-label="Search available patient tests" />

            </div>

            @if (tests.Any())
            {
                <div class="table-responsive">

                    <table id="selectTestsTable"
                           class="table select-table table-hover">

                        <thead>
                            <tr>
                                <th>Request Number</th>
                                <th>Priority</th>
                                <th>Patient</th>
                                @*    <th>ID Number</th> *@
                                <th>Assigning Manager</th>
                                <th>Doctor Full Name</th>
                                <th>Doctor Username</th>
                                <th>Clinical Notes</th>
                                <th>Test Type</th>

                                @*    <th>Turnaround</th> *@
                                <th>Status</th>
                                @*  <th>Sample Status</th> *@
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var test in tests)
                            {
                                var priority = test.Priority ?? "";
                                var requestStatus = test.RequestStatus ?? "";
                                var testStatus = test.TestStatus ?? "";
                                var isDeactivated = test.IsDeactivated;

                                var priorityClass =
                                    priority.Equals("Stat", StringComparison.OrdinalIgnoreCase)
                                        ? "danger"
                                        : priority.Equals("Urgent", StringComparison.OrdinalIgnoreCase)
                                            ? "warning"
                                            : "";

                                <tr data-search="@($"{test.RequestReference} {test.PatientName} {test.PatientIdNumber} {test.DoctorFullName} {test.DoctorUsername} {(managerNames.TryGetValue(test.RequestedTestId, out var searchManager) ? searchManager : "")} {test.ClinicalNotes} {test.TestTypeName} {test.Priority} {test.RequestStatus} {test.TestStatus}".ToLowerInvariant())">

                                    <!-- REQUEST NUMBER -->
                                    <td>
                                        <span class="select-name">
                                            @test.RequestReference
                                        </span>
                                    </td>
                                    <!-- PRIORITY -->
                                    <td>
                                        <span class="select-pill @priorityClass">
                                            @priority
                                        </span>
                                    </td>
                                    <!-- PATIENT FULL NAME -->
                                    <td>
                                        <span class="select-name">
                                            @test.PatientName
                                        </span>
                                    </td>


                                    <!-- PATIENT ID -->
                                    @*  <td>
                                        @test.PatientIdNumber
                                    </td> *@

                                    <!-- Manager who assigned this test type to the logged-in technician. -->
                                    <td>
                                        @(managerNames.TryGetValue(test.RequestedTestId, out var managerFullName)
                                            ? managerFullName : "Manager not recorded")
                                    </td>

                                    <!-- DOCTOR FULL NAME -->
                                    <td>
                                        @test.DoctorFullName
                                    </td>

                                    <!-- DOCTOR USERNAME -->
                                    <td>
                                        @test.DoctorUsername
                                    </td>

                                    <!-- CLINICAL NOTES -->
                                    <td>
                                        <div class="select-notes">
                                            @test.ClinicalNotes
                                        </div>
                                    </td>

                                    <!-- TEST TYPE -->
                                    <td>
                                        <span class="select-name">
                                            @test.TestTypeName
                                        </span>
                                    </td>

                                  

                                    <!-- TURNAROUND -->
                                    @* <td>
                                        <i class="far fa-clock text-muted mr-1"></i>
                                        @test.TurnaroundDisplay
                                    </td>
 *@
                                    <!-- REQUEST STATUS -->
                                    <td>
                                        <span class="select-pill @(isDeactivated ? "danger" : requestStatus == "InProgress" ? "success" :
                                                                                                                                                                                                               requestStatus == "SamplesReceived" ? "primary" : "")">
                                            @(isDeactivated ? "De-Activated" : requestStatus == "SamplesReceived" ? "Sample Received" :
                                              requestStatus == "InProgress" ? "In Progress" :
                                              requestStatus)
                                        </span>
                                    </td>

                                    <!-- TEST STATUS -->
                                    @*  <td>
                                        <span class="select-pill @(testStatus == "SamplesReceived" ? "success" : "")">
                                            <i class="fas fa-check-circle"></i>
                                            @testStatus
                                        </span>
                                    </td> *@

                                    <!-- ACTIONS -->
                                    <td class="text-center">
                                        @if (isDeactivated)
                                        {
                                            <span class="select-pill danger" title="@test.DeactivationReason">De-Activated</span>
                                            @if (!string.IsNullOrWhiteSpace(test.DeactivationReason))
                                            {
                                                <div class="select-subtext" title="@test.DeactivationReason">Reason: @test.DeactivationReason</div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="select-action-buttons">
                                                <!-- VIEW CLINICAL DETAILS -->
                                                <button type="button" class="select-btn js-view-clinical"
                                                        style="background:#0f766e"
                                                        data-test-id="@test.RequestedTestId">
                                                    <i class="fas fa-notes-medical mr-1"></i> View Medical Details
                                                </button>
                                                <!-- OPEN PERFORM TEST MODAL -->

                                                <button type="button"
                                                        class="select-btn open-perform-modal"
                                                        data-username="@test.DoctorUsername"
                                                        data-request-status="@test.RequestStatus"
                                                        data-test-id="@test.RequestedTestId"
                                                        data-request="@test.RequestReference"
                                                        data-patient="@test.PatientName"
                                                        data-patient-id="@test.PatientIdNumber"
                                                        data-doctor="@test.DoctorFullName"
                                                        data-test="@test.TestTypeName"
                                                        data-notes="@test.ClinicalNotes"
                                                        data-priority="@test.Priority"
                                                        data-turnaround="@test.TurnaroundDisplay"
                                                        data-status="@test.TestStatus">
                                                    <i class="fas fa-play-circle mr-1"></i>
                                                    Select Test
                                                </button>


                                                @*    <button type="button" class="select-btn edit-test js-edit-test"
                                                        data-test-id="@test.RequestedTestId"
                                                        data-request="@test.RequestReference"
                                                        data-patient="@test.PatientName"
                                                        data-doctor="@test.DoctorFullName"
                                                        data-test="@test.TestTypeName"
                                                        data-priority="@test.Priority"
                                                        data-notes="@test.ClinicalNotes">
                                                    <i class="fas fa-edit mr-1"></i> Edit
                                                </button> *@

                                                <button type="button" class="select-btn js-deactivate-test"
                                                        style="background:#b91c1c"
                                                        data-test-id="@test.RequestedTestId"
                                                        data-test-name="@test.TestTypeName"
                                                        data-request-number="@test.RequestReference">
                                                    <i class="fas fa-ban mr-1"></i> De-Activate
                                                </button>
                                            </div>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <div class="select-count"
                     id="selectVisibleCount"
                     aria-live="polite">
                    Showing @tests.Count available patient test(s).
                </div>
            }
            else
            {
                <div class="select-empty">

                    <i class="fas fa-clipboard-check fa-2x mb-3"></i>

                    <h5>No available patient tests</h5>

                    <p>
                        There are currently no unclaimed tests with
                        received samples matching your active assignments.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


<!-- Read-only medical information for the authorised technician. -->
<div class="modal fade" id="selectClinicalModal" tabindex="-1" aria-labelledby="selectClinicalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="selectClinicalModalLabel"><i class="fas fa-notes-medical mr-2"></i>Patient Medical Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p id="selectClinicalIdentity" class="font-weight-bold"></p>
                <div class="form-group"><label>Medical Conditions</label><div id="selectMedicalConditions" class="clinical-context-value"></div></div>
                <div class="form-group"><label>Allergies</label><div id="selectAllergies" class="clinical-context-value"></div></div>
                <div class="form-group"><label>Medications</label><div id="selectMedications" class="clinical-context-value"></div></div>
                <div class="form-group"><label>Doctor's Clinical Notes</label><div id="selectDoctorClinicalNotes" class="clinical-context-value"></div></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

<!-- Edit details modal: patient and doctor are read-only; only clinical notes are editable. -->
<div class="modal fade" id="editPatientTestModal" tabindex="-1" aria-labelledby="editPatientTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPatientTestModalLabel"><i class="fas fa-edit mr-2"></i>Edit Patient Test Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <form id="editPatientTestForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editRequestedTestId" name="testRequestTestTypeId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group"><label>Request Number</label><input id="editRequestReference" class="form-control" readonly /></div>
                        <div class="col-md-6 form-group"><label>Patient</label><input id="editPatientName" class="form-control" readonly /></div>
                        <div class="col-md-6 form-group"><label>Doctor</label><input id="editDoctorName" class="form-control" readonly /></div>
                        <div class="col-md-6 form-group"><label>Test Type</label><input id="editTestType" class="form-control" readonly /></div>
                        <div class="col-md-6 form-group"><label>Priority</label><input id="editPriority" class="form-control" readonly /></div>
                    </div>
                    <div class="form-group">
                        <label for="editClinicalNotes">Clinical Notes</label>
                        <textarea id="editClinicalNotes" name="clinicalNotes" class="form-control" rows="5" maxlength="2000"></textarea>
                        <small class="text-muted">These notes belong to the overall patient request and are shared across its tests.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button id="saveEditPatientTest" type="submit" class="btn btn-warning"><i class="fas fa-save mr-1"></i> Update Test</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PerformTestModal")

<form id="selectSoftDeleteAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <a id="aspEndpointSelectTestClinicalContext" asp-area="Technician" asp-controller="Tests" asp-action="SelectTestClinicalContext" hidden aria-hidden="true" tabindex="-1"></a>
    <a id="aspEndpointUpdateSelectedTestDetails" asp-area="Technician" asp-controller="Tests" asp-action="UpdateSelectedTestDetails" hidden aria-hidden="true" tabindex="-1"></a>
    <a id="aspEndpointDeactivateRequestedTest" asp-area="Technician" asp-controller="Tests" asp-action="DeactivateRequestedTest" hidden aria-hidden="true" tabindex="-1"></a>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script>
        $(function() {

            $(document).on('click', '.js-view-clinical', async function() {
                const button = $(this);
                const id = button.attr('data-test-id');
                button.prop('disabled', true);
                try {
                    const data = await $.get(document.getElementById("aspEndpointSelectTestClinicalContext").href, { id: id });
                    $('#selectClinicalIdentity').text((data.patientName || 'Patient') + ' | ' +
                        (data.requestNumber || '') + ' | ' + (data.testType || ''));
                    $('#selectMedicalConditions').text(data.medicalConditions || 'Not recorded');
                    $('#selectAllergies').text(data.allergies || 'Not recorded');
                    $('#selectMedications').text(data.medications || 'Not recorded');
                    $('#selectDoctorClinicalNotes').text(data.clinicalNotes || 'Not recorded');
                    const modal = document.getElementById('selectClinicalModal');
                    if (window.bootstrap && window.bootstrap.Modal)
                        window.bootstrap.Modal.getOrCreateInstance(modal).show();
                    else if ($.fn.modal) $('#selectClinicalModal').modal('show');
                    else alert('Bootstrap modal JavaScript is not loaded.');
                } catch (xhr) {
                    const message = xhr.responseJSON?.message || 'Unable to load patient medical details. Check your access and refresh.';
                    if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Medical details unavailable', text: message });
                    else alert(message);
                } finally { button.prop('disabled', false); }
            });
            $('#selectClinicalModal [data-dismiss="modal"]').on('click', function() {
                if (window.bootstrap && window.bootstrap.Modal)
                    window.bootstrap.Modal.getOrCreateInstance(document.getElementById('selectClinicalModal')).hide();
                else if ($.fn.modal) $('#selectClinicalModal').modal('hide');
            });

            // DataTables provides search, paging, sorting and exports.
            if ($('#selectTestsTable').length && $.fn.DataTable) {
                const selectTable = $('#selectTestsTable').DataTable({
                    processing: true,
                    autoWidth: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'All']],
                    paging: true,
                    pagingType: 'full_numbers',
                    scrollX: true,
                    scrollY: '500px',
                    scrollCollapse: true,
                    order: [[0, 'desc']],
                    columnDefs: [{ targets: -1, orderable: false, searchable: false }],
                    dom: "<'row align-items-center mb-3'<'col-lg-4 col-md-6'l><'col-lg-8 col-md-6 text-md-right'B>>" +
                        "<'row'<'col-sm-12'tr>>" +
                        "<'row align-items-center mt-3'<'col-md-5'i><'col-md-7'p>>",
                    buttons: [
                        { extend: 'copyHtml5', text: '<i class="fas fa-copy mr-1"></i> Copy', className: 'btn btn-secondary btn-sm btn-copy-visible', title: 'NMB-HLabSys - Available Patient Tests' },
                        { extend: 'excelHtml5', text: '<i class="fas fa-file-excel mr-1"></i> Excel', className: 'btn btn-success btn-sm', title: 'NMB-HLabSys - Available Patient Tests', filename: 'NMB-HLabSys_Available_Patient_Tests', sheetName: 'Patient Tests' },
                        {
                            extend: 'pdfHtml5', text: '<i class="fas fa-file-pdf mr-1"></i> PDF', className: 'btn btn-danger btn-sm', title: 'NMB-HLabSys - Available Patient Tests', filename: 'NMB-HLabSys_Available_Patient_Tests', orientation: 'landscape', pageSize: 'A3', customize: function(doc) {
                                doc.pageMargins = [20, 45, 20, 40];
                                doc.defaultStyle.fontSize = 7;
                                doc.styles.tableHeader.fontSize = 7;
                                doc.styles.title.fontSize = 15;
                                doc.styles.title.alignment = 'center';
                                doc.content.splice(1, 0, { text: 'Laboratory Available Patient Tests Report', alignment: 'center', fontSize: 10, margin: [0, 0, 0, 4] }, { text: 'Generated: ' + new Date().toLocaleString(), alignment: 'center', fontSize: 8, margin: [0, 0, 0, 12] });
                                const tableContent = doc.content.find(x => x.table);
                                if (tableContent) tableContent.table.widths = Array(tableContent.table.body[0].length).fill('*');
                                doc.footer = function(page, pages) { return { columns: [{ text: 'NMB-HLabSys | Available Patient Tests', alignment: 'left' }, { text: 'Page ' + page + ' of ' + pages, alignment: 'right' }], margin: [20, 0, 20, 0], fontSize: 7, color: '#64748b' }; };
                            }
                        },
                        { extend: 'print', text: '<i class="fas fa-print mr-1"></i> Print', className: 'btn btn-primary btn-sm', title: 'NMB-HLabSys - Available Patient Tests', messageTop: 'Laboratory Available Patient Tests Report' }
                    ].map(function(button) {
                        button.exportOptions = {
                            columns: ':not(:last-child)',
                            modifier: { search: 'applied', order: 'applied', page: 'all' },
                            format: { body: function(data, row, column, node) { return $(node).text().replace(/\s+/g, ' ').trim(); } }
                        };
                        return button;
                    }),
                    language: { emptyTable: 'No patient tests are available.', zeroRecords: 'No matching patient tests found.', info: 'Showing _START_ to _END_ of _TOTAL_ tests', infoEmpty: 'Showing 0 tests', infoFiltered: '(filtered from _MAX_ total tests)', lengthMenu: 'Show _MENU_ records' }
                });
                $('#selectSearch').on('keyup change input', function() { selectTable.search(this.value).draw(); });
                selectTable.on('draw', function() {
                    $('#selectVisibleCount').text('Showing ' + selectTable.rows({ search: 'applied' }).count() + ' matching patient test(s).');
                });
            }

            $(document).on('click', '.js-edit-test', function() {
                const b = $(this);
                $('#editRequestedTestId').val(b.attr('data-test-id'));
                $('#editRequestReference').val(b.attr('data-request'));
                $('#editPatientName').val(b.attr('data-patient'));
                $('#editDoctorName').val(b.attr('data-doctor'));
                $('#editTestType').val(b.attr('data-test'));
                $('#editPriority').val(b.attr('data-priority'));
                $('#editClinicalNotes').val(b.attr('data-notes') || '');
                const el = document.getElementById('editPatientTestModal');
                if (window.bootstrap && window.bootstrap.Modal)
                    window.bootstrap.Modal.getOrCreateInstance(el).show();
                else if ($.fn.modal) $('#editPatientTestModal').modal('show');
                else alert('Bootstrap modal JavaScript is not loaded.');
            });

            $('#editPatientTestModal [data-dismiss="modal"]').on('click', function() {
                if (window.bootstrap && window.bootstrap.Modal)
                    window.bootstrap.Modal.getOrCreateInstance(document.getElementById('editPatientTestModal')).hide();
                else if ($.fn.modal) $('#editPatientTestModal').modal('hide');
            });

            $('#editPatientTestForm').on('submit', async function(event) {
                event.preventDefault();
                const btn = $('#saveEditPatientTest').prop('disabled', true);
                try {
                    const response = await $.ajax({
                        url: document.getElementById("aspEndpointUpdateSelectedTestDetails").href,
                        method: 'POST',
                        data: $(this).serialize()
                    });
                    if (!response.success) throw new Error(response.message || 'Update failed.');
                    if (typeof Swal !== 'undefined') await Swal.fire({ icon: 'success', title: 'Updated', text: response.message });
                    window.location.reload();
                } catch (xhr) {
                    const message = xhr.responseJSON?.message || xhr.message || 'Unable to update test details.';
                    if (typeof Swal !== 'undefined') await Swal.fire({ icon: 'error', title: 'Update failed', text: message });
                    else alert(message);
                } finally { btn.prop('disabled', false); }
            });

            // Same SweetAlert2 confirmation and inline AJAX validation pattern as Receive Samples.
            $(document).on('click', '.js-deactivate-test', async function(event) {
                event.preventDefault();
                const button = $(this);
                if (button.prop('disabled')) return;

                if (typeof Swal === 'undefined') {
                    alert('SweetAlert2 is not loaded. Please contact the administrator.');
                    return;
                }

                const testId = Number(button.attr('data-test-id'));
                const testName = button.attr('data-test-name') || 'Selected test';
                const requestNumber = button.attr('data-request-number') || 'N/A';

                if (!Number.isInteger(testId) || testId <= 0) {
                    await Swal.fire({ icon: 'error', title: 'Invalid Test', text: 'Test ID is missing.' });
                    return;
                }

                const confirmation = await Swal.fire({
                    icon: 'warning',
                    title: 'De-Activate Patient Test?',
                    text: `Request: ${requestNumber} | Test: ${testName}. A reason is mandatory and will be recorded in the audit trail.`,
                    input: 'textarea',
                    inputLabel: 'Reason for de-activation (required)',
                    inputPlaceholder: 'Explain why this test must be de-activated...',
                    inputAttributes: { maxlength: '500', 'aria-label': 'Reason for de-activation' },
                    inputValidator: (value) => {
                        if (!value || !value.trim()) return 'Please provide a reason for de-activation.';
                        if (value.trim().length > 500) return 'The reason must not exceed 500 characters.';
                    },
                    showCancelButton: true,
                    confirmButtonText: 'Yes, De-Activate',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc2626',
                    showLoaderOnConfirm: true,
                    allowOutsideClick: () => !Swal.isLoading(),
                    preConfirm: async (value) => {
                        try {
                            const response = await $.ajax({
                                url: document.getElementById("aspEndpointDeactivateRequestedTest").href,
                                type: 'POST',
                                data: {
                                    testRequestTestTypeId: testId,
                                    reason: value.trim(),
                                    __RequestVerificationToken: $('#selectSoftDeleteAntiforgery input[name="__RequestVerificationToken"]').val()
                                }
                            });
                            if (!response || !response.success) {
                                Swal.showValidationMessage(response?.message || 'De-activation failed.');
                                return false;
                            }
                            return response;
                        } catch (xhr) {
                            const message = xhr.responseJSON?.message ||
                                (xhr.status === 401 || xhr.status === 403
                                    ? 'Your session has expired or you are not authorized.'
                                    : 'Unable to de-activate the test. Please try again.');
                            Swal.showValidationMessage(message);
                            return false;
                        }
                    }
                });

                if (confirmation.isConfirmed && confirmation.value?.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Patient Test De-Activated',
                        text: confirmation.value.message || 'The test and audit record were saved.',
                        confirmButtonText: 'OK'
                    });
                    window.location.reload();
                }
            });

            function updateVerification() {
                var total = $('#performTestModal .perform-verify').length;
                var checked = $('#performTestModal .perform-verify:checked').length;
                var complete = total === 5 && checked === total;
                $('#performCheckText').text(complete ? 'All 5 items verified — ready to start test' : checked + ' of 5 items verified');
                $('#performCheckStatus').toggleClass('complete', complete);
                $('#performCheckIcon').attr('class', complete ? 'fas fa-check-circle mr-2' : 'fas fa-exclamation-triangle mr-2');
                $('#performSubmit').prop('disabled', !complete);
            }

            $('.open-perform-modal').on('click', function() {
                var b = $(this);
                var values = {
                    performTestId: b.attr('data-test-id'),
                    performRequest: b.attr('data-request'),
                    performPatient: b.attr('data-patient'),
                    performPatientId: b.attr('data-patient-id'),
                    performDoctor: b.attr('data-doctor'),
                    performDoctorUsername: b.attr('data-username'),
                    performRequestStatus: b.attr('data-request-status'),
                    performTestType: b.attr('data-test'),
                    performNotes: b.attr('data-notes'),
                    performPriority: b.attr('data-priority'),
                    performTurnaround: b.attr('data-turnaround'),
                    performStatus: b.attr('data-status')
                };
                Object.keys(values).forEach(function(id) {
                    if (id === 'performTestId') $('#' + id).val(values[id] || '');
                    else $('#' + id).text(values[id] || 'Not available');
                });
                var modalElement = document.getElementById('performTestModal');
                if (!modalElement) { alert('Perform Test modal partial is missing.'); return; }
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(modalElement).show();
                } else if ($.fn.modal) {
                    $('#performTestModal').modal('show');
                } else {
                    alert('Bootstrap modal JavaScript is not loaded.');
                    return;
                }
                $('#performTestModal .perform-verify').prop('checked', false);
                $('#performNormal').removeClass('d-none');
                $('#performLoading').addClass('d-none');
                updateVerification();
            });

            $('#performTestModal [data-dismiss="modal"]').on('click', function() {
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(document.getElementById('performTestModal')).hide();
                } else if ($.fn.modal) {
                    $('#performTestModal').modal('hide');
                }
            });
            $('#performTestModal .perform-verify').on('change', updateVerification);
            $('#performTestForm').on('submit', function(event) {
                if ($('#performTestModal .perform-verify').length !== 5 || $('#performTestModal .perform-verify:checked').length !== 5 || !$('#performTestId').val()) {
                    event.preventDefault();
                    updateVerification();
                    return false;
                }
                $('#performSubmit').prop('disabled', true);
                $('#performNormal').addClass('d-none');
                $('#performLoading').removeClass('d-none');
                // Normal POST; the existing controller handles redirect and errors.
            });
        });
    </script>
}
