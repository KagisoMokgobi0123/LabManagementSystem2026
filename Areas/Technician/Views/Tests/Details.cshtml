@model NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel
@using System
@using System.Linq
@using NMB_HLabSys.Areas.Technician.Models
@using NMB_HLabSys.Areas.Manager.Models
@{
    ViewData["Title"] = "Test Details";
    Layout = "_TechnicianLayout";
    var request = Model.TestRequest;
    var status = Model.Status ?? "Unknown";
    var urgency = request?.Urgency.ToString() ?? "Routine";
    var deadline = Model.StartDateTime.HasValue && Model.TestType != null
        ? Model.StartDateTime.Value.AddMinutes(Model.TestType.TurnAroundTimeHours)
        : (DateTime?)null;
    var overdue = status == "In Progress" && deadline.HasValue && deadline.Value < DateTime.Now;
    // The controller must populate these from the actual patient/request models.
    var medicalConditions = ViewData["MedicalConditions"]?.ToString();
    var allergies = ViewData["Allergies"]?.ToString();
    var medications = ViewData["Medications"]?.ToString();
    var clinicalNotes = ViewData["ClinicalNotes"]?.ToString();
    var isOwner = ViewBag.IsTestOwner is bool owner && owner;
    var canVerify = ViewBag.CanVerify is bool verifier && verifier;
    var results = ViewBag.TestResults as IEnumerable<TestResultModel> ?? Enumerable.Empty<TestResultModel>();
    var measurements = ViewBag.TestMeasurements as IEnumerable<TestTypeMeasurementModel> ?? Enumerable.Empty<TestTypeMeasurementModel>();
    var resultList = results.ToList();
    var measurementList = measurements.ToList();
    var missingRequired = measurementList.Where(m => m.IsRequired && !resultList.Any(r => r.TestTypeMeasurementId == m.TestTypeMeasurementId && !string.IsNullOrWhiteSpace(r.ResultValue))).ToList();
}
<style>
    .details-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 55px
    }

    .details-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;
        background: linear-gradient(135deg,#073b5c 0%,#075985 45%,#0284c7 100%)
    }

        .details-hero h1 {
            color: #fff;
            font-size: 30px;
            font-weight: 700;
            margin: 0 0 8px
        }

        .details-hero p {
            color: rgba(255,255,255,.82);
            font-size: 14px;
            margin: 0
        }

    .details-eyebrow {
        display: inline-block;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 30px;
        padding: 7px 13px;
        margin-bottom: 14px
    }

    .details-back {
        display: inline-block;
        background: #fff;
        color: #075985 !important;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none !important
    }

    .details-hero .container-fluid { position: relative; z-index: 5; }
    .details-hero .details-back { position: relative; z-index: 10; pointer-events: auto; }
    .details-content {
        position: relative;
        z-index: 2;
        margin-top: -48px
    }

    .details-card {
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        overflow: hidden;
        margin-bottom: 22px
    }

    .details-card-head {
        padding: 18px 22px;
        border-bottom: 1px solid #eef2f7
    }

        .details-card-head h2 {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
            margin: 0
        }

    .details-card-body {
        padding: 22px
    }

    .details-field {
        padding: 11px 0;
        border-bottom: 1px solid #f1f5f9
    }

        .details-field:last-child {
            border-bottom: 0
        }

    .details-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
        margin-bottom: 5px
    }

    .details-value {
        display: block;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere
    }

    .details-pill {
        display: inline-block;
        border-radius: 30px;
        padding: 6px 11px;
        font-size: 11px;
        font-weight: 700;
        background: #e0f2fe;
        color: #0369a1
    }

        .details-pill.warning {
            background: #ffedd5;
            color: #9a3412
        }

        .details-pill.danger {
            background: #fee2e2;
            color: #b91c1c
        }

        .details-pill.success {
            background: #dcfce7;
            color: #166534
        }

    .details-note {
        padding: 16px 18px;
        border-radius: 10px;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        color: #334155;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere
    }

        .details-note.empty {
            background: #f8fafc;
            border-color: #e2e8f0;
            color: #64748b
        }

    .details-alert {
        padding: 15px 18px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 13px;
        font-weight: 600
    }

    .details-metric {
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        padding: 20px;
        height: 100%
    }

        .details-metric small {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px
        }

        .details-metric strong {
            font-size: 16px;
            color: #0f172a
        }


    .details-results-table th {
        background: #f0f7fd;
        color: #29486a;
        white-space: nowrap;
    }

    .details-results-table td {
        vertical-align: middle;
    }

    .details-flag {
        display: inline-block;
        border-radius: 30px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 700;
        background: #e2e8f0;
        color: #334155;
    }

        .details-flag.abnormal {
            background: #fee2e2;
            color: #991b1b;
        }

        .details-flag.normal {
            background: #dcfce7;
            color: #166534;
        }

    .details-review {
        border-left: 4px solid #0284c7;
    }

    .details-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    @@media(max-width:768px) {
        .details-hero h1 {
            font-size: 24px
        }

        .details-back {
            margin-top: 15px
        }
    }
</style>
<div class="details-page">
    <section class="details-hero">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="details-eyebrow"><i class="fas fa-flask mr-1"></i> Technician Workspace</span>
                    <h1>Test Details</h1>
                    <p>Review the selected test, patient information, and turnaround deadline.</p>
                </div>
                <div class="col-md-4 text-md-right">
<a href="@Url.Action(canVerify ? "PendingVerification" : "MyTests", "Tests", new { area = "Technician" })"
   class="details-back">
    <i class="fas fa-arrow-left mr-1"></i>
    @(canVerify ? "Pending Verification" : "My Tests")
</a>                </div>
            </div>
        </div>
    </section>
    <div class="container-fluid details-content">
        @if (overdue)
        {
            <div class="details-alert"><i class="fas fa-exclamation-triangle mr-2"></i>This test is overdue. Its expected completion time has passed.</div>
        }
        <div class="row mb-4">
            <div class="col-md-4 mb-3 mb-md-0"><div class="details-metric"><small>TEST STATUS</small><span class="details-pill @(status == "Verified" ? "success" : status == "Completed" || status == "To Be Reviewed" ? "warning" : "")">@status</span></div></div>
            <div class="col-md-4 mb-3 mb-md-0"><div class="details-metric"><small>EXPECTED COMPLETION</small><strong>@(deadline?.ToString("dd MMM yyyy, HH:mm") ?? "Not available")</strong></div></div>
            <div class="col-md-4"><div class="details-metric"><small>URGENCY</small><span class="details-pill @(urgency == "Stat" ? "danger" : urgency == "Urgent" ? "warning" : "")">@urgency</span></div></div>
        </div>
        <div class="row">
            <div class="col-lg-7">
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-vial text-primary mr-2"></i>Test Information</h2></div>
                    <div class="details-card-body">
                        <div class="row">
                            <div class="col-md-6 details-field"><span class="details-label">Test</span><span class="details-value">@(Model.TestType?.Name ?? "N/A")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Request Number</span><span class="details-value">@(request?.RequestNumber ?? "N/A")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Test ID</span><span class="details-value">@Model.TestRequestTestTypeId</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Sample Type</span><span class="details-value">@(Model.TestType?.SampleType?.Name ?? "N/A")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Started</span><span class="details-value">@(Model.StartDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not started")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Turnaround Time</span><span class="details-value">@(Model.TestType != null ? $"{Model.TestType.TurnAroundTimeHours} minutes" : "N/A")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Completed</span><span class="details-value">@(Model.CompletionDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not completed")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Request Status</span><span class="details-value">@(request?.Status ?? "N/A")</span></div>
                        </div>
                    </div>
                </div>
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-user-injured text-primary mr-2"></i>Patient &amp; Doctor</h2></div>
                    <div class="details-card-body">
                        <div class="row">
                            <div class="col-md-6 details-field"><span class="details-label">Patient</span><span class="details-value">@(request?.Patient?.FullName ?? "N/A")</span></div>
                            <div class="col-md-6 details-field"><span class="details-label">Requesting Doctor</span><span class="details-value">@(request?.Doctor?.FullName ?? "N/A")</span></div>
                        </div>
                    </div>
                </div>
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-notes-medical text-primary mr-2"></i>Doctor's Clinical Notes</h2></div>
                    <div class="details-card-body"><div class="details-note @(string.IsNullOrWhiteSpace(clinicalNotes) ? "empty" : "")">@(string.IsNullOrWhiteSpace(clinicalNotes) ? "Clinical notes have not been loaded." : clinicalNotes)</div></div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-heartbeat text-primary mr-2"></i>Medical Conditions</h2></div>
                    <div class="details-card-body"><div class="details-note @(string.IsNullOrWhiteSpace(medicalConditions) ? "empty" : "")">@(string.IsNullOrWhiteSpace(medicalConditions) ? "Medical conditions have not been loaded." : medicalConditions)</div></div>
                </div>
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-exclamation-circle text-primary mr-2"></i>Allergies</h2></div>
                    <div class="details-card-body"><div class="details-note @(string.IsNullOrWhiteSpace(allergies) ? "empty" : "")">@(string.IsNullOrWhiteSpace(allergies) ? "Allergy information has not been loaded." : allergies)</div></div>
                </div>
                <div class="details-card">
                    <div class="details-card-head"><h2><i class="fas fa-pills text-primary mr-2"></i>Current Medications</h2></div>
                    <div class="details-card-body"><div class="details-note @(string.IsNullOrWhiteSpace(medications) ? "empty" : "")">@(string.IsNullOrWhiteSpace(medications) ? "Medication information has not been loaded." : medications)</div></div>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
        }

        <div class="details-card">
            <div class="details-card-head">
                <h2><i class="fas fa-microscope text-primary mr-2"></i>Captured Test Measurements</h2>
            </div>
            <div class="details-card-body">
                @if (!resultList.Any())
                {
                    <div class="details-note empty">No measurements have been captured for this test yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover details-results-table">
                            <thead>
                                <tr>
                                    <th>Measurement</th>
                                    <th>Result</th>
                                    <th>Unit</th>
                                    <th>Reference Range</th>
                                    <th>Flag</th>
                                    <th>Technician Notes</th>
                                    <th>Review</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in resultList.OrderBy(r => r.ResultName))
                                {
                                    var referenceRange = result.ReferenceMin.HasValue || result.ReferenceMax.HasValue
                                        ? $"{(result.ReferenceMin.HasValue ? result.ReferenceMin.Value.ToString() : "—")} – {(result.ReferenceMax.HasValue ? result.ReferenceMax.Value.ToString() : "—")}"
                                        : "Not specified";
                                    <tr>
                                        <td><strong>@result.ResultName</strong></td>
                                        <td>@result.ResultValue</td>
                                        <td>@(result.MeasurementUnit ?? "—")</td>
                                        <td>@referenceRange</td>
                                        <td>
                                            <span class="details-flag @(result.IsAbnormal ? "abnormal" : result.ResultFlag == "Normal" ? "normal" : "")">
                                                @result.ResultFlag
                                            </span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(result.Notes) ? "—" : result.Notes)</td>
                                        <td>
                                            @if (result.RequiresReview)
                                            {
                                                <span class="details-pill warning">Returned for correction</span>
                                                @if (!string.IsNullOrWhiteSpace(result.ReviewNotes))
                                                {
                                                    <div class="small mt-1">@result.ReviewNotes</div>
                                                }
                                            }
                                            else if (result.VerifiedDateTime.HasValue)
                                            {
                                                <span class="details-pill success">Verified</span>
                                            }
                                            else
                                            {
                                                <span class="details-pill warning">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (missingRequired.Any())
                {
                    <div class="alert alert-warning mt-3">
                        <strong>Required measurements not yet captured:</strong>
                        @string.Join(", ", missingRequired.Select(m => m.MeasurementName))
                    </div>
                }

                @if (isOwner && (status == "In Progress" || status == "To Be Reviewed"))
                {
                    <div class="mt-3">
                        <a asp-area="Technician" asp-controller="Tests" asp-action="CaptureResults"
                           asp-route-id="@Model.TestRequestTestTypeId" class="btn btn-primary">
                            <i class="fas fa-edit mr-1"></i> Capture or Correct Results
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (canVerify && status == "Completed")
        {
            <div class="details-card details-review">
                <div class="details-card-head">
                    <h2><i class="fas fa-clipboard-check text-primary mr-2"></i>Independent Verification</h2>
                </div>
                <div class="details-card-body">
                    <p class="text-muted">Check each measurement, unit, reference range, abnormal flag and technician note before making a decision.</p>

                    @if (!resultList.Any() || missingRequired.Any())
                    {
                        <div class="alert alert-warning">
                            This test has missing results or required measurements. It cannot be approved until the issues are resolved.
                        </div>
                    }

                    <form asp-area="Technician" asp-controller="Tests" asp-action="VerifyTest" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TestRequestTestTypeId" />
                        <div class="form-group">
                            <label for="verificationNotes">Verification Notes (optional)</label>
                            <textarea id="verificationNotes" name="verificationNotes" maxlength="2000"
                                      rows="3" class="form-control" placeholder="Record your verification observations"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success" disabled="@(resultList.Count == 0 || missingRequired.Any())">
                            <i class="fas fa-check-circle mr-1"></i> Verify Test Results
                        </button>
                    </form>

                    <hr />
                    <form asp-area="Technician" asp-controller="Tests" asp-action="RejectTest" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TestRequestTestTypeId" />
                        <div class="form-group">
                            <label for="reviewNotes">Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea id="reviewNotes" name="reviewNotes" maxlength="2000" required
                                      rows="4" class="form-control" placeholder="Explain what the capturing technician must correct"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger" disabled="@(resultList.Count == 0)">
                            <i class="fas fa-times-circle mr-1"></i> Reject and Return for Correction
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
