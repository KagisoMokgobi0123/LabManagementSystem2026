@model NMB_HLabSys.Areas.Manager.Models.TestRequestTestTypeModel
@using NMB_HLabSys.Areas.Technician.Models
@{
    var result = ViewData["VerificationResult"] as TestResultModel;
    var range = result == null || (result.ReferenceMin == null && result.ReferenceMax == null)
        ? "Not configured"
        : $"{result.ReferenceMin?.ToString() ?? "—"} to {result.ReferenceMax?.ToString() ?? "—"}";
}
<style>
    #verifyTestModal .modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 20px 55px rgba(0,0,0,.18)
    }

    #verifyTestModal .modal-header {
        background: linear-gradient(135deg,#073b5c 0%,#075985 55%,#0284c7 100%);
        color: white;
        border: 0;
        padding: 22px 24px
    }

    #verifyTestModal .modal-title {
        font-size: 18px;
        font-weight: 700
    }

    #verifyTestModal .modal-body {
        background: #f8fafc;
        padding: 22px 24px;
        max-height: 65vh;
        overflow-y: auto
    }

    #verifyTestModal .vt-summary {
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 18px
    }

    #verifyTestModal .vt-section-title {
        font-size: 13px;
        font-weight: 750;
        color: #075985;
        margin: 0 0 12px
    }

    #verifyTestModal .vt-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 14px
    }

    #verifyTestModal .vt-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 4px
    }

    #verifyTestModal .vt-value {
        font-size: 12px;
        color: #1e293b;
        font-weight: 650;
        white-space: pre-wrap;
        overflow-wrap: anywhere
    }

    #verifyTestModal .vt-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        overflow: hidden;
        margin-bottom: 16px
    }

    #verifyTestModal .vt-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 17px;
        border-bottom: 1px solid #eef2f7;
        gap: 12px
    }

        #verifyTestModal .vt-card-head strong {
            font-size: 13px;
            color: #0f172a
        }

    #verifyTestModal .vt-counter {
        background: #f1f5f9;
        color: #64748b;
        border-radius: 30px;
        padding: 5px 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap
    }

    #verifyTestModal .vt-check-row {
        display: flex;
        align-items: center;
        padding: 13px 17px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
        gap: 12px;
        margin: 0
    }

        #verifyTestModal .vt-check-row:last-child {
            border-bottom: 0
        }

        #verifyTestModal .vt-check-row:hover {
            background: #f8fcff
        }

        #verifyTestModal .vt-check-row.checked {
            background: #f0fdf4
        }

    #verifyTestModal .vt-check-icon {
        width: 36px;
        height: 36px;
        flex: none;
        border-radius: 9px;
        background: #e0f2fe;
        color: #0284c7;
        display: flex;
        align-items: center;
        justify-content: center
    }

    #verifyTestModal .vt-check-row.checked .vt-check-icon {
        background: #dcfce7;
        color: #16a34a
    }

    #verifyTestModal .vt-check-copy {
        flex: 1;
        min-width: 0
    }

        #verifyTestModal .vt-check-copy small {
            display: block;
            color: #64748b;
            font-size: 10px;
            font-weight: 650
        }

        #verifyTestModal .vt-check-copy strong {
            display: block;
            color: #1e293b;
            font-size: 12px;
            overflow-wrap: anywhere
        }

    #verifyTestModal .vt-check-row input {
        width: 21px;
        height: 21px;
        accent-color: #16a34a;
        flex: none;
        cursor: pointer
    }

    #verifyTestModal .vt-notes {
        padding: 14px 17px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-bottom: 14px
    }

    #verifyTestModal .vt-note-value {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        font-size: 12px;
        color: #334155
    }

    #verifyTestModal .vt-security {
        background: #f0f9ff;
        border: 1px solid #e0f2fe;
        border-radius: 8px;
        padding: 11px 13px;
        color: #0369a1;
        font-size: 11px
    }

    #verifyTestModal .modal-footer {
        background: white;
        border-top: 1px solid #e2e8f0;
        padding: 15px 24px;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap
    }

    #verifyTestModal .vt-status {
        font-size: 11px;
        color: #64748b;
        align-self: center
    }

        #verifyTestModal .vt-status.ready {
            color: #15803d;
            font-weight: 700
        }

    #verifyTestModal .js-verify-decision[data-decision=Verify] {
        background: #0284c7;
        border-color: #0284c7;
        color: white
    }

        #verifyTestModal .js-verify-decision[data-decision=Verify]:disabled {
            background: #cbd5e1;
            border-color: #cbd5e1;
            cursor: not-allowed
        }
    @@media(max - width:650px) {
        #verifyTestModal .vt-grid {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        #verifyTestModal .modal-body {
            padding: 16px
        }
    }
</style>
<div class="modal fade" id="verifyTestModal" tabindex="-1" role="dialog" aria-labelledby="verifyTestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="verifyTestModalLabel"><i class="fas fa-user-check mr-2"></i>Independent Test Verification</h5>
                    <small>Second technician review — approve or return for correction</small>
                </div>
                <button type="button" class="close js-close-verify-modal" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="color:white;opacity:1"><span aria-hidden="true">&times;</span></button>
            </div>
            <form id="verifyTestForm" asp-area="Technician" asp-controller="Tests" asp-action="VerifyResult" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="testRequestTestTypeId" value="@Model.TestRequestTestTypeId" />
                <input type="hidden" name="decision" id="verifyTestDecision" value="" />
                <div class="modal-body">
                    <section class="vt-summary" aria-label="Test request summary">
                        <h6 class="vt-section-title"><i class="fas fa-file-medical mr-1"></i> Test Request Information</h6>
                        <div class="vt-grid">
                            <div><div class="vt-label">Request Number</div><div class="vt-value">@(Model.TestRequest?.RequestNumber ?? "N/A")</div></div>
                            <div><div class="vt-label">Patient</div><div class="vt-value">@(Model.TestRequest?.Patient?.FullName ?? "N/A")</div></div>
                            <div><div class="vt-label">Test Type</div><div class="vt-value">@(Model.TestType?.Name ?? "N/A")</div></div>
                            <div><div class="vt-label">Test ID</div><div class="vt-value">@Model.TestRequestTestTypeId</div></div>
                            <div><div class="vt-label">Status</div><div class="vt-value">@Model.Status</div></div>
                            <div><div class="vt-label">Completed (UTC)</div><div class="vt-value">@(Model.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</div></div>
                        </div>
                    </section>
                    <section class="vt-card" aria-label="Result verification checklist">
                        <div class="vt-card-head">
                            <div><strong>Test Result Verification Checklist</strong><div class="text-muted" style="font-size:10px">Review each item before approving this result.</div></div>
                            <span class="vt-counter"><span id="vtCheckedCount">0</span> / 5</span>
                        </div>
                        <div>
                            <label class="vt-check-row"><span class="vt-check-icon"><i class="fas fa-file-medical"></i></span><span class="vt-check-copy"><small>Confirm Request Number</small><strong>@(Model.TestRequest?.RequestNumber ?? "N/A")</strong></span><input type="checkbox" class="vt-check" aria-label="Confirm request number" /></label>
                            <label class="vt-check-row"><span class="vt-check-icon"><i class="fas fa-vials"></i></span><span class="vt-check-copy"><small>Confirm Test Type</small><strong>@(Model.TestType?.Name ?? "N/A")</strong></span><input type="checkbox" class="vt-check" aria-label="Confirm test type" /></label>
                            <label class="vt-check-row"><span class="vt-check-icon"><i class="fas fa-flask"></i></span><span class="vt-check-copy"><small>Confirm Captured Result</small><strong>@(result?.ResultName ?? "N/A"): @(result?.ResultValue ?? "N/A") @(result?.MeasurementUnit ?? "")</strong></span><input type="checkbox" class="vt-check" aria-label="Confirm captured result" /></label>
                            <label class="vt-check-row"><span class="vt-check-icon"><i class="fas fa-ruler"></i></span><span class="vt-check-copy"><small>Check Reference Range and Flag</small><strong>@range | @(result?.ResultFlag ?? "Not evaluated") @(result?.IsAbnormal == true ? "(ABNORMAL)" : "")</strong></span><input type="checkbox" class="vt-check" aria-label="Check reference range and flag" /></label>
                            <label class="vt-check-row"><span class="vt-check-icon"><i class="fas fa-user-shield"></i></span><span class="vt-check-copy"><small>Confirm Independent Verification</small><strong>I am not the technician who performed this test.</strong></span><input type="checkbox" class="vt-check" aria-label="Confirm independent verification" /></label>
                        </div>
                    </section>
                    <section class="vt-notes"><h6 class="vt-section-title"><i class="fas fa-notes-medical mr-1"></i> Doctor's Clinical Notes</h6><div class="vt-note-value">@(string.IsNullOrWhiteSpace(Model.TestRequest?.ClinicalNotes) ? "Not recorded" : Model.TestRequest.ClinicalNotes)</div></section>
                    <section class="vt-notes"><h6 class="vt-section-title"><i class="fas fa-comment-medical mr-1"></i> Capturing Technician's Notes</h6><div class="vt-note-value">@(string.IsNullOrWhiteSpace(result?.Notes) ? "Not recorded" : result.Notes)</div></section>
                    <div class="form-group"><label for="verifyTestNotes" class="font-weight-bold" style="font-size:12px">Verification / Return Notes</label><textarea id="verifyTestNotes" name="notes" class="form-control" rows="3" maxlength="2000" placeholder="Optional when verifying; required when returning for correction."></textarea><div class="invalid-feedback">Provide a reason for returning this test.</div></div>
                    <div class="vt-security"><i class="fas fa-shield-alt mr-1"></i> Only a different technician with an active manager assignment may verify this result. Decisions are recorded in the audit history.</div>
                </div>
                <div class="modal-footer">
                    <div id="vtVerificationStatus" class="vt-status"><i class="fas fa-info-circle mr-1"></i> Complete all 5 checks to verify.</div>
                    <div class="d-flex flex-wrap" style="gap:8px">
                        <button type="button" class="btn btn-outline-secondary js-close-verify-modal" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-outline-warning js-verify-decision" data-decision="ReturnForReview"><i class="fas fa-undo mr-1"></i> Return for Review</button>
                        <button type="submit" class="btn js-verify-decision" data-decision="Verify" disabled><i class="fas fa-check-circle mr-1"></i> Verify Test</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
