@using NMB_HLabSys.Models.Account.RegisterUser
@{
    ViewData["Title"] = "My Profile";
    Layout = "_TechnicianLayout";
}

<div class="main-panel">
    <div class="content">

        <div class="panel-header bg-primary-gradient">
            <div class="page-inner py-5">

                <h2 class="text-white pb-2 fw-bold">
                    My Profile
                </h2>

                <h5 class="text-white op-7">
                    Lab Technician Account
                </h5>

            </div>
        </div>


        <div class="page-inner mt--5">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle mr-2"></i>
                    @TempData["Success"]
                </div>
            }


            <div class="row">

                <!-- PROFILE CARD -->
                <div class="col-md-4">

                    <div class="card card-profile">

                        <div class="card-header"
                             style="background:#1572E8;height:100px;">
                        </div>

                        <div class="card-body text-center">

                            <div class="avatar avatar-xl"
                                 style="margin-top:-70px;">

                                <img src="~/assets/img/profile.jpg"
                                     class="avatar-img rounded-circle border border-white"
                                     alt="Lab Technician">

                            </div>

                            <h4 class="mt-3 fw-bold">
                                @Model.FirstName @Model.LastName
                            </h4>

                            <span class="badge badge-primary">
                                Lab Technician
                            </span>

                            <p class="text-muted mt-3">
                                Nelson Mandela Bay Haematology
                                Diagnostic Laboratories
                            </p>

                            <a asp-area="Technician"
                               asp-controller="Profile"
                               asp-action="Edit"
                               class="btn btn-primary btn-round">

                                <i class="fas fa-user-edit mr-2"></i>
                                Edit Profile

                            </a>

                        </div>

                    </div>

                </div>


                <!-- ACCOUNT INFORMATION -->
                <div class="col-md-8">

                    <div class="card">

                        <div class="card-header">
                            <h4 class="card-title">
                                <i class="fas fa-user-circle text-primary mr-2"></i>
                                Account Information
                            </h4>
                        </div>


                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6 mb-4">
                                    <small class="text-muted">
                                        First Name
                                    </small>

                                    <h6 class="fw-bold">
                                        @Model.FirstName
                                    </h6>
                                </div>


                                <div class="col-md-6 mb-4">
                                    <small class="text-muted">
                                        Last Name
                                    </small>

                                    <h6 class="fw-bold">
                                        @Model.LastName
                                    </h6>
                                </div>


                                <div class="col-md-6 mb-4">
                                    <small class="text-muted">
                                        Email Address
                                    </small>

                                    <h6 class="fw-bold">
                                        @Model.Email
                                    </h6>
                                </div>


                                <div class="col-md-6 mb-4">
                                    <small class="text-muted">
                                        Phone Number
                                    </small>

                                    <h6 class="fw-bold">
                                        @(Model.PhoneNumber ?? "Not provided")
                                    </h6>
                                </div>


                                <div class="col-md-6 mb-4">
                                    <small class="text-muted">
                                        System Role
                                    </small>

                                    <h6 class="fw-bold text-primary">
                                        Lab Technician
                                    </h6>
                                </div>

                            </div>


                            <hr>


                            <div class="mt-4">

                                <a asp-area="Technician"
                                   asp-controller="Profile"
                                   asp-action="Settings"
                                   class="btn btn-outline-primary btn-round">

                                    <i class="fas fa-cog mr-2"></i>
                                    Account Settings

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>