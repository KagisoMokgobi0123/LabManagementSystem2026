@model NMB_HLabSys.Areas.Technician.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_TechnicianLayout";
}

<style>
    .password-page {
        min-height: 100vh;
        padding: 40px 0;
        background: #f4f7fb;
    }

    .password-card {
        overflow: hidden;

        max-width: 620px;
        margin: auto;

        border: 0;
        border-radius: 14px;

        background: #fff;

        box-shadow: 0 5px 25px rgba(15, 23, 42, .08);
    }

    .password-header {
        padding: 25px;

        background: linear-gradient(
            135deg,
            #073b5c,
            #075985,
            #0284c7
        );

        color: #fff;
    }

    .password-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 50px;
        height: 50px;

        margin-bottom: 14px;

        border-radius: 12px;

        background: rgba(255,255,255,.15);

        font-size: 20px;
    }

    .password-header h3 {
        margin-bottom: 5px;
        font-size: 21px;
        font-weight: 700;
    }

    .password-header p {
        margin: 0;
        color: rgba(255,255,255,.8);
        font-size: 12px;
    }

    .password-body {
        padding: 28px;
    }

    .form-label {
        margin-bottom: 6px;
        color: #334155;
        font-size: 12px;
        font-weight: 600;
    }

    .password-input {
        height: 43px;

        border: 1px solid #dbe3ec;
        border-radius: 8px;

        font-size: 13px;
    }

    .password-input:focus {
        border-color: #0284c7;

        box-shadow: 0 0 0 3px rgba(2,132,199,.10);
    }

    .password-requirements {
        margin-bottom: 20px;
        padding: 14px;

        border-radius: 9px;

        background: #f8fafc;

        color: #64748b;

        font-size: 11px;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 15px;

        border: 1px solid #fecaca;
        border-radius: 8px;

        background: #fef2f2;
        color: #b91c1c;

        font-size: 12px;
    }
</style>


<div class="password-page">

    <div class="container-fluid">

        <div class="password-card">

            <!-- HEADER -->

            <div class="password-header">

                <div class="password-header-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h3>
                    Change Password
                </h3>

                <p>
                    Update the password used to access your
                    Lab Technician account.
                </p>

            </div>


            <!-- BODY -->

            <div class="password-body">


                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">

                        <i class="fas fa-check-circle mr-1"></i>

                        @TempData["SuccessMessage"]

                    </div>
                }


                <form asp-area="Technician"
                      asp-controller="Profile"
                      asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>


                    <!-- CURRENT PASSWORD -->

                    <div class="form-group">

                        <label asp-for="CurrentPassword"
                               class="form-label">
                        </label>

                        <input asp-for="CurrentPassword"
                               class="form-control password-input"
                               placeholder="Enter current password" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- NEW PASSWORD -->

                    <div class="form-group">

                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control password-input"
                               placeholder="Enter new password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control password-input"
                               placeholder="Confirm new password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="password-requirements">

                        <i class="fas fa-shield-alt mr-1"></i>

                        Your new password must satisfy the password
                        requirements configured for NMB-HLabSys.

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-key mr-1"></i>

                        Change Password

                    </button>


                    <a href="/Technician/Profile/Index"
                       class="btn btn-outline-secondary ml-2">

                        <i class="fas fa-arrow-left mr-1"></i>

                        Back to Profile

                    </a>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}