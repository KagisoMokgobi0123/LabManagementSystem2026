        border-radius: 50px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-submitted {
        background: #e0f2fe;
        color: #0369a1;
    }

    .status-progress {
        background: #fef3c7;
        color: #b45309;
    }

    .status-completed {
