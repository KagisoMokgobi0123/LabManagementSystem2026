@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_TechnicianLayout";

    var currentUser = await UserManager.GetUserAsync(User);

    var technicianName = currentUser?.FullName ?? "Lab Technician";
    var technicianEmail = currentUser?.Email ?? "";

    var technicianInitial =
        !string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? currentUser.FirstName.Substring(0, 1).ToUpper()
            : "T";
}

<style>
    /* =========================================================
       PAGE
       ========================================================= */

    .tech-dashboard {
        min-height: 100vh;
        background: #f4f7fb;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .tech-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;
        background: linear-gradient(
            135deg,
            #073b5c 0%,
            #075985 45%,
            #0284c7 100%
        );
    }

    .tech-hero::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        right: 220px;
        bottom: -190px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
    }

    .tech-hero::after {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        right: -100px;
        top: -210px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
    }

    .tech-hero-content {
        position: relative;
        z-index: 2;
    }

    .tech-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        margin-bottom: 14px;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,.20);
        background: rgba(255,255,255,.13);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

    .tech-hero h1 {
        margin-bottom: 7px;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
    }

    .tech-hero p {
        max-width: 720px;
        margin: 0;
        color: rgba(255,255,255,.82);
        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s ease;
    }

    .hero-btn:hover {
        transform: translateY(-2px);
    }

    .hero-btn-primary {
        background: #fff;
        color: #075985 !important;
    }

    .hero-btn-outline {
        border: 1px solid rgba(255,255,255,.50);
        background: rgba(255,255,255,.08);
        color: #fff !important;
    }

    /* =========================================================
       PAGE INNER
       ========================================================= */

    .tech-page-inner {
        position: relative;
        z-index: 5;
        margin-top: -48px;
        padding-bottom: 50px;
    }

    /* =========================================================
       CLICKABLE STAT CARDS
       ========================================================= */

    .stat-card-link {
        display: block;
        height: 100%;
        color: inherit !important;
        text-decoration: none !important;
    }

    .stat-card {
        position: relative;
        height: 100%;
        padding: 20px;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        cursor: pointer;

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            border-color .2s ease;
    }

    .stat-card-link:hover .stat-card {
        transform: translateY(-4px);
        border-color: #bae6fd;
        box-shadow: 0 12px 30px rgba(15,23,42,.13);
    }

    .stat-card::after {
        content: "\f054";
        position: absolute;
        right: 20px;
        bottom: 17px;

        font-family: "Font Awesome 5 Free";
        font-size: 10px;
        font-weight: 900;

        color: #cbd5e1;
        opacity: 0;
        transform: translateX(-5px);
        transition: .2s ease;
    }

    .stat-card-link:hover .stat-card::after {
        opacity: 1;
        transform: translateX(0);
    }

    .stat-card-link:focus {
        outline: none;
    }

    .stat-card-link:focus .stat-card {
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2,132,199,.15);
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }

    .stat-title {
        margin-bottom: 7px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .stat-number {
        margin: 0;
        color: #0f172a;
        font-size: 28px;
        font-weight: 700;
    }

    .stat-note {
        margin-top: 7px;
        padding-right: 10px;
        color: #94a3b8;
        font-size: 11px;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 44px;
        height: 44px;
        min-width: 44px;

        border-radius: 11px;
        font-size: 17px;
    }

    .icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .icon-cyan {
        background: #cffafe;
        color: #0891b2;
    }

    .icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .icon-purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-red {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-yellow {
        background: #fef3c7;
        color: #d97706;
    }

    /* =========================================================
       DASHBOARD CARDS
       ========================================================= */

    .dashboard-card {
        margin-bottom: 24px;
        border: 0;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
    }

    .dashboard-card .card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #eef2f7;
        background: transparent;
    }

    .dashboard-card .card-body {
        padding: 20px;
    }

    .dashboard-title {
        margin: 0;
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        margin-top: 4px;
        margin-bottom: 0;
        color: #94a3b8;
        font-size: 11px;
    }

    /* =========================================================
       WORKFLOW
       ========================================================= */

    .workflow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .workflow-item {
        flex: 1;
        text-align: center;
    }

    .workflow-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 48px;
        height: 48px;

        margin: auto;
        border-radius: 50%;

        background: #e0f2fe;
        color: #0284c7;

        font-size: 16px;
    }

    .workflow-title {
        margin-top: 8px;
        color: #334155;
        font-size: 11px;
        font-weight: 600;
    }

    .workflow-line {
        flex: .6;
        height: 2px;
        margin-top: -20px;
        background: #e2e8f0;
    }

    /* =========================================================
       CLICKABLE WORKFLOW
       ========================================================= */

    .workflow-link {
        position: relative;
        display: block;
        padding: 12px 8px;
        border: 1px solid transparent;
        border-radius: 10px;
        color: inherit !important;
        text-decoration: none !important;
        cursor: pointer;
        transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

    .workflow-link:hover {
        transform: translateY(-4px);
        border-color: #bae6fd;
        background: #f8fcff;
        box-shadow: 0 7px 20px rgba(15, 23, 42, .08);
        color: inherit !important;
        text-decoration: none !important;
    }

    .workflow-link:focus {
        outline: none;
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, .15);
    }

    .workflow-link .workflow-icon {
        transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
    }

    .workflow-link:hover .workflow-icon {
        transform: scale(1.08);
        background: #0284c7;
        color: #fff;
        box-shadow: 0 5px 14px rgba(2, 132, 199, .25);
    }

    .workflow-link .workflow-title {
        transition: color .2s ease;
    }

    .workflow-link:hover .workflow-title {
        color: #0284c7;
    }

    .workflow-hint {
        margin-top: 3px;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 500;
        transition: color .2s ease;
    }

    .workflow-link:hover .workflow-hint {
        color: #64748b;
    }

    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .quick-action {
        display: flex;
        align-items: center;

        min-height: 78px;
        margin-bottom: 12px;
        padding: 15px;

        border: 1px solid #e8edf3;
        border-radius: 10px;

        background: #fff;

        color: inherit !important;
        text-decoration: none !important;

        transition: .2s ease;
    }

    .quick-action:hover {
        transform: translateY(-2px);
        border-color: #0284c7;
        background: #f8fcff;
        box-shadow: 0 6px 18px rgba(15,23,42,.06);
    }

    .quick-action-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 42px;
        height: 42px;
        min-width: 42px;

        margin-right: 12px;

        border-radius: 10px;

        background: #e0f2fe;
        color: #0284c7;
    }

    .quick-action-title {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }

    .quick-action-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    .quick-action-arrow {
        margin-left: auto;
        padding-left: 10px;
        color: #cbd5e1;
    }

    /* =========================================================
       ATTENTION
       ========================================================= */

    .attention-item {
        display: flex;
        align-items: flex-start;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .attention-item:last-child {
        border-bottom: 0;
    }

    .attention-icon {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 37px;
        height: 37px;
        min-width: 37px;

        margin-right: 11px;

        border-radius: 9px;
    }

    .attention-title {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
    }

    .attention-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .tech-table {
        margin-bottom: 0;
    }

    .tech-table thead th {
        padding: 12px 10px;

        border-top: 0;
        border-bottom: 1px solid #e2e8f0;

        color: #64748b;

        font-size: 10px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .tech-table tbody td {
        padding: 13px 10px;
        vertical-align: middle;

        border-color: #f1f5f9;

        color: #334155;
        font-size: 12px;
    }

    .request-number {
        color: #075985;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 9px;

        border-radius: 50px;

        font-size: 10px;
        font-weight: 700;
    }

    .status-submitted {
        background: #e0f2fe;
        color: #0369a1;
    }

    .status-progress {
        background: #fef3c7;
        color: #b45309;
    }

    .status-completed {
        background: #dcfce7;
        color: #15803d;
    }

    .status-review {
        background: #ffedd5;
        color: #c2410c;
    }

    .status-verified {
        background: #d1fae5;
        color: #047857;
    }

    .status-stat {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* =========================================================
       FILTERS
       ========================================================= */

    .filter-select {
        height: 35px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        font-size: 11px;
    }

    /* =========================================================
       PROFILE
       ========================================================= */

    .profile-summary {
        display: flex;
        align-items: center;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 46px;
        height: 46px;

        margin-right: 12px;

        border-radius: 50%;

        background: linear-gradient(
            135deg,
            #075985,
            #0284c7
        );

        color: #fff;
        font-weight: 700;
    }

    .profile-name {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }

    .profile-role,
    .profile-email {
        color: #64748b;
        font-size: 11px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width: 768px) {

        .tech-hero {
            padding-top: 25px;
        }

        .tech-hero h1 {
            font-size: 24px;
        }

        .hero-actions {
            margin-top: 20px;
        }

        .workflow {
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
        }

        .workflow-link {
            display: grid;
            grid-template-columns: 48px 1fr;
            grid-template-rows: auto auto;
            column-gap: 12px;
            width: 100%;
            text-align: left;
        }

        .workflow-link .workflow-icon {
            grid-column: 1;
            grid-row: 1 / span 2;
            margin: 0;
        }

        .workflow-link .workflow-title {
            grid-column: 2;
            grid-row: 1;
            align-self: end;
            margin: 0;
            font-size: 12px;
        }

        .workflow-link .workflow-hint {
            grid-column: 2;
            grid-row: 2;
            align-self: start;
            margin-top: 2px;
        }

        .workflow-line {
            flex: none;
            width: 2px;
            height: 16px;
            margin: 0 0 0 31px;
            background: #e2e8f0;
        }
    }
</style>


<div class="tech-dashboard">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <div class="tech-hero">

        <div class="container-fluid">

            <div class="tech-hero-content">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <div class="tech-badge">

                            <i class="fas fa-microscope"></i>

                            Lab Technician Subsystem

                        </div>

                        <h1>
                            Welcome, @technicianName
                        </h1>

                        <p>
                            Receive patient test requests and samples,
                            select assigned test types, capture laboratory
                            results and perform two-step result verification.
                        </p>

                    </div>


                    <div class="col-md-4">

                        <div class="hero-actions justify-content-md-end">

                            <a asp-area="Technician"
                               asp-controller="ReceiveSamples"
                               asp-action="Index"
                               class="hero-btn hero-btn-primary">

                                <i class="fas fa-vials"></i>

                                Receive Samples

                            </a>

                            <a asp-area="Technician"
                               asp-controller="ReceiveSamples"
                               asp-action="VerifiedSamples"
                               class="hero-btn hero-btn-outline">

                                <i class="fas fa-check-double"></i>

                                Verify Results

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

    <div class="container-fluid tech-page-inner">


        <!-- =====================================================
             WORKLOAD CARDS - ROW 1
             ===================================================== -->

        <div class="row">

            <!-- MY SELECTED TESTS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="MyTests"
                   class="stat-card-link"
                   title="View my selected tests">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    My Selected Tests
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Tests currently assigned to you
                                </div>

                            </div>

                            <div class="stat-icon icon-blue">

                                <i class="fas fa-microscope"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- WAITING FOR SELECTION -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="Available"
                   class="stat-card-link"
                   title="View tests waiting for selection">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Waiting for Selection
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Available assigned test types
                                </div>

                            </div>

                            <div class="stat-icon icon-cyan">

                                <i class="fas fa-list-check"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- WAITING FOR VERIFICATION -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Verification"
                   asp-action="Pending"
                   class="stat-card-link"
                   title="View results waiting for verification">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Waiting for Verification
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Completed results requiring verification
                                </div>

                            </div>

                            <div class="stat-icon icon-purple">

                                <i class="fas fa-user-check"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- TO BE REVIEWED -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="Review"
                   class="stat-card-link"
                   title="View tests returned for review">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    To Be Reviewed
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Results returned with verification notes
                                </div>

                            </div>

                            <div class="stat-icon icon-orange">

                                <i class="fas fa-rotate-left"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>


        <!-- =====================================================
             WORKLOAD CARDS - ROW 2
             ===================================================== -->

        <div class="row">

            <!-- URGENT / STAT -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="Urgent"
                   class="stat-card-link"
                   title="View urgent and STAT tests">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Urgent / STAT Tests
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    High-priority laboratory tests
                                </div>

                            </div>

                            <div class="stat-icon icon-red">

                                <i class="fas fa-bolt"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- OVERDUE -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="Overdue"
                   class="stat-card-link"
                   title="View overdue tests">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Overdue Tests
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Tests beyond turnaround time
                                </div>

                            </div>

                            <div class="stat-icon icon-red">

                                <i class="fas fa-clock"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- NEARING TAT -->

            <div class="col-xl-4 col-md-12 mb-4">

                <a asp-area="Technician"
                   asp-controller="Tests"
                   asp-action="NearingTat"
                   class="stat-card-link"
                   title="View tests nearing turnaround time">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Nearing TAT Limit
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Tests approaching expected completion
                                </div>

                            </div>

                            <div class="stat-icon icon-yellow">

                                <i class="fas fa-hourglass-half"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>


        <!-- =====================================================
             LABORATORY WORKFLOW
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    Laboratory Test Workflow
                </h4>

                <p class="dashboard-subtitle">
                    Lab Technician test processing and verification workflow
                </p>

            </div>

            <div class="card-body">

                <div class="workflow">

                    <a asp-area="Technician" asp-controller="ReceiveSamples" asp-action="Index"
                       class="workflow-item workflow-link" title="Receive and verify laboratory samples">
                        <div class="workflow-icon"><i class="fas fa-vials"></i></div>
                        <div class="workflow-title">Receive Samples</div>
                        <div class="workflow-hint">Verify &amp; receive</div>
                    </a>

                    <div class="workflow-line"></div>

                    <a asp-area="Technician" asp-controller="Tests" asp-action="Available"
                       class="workflow-item workflow-link" title="Select an available assigned test type">
                        <div class="workflow-icon"> <i class="fas fa-clipboard-list"></i></div>
                        <div class="workflow-title">Select Test Type</div>
                        <div class="workflow-hint">Available tests</div>
                    </a>

                    <div class="workflow-line"></div>

                    <a asp-area="Technician" asp-controller="Tests" asp-action="MyTests"
                       class="workflow-item workflow-link" title="View and perform your selected tests">
                        <div class="workflow-icon"><i class="fas fa-microscope"></i></div>
                        <div class="workflow-title">Perform Test</div>
                        <div class="workflow-hint">My selected tests</div>
                    </a>

                    <div class="workflow-line"></div>

