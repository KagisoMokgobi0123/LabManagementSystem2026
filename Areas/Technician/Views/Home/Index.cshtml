               PAGE INNER
               ========================================================= */

    .tech-page-inner {
        position: relative;
        z-index: 5;
        margin-top: -48px;
        padding-bottom: 50px;
    }

    /* =========================================================
               CLICKABLE STAT CARDS
               ========================================================= */

    .stat-card-link {
        display: block;
        height: 100%;
        color: inherit !important;
        text-decoration: none !important;
    }

    .stat-card {
        position: relative;
        height: 100%;
        padding: 20px;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .stat-card-link:hover .stat-card {
        transform: translateY(-4px);
        border-color: #bae6fd;
        box-shadow: 0 12px 30px rgba(15,23,42,.13);
    }

    .stat-card::after {
        content: "\f054";
        position: absolute;
        right: 20px;
        bottom: 17px;
        font-family: "Font Awesome 5 Free";
        font-size: 10px;
        font-weight: 900;
        color: #cbd5e1;
        opacity: 0;
        transform: translateX(-5px);
        transition: .2s ease;
    }

    .stat-card-link:hover .stat-card::after {
        opacity: 1;
        transform: translateX(0);
    }

    .stat-card-link:focus {
        outline: none;
    }

        .stat-card-link:focus .stat-card {
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2,132,199,.15);
        }

    .stat-top {
        display: flex;
