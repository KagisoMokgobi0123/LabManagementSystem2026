            }

            .workflow-link .workflow-title {
                grid-column: 2;
                grid-row: 1;
                align-self: end;
                margin: 0;
                font-size: 12px;
            }

            .workflow-link .workflow-hint {
                grid-column: 2;
                grid-row: 2;
                align-self: start;
                margin-top: 2px;
            }

        .workflow-line {
            flex: none;
            width: 2px;
            height: 16px;
            margin: 0 0 0 31px;
            background: #e2e8f0;
        }
    }
</style>


