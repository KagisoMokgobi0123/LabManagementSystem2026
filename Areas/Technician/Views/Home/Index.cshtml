    .tech-tool > summary:hover, .tech-tool[open] > summary { background:rgba(255,255,255,.24); }
    .tech-tool .tool-count { position:absolute; top:-6px; right:-6px; min-width:19px; height:19px; padding:0 4px; border-radius:12px; background:#dc2626; color:#fff; font-size:11px; font-weight:700; text-align:center; line-height:19px; pointer-events:none; }
    .tech-tool-menu { position:absolute; right:0; top:calc(100% + 9px); width:280px; max-width:calc(100vw - 32px); padding:14px; background:#fff; color:#334155; border:1px solid #e2e8f0; border-radius:12px; box-shadow:0 12px 32px rgba(0,0,0,.18); z-index:50; overflow-wrap:anywhere; }
    .tech-tool-menu h3 { font-size:14px; font-weight:700; margin:0 0 8px; color:#0f172a; }
    .tech-tool-menu p { font-size:12px; margin:0 0 12px; }
    .tech-tool-menu a { display:block; font-size:12px; padding:9px; border-radius:7px; text-decoration:none; color:#075985; }
    .tech-tool-menu a:hover { background:#eff6ff; }
    .tech-profile-trigger { width:auto !important; padding:0 12px; gap:9px; }
    .tech-profile-trigger .tech-avatar { display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:50%; background:#fff; color:#075985; font-weight:700; }
    @@media(max-width:575.98px) { .tech-header-tools { flex-wrap:wrap; } .tech-profile-trigger .tech-profile-label { display:none; } }

