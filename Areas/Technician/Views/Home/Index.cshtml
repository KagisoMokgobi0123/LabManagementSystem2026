            position: absolute;
            width: 260px;
            height: 260px;
            right: 220px;
            bottom: -190px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

        .tech-hero::after {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -100px;
            top: -210px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

    .tech-hero-content {
        position: relative;
        z-index: 2;
    }

    .tech-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        margin-bottom: 14px;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,.20);
        background: rgba(255,255,255,.13);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

    .tech-hero h1 {
