        color: #ea580c;
    }

    .icon-purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-red {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-yellow {
        background: #fef3c7;
        color: #d97706;
    }

    /* =========================================================
               DASHBOARD CARDS
               ========================================================= */

    .dashboard-card {
