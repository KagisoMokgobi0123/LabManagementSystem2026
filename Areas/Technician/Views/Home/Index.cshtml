    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media(max-width: 768px) {

        .tech-hero {
            padding-top: 25px;
        }

            .tech-hero h1 {
                font-size: 24px;
            }

        .hero-actions {
            margin-top: 20px;
        }

        .workflow {
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
        }

        .workflow-link {
            display: grid;
            grid-template-columns: 48px 1fr;
            grid-template-rows: auto auto;
            column-gap: 12px;
            width: 100%;
            text-align: left;
