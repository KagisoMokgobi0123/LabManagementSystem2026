        font-size: 11px;
    }

    /* =========================================================
               PROFILE
               ========================================================= */

    .profile-summary {
        display: flex;
        align-items: center;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        margin-right: 12px;
        border-radius: 50%;
        background: linear-gradient( 135deg, #075985, #0284c7 );
