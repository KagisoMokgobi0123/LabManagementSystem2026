        color: #94a3b8;
        font-size: 11px;
    }

    /* =========================================================
               WORKFLOW
               ========================================================= */

    .workflow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .workflow-item {
        flex: 1;
        text-align: center;
    }

    .workflow-icon {
        display: flex;
        align-items: center;
        justify-content: center;
