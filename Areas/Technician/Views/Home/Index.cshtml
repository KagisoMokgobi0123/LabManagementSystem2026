        <div class="dashboard-card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-lg-5">
                        <h4 class="dashboard-title">My Test Workload</h4>
                        <p class="dashboard-subtitle">Selected tests, expected completion times and processing status</p>
                    </div>
                    <div class="col-lg-7 mt-3 mt-lg-0">
                        <div class="row">
                            <div class="col-md-3 mb-2 mb-md-0">
                                <select id="workloadUrgency" class="form-control filter-select" onchange="filterTechnicianWorkload()">
                                    <option value="">All Urgencies</option>
                                    <option value="Routine">Routine</option>
                                    <option value="Urgent">Urgent</option>
                                    <option value="Stat">STAT</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-2 mb-md-0">
                                <select id="workloadCategory" class="form-control filter-select" onchange="filterTechnicianWorkload()">
                                    <option value="">All Categories</option>
                                    @foreach (var category in workloadCategories)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-2 mb-md-0">
                                <select id="workloadDue" class="form-control filter-select" onchange="filterTechnicianWorkload()">
                                    <option value="">All Due Times</option>
                                    <option value="overdue">Overdue</option>
                                    <option value="soon">Due Soon (next 24h)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input id="workloadRequest" type="text" class="form-control filter-select" placeholder="Request #" oninput="filterTechnicianWorkload()" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table tech-table" id="technicianWorkloadTable">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Test Type</th>
                                <th>Category</th>
                                <th>Urgency</th>
                                <th>Started</th>
                                <th>Expected Completion</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var test in workload)
                            {
                                var started = test.StartDateTime;
                                DateTime? due = started.HasValue && test.TestType != null
                                    ? started.Value.AddHours(test.TestType.TurnAroundTimeHours)
                                    : null;
                                var urgency = test.TestRequest?.Urgency.ToString() ?? "—";
                                var category = test.TestType?.TestCategory?.Description ?? "—";
                                var requestNumber = test.TestRequest?.RequestNumber ?? test.TestRequestId.ToString();
                                var dueState = due.HasValue && test.Status != "Completed" && test.Status != "Verified"
                                    ? (due.Value < workloadNowUtc ? "overdue" :
                                       due.Value <= workloadNowUtc.AddHours(24) ? "soon" : "later")
                                    : "none";
                                <tr class="workload-row" data-urgency="@urgency" data-category="@category" data-due="@dueState" data-request="@requestNumber">
                                    <td><span class="request-number">@requestNumber</span></td>
                                    <td>@(test.TestType?.Name ?? "—")</td>
                                    <td>@category</td>
                                    <td>@urgency</td>
                                    <td>@(started.HasValue ? started.Value.ToString("dd MMM yyyy HH:mm") + " UTC" : "Not started")</td>
                                    <td>@(due.HasValue ? due.Value.ToString("dd MMM yyyy HH:mm") + " UTC" : "—")</td>
                                    <td><span class="status-badge status-progress">@test.Status</span></td>
                                    <td><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Details", "Tests", new { area = "Technician", id = test.TestRequestTestTypeId })">View</a></td>
                                </tr>
                            }
                            <tr id="workloadEmpty" style="@(workload.Any() ? "display:none" : "")">
                                <td colspan="8" class="text-center py-5 text-muted">
                                    No matching selected tests.
                                    <div class="mt-3"><a href="/Technician/Tests/Select" class="btn btn-primary btn-sm">View Available Tests</a></div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <script>
                    function filterTechnicianWorkload() {
                        const urgency = document.getElementById('workloadUrgency').value.toLowerCase();
                        const category = document.getElementById('workloadCategory').value.toLowerCase();
                        const due = document.getElementById('workloadDue').value;
                        const request = document.getElementById('workloadRequest').value.toLowerCase().trim();
                        let shown = 0;
                        document.querySelectorAll('#technicianWorkloadTable .workload-row').forEach(row => {
                            const matches = (!urgency || row.dataset.urgency.toLowerCase() === urgency)
                                && (!category || row.dataset.category.toLowerCase() === category)
                                && (!due || row.dataset.due === due)
                                && (!request || row.dataset.request.toLowerCase().includes(request));
                            row.style.display = matches ? '' : 'none';
                            if (matches) shown++;
                        });
                        document.getElementById('workloadEmpty').style.display = shown ? 'none' : '';
                    }
        </script>


