@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject NMB_HLabSys.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "Lab Technician Dashboard";
    Layout = "_TechnicianLayout";

    var currentUser = await UserManager.GetUserAsync(User);

    // Current database counts (updated on every dashboard request).
    var technicianId = currentUser?.Id;
    var assignedTypeIds = Db.TechnicianTestTypes
        .Where(a => a.TechnicianId == technicianId && a.IsActive)
        .Select(a => a.TestTypeId);
    var mySelectedCount = Db.TestRequestTestTypes.Count(t =>
        t.TechnicianId == technicianId && t.Status == "In Progress");
    var waitingSelectionCount = Db.TestRequestTestTypes.Count(t =>
        t.Status == "SamplesReceived" && (t.TechnicianId == null || t.TechnicianId == "") && assignedTypeIds.Contains(t.TestTypeId));
    var waitingVerificationCount = Db.TestRequestTestTypes.Count(t =>
        t.Status == "Completed" && t.TechnicianId != null && t.TechnicianId != technicianId && assignedTypeIds.Contains(t.TestTypeId));
    var toReviewCount = Db.TestRequestTestTypes.Count(t =>
        t.TechnicianId == technicianId && t.Status == "To Be Reviewed");
    var urgentRequestIds = Db.TestRequests.AsEnumerable()
        .Where(r => r.Urgency.ToString().Equals("Urgent", StringComparison.OrdinalIgnoreCase)
                 || r.Urgency.ToString().Equals("Stat", StringComparison.OrdinalIgnoreCase))
        .Select(r => r.TestRequestId).ToList();
    var urgentCount = Db.TestRequestTestTypes.Count(t =>
        urgentRequestIds.Contains(t.TestRequestId) &&
        (t.TechnicianId == technicianId ||
         (t.Status == "SamplesReceived" && (t.TechnicianId == null || t.TechnicianId == "") && assignedTypeIds.Contains(t.TestTypeId))) &&
        (t.Status == "SamplesReceived" || t.Status == "In Progress"));

    // Current technician's selected tests; fetched fresh on each page request.
    var workload = await Db.TestRequestTestTypes.AsNoTracking()
            .Include(t => t.TestRequest)
            .Include(t => t.TestType).ThenInclude(tt => tt.TestCategory)
            .Where(t => t.TechnicianId == technicianId &&
                (t.Status == "In Progress" || t.Status == "Completed" || t.Status == "To Be Reviewed"))
            .OrderByDescending(t => t.StartDateTime)
            .ToListAsync();
    var workloadNowUtc = DateTime.UtcNow;
    // Turnaround-time statistics for this technician's active tests.
    // No matching records produce 0, never a dash.
    var activeDeadlines = workload
        .Where(t => t.Status == "In Progress" && t.StartDateTime.HasValue && t.TestType != null)
        .Select(t => t.StartDateTime!.Value.AddHours(t.TestType!.TurnAroundTimeHours))
        .ToList();
    var overdueCount = activeDeadlines.Count(due => due < workloadNowUtc);
    var nearingTatCount = activeDeadlines.Count(due =>
        due >= workloadNowUtc && due <= workloadNowUtc.AddMinutes(60));

    var workloadCategories = workload
        .Select(t => t.TestType?.TestCategory?.Description)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct().OrderBy(c => c).ToList();

    var technicianName = currentUser?.FullName ?? "Lab Technician";
    var technicianEmail = currentUser?.Email ?? "";

    var technicianInitial =
        !string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? currentUser.FirstName.Substring(0, 1).ToUpper()
            : "T";
}

<style>

