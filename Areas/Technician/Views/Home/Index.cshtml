<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script>
(() => {
    const canvas = document.getElementById('technicianActivityChart');
    if (!canvas) return;
    const status = document.getElementById('activityStatus');
    let days = 7;
    let chart = null;
    let loading = false;
    const endpoint = '@Url.Action("TestActivityStats", "Home", new { area = "Technician" })';
    const buttons = document.querySelectorAll('.activity-period');
    async function refreshActivity() {
        if (loading) return;
        if (typeof Chart === 'undefined') {
            status.textContent = 'Chart.js did not load. Check your internet connection or install Chart.js locally.';
            return;
        }
        loading = true;
        try {
            const response = await fetch(endpoint + '?days=' + days, { cache: 'no-store', credentials: 'same-origin' });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const data = await response.json();
            const started = data.started.reduce((a, b) => a + b, 0);
            const completed = data.completed.reduce((a, b) => a + b, 0);
            document.getElementById('activityStarted').textContent = started;
            document.getElementById('activityCompleted').textContent = completed;
            document.getElementById('activityRate').textContent = started ? (completed / started * 100).toFixed(1) + '%' : 'N/A';
            const series = [
                { label: 'Started', data: data.started, borderColor: '#0284c7', backgroundColor: '#0284c7', tension: 0.25 },
                { label: 'Completed', data: data.completed, borderColor: '#16a34a', backgroundColor: '#16a34a', tension: 0.25 }
            ];
            if (chart) {
                chart.data.labels = data.labels;
                chart.data.datasets = series;
                chart.update();
            } else {
                chart = new Chart(canvas, {
                    type: 'line',
                    data: { labels: data.labels, datasets: series },
                    options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
                });
            }
            status.textContent = 'Last updated: ' + new Date().toLocaleTimeString() + ' (graph dates use UTC)';
        } catch (err) {
            status.textContent = 'Unable to load live statistics: ' + err.message;
        } finally { loading = false; }
    }
    buttons.forEach(btn => btn.addEventListener('click', () => {
        days = Number(btn.dataset.days);
        buttons.forEach(b => { b.classList.toggle('btn-primary', b === btn); b.classList.toggle('btn-outline-primary', b !== btn); });
        refreshActivity();
    }));
    document.getElementById('refreshActivity').addEventListener('click', refreshActivity);
    refreshActivity();
    const interval = setInterval(() => { if (!document.hidden) refreshActivity(); }, 15000);
    window.addEventListener('pagehide', () => clearInterval(interval), { once: true });
})();
</script>
