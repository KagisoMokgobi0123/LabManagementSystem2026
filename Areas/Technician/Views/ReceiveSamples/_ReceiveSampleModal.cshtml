@using NMB_HLabSys.Areas.Technician.Models
@model ReceiveSampleViewModel
<style>
    /* =========================================
       RECEIVE SAMPLE VERIFICATION
    ========================================= */
    .verification-warning.verification-success {
        background: #e4f7ed;
        border-color: #b5e8cd;
        color: #178451;
    }

    .verification-modal-card {
        width: 100%;
        background: #fff;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.22);
    }

    .verification-header {
        min-height: 74px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #1473f6;
        color: white;
    }

    .verification-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 24px;
        font-weight: 500;
    }

        .verification-title i {
            font-size: 20px;
        }

    .verification-close {
        border: 0;
        background: transparent;
        color: #c9ddff;
        font-size: 25px;
        cursor: pointer;
        transition: .2s ease;
    }

        .verification-close:hover {
            color: white;
            transform: scale(1.08);
        }


    /* BODY */

    .verification-body {
        padding: 20px;
    }

    .verification-checklist {
        padding: 16px 18px 18px;
        background: #f7f7f7;
        border-radius: 12px;
    }

    .checklist-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-size: 20px;
        font-weight: 500;
        color: #252525;
    }

        .checklist-heading i {
            color: #262d34;
            font-size: 18px;
        }


    /* EACH ROW */

    .verification-row {
        min-height: 47px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #262626;
    }

        .verification-row label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin: 0;
            font-size: 18px;
            cursor: pointer;
        }

            .verification-row label strong {
                font-weight: 700;
            }

            .verification-row label span {
                font-weight: 400;
            }


    /* CHECKBOXES */

    .verification-check {
        width: 19px;
        height: 19px;
        min-width: 19px;
        border-radius: 4px;
        cursor: pointer;
        border: 1px solid #bfc4ca;
    }

        .verification-check:checked {
            background-color: #1473f6;
            border-color: #1473f6;
        }


    /* BARCODE */

    .verification-barcode {
        width: 220px;
        min-height: 45px;
        padding: 7px 14px;
        margin-left: 3px;
        border: 1px solid #cfd3d7;
        border-radius: 5px;
        font-size: 18px;
        background: #fff !important;
        color: #333;
    }

    .barcode-valid {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-left: 55px;
        color: #039447;
        font-size: 17px;
    }

        .barcode-valid i {
            font-size: 14px;
        }


    /* SAMPLE TYPE */

    .verification-select {
        width: 145px;
        min-height: 44px;
        margin-left: 4px;
        border: 1px solid #ccd2d8;
        border-radius: 5px;
        background: white;
        font-size: 17px;
    }

    .verification-validation {
        display: block;
        margin-left: 30px;
        font-size: 13px;
    }


    /* WARNING */

    .verification-warning {
        margin-top: 18px;
        padding: 20px;
        border-radius: 5px;
        border: 1px solid #ffe089;
        background: #fff3c4;
        color: #765700;
        font-size: 17px;
    }


    /* FOOTER */

    .verification-footer {
        min-height: 84px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 18px 20px;
        border-top: 1px solid #e1e4e8;
        background: white;
    }

    .verification-cancel {
        min-width: 93px;
        min-height: 45px;
        border: none;
        border-radius: 5px;
        color: white;
        background: #737d86;
        font-size: 17px;
    }

        .verification-cancel:hover {
            background: #626b73;
            color: white;
        }

    .verification-confirm {
        min-height: 45px;
        padding: 0 18px;
        border: none;
        border-radius: 5px;
        background: #55b987;
        color: white;
        font-size: 17px;
    }

        .verification-confirm:hover:not(:disabled) {
            background: #41a975;
            color: white;
        }

        .verification-confirm:disabled {
            opacity: .8;
            cursor: not-allowed;
        }


    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .verification-title {
            font-size: 18px;
        }

        .verification-row {
            flex-wrap: wrap;
        }

            .verification-row label {
                font-size: 15px;
            }

        .verification-barcode {
            width: 100%;
        }

        .barcode-valid {
            margin-left: 29px;
        }

        .verification-select {
            width: 100%;
        }

        .verification-footer {
            flex-direction: column-reverse;
        }

            .verification-footer .btn {
                width: 100%;
            }
    }</style>
<div class="verification-modal-card">

    <div class="verification-header">
        <div class="verification-title">
            <i class="fas fa-vial"></i>
            Receive Sample - Verification Required
        </div>

        <button type="button"
                class="verification-close"
                data-bs-dismiss="modal"
                aria-label="Close">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="verification-body">

        <div class="verification-checklist">

            <div class="checklist-heading">
                <i class="fas fa-check-circle"></i>
                Sample Verification Checklist
            </div>

            <!-- REQUEST NUMBER -->
            <div class="verification-row">
                <input asp-for="VerifyRequestNumber"
                       class="form-check-input verification-check"
                       id="verifyRequestNumber" />

                <label for="verifyRequestNumber">
                    <strong>Request Number:</strong>
                    <span>@Model.RequestNumber</span>
                </label>
            </div>


            <!-- TECHNICIAN -->
            <div class="verification-row">
                <input asp-for="VerifyTechnician"
                       class="form-check-input verification-check"
                       id="verifyTechnician" />

                <label for="verifyTechnician">
                    <strong>Technician Receiving:</strong>
                    <span>@Model.TechnicianName</span>
                </label>
            </div>


            <!-- BARCODE -->
            <div class="verification-row align-items-center">

                <input asp-for="VerifyBarcode"
                       class="form-check-input verification-check"
                       id="verifyBarcode" />

                <label for="verifyBarcode" class="mb-0">
                    <strong>Sample Barcode:</strong>
                </label>

                <input type="text"
                       value="@Model.Barcode"
                       class="form-control verification-barcode"
                       readonly />

                <span class="barcode-valid">
                    <i class="fas fa-check"></i>
                    Unique
                </span>

            </div>


            <!-- SAMPLE TYPE -->
            <div class="verification-row align-items-center">

                <input asp-for="VerifySampleType"
                       class="form-check-input verification-check"
                       id="verifySampleType" />

                <label for="verifySampleType" class="mb-0">
                    <strong>Sample Type:</strong>
                </label>

                <select asp-for="SampleTypeId"
                        asp-items="Model.SampleTypes"
                        class="form-select verification-select">

                    <option value="">
                        Select
                    </option>

                </select>

            </div>

            <span asp-validation-for="SampleTypeId"
                  class="text-danger verification-validation">
            </span>


            <!-- DATE TIME -->
            <div class="verification-row">

                <input asp-for="VerifyDateTime"
                       class="form-check-input verification-check"
                       id="verifyDateTime" />

                <label for="verifyDateTime">
                    <strong>Date/Time Received:</strong>

                    <span>
                        @Model.DateTimeReceived.ToString("M/d/yyyy, h:mm:ss tt")
                    </span>
                </label>

            </div>

        </div>


        <div id="verificationWarning"
             class="verification-warning">

            Please verify all items.

        </div>

    </div>


    <div class="verification-footer">

        <button type="button"
                class="btn verification-cancel"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="confirmReceiveBtn"
                class="btn verification-confirm"
                disabled>

            <i class="fas fa-check-circle"></i>

            Confirm &amp; Set Status to "Samples Received"

        </button>

    </div>

</div>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const checks =
                document.querySelectorAll(".verification-check");

            const confirmButton =
                document.getElementById("confirmReceiveBtn");

            const warning =
                document.getElementById("verificationWarning");


            function updateVerificationStatus() {

                const allChecked =
                    Array.from(checks)
                        .every(check => check.checked);


                confirmButton.disabled = !allChecked;


                if (allChecked) {

                    warning.innerHTML =
                        '<i class="fas fa-check-circle me-2"></i>' +
                        'All items have been verified.';

                    warning.classList.add(
                        "verification-success"
                    );

                }
                else {

                    warning.textContent =
                        "Please verify all items.";

                    warning.classList.remove(
                        "verification-success"
                    );

                }
            }


            checks.forEach(check => {

                check.addEventListener(
                    "change",
                    updateVerificationStatus
                );

            });


            updateVerificationStatus();

        });
    </script>