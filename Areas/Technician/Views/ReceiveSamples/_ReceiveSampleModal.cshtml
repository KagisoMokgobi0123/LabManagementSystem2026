@using NMB_HLabSys.Areas.Technician.Models
@model ReceiveSampleViewModel
<style>
    /* =========================================
       RECEIVE SAMPLE VERIFICATION
    ========================================= */
    .verification-warning.verification-success {
        background: #e4f7ed;
        border-color: #b5e8cd;
        color: #178451;
    }

    .verification-modal-card {
        width: 100%;
        background: #fff;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.22);
    }

    .verification-header {
        min-height: 74px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #1473f6;
        color: white;
    }

    .verification-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 24px;
        font-weight: 500;
    }

        .verification-title i {
            font-size: 20px;
        }

    .verification-close {
        border: 0;
        background: transparent;
        color: #c9ddff;
        font-size: 25px;
        cursor: pointer;
        transition: .2s ease;
    }

        .verification-close:hover {
            color: white;
            transform: scale(1.08);
        }


    /* BODY */

    .verification-body {
        padding: 20px;
    }

    .verification-checklist {
        padding: 16px 18px 18px;
        background: #f7f7f7;
        border-radius: 12px;
    }

    .checklist-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        font-size: 20px;
        font-weight: 500;
        color: #252525;
    }

        .checklist-heading i {
            color: #262d34;
            font-size: 18px;
        }


    /* EACH ROW */

    .verification-row {
        min-height: 47px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #262626;
    }

        .verification-row label {
            display: flex;
            align-items: center;
            gap: 5px;
            margin: 0;
            font-size: 18px;
            cursor: pointer;
        }

            .verification-row label strong {
                font-weight: 700;
            }

            .verification-row label span {
                font-weight: 400;
            }


    /* CHECKBOXES */

    .verification-check {
        width: 19px;
        height: 19px;
        min-width: 19px;
        border-radius: 4px;
        cursor: pointer;
        border: 1px solid #bfc4ca;
    }

        .verification-check:checked {
            background-color: #1473f6;
            border-color: #1473f6;
        }


    /* BARCODE */

    .verification-barcode {
        width: 220px;
        min-height: 45px;
        padding: 7px 14px;
        margin-left: 3px;
        border: 1px solid #cfd3d7;
        border-radius: 5px;
        font-size: 18px;
        background: #fff !important;
        color: #333;
    }

    .barcode-valid {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-left: 55px;
        color: #039447;
        font-size: 17px;
    }

        .barcode-valid i {
            font-size: 14px;
        }


    /* SAMPLE TYPE */

    .verification-select {
        width: 145px;
        min-height: 44px;
        margin-left: 4px;
        border: 1px solid #ccd2d8;
        border-radius: 5px;
        background: white;
        font-size: 17px;
    }

    .verification-validation {
        display: block;
        margin-left: 30px;
        font-size: 13px;
    }


    /* WARNING */

    .verification-warning {
        margin-top: 18px;
        padding: 20px;
        border-radius: 5px;
        border: 1px solid #ffe089;
        background: #fff3c4;
        color: #765700;
        font-size: 17px;
    }


    /* FOOTER */

    .verification-footer {
        min-height: 84px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 18px 20px;
        border-top: 1px solid #e1e4e8;
        background: white;
    }

    .verification-cancel {
        min-width: 93px;
        min-height: 45px;
        border: none;
        border-radius: 5px;
        color: white;
        background: #737d86;
        font-size: 17px;
    }

        .verification-cancel:hover {
            background: #626b73;
            color: white;
        }

    .verification-confirm {
        min-height: 45px;
        padding: 0 18px;
        border: none;
        border-radius: 5px;
        background: #55b987;
        color: white;
        font-size: 17px;
    }

        .verification-confirm:hover:not(:disabled) {
            background: #41a975;
            color: white;
        }

        .verification-confirm:disabled {
            opacity: .8;
            cursor: not-allowed;
        }


    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .verification-title {
            font-size: 18px;
        }

        .verification-row {
            flex-wrap: wrap;
        }

            .verification-row label {
                font-size: 15px;
            }

        .verification-barcode {
            width: 100%;
        }

        .barcode-valid {
            margin-left: 29px;
        }

        .verification-select {
            width: 100%;
        }

        .verification-footer {
            flex-direction: column-reverse;
        }

            .verification-footer .btn {
                width: 100%;
            }
    }</style>

    <div class="verification-body">

        <div class="verification-checklist">

            <div class="checklist-heading mb-3">
                <i class="fas fa-clipboard-check mr-1"></i>
                Sample Verification Checklist
            </div>


            <!-- ===================== -->
            <!-- ROW 1: THREE FIELDS   -->
            <!-- ===================== -->
            <div class="row">

                <!-- REQUEST NUMBER -->
                <div class="col-md-4">

                    <div class="verification-row">

                        <input asp-for="VerifyRequestNumber"
                               type="checkbox"
                               class="verification-check"
                               id="verifyRequestNumber" />

                        <label for="verifyRequestNumber">

                            <strong>Request Number</strong>

                            <span>
                                @Model.RequestNumber
                            </span>

                        </label>

                    </div>

                </div>


                <!-- TECHNICIAN -->
                <div class="col-md-4">

                    <div class="verification-row">

                        <input asp-for="VerifyTechnician"
                               type="checkbox"
                               class="verification-check"
                               id="verifyTechnician" />

                        <label for="verifyTechnician">

                            <strong>Technician Receiving</strong>

                            <span>
                                @Model.TechnicianName
                            </span>

                        </label>

                    </div>

                </div>


                <!-- BARCODE -->
                <div class="col-md-4">

                    <div class="verification-row">

                        <input asp-for="VerifyBarcode"
                               type="checkbox"
                               class="verification-check"
                               id="verifyBarcode" />

                        <label for="verifyBarcode">

                            <strong>Sample Barcode</strong>

                            <span>
                                @Model.Barcode
                            </span>

                            <small class="barcode-valid">
                                <i class="fas fa-check-circle mr-1"></i>
                                Unique
                            </small>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ===================== -->
            <!-- ROW 2: THREE FIELDS   -->
            <!-- ===================== -->
            <div class="row">

                <!-- SAMPLE TYPE -->
                <div class="col-md-4">

                    <div class="verification-row">

                        <input asp-for="VerifySampleType"
                               type="checkbox"
                               class="verification-check"
                               id="verifySampleType" />

                        <label for="verifySampleType">

                            <strong>Sample Type</strong>

                            <span>
                                @Model.SampleTypeName
                            </span>

                        </label>

                    </div>

                </div>


                <!-- DATE / TIME -->
                <div class="col-md-4">

                    <div class="verification-row">

                        <input asp-for="VerifyDateTime"
                               type="checkbox"
                               class="verification-check"
                               id="verifyDateTime" />

                        <label for="verifyDateTime">

                            <strong>Date / Time Received</strong>

                            <span>
                                @Model.DateTimeReceived.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </span>

                        </label>

                    </div>

                </div>


                <!-- VERIFICATION STATUS -->
                <div class="col-md-12">

                    <div id="verificationWarning"
                         class="verification-warning">

                        <div>

                            <i class="fas fa-exclamation-triangle mr-1"></i>

                            <strong>
                                Verification Required
                            </strong>

                            <div class="mt-1">
                                Please verify all items.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <div class="verification-footer">

        <button type="button"
                class="btn verification-cancel"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="confirmReceiveBtn"
                class="btn verification-confirm"
                disabled>

            <i class="fas fa-check-circle"></i>

            Confirm &amp; Set Status to "Samples Received"

        </button>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const checks =
                document.querySelectorAll(".verification-check");

            const confirmButton =
                document.getElementById("confirmReceiveBtn");

            const warning =
                document.getElementById("verificationWarning");


            function updateVerificationStatus() {

                const allChecked =
                    Array.from(checks)
                        .every(check => check.checked);


                confirmButton.disabled = !allChecked;


                if (allChecked) {

                    warning.innerHTML =
                        '<i class="fas fa-check-circle me-2"></i>' +
                        'All items have been verified.';

                    warning.classList.add(
                        "verification-success"
                    );

                }
                else {

                    warning.textContent =
                        "Please verify all items.";

                    warning.classList.remove(
                        "verification-success"
                    );

                }
            }


            checks.forEach(check => {

                check.addEventListener(
                    "change",
                    updateVerificationStatus
                );

            });


            updateVerificationStatus();

        });
    </script>