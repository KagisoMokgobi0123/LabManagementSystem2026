                                '<i class="fas fa-chevron-right"></i>',

                            last:
                                '<i class="fas fa-angle-double-right"></i>'
                        }
                    }
                });


                // ========================================================
                // SEARCH
                // ========================================================

                $("#requestSearch").on(
                    "keyup change",
                    function() {

                        table
                            .search(this.value)
                            .draw();
                    }
                );


                // ========================================================
                // URGENCY FILTER
                // Column 5 = Urgency
                // ========================================================

                $("#urgencyFilter").on(
                    "change",
                    function() {

                        const value =
                            $(this).val();

                        if (!value) {

                            table
                                .column(5)
                                .search("")
                                .draw();

                            return;
                        }

                        table
                            .column(5)
                            .search(
                                "^" + value + "$",
                                true,
                                false
                            )
                            .draw();
                    }
                );
            }


            // ============================================================
            // DE-ACTIVATE SAMPLE: MANDATORY REASON + AUDIT
            // ============================================================
            $(document).on("click", ".js-deactivate-sample", async function(event) {
                event.preventDefault();
                const button = $(this);
                if (button.prop("disabled")) return;

                if (typeof Swal === "undefined") {
                    alert("SweetAlert2 is not loaded. Please contact the administrator.");
                    return;
                }

                const sampleId = Number(button.attr("data-sample-id"));
                const barcode = button.attr("data-barcode") || "Selected sample";
                const requestNumber = button.attr("data-request-number") || "N/A";
                if (!Number.isInteger(sampleId) || sampleId <= 0) {
                    await Swal.fire({ icon: "error", title: "Invalid Sample", text: "Sample ID is missing." });
                    return;
                }

                const confirmation = await Swal.fire({
                    icon: "warning",
                    title: "De-Activate Sample?",
                    text: `Request: ${requestNumber} | Barcode: ${barcode}. A reason is mandatory and will be recorded in the audit trail.`,
                    input: "textarea",
                    inputLabel: "Reason for de-activation (required)",
                    inputPlaceholder: "Explain why this sample must be de-activated...",
                    inputAttributes: { maxlength: "500", "aria-label": "Reason for de-activation" },
                    inputValidator: (value) => {
                        if (!value || !value.trim()) return "Please provide a reason for de-activation.";
                        if (value.trim().length > 500) return "The reason must not exceed 500 characters.";
                    },
                    showCancelButton: true,
                    confirmButtonText: "Yes, De-Activate",
                    cancelButtonText: "Cancel",
                    confirmButtonColor: "#dc2626",
                    showLoaderOnConfirm: true,
                    allowOutsideClick: () => !Swal.isLoading(),
                    preConfirm: async (value) => {
                        try {
                            const response = await $.ajax({
                                url: '@Url.Action("DeactivateSample", "ReceiveSamples", new { area = "Technician" })',
                                type: "POST",
                                data: {
                                    sampleId: sampleId,
                                    reason: value.trim(),
                                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                                }
                            });
                            if (!response || !response.success) {
                                Swal.showValidationMessage(response?.message || "De-activation failed.");
                                return false;
                            }
                            return response;
                        } catch (xhr) {
                            const message = xhr.responseJSON?.message ||
                                (xhr.status === 401 || xhr.status === 403
                                    ? "Your session has expired or you are not authorized."
                                    : "Unable to de-activate the sample. Please try again.");
                            Swal.showValidationMessage(message);
                            return false;
                        }
                    }
                });

                if (confirmation.isConfirmed && confirmation.value?.success) {
                    await Swal.fire({
                        icon: "success",
                        title: "Sample De-Activated",
                        text: confirmation.value.message || "The sample and audit record were saved.",
                        confirmButtonText: "OK"
                    });
                    window.location.reload();
                }
            });

            // ============================================================
            // RECEIVE SAMPLE MODAL
            // ============================================================

            $(document).on(
                "click",
                ".js-receive-sample",
                function(event) {

                    event.preventDefault();


                    // ====================================================
                    // BUTTON
                    // ====================================================

                    const button =
                        $(this);


                    // ====================================================
                    // READ VALUES DIRECTLY FROM HTML ATTRIBUTES
                    // ====================================================

                    const testRequestId =
                        button.attr("data-request-id");

                    const sampleId =
                        button.attr("data-sample-id");

                    const requestNumber =
                        button.attr("data-request-number");

                    const barcode =
                        button.attr("data-barcode");


                    // ====================================================
                    // DEBUG INFORMATION
                    // ====================================================

                    console.log(
                        "========================================"
                    );

                    console.log(
                        "RECEIVE SAMPLE BUTTON CLICKED"
                    );

                    console.log(
                        "TestRequestId:",
                        testRequestId
                    );

                    console.log(
                        "SampleId:",
                        sampleId
                    );

                    console.log(
                        "RequestNumber:",
                        requestNumber
                    );

                    console.log(
                        "Barcode:",
                        barcode
                    );

                    console.log(
                        "========================================"
                    );


                    // ====================================================
                    // VALIDATE TEST REQUEST ID
                    // ====================================================

                    if (
                        !testRequestId ||
                        testRequestId === "0"
                    ) {

                        Swal.fire({

                            icon:
                                "error",

                            title:
                                "Request Missing",

                            text:
                                "Unable to determine the TestRequestId for this sample.",

                            confirmButtonText:
                                "OK"
                        });

                        return;
                    }


                    // ====================================================
                    // VALIDATE SAMPLE ID
                    // ====================================================

                    if (
                        !sampleId ||
                        sampleId === "0"
                    ) {

                        Swal.fire({

                            icon:
                                "error",

                            title:
                                "Sample Missing",

                            text:
                                "Unable to determine the SampleId for this sample.",

                            confirmButtonText:
                                "OK"
                        });

                        return;
                    }


                    // ====================================================
                    // PREVENT DOUBLE CLICK
                    // ====================================================

                    button
                        .prop("disabled", true);


                    // ====================================================
                    // SHOW LOADING CONTENT
                    // ====================================================

                    $("#receiveSampleModalContent")
                        .html(`

                                                                                <div class="modal-body text-center py-5">

                                                                                    <div
                                                                                        class="spinner-border text-primary"
                                                                                        role="status">

                                                                                        <span class="sr-only">
                                                                                            Loading...
                                                                                        </span>

                                                                                    </div>

                                                                                    <h6 class="mt-3 mb-1">

                                                                                        Loading Sample

                                                                                    </h6>

                                                                                    <p class="text-muted mb-0">

                                                                                        ${requestNumber || "Request"}

                                                                                        <br />

                                                                                        ${barcode || ""}

                                                                                    </p>

                                                                                </div>

                                                                            `);


                    // ====================================================
                    // SHOW MODAL
                    // ====================================================

                    $("#receiveSampleModal")
                        .modal("show");


                    // ====================================================
                    // URL
                    // ====================================================

                    const receiveUrl =
                        '@Url.Action(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "Receive",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "ReceiveSamples",
                                    new { area = "Technician" })';


                    console.log(
                        "Receive URL:",
                        receiveUrl
                    );


                    // ====================================================
                    // AJAX GET
                    //
                    // Controller:
                    //
                    // Receive(
                    //     int testRequestId,
                    //     int sampleId
                    // )
                    //
                    // ====================================================

                    $.ajax({

                        url:
                            receiveUrl,

                        type:
                            "GET",

                        cache:
                            false,

                        data: {

                            testRequestId:
                                testRequestId,

                            sampleId:
                                sampleId
                        },


                        // ================================================
                        // SUCCESS
                        // ================================================

                        success:
                            function(
                                response,
                                textStatus,
                                xhr
                            ) {

                                console.log(
                                    "Sample loaded successfully."
                                );

                                console.log(
                                    "HTTP Status:",
                                    xhr.status
                                );


                                $("#receiveSampleModalContent")
                                    .html(response);


                                button
                                    .prop(
                                        "disabled",
                                        false
                                    );
                            },


                        // ================================================
                        // ERROR
                        // ================================================

                        error:
                            function(
                                xhr,
                                textStatus,
                                errorThrown
                            ) {

                                button
                                    .prop(
                                        "disabled",
                                        false
                                    );


                                $("#receiveSampleModal")
                                    .modal("hide");


                                // =========================================
                                // CONSOLE DEBUG
                                // =========================================

                                console.error(
                                    "========================================"
                                );

                                console.error(
                                    "FAILED TO LOAD SAMPLE"
                                );

                                console.error(
                                    "HTTP Status:",
                                    xhr.status
                                );

                                console.error(
                                    "Text Status:",
                                    textStatus
                                );

                                console.error(
                                    "Error:",
                                    errorThrown
                                );

                                console.error(
                                    "TestRequestId:",
                                    testRequestId
                                );

                                console.error(
                                    "SampleId:",
                                    sampleId
                                );

                                console.error(
                                    "RequestNumber:",
                                    requestNumber
                                );

                                console.error(
                                    "Barcode:",
                                    barcode
                                );

                                console.error(
                                    "Server Response:",
                                    xhr.responseText
                                );

                                console.error(
                                    "========================================"
                                );


                                // =========================================
                                // USER-FRIENDLY ERROR
                                // =========================================

                                let errorMessage =
                                    "The sample information could not be loaded.";


                                // -----------------------------------------
                                // HTTP 400
                                // -----------------------------------------

                                if (xhr.status === 400) {

                                    errorMessage =
                                        xhr.responseText ||
                                        "This sample cannot currently be received.";
                                }


                                // -----------------------------------------
                                // HTTP 401
                                // -----------------------------------------

                                else if (xhr.status === 401) {

                                    errorMessage =
                                        "Your login session has expired. Please sign in again.";
                                }


                                // -----------------------------------------
                                // HTTP 403
                                // -----------------------------------------

                                else if (xhr.status === 403) {

                                    errorMessage =
                                        "You are not authorized to receive laboratory samples.";
                                }


                                // -----------------------------------------
                                // HTTP 404
                                // -----------------------------------------

                                else if (xhr.status === 404) {

                                    errorMessage =
                                        "The sample could not be found. " +
                                        "TestRequestId: " +
                                        testRequestId +
                                        ", SampleId: " +
                                        sampleId +
                                        ".";
                                }


                                // -----------------------------------------
                                // HTTP 500
                                // -----------------------------------------

                                else if (xhr.status === 500) {

                                    errorMessage =
                                        "A server error occurred while loading the sample. " +
                                        "Check the Visual Studio Output window for the exception.";
                                }


                                // -----------------------------------------
                                // HTTP 0
                                // -----------------------------------------

                                else if (xhr.status === 0) {

                                    errorMessage =
                                        "The request could not reach the server. " +
                                        "Check your connection and application.";
                                }


                                // =========================================
                                // SWEETALERT
                                // =========================================

                                Swal.fire({

                                    icon:
                                        "error",

                                    title:
                                        "Unable to Load Sample",

                                    html:
                                        "<div style='text-align:left'>" +

                                        "<p>" +
                                        errorMessage +
                                        "</p>" +

                                        "<hr>" +

                                        "<small>" +

                                        "<strong>Request:</strong> " +
                                        (requestNumber || "N/A") +

                                        "<br>" +

                                        "<strong>TestRequestId:</strong> " +
                                        testRequestId +

                                        "<br>" +

                                        "<strong>SampleId:</strong> " +
                                        sampleId +

                                        "<br>" +

                                        "<strong>HTTP Status:</strong> " +
                                        xhr.status +

                                        "</small>" +

                                        "</div>",

                                    confirmButtonText:
                                        "OK"
                                });
                            }
                    });
                }
            );


            // ============================================================
            // RESET RECEIVE MODAL AFTER CLOSING
            // ============================================================

            $("#receiveSampleModal")
                .on(
                    "hidden.bs.modal",
                    function() {

                        $("#receiveSampleModalContent")
                            .html(`

                                                                                    <div class="modal-body text-center py-5">

                                                                                        <div
                                                                                            class="spinner-border text-primary"
                                                                                            role="status">

                                                                                            <span class="sr-only">
                                                                                                Loading...
                                                                                            </span>

                                                                                        </div>

                                                                                        <p class="mt-3 text-muted mb-0">

                                                                                            Loading sample information...

                                                                                        </p>

                                                                                    </div>

                                                                                `);
                    }
                );

        });

    </script>
}