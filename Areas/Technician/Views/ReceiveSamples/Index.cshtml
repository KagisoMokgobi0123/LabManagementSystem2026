                                                                PATIENT
                                                            </th>

                                                            <th>
                                                                URGENCY
                                                            </th>

                                                            <th>
                                                                TEST TYPES
                                                            </th>

                                                            <th>
                                                                CLINICAL NOTES
                                                            </th>

                                                            <th>
                                                                ACTION
                                                            </th>

                                                        </tr>
                                                    </thead>


                                                    <tbody>

                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>

                                                                <!-- REQUEST NUMBER -->
                                                                <td>

                                                                    <span class="request-number">
                                                                        @item.RequestNumber
                                                                    </span>

                                                                </td>


                                                                <!-- PATIENT -->
                                                                <td>

                                                                    @if (item.Patient != null)
                                                                    {
                                                                        @item.Patient.FullName
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- URGENCY -->
                                                                <td>

                                                                    <span class="urgency-badge">
                                                                        @item.Urgency
                                                                    </span>

                                                                </td>


                                                                <!-- TEST TYPE -->
                                                                <td>

                                                                    @if (item.TestType != null)
                                                                    {
                                                                        @item.TestType.Name
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- CLINICAL NOTES -->
                                                                <td>

                                                                    @if (!string.IsNullOrEmpty(item.ClinicalNotes))
                                                                    {
                                                                        @item.ClinicalNotes
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>No clinical notes</span>
                                                                    }

                                                                </td>


                                                                <!-- ACTION -->
																	<td class="form-button-action">

                                                                    <a asp-area="Technician"
                                                                       asp-controller="ReceiveSamples"
                                                                       asp-action="Receive"
                                                                       asp-route-requestNumber="@item.RequestNumber"
                                                                       class="receive-btn">

                                                                        <i class="bi bi-inbox-fill"></i>
                                                                        Receive Samples

                                                                    </a>

                                                                </td>

                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>
                                            }
                                            else
                                            {
                                                <div class="empty-message">

                                                    <i class="bi bi-inbox"></i>

                                                    <p>
                                                        There are currently no pending samples to receive.
                                                    </p>

                                                </div>
                                            }

                                        </div>

									   	</div>
										</div>
                                    </div>

                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
		<script>
				$(document).ready(function() {

					$('#basic-datatables').DataTable({

						// Search
						searching: true,

						// Pagination
						paging: true,
						pageLength: 10,

						// Page length options
						lengthMenu: [
							[10, 25, 50, 100, -1],
							[10, 25, 50, 100, "All"]
						],

						// Sorting
						ordering: true,

						// Information text
						info: true,

						// Horizontal scrollbar
						scrollX: true,

						// Vertical scrollbar
						scrollY: '400px',

						// Don't collapse vertical area
						scrollCollapse: false,

						// Keep pagination
						paging: true,

						// Layout
						dom:
							"<'row mb-3'<'col-md-6'l><'col-md-6'f>>" +
							"<'row mb-3'<'col-md-12'B>>" +
							"<'row'<'col-md-12'tr>>" +
							"<'row mt-3'<'col-md-5'i><'col-md-7'p>>",

						// Export buttons
						buttons: [
							{
								extend: 'pdfHtml5',
								text: '<i class="fas fa-file-pdf"></i> PDF',
								title: 'Pending Sample Reception',

								// Do not export ACTION column
								exportOptions: {
									columns: [0, 1, 2, 3, 4]
								},

								orientation: 'landscape',
								pageSize: 'A4'
							},
							{
								extend: 'excelHtml5',
								text: '<i class="fas fa-file-excel"></i> Excel',
								title: 'Pending Sample Reception',

								exportOptions: {
									columns: [0, 1, 2, 3, 4]
								}
							},
							{
								extend: 'print',
								text: '<i class="fas fa-print"></i> Print',
								title: 'Pending Sample Reception',

								exportOptions: {
									columns: [0, 1, 2, 3, 4]
								}
							}
						],

						// Disable sorting on ACTION column
						columnDefs: [
							{
								targets: 5,
								orderable: false,
								searchable: false
							}
						],

						language: {
							search: "Search:",
							searchPlaceholder: "Search requests...",
							lengthMenu: "Show _MENU_ entries",
							info: "Showing _START_ to _END_ of _TOTAL_ requests",
							infoEmpty: "No requests available",
							zeroRecords: "No matching requests found"
						}
					});

				});
		</script>

	






