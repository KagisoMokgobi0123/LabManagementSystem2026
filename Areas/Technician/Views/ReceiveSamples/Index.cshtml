														   class="display table table-bordered table-striped table-hover">
                                                    <thead>
                                                        <tr>

                                                            <th>
                                                                Request #
                                                            </th>
																	<th>
																		Doctor
																	</th>
                                                            <th>
                                                                Patient
                                                            </th>

                                                            <th>
                                                                Urgency
                                                            </th>

                                                            <th>
                                                                Test Type
                                                            </th>

                                                            <th>
                                                                Clinical Notes
                                                            </th>

                                                            <th>
                                                                Action
                                                            </th>

                                                        </tr>
                                                    </thead>


                                                    <tbody>

                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>

                                                                <!-- REQUEST NUMBER -->
                                                                <td>

                                                                    <span class="request-number">
                                                                        @item.RequestNumber
                                                                    </span>

                                                                </td>
																  <td>

                                                                    <span class="request-doctor">
                                                                        @item.Doctor.ApplicationUser.FullName
                                                                    </span>

                                                                </td>


                                                                <!-- PATIENT -->
                                                                <td>

                                                                    @if (item.Patient != null)
                                                                    {
                                                                        @item.Patient.FullName
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- URGENCY -->
                                                                <td>

                                                                    <span class="urgency-badge">
                                                                        @item.Urgency
                                                                    </span>

                                                                </td>


                                                                <!-- TEST TYPE -->
                                                                <td>

                                                                    @if (item.TestType != null)
                                                                    {
                                                                        @item.TestType.Name
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- CLINICAL NOTES -->
                                                                <td>

                                                                    @if (!string.IsNullOrEmpty(item.ClinicalNotes))
                                                                    {
                                                                        @item.ClinicalNotes
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>No clinical notes</span>
                                                                    }

                                                                </td>

																
                                                                <!-- ACTION -->
																	<td class="form-button-action">
																			<div class="form-button-action">
																				<button type="button"
																						class="btn btn-link btn-success btn-sm receive-sample-btn"
																						data-request-number="@item.RequestNumber"
																						data-toggle="tooltip"
																						title="Verify sample">

																					<i class="fas fa-inbox mr-1"></i>
																					Receive Sample

																				</button>
																			
																			</div>
																		

                                                                </td>

                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>
                                          
											
														
												
											
											}
                                            else
                                            {
                                                <div class="empty-message">

                                                    <i class="bi bi-inbox"></i>

                                                    <p>
                                                        There are currently no pending samples to receive.
                                                    </p>

                                                </div>
                                            }

                                        </div>

									
									
									</div>
										
								
								</div>
                                    </div>

                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade"
	 id="receiveSampleModal"
	 tabindex="0"
	 role="dialog"
	 aria-labelledby="receiveSampleModalLabel"
	 aria-hidden="true">

	<div class="modal-dialog modal-xl modal-dialog-centered"
		 role="document">

		<div class="modal-content">

			<!-- MODAL HEADER -->
			<div class="modal-header bg-primary text-white">

				<h5 class="modal-title"
					id="receiveSampleModalLabel">

					<i class="fas fa-vials mr-2"></i>
					Receive Sample - Verification Required

				</h5>

				<button type="button"
						class="close text-white"
						data-dismiss="modal"
						aria-label="Close">

					<span aria-hidden="true">&times;</span>

				</button>

			</div>

			<!-- AJAX PARTIAL VIEW -->
			<div id="receiveSampleModalContent" style="width:100%">

				<div class="text-center p-5">

					<i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

					<p class="mt-2 mb-0">
						Loading sample...
					</p>

				</div>

			</div>






			

		</div>

	</div>

</div>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // ================================================================
    // NMB-HLabSys
    // RECEIVE SAMPLE - CLEAN + DIAGNOSTIC VERSION
    // ================================================================


    // ================================================================
    // LOGGING HELPERS
    // ================================================================

    function receiveLog(message, data) {

        if (typeof data !== 'undefined') {
            console.log(
                '[ReceiveSamples] ' + message,
                data
            );
        }
        else {
            console.log(
                '[ReceiveSamples] ' + message
            );
        }
    }


    function receiveError(message, data) {

        console.error(
            '[ReceiveSamples] ' + message,
            data || ''
        );
    }



    // ================================================================
    // CLEAN BOOTSTRAP MODAL STATE
    // ================================================================

    function cleanupReceiveModalState() {

        receiveLog(
            'Cleaning modal state.'
        );


        // Remove Bootstrap backdrops only.
        // Do NOT remove SweetAlert containers.
        $('.modal-backdrop').remove();


        if ($('.modal.show').length === 0) {

            $('body')
                .removeClass('modal-open')
                .css({
                    'padding-right': '',
                    'overflow': ''
                });
        }
    }



    // ================================================================
    // CHECK FOR DUPLICATE RECEIVE MODALS
    // ================================================================

    function diagnoseReceiveModal() {

        var modals =
            $('[id="receiveSampleModal"]');


        receiveLog(
            'Receive modal count:',
            modals.length
        );


        if (modals.length > 1) {

            receiveError(
                'Duplicate #receiveSampleModal detected.',
                modals.length
            );


            // Keep first modal only
            modals
                .slice(1)
                .remove();


            receiveLog(
                'Duplicate Receive Sample modal removed.'
            );
        }


        var contentContainers =
            $('[id="receiveSampleModalContent"]');


        receiveLog(
            'Modal content container count:',
            contentContainers.length
        );
    }



    // ================================================================
    // DOCUMENT READY
    // ================================================================

    $(document).ready(function() {

        receiveLog(
            'Receive Samples page loaded.'
        );


        diagnoseReceiveModal();


        // ============================================================
        // CLEAN OLD BACKDROP
        // ============================================================

        if (
            !$('#receiveSampleModal')
                .hasClass('show')
        ) {

            cleanupReceiveModalState();
        }



        // ============================================================
        // DATATABLE
        // ============================================================

        if ($('#basic-datatables').length) {

            var table =
                $('#basic-datatables')
                    .DataTable({

                        searching: true,

                        paging: true,

                        pageLength: 10,


                        lengthMenu: [
                            [10, 25, 50, 100],
                            [10, 25, 50, 100]
                        ],


                        scrollX: true,

                        scrollY: '400px',

                        scrollCollapse: false,

                        autoWidth: false,


                        dom:
                            "<'row mb-3'<'col-md-6'l><'col-md-6'f>>" +
                            "<'row mb-3'<'col-md-12'B>>" +
                            "<'row'<'col-md-12'tr>>" +
                            "<'row mt-3'<'col-md-5'i><'col-md-7'p>>",


                        buttons: [

                            {
                                extend:
                                    'pdfHtml5',

                                text:
                                    '<i class="fas fa-file-pdf"></i> PDF',

                                title:
                                    'Pending Sample Reception',

                                filename:
                                    'NMB-HLabSys_Pending_Samples',

                                exportOptions: {
                                    columns:
                                        [0, 1, 2, 3, 4, 5]
                                },

                                orientation:
                                    'landscape',

                                pageSize:
                                    'A4'
                            }

                        ],


                        columnDefs: [

                            {
                                targets: 6,

                                orderable: false,

                                searchable: false,

                                exportable: false
                            }

                        ],


                        language: {

                            search:
                                'Search pending samples:',

                            lengthMenu:
                                'Show _MENU_ samples',

                            info:
                                'Showing _START_ to _END_ of _TOTAL_ pending samples',

                            infoEmpty:
                                'No pending samples available',

                            zeroRecords:
                                'No matching pending samples found',

                            emptyTable:
                                'No pending samples available',

                            paginate: {

                                previous:
                                    '<i class="fas fa-chevron-left"></i>',

                                next:
                                    '<i class="fas fa-chevron-right"></i>'

                            }

                        }

                    });



            // Atlantis sidebar resize
            $('.toggle-sidebar, .sidenav-toggler')
                .on(
                    'click',
                    function() {

                        setTimeout(
                            function() {

                                table
                                    .columns
                                    .adjust()
                                    .draw(false);

                            },
                            350
                        );
                    }
                );


            // Browser resize
            $(window)
                .on(
                    'resize',
                    function() {

                        table
                            .columns
                            .adjust();
                    }
                );
        }



        // ============================================================
        // TOOLTIPS
        // ============================================================

        $('[data-toggle="tooltip"]')
            .tooltip();

    });



    // ================================================================
    // OPEN RECEIVE SAMPLE
    // ================================================================

    $(document).on(
        'click',
        '.receive-sample-btn',
        function(e) {

            e.preventDefault();

            e.stopPropagation();


            receiveLog(
                'Receive Sample clicked.'
            );


            diagnoseReceiveModal();


            var button =
                $(this);


            var requestNumber =
                button.data(
                    'request-number'
                );


            receiveLog(
                'Request Number:',
                requestNumber
            );



            // ========================================================
            // REQUEST NUMBER REQUIRED
            // ========================================================

            if (!requestNumber) {

                Swal.fire({

                    icon:
                        'error',

                    title:
                        'Request Number Missing',

                    text:
                        'Unable to determine the test request number.',

                    confirmButtonText:
                        'OK',

                    confirmButtonColor:
                        '#1572E8'

                });


                return;
            }



            // ========================================================
            // RECEIVE MODAL MUST EXIST
            // ========================================================

            var receiveModal =
                $('#receiveSampleModal');


            if (!receiveModal.length) {

                receiveError(
                    '#receiveSampleModal was not found.'
                );


                Swal.fire({

                    icon:
                        'error',

                    title:
                        'Receive Modal Missing',

                    text:
                        'The Receive Sample modal could not be found.',

                    confirmButtonText:
                        'OK',

                    confirmButtonColor:
                        '#1572E8'

                });


                return;
            }



            button.prop(
                'disabled',
                true
            );



            // ========================================================
            // CLEAN OLD MODAL STATE
            // ========================================================

            if (
                !receiveModal
                    .hasClass('show')
            ) {

                cleanupReceiveModalState();
            }



            // ========================================================
            // LOADING CONTENT
            // ========================================================

            $('#receiveSampleModalContent')
                .html(`

                        <div class="text-center p-5">

                            <i class="
                                fas
                                fa-spinner
                                fa-spin
                                fa-2x
                                text-primary">
                            </i>

                            <h5 class="mt-3 mb-1">
                                Loading Sample
                            </h5>

                            <p class="text-muted mb-0">
                                Retrieving laboratory sample information...
                            </p>

                        </div>

                    `);



            // ========================================================
            // GET RECEIVE URL
            // ========================================================

            var receiveUrl =
                '@Url.Action(
                                        "Receive",
                                        "ReceiveSamples",
                        new { area = "Technician" }
                                )';



            receiveLog(
                'GET URL:',
                receiveUrl
            );



            // ========================================================
            // GET SAMPLE PARTIAL
            // ========================================================

            $.ajax({

                url:
                    receiveUrl,

                type:
                    'GET',

                data: {

                    requestNumber:
                        requestNumber
                },


                // ====================================================
                // GET SUCCESS
                // ====================================================

                success:
                    function(html) {

                        button.prop(
                            'disabled',
                            false
                        );


                        receiveLog(
                            'Receive partial loaded.'
                        );



                        // =============================================
                        // CHECK FOR NESTED MODAL
                        // =============================================

                        var parsed =
                            $('<div>')
                                .html(html);


                        var nestedModal =
                            parsed.find(
                                '#receiveSampleModal'
                            );


                        if (
                            nestedModal.length > 0
                        ) {

                            receiveError(
                                '_ReceiveSampleModal contains another #receiveSampleModal.'
                            );


                            Swal.fire({

                                icon:
                                    'error',

                                title:
                                    'Duplicate Modal Detected',

                                html:
                                    'The <strong>_ReceiveSampleModal</strong> partial contains another ' +
                                    '<code>#receiveSampleModal</code>.<br><br>' +
                                    'Remove the outer Bootstrap modal from the partial.',

                                confirmButtonText:
                                    'OK',

                                confirmButtonColor:
                                    '#1572E8'

                            });


                            return;
                        }



                        // =============================================
                        // INSERT PARTIAL
                        // =============================================

                        $('#receiveSampleModalContent')
                            .html(html);



                        // =============================================
                        // INITIALISE CHECKBOXES
                        // =============================================

                        updateVerificationState();



                        // =============================================
                        // OPEN ONE MODAL ONLY
                        // =============================================

                        if (
                            !receiveModal
                                .hasClass('show')
                        ) {

                            receiveLog(
                                'Opening Receive Sample modal.'
                            );


                            receiveModal.modal({

                                backdrop:
                                    true,

                                keyboard:
                                    true,

                                show:
                                    true
                            });
                        }
                    },


                // ====================================================
                // GET ERROR
                // ====================================================

                error:
                    function(
                        xhr,
                        status,
                        error
                    ) {

                        button.prop(
                            'disabled',
                            false
                        );


                        receiveError(
                            'GET Receive failed.',
                            {
                                statusCode:
                                    xhr.status,

                                status:
                                    status,

                                error:
                                    error,

                                response:
                                    xhr.responseText
                            }
                        );


                        receiveModal
                            .modal('hide');


                        cleanupReceiveModalState();


                        Swal.fire({

                            icon:
                                'error',

                            title:
                                'Unable to Load Sample',

                            html:
                                'The sample information could not be loaded.' +
                                '<br><br>' +
                                '<strong>HTTP Status:</strong> ' +
                                xhr.status,

                            confirmButtonText:
                                'OK',

                            confirmButtonColor:
                                '#1572E8'

                        });
                    }

            });

        }
    );



    // ================================================================
    // UPDATE VERIFICATION STATE
    // ================================================================

    function updateVerificationState() {

        var container =
            $('#receiveSampleModalContent');


        var checkboxes =
            container.find(
                '.verification-check'
            );


        if (!checkboxes.length) {

            receiveLog(
                'No verification checkboxes found.'
            );

            return;
        }


        var total =
            checkboxes.length;


        var checked =
            checkboxes
                .filter(':checked')
                .length;


        var allVerified =
            total > 0 &&
            checked === total;



        receiveLog(
            'Verification:',
            {
                checked:
                    checked,

                total:
                    total,

                complete:
                    allVerified
            }
        );



        // ============================================================
        // CONFIRM BUTTON
        // ============================================================

        container
            .find(
                '#confirmReceiveBtn, ' +
                '.confirm-receive-btn, ' +
                'button[type="submit"]'
            )
            .prop(
                'disabled',
                !allVerified
            );



        // ============================================================
        // COUNTER
        // ============================================================

        $('#verifiedCount')
            .text(checked);


        $('#totalVerificationCount')
            .text(total);



        // ============================================================
        // PROGRESS
        // ============================================================

        var percentage =
            total > 0
                ? Math.round(
                    (checked / total) *
                    100
                )
                : 0;


        $('#verificationProgress')
            .css(
                'width',
                percentage + '%'
            )
            .attr(
                'aria-valuenow',
                percentage
            );



        // ============================================================
        // STATUS
        // ============================================================

        if (allVerified) {

            $('#verificationStatus')

                .removeClass(
                    'text-muted text-warning'
                )

                .addClass(
                    'text-success'
                )

                .html(
                    '<i class="fas fa-check-circle mr-1"></i>' +
                    'All verification checks completed.'
                );
        }
        else {

            $('#verificationStatus')

                .removeClass(
                    'text-success'
                )

                .addClass(
                    'text-muted'
                )

                .html(
                    '<i class="fas fa-shield-alt mr-1"></i>' +
                    checked +
                    ' of ' +
                    total +
                    ' verification checks completed.'
                );
        }
    }



    // ================================================================
    // VERIFICATION CHECKBOX CHANGED
    // ================================================================

    $(document).on(
        'change',
        '#receiveSampleModalContent .verification-check',
        function() {

            updateVerificationState();
        }
    );



    // ================================================================
    // RECEIVE SAMPLE FORM SUBMIT
    // ONE SUBMIT HANDLER ONLY
    // ================================================================

    $(document).on(
        'submit',
        '#receiveSampleForm',
        function(e) {

            e.preventDefault();

            e.stopPropagation();


            receiveLog(
                'Receive form submitted.'
            );


            var form =
                $(this);


            var submitButton =
                form.find(
                    'button[type="submit"]'
                );


            var checkboxes =
                form.find(
                    '.verification-check'
                );


            var unchecked =
                checkboxes
                    .filter(
                        ':not(:checked)'
                    );



            // ========================================================
            // CLIENT VERIFICATION
            // ========================================================

            if (
                checkboxes.length > 0 &&
                unchecked.length > 0
            ) {

                Swal.fire({

                    target:
                        document.getElementById(
                            'receiveSampleModal'
                        ),

                    backdrop:
                        false,

                    icon:
                        'warning',

                    title:
                        'Verification Required',

                    text:
                        'Please verify all sample information before receiving the sample.',

                    confirmButtonText:
                        'OK',

                    confirmButtonColor:
                        '#1572E8'

                });


                return;
            }



            // ========================================================
            // DIAGNOSTIC FORM DATA
            // ========================================================

            receiveLog(
                'POST URL:',
                form.attr('action')
            );


            receiveLog(
                'Submitted fields:',
                form.serializeArray()
            );



            // ========================================================
            // CONFIRM RECEIVE
            // ========================================================

            Swal.fire({

                target:
                    document.getElementById(
                        'receiveSampleModal'
                    ),

                backdrop:
                    false,

                icon:
                    'question',

                title:
                    'Receive This Sample?',

                html:
                    'You are about to confirm that all sample information ' +
                    'has been checked and verified.' +
                    '<br><br>' +
                    '<strong>' +
                    'The sample will be marked as Samples Received.' +
                    '</strong>',

                showCancelButton:
                    true,

                confirmButtonText:
                    '<i class="fas fa-check-circle mr-1"></i>' +
                    ' Confirm & Receive',

                cancelButtonText:
                    '<i class="fas fa-times mr-1"></i>' +
                    ' Cancel',

                confirmButtonColor:
                    '#31CE36',

                cancelButtonColor:
                    '#6c757d',

                reverseButtons:
                    true

            })
                .then(
                    function(result) {

                        if (
                            !result.isConfirmed
                        ) {

                            receiveLog(
                                'Receive cancelled.'
                            );

                            return;
                        }



                        // =================================================
                        // DISABLE BUTTON
                        // =================================================

                        submitButton.prop(
                            'disabled',
                            true
                        );



                        // =================================================
                        // LOADING
                        // =================================================

                        Swal.fire({

                            target:
                                document.getElementById(
                                    'receiveSampleModal'
                                ),

                            backdrop:
                                false,

                            title:
                                'Receiving Sample',

                            html:
                                'Please wait while the sample verification is being saved...',

                            allowOutsideClick:
                                false,

                            allowEscapeKey:
                                false,

                            showConfirmButton:
                                false,

                            didOpen:
                                function() {

                                    Swal.showLoading();
                                }

                        });



                        // =================================================
                        // POST RECEIVE
                        // =================================================

                        $.ajax({
                            url: '@Url.Action(
        "Receive",
        "ReceiveSamples",
                new { area = "Technician" }
                                                        )',

    type: 'POST',

                            data: form.serialize(),

                            dataType: 'json',


                            // =============================================
                            // SUCCESS
                            // =============================================

                            success:
                                function(
                                    response,
                                    textStatus,
                                    xhr
                                ) {

                                    submitButton.prop(
                                        'disabled',
                                        false
                                    );


                                    receiveLog(
                                        'POST JSON response:',
                                        {
                                            status:
                                                xhr.status,

                                            contentType:
                                                xhr.getResponseHeader(
                                                    'Content-Type'
                                                ),

                                            response:
                                                response
                                        }
                                    );



                                    // =====================================
                                    // EMPTY RESPONSE
                                    // =====================================

                                    if (!response) {

                                        Swal.fire({

                                            target:
                                                document.getElementById(
                                                    'receiveSampleModal'
                                                ),

                                            backdrop:
                                                false,

                                            icon:
                                                'error',

                                            title:
                                                'Empty Response',

                                            text:
                                                'The server returned an empty response.',

                                            confirmButtonText:
                                                'OK',

                                            confirmButtonColor:
                                                '#1572E8'

                                        });


                                        return;
                                    }



                                    // =====================================
                                    // CONTROLLER RETURNED FAILURE
                                    // =====================================

                                    if (
                                        response.success !==
                                        true
                                    ) {

                                        receiveError(
                                            'Controller rejected sample.',
                                            response
                                        );


                                        Swal.fire({

                                            target:
                                                document.getElementById(
                                                    'receiveSampleModal'
                                                ),

                                            backdrop:
                                                false,

                                            icon:
                                                response.icon ||
                                                'error',

                                            title:
                                                response.title ||
                                                'Unable to Receive Sample',

                                            html:
                                                response.message ||
                                                'The sample could not be received.',

                                            confirmButtonText:
                                                'OK',

                                            confirmButtonColor:
                                                '#1572E8'

                                        });


                                        return;
                                    }



                                    // =====================================
                                    // SAMPLE SAVED SUCCESSFULLY
                                    // =====================================

                                    receiveLog(
                                        'Sample received successfully.',
                                        response
                                    );


                                    Swal.close();



                                    var receiveModal =
                                        $('#receiveSampleModal');



                                    // =====================================
                                    // WAIT FOR RECEIVE MODAL TO CLOSE
                                    // =====================================

                                    receiveModal
                                        .one(
                                            'hidden.bs.modal.receiveSuccess',
                                            function() {

                                                cleanupReceiveModalState();


                                                Swal.fire({

                                                    icon:
                                                        'success',

                                                    title:
                                                        response.title ||
                                                        'Sample Received!',

                                                    html:

                                                        '<div class="text-left">' +

                                                        '<p class="mb-3">' +

                                                        (
                                                            response.message ||
                                                            'The sample has been successfully received.'
                                                        ) +

                                                        '</p>' +


                                                        '<div class="alert alert-success mb-0">' +


                                                        '<div class="mb-2">' +

                                                        '<strong>' +
                                                        '<i class="fas fa-barcode mr-1"></i>' +
                                                        'Barcode:' +
                                                        '</strong> ' +

                                                        (
                                                            response.barcode ||
                                                            'N/A'
                                                        ) +

                                                        '</div>' +


                                                        '<div class="mb-2">' +

                                                        '<strong>' +
                                                        '<i class="fas fa-user-check mr-1"></i>' +
                                                        'Verified By:' +
                                                        '</strong> ' +

                                                        (
                                                            response.technician ||
                                                            'N/A'
                                                        ) +

                                                        '</div>' +


                                                        '<div>' +

                                                        '<strong>' +
                                                        '<i class="far fa-clock mr-1"></i>' +
                                                        'Date Received:' +
                                                        '</strong> ' +

                                                        (
                                                            response.receivedAt ||
                                                            'N/A'
                                                        ) +

                                                        '</div>' +


                                                        '</div>' +

                                                        '</div>',

                                                    confirmButtonText:
                                                        'OK',

                                                    confirmButtonColor:
                                                        '#1572E8',

                                                    allowOutsideClick:
                                                        false,

                                                    allowEscapeKey:
                                                        false

                                                })
                                                    .then(
                                                        function() {

                                                            window.location.href =
                                                                '@Url.Action(
                                                                                                                        "VerifiedSamples",
                                                                                                                        "ReceiveSamples",
                                                                                                                        new { area = "Technician" }
                                                                                                                                )';

                                                        }
                                                    );
                                            }
                                        );



                                    receiveModal
                                        .modal('hide');
                                },



                            // =============================================
                            // AJAX / JSON / HTTP ERROR
                            // =============================================

                            error:
                                function(
                                    xhr,
                                    status,
                                    error
                                ) {

                                    submitButton.prop(
                                        'disabled',
                                        false
                                    );


                                    // =====================================
                                    // FULL CONSOLE DIAGNOSTIC
                                    // =====================================

                                    console.error(
                                        '========== RECEIVE SAMPLE ERROR =========='
                                    );


                                    console.error(
                                        'POST URL:',
                                        form.attr('action')
                                    );


                                    console.error(
                                        'HTTP Status:',
                                        xhr.status
                                    );


                                    console.error(
                                        'jQuery Status:',
                                        status
                                    );


                                    console.error(
                                        'Error:',
                                        error
                                    );


                                    console.error(
                                        'Content-Type:',
                                        xhr.getResponseHeader(
                                            'Content-Type'
                                        )
                                    );


                                    console.error(
                                        'Response JSON:',
                                        xhr.responseJSON
                                    );


                                    console.error(
                                        'Response Text:',
                                        xhr.responseText
                                    );


                                    console.error(
                                        'Submitted Fields:',
                                        form.serializeArray()
                                    );


                                    console.error(
                                        '=========================================='
                                    );



                                    // =====================================
                                    // DEFAULT
                                    // =====================================

                                    var title =
                                        'Unable to Receive Sample';


                                    var message =
                                        'The server could not process the sample reception.';



                                    // =====================================
                                    // CONTROLLER JSON ERROR
                                    // =====================================

                                    if (
                                        xhr.responseJSON
                                    ) {

                                        title =
                                            xhr.responseJSON.title ||
                                            title;


                                        message =
                                            xhr.responseJSON.message ||
                                            message;
                                    }



                                    // =====================================
                                    // HTML RETURNED INSTEAD OF JSON
                                    // =====================================

                                    else if (
                                        status ===
                                        'parsererror'
                                    ) {

                                        title =
                                            'Server Returned HTML';


                                        var responseText =
                                            xhr.responseText ||
                                            '';


                                        var preview =
                                            responseText;


                                        if (
                                            preview.length >
                                            1500
                                        ) {

                                            preview =
                                                preview.substring(
                                                    0,
                                                    1500
                                                ) +
                                                '...';
                                        }



                                        message =

                                            '<div class="text-left">' +

                                            '<p>' +
                                            'The Receive POST reached the server, but ASP.NET returned HTML/text instead of JSON.' +
                                            '</p>' +


                                            '<p class="mb-1">' +

                                            '<strong>' +
                                            'HTTP Status:' +
                                            '</strong> ' +

                                            xhr.status +

                                            '</p>' +


                                            '<p class="mb-3">' +

                                            '<strong>' +
                                            'Content-Type:' +
                                            '</strong> ' +

                                            (
                                                xhr.getResponseHeader(
                                                    'Content-Type'
                                                ) ||
                                                'Unknown'
                                            ) +

                                            '</p>' +


                                            '<hr>' +


                                            '<p class="mb-1">' +

                                            '<strong>' +
                                            'Returned response:' +
                                            '</strong>' +

                                            '</p>' +


                                            '<pre style="' +

                                            'max-height:220px;' +
                                            'overflow:auto;' +
                                            'white-space:pre-wrap;' +
                                            'font-size:11px;' +
                                            'text-align:left;' +
                                            'background:#f5f5f5;' +
                                            'padding:10px;' +
                                            'border-radius:5px;' +

                                            '">' +

                                            $('<div>')
                                                .text(preview)
                                                .html() +

                                            '</pre>' +


                                            '<p class="text-muted mt-2 mb-0">' +

                                            'The complete response is available in the browser console.' +

                                            '</p>' +

                                            '</div>';
                                    }



                                    // =====================================
                                    // 400
                                    // =====================================

                                    else if (
                                        xhr.status ===
                                        400
                                    ) {

                                        title =
                                            'Invalid Request';


                                        message =
                                            'ASP.NET rejected the request. Check the submitted values and anti-forgery token.';
                                    }



                                    // =====================================
                                    // 401
                                    // =====================================

                                    else if (
                                        xhr.status ===
                                        401
                                    ) {

                                        title =
                                            'Session Expired';


                                        message =
                                            'Your login session has expired. Please sign in again.';
                                    }



                                    // =====================================
                                    // 403
                                    // =====================================

                                    else if (
                                        xhr.status ===
                                        403
                                    ) {

                                        title =
                                            'Access Denied';


                                        message =
                                            'You are not authorized to receive this sample.';
                                    }



                                    // =====================================
                                    // 404
                                    // =====================================

                                    else if (
                                        xhr.status ===
                                        404
                                    ) {

                                        title =
                                            'Receive Action Not Found';


                                        message =
                                            'The Receive POST action could not be found.';
                                    }



                                    // =====================================
                                    // 500+
                                    // =====================================

                                    else if (
                                        xhr.status >=
                                        500
                                    ) {

                                        title =
                                            'Server Error';


                                        message =
                                            'A server-side error occurred while receiving the sample.';
                                    }



                                    // =====================================
                                    // DISPLAY ERROR INSIDE RECEIVE MODAL
                                    // =====================================

                                    Swal.fire({

                                        target:
                                            document.getElementById(
                                                'receiveSampleModal'
                                            ),

                                        backdrop:
                                            false,

                                        icon:
                                            'error',

                                        title:
                                            title,

                                        html:
                                            message,

                                        width:
                                            700,

                                        confirmButtonText:
                                            'OK',

                                        confirmButtonColor:
                                            '#1572E8'

                                    });
                                }

                        });

                    }
                );

        }
    );



    // ================================================================
    // RECEIVE MODAL SHOWN
    // ================================================================

    $('#receiveSampleModal')
        .on(
            'shown.bs.modal',
            function() {

                receiveLog(
                    'Receive Sample modal shown.'
                );


                receiveLog(
                    'Visible Bootstrap modals:',
                    $('.modal.show').length
                );


                receiveLog(
                    'Bootstrap backdrops:',
                    $('.modal-backdrop').length
                );



                // ====================================================
                // KEEP ONLY ONE BOOTSTRAP BACKDROP
                // ====================================================

                var backdrops =
                    $('.modal-backdrop');


                if (
                    backdrops.length > 1
                ) {

                    receiveError(
                        'Duplicate Bootstrap backdrops detected.',
                        backdrops.length
                    );


                    backdrops
                        .slice(
                            0,
                            backdrops.length - 1
                        )
                        .remove();
                }
            }
        );



    // ================================================================
    // RECEIVE MODAL CLOSED
    // ================================================================

    $('#receiveSampleModal')
        .on(
            'hidden.bs.modal',
            function() {

                receiveLog(
                    'Receive Sample modal closed.'
                );


                // ====================================================
                // RESET CONTENT
                // ====================================================

                $('#receiveSampleModalContent')
                    .html(`

                            <div class="text-center p-5">

                                <i class="
                                    fas
                                    fa-spinner
                                    fa-spin
                                    fa-2x
                                    text-primary">
                                </i>

                                <p class="mt-2 mb-0">
                                    Loading sample...
                                </p>

                            </div>

                        `);



                // ====================================================
                // CLEAN ORPHAN BACKDROP
                // ====================================================

                cleanupReceiveModalState();

            }
        );

</script>