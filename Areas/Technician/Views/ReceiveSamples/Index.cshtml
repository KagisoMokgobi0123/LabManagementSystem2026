                                            {
													<table id="basic-datatables"
														   class="display table table-bordered table-striped table-hover">
                                                    <thead>
                                                        <tr>

                                                            <th>
                                                                Request #
                                                            </th>
																	<th>
																		Doctor
																	</th>
                                                            <th>
                                                                Patient
                                                            </th>

                                                            <th>
                                                                Urgency
                                                            </th>

                                                            <th>
                                                                Test Type
                                                            </th>

                                                            <th>
                                                                Clinical Notes
                                                            </th>

                                                            <th>
                                                                Action
                                                            </th>

                                                        </tr>
                                                    </thead>


                                                    <tbody>

                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>

                                                                <!-- REQUEST NUMBER -->
                                                                <td>

                                                                    <span class="request-number">
                                                                        @item.RequestNumber
                                                                    </span>

                                                                </td>
																  <td>

                                                                    <span class="request-doctor">
                                                                        @item.Doctor.FullName
                                                                    </span>

                                                                </td>


                                                                <!-- PATIENT -->
                                                                <td>

                                                                    @if (item.Patient != null)
                                                                    {
                                                                        @item.Patient.FullName
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- URGENCY -->
                                                                <td>

                                                                    <span class="urgency-badge">
                                                                        @item.Urgency
                                                                    </span>

                                                                </td>


                                                                <!-- TEST TYPE -->
                                                                <td>

                                                                    @if (item.TestType != null)
                                                                    {
                                                                        @item.TestType.Name
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>N/A</span>
                                                                    }

                                                                </td>


                                                                <!-- CLINICAL NOTES -->
                                                                <td>

                                                                    @if (!string.IsNullOrEmpty(item.ClinicalNotes))
                                                                    {
                                                                        @item.ClinicalNotes
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>No clinical notes</span>
                                                                    }

                                                                </td>

																
                                                                <!-- ACTION -->
																	<td class="form-button-action">
																			<div class="form-button-action">
																				<button type="button"
																						class="btn btn-link btn-success btn-sm receive-sample-btn"
																						data-request-number="@item.RequestNumber"
																						data-toggle="tooltip"
																						title="Verify sample">

																					<i class="fas fa-inbox mr-1"></i>
																					Receive Sample

																				</button>
																			
																			</div>
																		

                                                                </td>

                                                            </tr>
                                                        }

                                                    </tbody>

                                                </table>
                                          
											
														
												
											
											}
                                            else
                                            {
                                                <div class="empty-message">

                                                    <i class="bi bi-inbox"></i>

                                                    <p>
                                                        There are currently no pending samples to receive.
                                                    </p>

                                                </div>
                                            }

                                        </div>

									
									
									</div>
										
								
								</div>
                                    </div>

                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade"
	 id="receiveSampleModal"
	 tabindex="0"
	 role="dialog"
	 aria-labelledby="receiveSampleModalLabel"
	 aria-hidden="true">

	<div class="modal-dialog modal-xl modal-dialog-centered"
		 role="document">

		<div class="modal-content">

			<!-- MODAL HEADER -->
			<div class="modal-header bg-primary text-white">

				<h5 class="modal-title"
					id="receiveSampleModalLabel">

					<i class="fas fa-vials mr-2"></i>
					Receive Sample - Verification Required

				</h5>

				<button type="button"
						class="close text-white"
						data-dismiss="modal"
						aria-label="Close">

					<span aria-hidden="true">&times;</span>

				</button>

			</div>

			<!-- AJAX PARTIAL VIEW -->
			<div id="receiveSampleModalContent" style="width:100%">

				<div class="text-center p-5">

					<i class="fas fa-spinner fa-spin fa-2x text-primary"></i>

					<p class="mt-2 mb-0">
						Loading sample...
					</p>

				</div>

			</div>






			

		</div>

	</div>

</div>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    $(document).ready(function() {

        // =========================================================
        // DATATABLE
        // =========================================================

        if ($('#basic-datatables').length) {

            var table = $('#basic-datatables').DataTable({

                searching: true,
                paging: true,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                scrollX: true,
                scrollY: '400px',
                scrollCollapse: false,

                autoWidth: false,

                dom:
                    "<'row mb-3'<'col-md-6'l><'col-md-6'f>>" +
                    "<'row mb-3'<'col-md-12'B>>" +
                    "<'row'<'col-md-12'tr>>" +
                    "<'row mt-3'<'col-md-5'i><'col-md-7'p>>",

                buttons: [

                    {
                        extend: 'pdfHtml5',

                        text:
                            '<i class="fas fa-file-pdf"></i> PDF',

                        title:
                            'Pending Sample Reception',

                        filename:
                            'NMB-HLabSys_Pending_Samples',

                        exportOptions: {

                            // Exclude action column
                            columns: [0, 1, 2, 3, 4, 5]

                        },

                        orientation:
                            'landscape',

                        pageSize:
                            'A4'
                    }

                ],

                columnDefs: [

                    {
                        // Action column is column 6
                        targets: 6,

                        orderable: false,

                        searchable: false,

                        exportable: false
                    }

                ],

                language: {

                    search:
                        "Search pending samples:",

                    lengthMenu:
                        "Show _MENU_ samples",

                    info:
                        "Showing _START_ to _END_ of _TOTAL_ pending samples",

                    infoEmpty:
                        "No pending samples available",

                    zeroRecords:
                        "No matching pending samples found",

                    emptyTable:
                        "No pending samples available",

                    paginate: {

                        previous:
                            '<i class="fas fa-chevron-left"></i>',

                        next:
                            '<i class="fas fa-chevron-right"></i>'

                    }

                }

            });


            // =====================================================
            // FIX DATATABLE WHEN SIDEBAR CHANGES
            // =====================================================

            $('.toggle-sidebar, .sidenav-toggler')
                .on('click', function() {

                    setTimeout(function() {

                        table.columns
                            .adjust()
                            .draw(false);

                    }, 350);

                });


            // =====================================================
            // FIX DATATABLE WHEN WINDOW RESIZES
            // =====================================================

            $(window).on('resize', function() {

                table.columns.adjust();

            });

        }


        // =========================================================
        // ATLANTIS TOOLTIPS
        // =========================================================

        $('[data-toggle="tooltip"]').tooltip();

    });



    // =============================================================
    // OPEN RECEIVE SAMPLE MODAL
    // =============================================================

    $(document).on(
        'click',
        '.receive-sample-btn',
        function() {

            var button =
                $(this);

            var requestNumber =
                button.data('request-number');


            if (!requestNumber) {

                Swal.fire({

                    icon:
                        'error',

                    title:
                        'Request Number Missing',

                    text:
                        'Unable to determine the test request number.',

                    confirmButtonText:
                        'OK',

                    confirmButtonColor:
                        '#1572E8'

                });

                return;
            }


            // Disable button while loading
            button.prop('disabled', true);


            // =====================================================
            // OPEN MODAL
            // =====================================================

            $('#receiveSampleModal')
                .modal('show');


            // =====================================================
            // LOADING CONTENT
            // =====================================================

            $('#receiveSampleModalContent')
                .html(`

                        <div class="text-center p-5">

                            <i class="
                                fas
                                fa-spinner
                                fa-spin
                                fa-2x
                                text-primary">
                            </i>

                            <h5 class="mt-3 mb-1">
                                Loading Sample
                            </h5>

                            <p class="text-muted mb-0">
                                Retrieving laboratory sample information...
                            </p>

                        </div>

                    `);


            // =====================================================
            // GET RECEIVE URL
            // =====================================================

            var url =
                '@Url.Action(
                                        "Receive",
                                        "ReceiveSamples",
                        new { area = "Technician" }
                                )';


            // =====================================================
            // LOAD PARTIAL VIEW
            // =====================================================

            $.get(
                url,
                {
                    requestNumber:
                        requestNumber
                }
            )

                .done(function(html) {

                    button.prop(
                        'disabled',
                        false
                    );


                    $('#receiveSampleModalContent')
                        .html(html);


                    // Initialise verification state
                    updateVerificationState();

                })

                .fail(function(xhr) {

                    button.prop(
                        'disabled',
                        false
                    );


                    $('#receiveSampleModal')
                        .modal('hide');


                    Swal.fire({

                        icon:
                            'error',

                        title:
                            'Unable to Load Sample',

                        text:
                            'The sample verification information could not be loaded. Please try again.',

                        confirmButtonText:
                            'OK',

                        confirmButtonColor:
                            '#1572E8'

                    });

                });

        });



    // =============================================================
    // VERIFICATION CHECKBOX STATE
    // =============================================================

    function updateVerificationState() {

        var checkboxes =
            $('#receiveSampleModalContent')
                .find('.verification-check');


        // No verification checkboxes found
        if (!checkboxes.length) {
            return;
        }


        var total =
            checkboxes.length;


        var checked =
            checkboxes.filter(':checked').length;


        var allVerified =
            total > 0 &&
            checked === total;


        // =========================================================
        // ENABLE / DISABLE CONFIRM BUTTON
        // =========================================================

        $('#receiveSampleModalContent')
            .find(
                '#confirmReceiveBtn, ' +
                '.confirm-receive-btn, ' +
                'button[type="submit"]'
            )
            .prop(
                'disabled',
                !allVerified
            );


        // =========================================================
        // UPDATE COUNT
        // =========================================================

        $('#verifiedCount')
            .text(checked);


        $('#totalVerificationCount')
            .text(total);


        // =========================================================
        // UPDATE PROGRESS BAR
        // =========================================================

        var percentage =
            total > 0
                ? Math.round(
                    (checked / total) * 100
                )
                : 0;


        $('#verificationProgress')
            .css(
                'width',
                percentage + '%'
            )
            .attr(
                'aria-valuenow',
                percentage
            );


        // =========================================================
        // STATUS MESSAGE
        // =========================================================

        if (allVerified) {

            $('#verificationStatus')
                .removeClass(
                    'text-muted text-warning'
                )
                .addClass(
                    'text-success'
                )
                .html(
                    '<i class="fas fa-check-circle mr-1"></i>' +
                    'All verification checks completed.'
                );

        }
        else {

            $('#verificationStatus')
                .removeClass(
                    'text-success'
                )
                .addClass(
                    'text-muted'
                )
                .html(
                    '<i class="fas fa-shield-alt mr-1"></i>' +
                    checked +
                    ' of ' +
                    total +
                    ' verification checks completed.'
                );

        }

    }



    // =============================================================
    // VERIFICATION CHECKBOX CHANGED
    // =============================================================

    $(document).on(
        'change',
        '#receiveSampleModalContent .verification-check',
        function() {

            updateVerificationState();

        });



    // =============================================================
    // RECEIVE SAMPLE FORM SUBMIT
    // =============================================================

    $(document).on(
        'submit',
        '#receiveSampleForm',
        function(e) {

            e.preventDefault();


            var form =
                $(this);


            var submitButton =
                form.find(
                    'button[type="submit"]'
                );


            // =====================================================
            // VERIFY ALL CHECKBOXES CLIENT SIDE
            // =====================================================

            var checkboxes =
                form.find(
                    '.verification-check'
                );


            var unchecked =
                checkboxes.filter(
                    ':not(:checked)'
                );


            if (checkboxes.length > 0 &&
                unchecked.length > 0) {

                Swal.fire({

                    icon:
                        'warning',

                    title:
                        'Verification Required',

                    text:
                        'Please verify all sample information before receiving the sample.',

                    confirmButtonText:
                        'OK',

                    confirmButtonColor:
                        '#1572E8'

                });

                return;
            }


            // =====================================================
            // CONFIRM WITH TECHNICIAN
            // =====================================================

            Swal.fire({

                icon:
                    'question',

                title:
                    'Receive This Sample?',

                html:
                    'You are about to confirm that the sample ' +
                    'information has been checked and verified.<br><br>' +

                    '<strong>This sample will be marked as received and verified.</strong>',

                showCancelButton:
                    true,

                confirmButtonText:
                    '<i class="fas fa-check-circle mr-1"></i>' +
                    ' Confirm & Receive',

                cancelButtonText:
                    '<i class="fas fa-times mr-1"></i>' +
                    ' Cancel',

                confirmButtonColor:
                    '#31CE36',

                cancelButtonColor:
                    '#6c757d',

                reverseButtons:
                    true,

                focusCancel:
                    true

            }).then(function(result) {

                if (!result.isConfirmed) {
                    return;
                }


                // =================================================
                // DISABLE SUBMIT
                // =================================================

                submitButton
                    .prop(
                        'disabled',
                        true
                    );


                // =================================================
                // SHOW PROCESSING SWEETALERT
                // =================================================

                Swal.fire({

                    title:
                        'Receiving Sample',

                    html:
                        'Please wait while the laboratory verification is being saved...',

                    allowOutsideClick:
                        false,

                    allowEscapeKey:
                        false,

                    showConfirmButton:
                        false,

                    didOpen: function() {

                        Swal.showLoading();

                    }

                });


                // =================================================
                // SUBMIT RECEIVE FORM
                // =================================================

                $.ajax({

                    url:
                        form.attr('action'),

                    type:
                        'POST',

                    data:
                        form.serialize(),

                    dataType:
                        'json',


                    // =============================================
                    // SUCCESSFUL HTTP REQUEST
                    // =============================================

                    success: function(response) {

                        submitButton
                            .prop(
                                'disabled',
                                false
                            );


                        // =========================================
                        // SAMPLE SUCCESSFULLY RECEIVED
                        // =========================================

                        if (response &&
                            response.success === true) {


                            $('#receiveSampleModal')
                                .modal('hide');


                            Swal.fire({

                                icon:
                                    'success',

                                title:
                                    response.title ||
                                    'Sample Verified!',

                                html:

                                    '<div class="text-left">' +

                                    '<p class="mb-3">' +

                                    (
                                        response.message ||
                                        'The sample has been successfully received and verified.'
                                    ) +

                                    '</p>' +


                                    '<div class="alert alert-success mb-0">' +

                                    '<div class="mb-2">' +

                                    '<strong>' +
                                    '<i class="fas fa-barcode mr-1"></i>' +
                                    'Barcode:' +
                                    '</strong> ' +

                                    (
                                        response.barcode ||
                                        'N/A'
                                    ) +

                                    '</div>' +


                                    '<div class="mb-2">' +

                                    '<strong>' +
                                    '<i class="fas fa-user-check mr-1"></i>' +
                                    'Verified By:' +
                                    '</strong> ' +

                                    (
                                        response.technician ||
                                        'N/A'
                                    ) +

                                    '</div>' +


                                    '<div>' +

                                    '<strong>' +
                                    '<i class="far fa-clock mr-1"></i>' +
                                    'Date Received:' +
                                    '</strong> ' +

                                    (
                                        response.receivedAt ||
                                        'N/A'
                                    ) +

                                    '</div>' +

                                    '</div>' +

                                    '</div>',

                                confirmButtonText:
                                    '<i class="fas fa-check mr-1"></i> OK',

                                confirmButtonColor:
                                    '#1572E8',

                                allowOutsideClick:
                                    false,

                                allowEscapeKey:
                                    false

                            }).then(function() {


                                // =================================
                                // REFRESH PENDING SAMPLES
                                // =================================
                                //
                                // Because IsReceived = true and the
                                // TestRequest status is SamplesReceived,
                                // the sample should disappear from the
                                // pending list after reload.
                                // =================================

                                window.location.reload();

                            });


                            return;

                        }


                        // =========================================
                        // CONTROLLER VALIDATION / BUSINESS ERROR
                        // =========================================

                        Swal.fire({

                            icon:
                                response.icon ||
                                'error',

                            title:
                                response.title ||
                                'Verification Failed',

                            html:
                                response.message ||
                                'The sample could not be received.',

                            confirmButtonText:
                                'OK',

                            confirmButtonColor:
                                '#1572E8'

                        });

                    },


                    // =============================================
                    // AJAX / SERVER ERROR
                    // =============================================

                    error: function(xhr) {

                        submitButton
                            .prop(
                                'disabled',
                                false
                            );


                        var title =
                            'Unable to Receive Sample';


                        var message =
                            'An unexpected error occurred while receiving the sample. Please try again.';


                        // =========================================
                        // BAD REQUEST
                        // =========================================

                        if (xhr.status === 400) {

                            title =
                                'Invalid Request';

                            message =
                                'The sample request could not be processed. Please refresh the page and try again.';

                        }


                        // =========================================
                        // UNAUTHORIZED
                        // =========================================

                        else if (xhr.status === 401) {

                            title =
                                'Session Expired';

                            message =
                                'Your session has expired. Please sign in again.';

                        }


                        // =========================================
                        // FORBIDDEN
                        // =========================================

                        else if (xhr.status === 403) {

                            title =
                                'Access Denied';

                            message =
                                'You are not authorized to receive this sample.';

                        }


                        // =========================================
                        // NOT FOUND
                        // =========================================

                        else if (xhr.status === 404) {

                            title =
                                'Sample Not Found';

                            message =
                                'The requested sample could not be found.';

                        }


                        // =========================================
                        // SERVER ERROR
                        // =========================================

                        else if (xhr.status >= 500) {

                            title =
                                'Server Error';

                            message =
                                'A server error occurred while saving the sample verification.';

                        }


                        Swal.fire({

                            icon:
                                'error',

                            title:
                                title,

                            text:
                                message,

                            confirmButtonText:
                                'OK',

                            confirmButtonColor:
                                '#1572E8'

                        });

                    }

                });

            });

        });



    // =============================================================
    // MODAL CLOSED
    // =============================================================

    $('#receiveSampleModal')
        .on(
            'hidden.bs.modal',
            function() {

                // Reset modal content so old sample information
                // isn't briefly displayed when another sample opens.

                $('#receiveSampleModalContent')
                    .html(`

                            <div class="text-center p-5">

                                <i class="
                                    fas
                                    fa-spinner
                                    fa-spin
                                    fa-2x
                                    text-primary">
                                </i>

                                <p class="mt-2 mb-0">
                                    Loading sample...
                                </p>

                            </div>

                        `);

            }
        );

</script>







