@model NMB_HLabSys.Areas.Technician.Models.ReceiveSampleViewModel

@{
	ViewData["Title"] = "NMB_HLabSys | Receive Samples";
	Layout = "_TechnicianLayout";
}
<div class="main-panel">
	<div class="content">
		<div class="panel-header bg-primary-gradient">
			<div class="page-inner py-5">
				<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row">
					<div>
                        <h2 class="text-white pb-2 fw-bold">
                            📦 Receive Sample - Verification Required
                        </h2>
						<h5 class="text-white op-7 mb-2">Lab Technician Receive Samples</h5>
					</div>
					<div class="ml-md-auto py-2 py-md-0">
						<a href="#" class="btn btn-secondary btn-round">Receive Sample</a>
					</div>
				</div>
			</div>
		</div>
		<div class="page-inner mt--5">
			<div class="row mt--2">
				<div class="col-md-6">
					<div class="card full-height">
						<div class="card-body">
                            <div class="modal-content">

                            <form asp-action="Receive"
                                  asp-controller="ReceiveSamples"
                                  asp-area="Technician"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input asp-for="TestRequestId" type="hidden" />

                                <input asp-for="SampleID" type="hidden" />

                                <input asp-for="RequestNumber" type="hidden" />

                                <input asp-for="Barcode" type="hidden" />

                                <input asp-for="SampleTypeId" type="hidden" />

                                <input asp-for="DateTimeReceived" type="hidden" />

                                <div class="modal-body">

                                    <div class="card bg-light">

                                        <div class="card-body">

                                            <h5>
                                                ✔ Sample Verification Checklist
                                            </h5>


                                            <!-- Request Number -->

                                            <div class="form-check mb-3">

                                                <input asp-for="VerifyRequestNumber"
                                                       class="form-check-input verification-check"
                                                       type="checkbox"
                                                       id="verifyRequestNumber" />

                                                <label class="form-check-label"
                                                       for="verifyRequestNumber">

                                                    <strong>Request Number:</strong>

                                                    @Model.RequestNumber

                                                </label>

                                            </div>


                                            <!-- Technician -->

                                            <div class="form-check mb-3">

                                                <input asp-for="VerifyTechnician"
                                                       class="form-check-input verification-check"
                                                       type="checkbox"
                                                       id="verifyTechnician" />

                                                <label class="form-check-label"
                                                       for="verifyTechnician">

                                                    <strong>Technician Receiving:</strong>

                                                    @Model.TechnicianName

                                                </label>

                                            </div>


                                            <!-- Barcode -->

                                            <div class="form-check mb-3">

                                                <input asp-for="VerifyBarcode"
                                                       class="form-check-input verification-check"
                                                       type="checkbox"
                                                       id="verifyBarcode" />

                                                <label class="form-check-label"
                                                       for="verifyBarcode">

                                                    <strong>Sample Barcode:</strong>

                                                    @Model.Barcode

                                                    <span class="text-success ms-3">
                                                        ✓ Unique
                                                    </span>

                                                </label>

                                            </div>


                                            <!-- Sample Type -->

                                            <div class="form-check mb-3">

                                                <input asp-for="VerifySampleType"
                                                       class="form-check-input verification-check"
                                                       type="checkbox"
                                                       id="verifySampleType" />

                                                <label class="form-check-label"
                                                       for="verifySampleType">

                                                    <strong>Sample Type:</strong>

                                                    <select asp-for="SampleTypeId"
                                                            asp-items="Model.SampleTypes"
                                                            class="form-select d-inline-block"
                                                            style="width: 200px;">

                                                        <option value="">
                                                            Select
                                                        </option>

                                                    </select>

                                                </label>

                                            </div>


                                            <!-- Date/Time -->

                                            <div class="form-check mb-3">

                                                <input asp-for="VerifyDateTime"
                                                       class="form-check-input verification-check"
                                                       type="checkbox"
                                                       id="verifyDateTime" />

                                                <label class="form-check-label"
                                                       for="verifyDateTime">

                                                    <strong>Date/Time Received:</strong>

                                                    @Model.DateTimeReceived.ToString("d/M/yyyy, h:mm:ss tt")

                                                </label>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Warning -->

                                    <div id="verificationWarning"
                                         class="alert alert-warning mt-3">

                                        Please verify all items before confirming.

                                    </div>

                                </div>


                                <!-- Footer -->

                                <div class="modal-footer">

                                    <a asp-action="Index"
                                       asp-controller="ReceiveSamples"
                                       asp-area="Technician"
                                       class="btn btn-secondary">

                                        Cancel

                                    </a>

                                    <button type="submit"
                                            id="confirmButton"
                                            class="btn btn-success"
                                            disabled>

                                        ✔ Confirm & Set Status to "Samples Received"

                                    </button>

                                </div>

                            </form>
						</div>
                        </div>
					</div>
				</div>
			</div>
		
		</div>
	</div>
</div>



@section Scripts {

    <script>

        const checkboxes =
            document.querySelectorAll(".verification-check");

        const confirmButton =
            document.getElementById("confirmButton");

        const warning =
            document.getElementById("verificationWarning");


        function checkVerification()
        {
            let allChecked = true;

            checkboxes.forEach(function (checkbox)
            {
                if (!checkbox.checked)
                {
                    allChecked = false;
                }
            });


            if (allChecked)
            {
                confirmButton.disabled = false;

                warning.classList.remove("alert-warning");

                warning.classList.add("alert-success");

                warning.innerHTML =
                    "✓ All items verified. You can now confirm receipt.";
            }
            else
            {
                confirmButton.disabled = true;

                warning.classList.remove("alert-success");

                warning.classList.add("alert-warning");

                warning.innerHTML =
                    "Please verify all items before confirming.";
            }
        }


        checkboxes.forEach(function (checkbox)
        {
            checkbox.addEventListener(
                "change",
                checkVerification
            );
        });

    </script>

}