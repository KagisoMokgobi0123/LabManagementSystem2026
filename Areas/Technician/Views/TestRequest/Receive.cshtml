@using NMB_HLabSys.Areas.Technician.ViewModels
@{
	ViewData["Title"] = "NMB_HLabSys | Verify Samples";
	Layout = "_TechnicianLayout";
}
@model ReceiveSampleViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <h4 class="mb-0"><i class="fas fa-vial me-2"></i> Receive Patient Sample</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-secondary py-2">
                        <strong>Verifying Request:</strong> @Model.RequestNumber
                    </div>

                    <form asp-action="Receive" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="TestRequestId" />

                        <div class="mb-4">
                            <label asp-for="Barcode" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                <input asp-for="Barcode" class="form-control form-control-lg"
                                       placeholder="Scan barcode number here..." autofocus />
                            </div>
                            <span asp-validation-for="Barcode" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SampleType" class="form-label fw-bold"></label>
                            <select asp-for="SampleType" class="form-select form-control-lg">
                                <option value="">-- Select Sample Type --</option>
                                <option value="Whole Blood">Whole Blood (EDTA)</option>
                                <option value="Plasma">Plasma (Citrate)</option>
                                <option value="Serum">Serum (Plain)</option>
                                <option value="Urine">Urine</option>
                            </select>
                            <span asp-validation-for="SampleType" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded">
                            <div>
                                <small class="text-muted d-block">Receiving Technician</small>
                                <strong>@User.Identity?.Name</strong>
                            </div>
                            <div>
                                <small class="text-muted d-block">Current Date/Time</small>
                                <strong>@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</strong>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-check-circle me-1"></i> Confirm & Set Status: Samples Received
                            </button>
                            <a asp-action="Index" class="btn btn-link w-100 mt-2 text-decoration-none text-muted">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
