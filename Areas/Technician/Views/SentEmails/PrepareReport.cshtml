@{
    ViewData["Title"] = "Prepare Laboratory Report";
    Layout = "_TechnicianLayout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Prepare Laboratory Report</h3>
            <p class="text-muted mb-0">
                Generate a combined PDF containing independently
                verified laboratory test results.
            </p>
        </div>

        <a href="@Url.Action("Index", "SentEmails", new { area = "Technician" })"
           class="btn btn-outline-secondary">
            Back to Sent Emails
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Laboratory PDF Preparation
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-info">
                <strong>Development Testing Only</strong>
                <p class="mb-0 mt-2">
                    This operation prepares a PDF report
                    and saves it to the pending email record.
                    It does not send an email.
                </p>
            </div>

            <form method="post"
                  action="@Url.Action("PrepareReport", "SentEmails", new { area = "Technician" })">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="testRequestId"
                           class="form-label fw-semibold">
                        Test Request ID
                    </label>

                    <input type="number"
                           id="testRequestId"
                           name="testRequestId"
                           class="form-control"
                           placeholder="Enter Test Request ID"
                           min="1"
                           required />

                    <small class="text-muted">
                        The request must be completed, all tests
                        must be independently verified, and
                        a pending email record must exist.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Prepare Test PDF
                    </button>

                    <a href="@Url.Action("Index", "SentEmails", new { area = "Technician" })"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card mt-4 border-0 shadow-sm">
        <div class="card-body">

            <h5>Report Preparation Requirements</h5>

            <ul class="mb-0">
                <li>
                    The laboratory request must have
                    Completed status.
                </li>
                <li>
                    Every requested test must have
                    Verified status.
                </li>
                <li>
                    Each test must have a valid result
                    independently verified by another technician.
                </li>
                <li>
                    The requesting doctor must have
                    a valid email address.
                </li>
                <li>
                    A pending outgoing email record
                    must already exist.
                </li>
            </ul>

        </div>
    </div>

</div>
