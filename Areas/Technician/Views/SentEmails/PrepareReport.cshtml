@{
    ViewData["Title"] = "Prepare Laboratory Report";
}

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-1">
                <i class="fas fa-file-pdf me-2"></i>
                Prepare Laboratory Report
            </h4>

            <p class="mb-0">
                Generate a PDF containing all independently
                verified laboratory results.
            </p>
        </div>

        <div class="card-body p-4">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="alert alert-info">
                <strong>Development testing:</strong>
                This process prepares the laboratory PDF
                and stores it in the pending email record.
                It does not send an email.
            </div>

            <form method="post"
                  action="@Url.Action("PrepareReport", "SentEmails", new { area = "Technician" })">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="testRequestId"
                           class="form-label fw-bold">
                        Test Request ID
                    </label>

                    <input type="number"
                           id="testRequestId"
                           name="testRequestId"
                           class="form-control"
                           min="1"
                           required
                           placeholder="Enter Test Request ID" />

                    <div class="form-text">
                        Enter the ID of a completed laboratory
                        request with all results independently
                        verified.
                    </div>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fas fa-file-pdf me-1"></i>
                        Prepare Test PDF
                    </button>

                    <a href="@Url.Action("Index", "SentEmails", new { area = "Technician" })"
                       class="btn btn-outline-secondary">
                        Back to Sent Emails
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>
