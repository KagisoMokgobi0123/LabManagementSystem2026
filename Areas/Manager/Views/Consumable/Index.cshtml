@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.ConsumableModel>

@{
    ViewData["Title"] = "Consumables";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-boxes-stacked text-primary me-2"></i>
                Consumables
            </h4>

            <p class="text-muted mb-0">
                Manage laboratory consumable stock and stock history.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#consumableModal"
                onclick="openCreateModal()">

            <i class="fa-solid fa-plus me-1"></i>
            Add Consumable

        </button>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Please correct the following errors:
            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <div class="alert alert-info border-0 shadow-sm">

        <div class="d-flex">

            <i class="fa-solid fa-circle-info mt-1 me-3"></i>

            <div>

                <div class="fw-semibold">
                    Stock monitoring
                </div>

                <div class="small">
                    Stock status is calculated from the current quantity
                    and reorder level. Stock adjustments should be used
                    whenever the quantity changes.
                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <h6 class="fw-bold mb-0">
                        Consumable Stock
                    </h6>

                    <small class="text-muted">
                        Current laboratory inventory
                    </small>

                </div>

                <div class="d-flex align-items-center gap-2">


                    <div class="input-group input-group-sm"
                         style="width:280px;">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                        </span>

                        <input type="text"
                               id="consumableSearch"
                               class="form-control"
                               placeholder="Search consumables..."
                               autocomplete="off" />

                    </div>




                    <span class="badge bg-primary-subtle text-primary"
                          id="recordCount">

                        @(Model?.Count() ?? 0) item(s)

                    </span>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="consumablesTable">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Consumable
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Quantity On Hand
                            </th>

                            <th>
                                Reorder Level
                            </th>

                            <th>
                                Stock Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="consumablesTableBody">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var consumable in Model)
                            {

                                var reorderThreshold =
                                    consumable.ReorderLevel * 1.10m;

                                var isReorderNow =
                                    consumable.QuantityOnHand <=
                                    consumable.ReorderLevel;

                                var isNearReorder =
                                    !isReorderNow &&
                                    consumable.QuantityOnHand <=
                                    reorderThreshold;

                                var stockStatus =
                                    isReorderNow
                                        ? "Reorder Now"
                                        : isNearReorder
                                            ? "Near Reorder"
                                            : "Sufficient";

                                var encodedName =
                                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                        consumable.Name ?? "");

                                var encodedSupplier =
                                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                        consumable.Supplier?.SupplierName ?? "No supplier");

                                var encodedStatus =
                                    System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                        stockStatus);


                                <tr class="consumable-row"
                                    data-name="@consumable.Name"
                                    data-supplier="@consumable.Supplier?.SupplierName"
                                    data-status="@stockStatus">

                                    <td>

                                        <div class="fw-semibold">
                                            @consumable.Name
                                        </div>

                                    </td>


                                    <td>

                                        @if (consumable.Supplier != null)
                                        {
                                            <span>
                                                @consumable.Supplier.SupplierName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No supplier
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="fw-semibold">
                                            @consumable.QuantityOnHand
                                        </span>

                                    </td>

                                    <td>
                                        @consumable.ReorderLevel
                                    </td>



                                    <td>

                                        @if (isReorderNow)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                Reorder Now

                                            </span>
                                        }
                                        else if (isNearReorder)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa-solid fa-bell me-1"></i>
                                                Near Reorder

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-check me-1"></i>
                                                Sufficient

                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm"
                                             role="group">


                                            <!-- VIEW -->

                                            <button type="button"
                                                    class="btn btn-outline-info"
                                                    title="View consumable"
                                                    onclick="viewConsumable(
                                                '@consumable.ConsumableId',
                                                '@Html.Raw(encodedName)',
                                                '@Html.Raw(encodedSupplier)',
                                                '@consumable.QuantityOnHand',
                                                '@consumable.ReorderLevel',
                                                '@Html.Raw(encodedStatus)'
                                                )">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>


                                            <!-- STOCK ADJUSTMENT -->

                                            <button type="button"
                                                    class="btn btn-outline-success"
                                                    title="Adjust stock"
                                                    onclick="adjustStock(
                                                '@consumable.ConsumableId',
                                                '@Html.Raw(encodedName)',
                                                '@consumable.QuantityOnHand'
                                                )">

                                                <i class="fa-solid fa-arrows-up-down"></i>

                                            </button>


                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit consumable"
                                                    onclick="editConsumable(
                                                '@consumable.ConsumableId',
                                                '@Html.Raw(encodedName)',
                                                '@consumable.SupplierId',
                                                '@consumable.QuantityOnHand',
                                                '@consumable.ReorderLevel'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>


                                            <!-- DELETE -->

                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Delete consumable"
                                                    onclick="deleteConsumable(
                                                '@consumable.ConsumableId',
                                                '@Html.Raw(encodedName)'
                                                )">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-box-open fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No consumables found
                                        </div>

                                        <small>
                                            Add a consumable to begin managing stock.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }



                        <tr id="noSearchResultsRow"
                            style="display:none;">

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="fa-solid fa-magnifying-glass fa-2x mb-3"></i>

                                    <div class="fw-semibold">
                                        No matching consumables found
                                    </div>

                                    <small>
                                        Try a different consumable, supplier,
                                        or stock status.
                                    </small>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- add and edit pop up form -->

<div class="modal fade"
     id="consumableModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="consumableForm"
                  method="post"
                  asp-area="Manager"
                  asp-controller="Consumable"
                  asp-action="Create">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="consumableModalTitle">

                        <i class="fa-solid fa-plus text-primary me-2"></i>
                        Add Consumable

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="ConsumableId"
                           name="ConsumableId"
                           value="0" />

                    <input type="hidden"
                           id="consumableRouteId"
                           name="id"
                           value="0" />


                    <!-- NAME -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="Name">

                            Consumable Name

                        </label>

                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>


                    <!-- SUPPLIER -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="SupplierId">

                            Supplier

                        </label>

                        <select id="SupplierId"
                                name="SupplierId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Supplier --
                            </option>

                            @if (ViewBag.Suppliers != null)
                            {
                                foreach (var supplier in ViewBag.Suppliers)
                                {
                                    <option value="@supplier.SupplierId">
                                        @supplier.SupplierName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- quantity reorder-->

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="QuantityOnHand">

                                Quantity On Hand

                            </label>

                            <input type="number"
                                   id="QuantityOnHand"
                                   name="QuantityOnHand"
                                   class="form-control"
                                   min="0"
                                   required />

                            <div id="quantityHelp"
                                 class="form-text">

                                Enter the opening stock quantity.

                            </div>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="ReorderLevel">

                                Reorder Level

                            </label>

                            <input type="number"
                                   id="ReorderLevel"
                                   name="ReorderLevel"
                                   class="form-control"
                                   min="0"
                                   required />

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-1"></i>

                        <span id="saveButtonText">
                            Save Consumable
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!--view Consumable details-->

<div class="modal fade"
     id="viewConsumableModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-circle-info text-info me-2"></i>
                    Consumable Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="mb-3">

                    <small class="text-muted d-block">
                        Consumable
                    </small>

                    <div id="viewConsumableName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Supplier
                    </small>

                    <div id="viewConsumableSupplier"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="row">

                    <div class="col-6">

                        <small class="text-muted d-block">
                            Quantity On Hand
                        </small>

                        <div id="viewConsumableQuantity"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-6">

                        <small class="text-muted d-block">
                            Reorder Level
                        </small>

                        <div id="viewConsumableReorder"
                             class="fw-semibold">
                        </div>

                    </div>

                </div>


                <div class="mt-3">

                    <small class="text-muted d-block">
                        Stock Status
                    </small>

                    <div id="viewConsumableStatus"
                         class="fw-semibold">
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- Stock adjustment form -->

<div class="modal fade"
     id="adjustStockModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="adjustStockForm"
                  action="@Url.Action("AdjustStock", "Consumable", new { area = "Manager" })"
                  method="post">
                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="adjustConsumableId"
                       name="id" />


                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-arrows-up-down text-success me-2"></i>
                        Adjust Stock

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="alert alert-light border">

                        <div class="small text-muted">
                            Consumable
                        </div>

                        <div id="adjustConsumableName"
                             class="fw-semibold">
                        </div>

                        <div class="small text-muted mt-2">
                            Current quantity
                        </div>

                        <div id="adjustCurrentQuantity"
                             class="fw-bold text-primary">
                        </div>

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="adjustmentType">

                            Adjustment Type

                        </label>

                        <select name="adjustmentType"
                                id="adjustmentType"
                                class="form-select"
                                required>

                            <option value="increase">
                                Increase Quantity
                            </option>

                            <option value="decrease">
                                Decrease Quantity
                            </option>

                            <option value="set">
                                Set New Quantity
                            </option>

                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="adjustmentValue">

                            Quantity

                        </label>

                        <input type="number"
                               id="adjustmentValue"
                               name="quantity"
                               class="form-control"
                               min="0"
                               required />

                    </div>


                    <div id="decreaseWarning"
                         class="alert alert-warning d-none">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>

                        The resulting stock quantity cannot be negative.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            id="applyAdjustmentButton"
                            class="btn btn-success">

                        <i class="fa-solid fa-check me-1"></i>
                        Apply Adjustment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Delete a consumable  -->

<div class="modal fade"
     id="deleteConsumableModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="deleteConsumableForm"
                  action="@Url.Action("Delete", "Consumable", new { area = "Manager" })"
                  method="post">
                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="deleteConsumableId"
                       name="id" />


                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-danger">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        Delete Consumable

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        Are you sure you want to delete this consumable?
                    </p>

                    <div class="alert alert-warning mb-0">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        <strong id="deleteConsumableName"></strong>

                        <div class="small mt-1">

                            This will be a soft delete. The consumable
                            will not be permanently removed.

                        </div>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Consumable

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!--Successful message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="modal fade"
         id="successMessageModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-success">

                        <i class="fa-solid fa-circle-check me-2"></i>
                        Success

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body text-center py-4">

                    <div class="mb-3">

                        <div class="d-inline-flex
                            align-items-center
                            justify-content-center
                            rounded-circle
                            bg-success-subtle
                            text-success"
                             style="width:70px;height:70px;">

                            <i class="fa-solid fa-check fa-2x"></i>

                        </div>

                    </div>


                    <h6 class="fw-semibold mb-2">
                        Operation Successful
                    </h6>

                    <p class="text-muted mb-0">
                        @TempData["SuccessMessage"]
                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-success px-4"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-check me-1"></i>
                        OK

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        /* Success message*/

        document.addEventListener("DOMContentLoaded", function () {

            const successModal =
                document.getElementById("successMessageModal");

            if (successModal) {

                const modal =
                    new bootstrap.Modal(successModal);

                modal.show();
            }

        });


        /* Create Form */

        function openCreateModal() {

            const form =
                document.getElementById("consumableForm");

            form.action =
                "@Url.Action("Create", "Consumable", new { area = "Manager" })";

            document.getElementById("consumableModalTitle")
                .innerHTML =
                '<i class="fa-solid fa-plus text-primary me-2"></i>' +
                'Add Consumable';

            document.getElementById("saveButtonText")
                .innerText =
                "Save Consumable";

            document.getElementById("ConsumableId")
                .value = "0";

            document.getElementById("consumableRouteId")
                .value = "0";

            document.getElementById("Name")
                .value = "";

            document.getElementById("SupplierId")
                .value = "";

            document.getElementById("QuantityOnHand")
                .value = "";

            document.getElementById("QuantityOnHand")
                .readOnly = false;

            document.getElementById("ReorderLevel")
                .value = "";

            document.getElementById("quantityHelp")
                .innerText =
                "Enter the opening stock quantity.";

        }


        /*view form*/

        function viewConsumable(
            id,
            name,
            supplier,
            quantity,
            reorderLevel,
            status) {

            document.getElementById("viewConsumableName")
                .innerText = name;

            document.getElementById("viewConsumableSupplier")
                .innerText = supplier;

            document.getElementById("viewConsumableQuantity")
                .innerText = quantity;

            document.getElementById("viewConsumableReorder")
                .innerText = reorderLevel;

            document.getElementById("viewConsumableStatus")
                .innerText = status;

            new bootstrap.Modal(
                document.getElementById("viewConsumableModal")
            ).show();

        }


        /* Edit */

        function editConsumable(
            id,
            name,
            supplierId,
            quantity,
            reorderLevel) {

            const form =
                document.getElementById("consumableForm");

            form.action =
                "@Url.Action("Edit", "Consumable", new { area = "Manager" })";

            document.getElementById("consumableModalTitle")
                .innerHTML =
                '<i class="fa-solid fa-pen text-primary me-2"></i>' +
                'Edit Consumable';

            document.getElementById("saveButtonText")
                .innerText =
                "Update Consumable";

            document.getElementById("ConsumableId")
                .value = id;

            document.getElementById("consumableRouteId")
                .value = id;

            document.getElementById("Name")
                .value = name;

            document.getElementById("SupplierId")
                .value = supplierId;

            document.getElementById("QuantityOnHand")
                .value = quantity;

            document.getElementById("QuantityOnHand")
                .readOnly = true;

            document.getElementById("ReorderLevel")
                .value = reorderLevel;

            document.getElementById("quantityHelp")
                .innerText =
                "Quantity can only be changed using Adjust Stock.";

            new bootstrap.Modal(
                document.getElementById("consumableModal")
            ).show();

        }


        /*Adjust The Stock*/

        function adjustStock(
            id,
            name,
            quantity) {

            document.getElementById("adjustConsumableId")
                .value = id;

            document.getElementById("adjustConsumableName")
                .innerText = name;

            document.getElementById("adjustCurrentQuantity")
                .innerText = quantity;

            document.getElementById("adjustmentType")
                .value = "increase";

            document.getElementById("adjustmentValue")
                .value = "";

            document.getElementById("decreaseWarning")
                .classList.add("d-none");

            document.getElementById("adjustmentValue")
                .setCustomValidity("");

            document.getElementById("applyAdjustmentButton")
                .disabled = false;

            new bootstrap.Modal(
                document.getElementById("adjustStockModal")
            ).show();

        }


        /* Delete form */

        function deleteConsumable(id, name) {

            document.getElementById("deleteConsumableId")
                .value = id;

            document.getElementById("deleteConsumableName")
                .innerText = name;

            new bootstrap.Modal(
                document.getElementById("deleteConsumableModal")
            ).show();

        }


        /* Search */

        const searchInput =
            document.getElementById("consumableSearch");

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    const search =
                        this.value.toLowerCase().trim();

                    const rows =
                        document.querySelectorAll(
                            "#consumablesTableBody .consumable-row"
                        );

                    let visibleCount = 0;

                    rows.forEach(function (row) {

                        const name =
                            (
                                row.dataset.name || ""
                            ).toLowerCase();

                        const supplier =
                            (
                                row.dataset.supplier || ""
                            ).toLowerCase();

                        const status =
                            (
                                row.dataset.status || ""
                            ).toLowerCase();

                        const matches =
                            name.includes(search) ||
                            supplier.includes(search) ||
                            status.includes(search);

                        row.style.display =
                            matches ? "" : "none";

                        if (matches) {
                            visibleCount++;
                        }

                    });


                    document.getElementById("recordCount")
                        .innerText =
                        visibleCount + " item(s)";


                    const noSearchResultsRow =
                        document.getElementById(
                            "noSearchResultsRow"
                        );

                    if (noSearchResultsRow) {

                        noSearchResultsRow.style.display =
                            rows.length > 0 &&
                            visibleCount === 0
                                ? ""
                                : "none";

                    }

                }
            );

        }


        /* Validate adjustment*/

        const adjustmentType =
            document.getElementById("adjustmentType");

        const adjustmentValue =
            document.getElementById("adjustmentValue");

        const warning =
            document.getElementById("decreaseWarning");

        const currentQuantity =
            document.getElementById("adjustCurrentQuantity");

        const applyAdjustmentButton =
            document.getElementById("applyAdjustmentButton");


        function validateAdjustment() {

            if (!adjustmentType ||
                !adjustmentValue ||
                !warning ||
                !currentQuantity ||
                !applyAdjustmentButton) {

                return;
            }


            const type =
                adjustmentType.value;

            const value =
                parseInt(
                    adjustmentValue.value || "0"
                );

            const current =
                parseInt(
                    currentQuantity.innerText || "0"
                );


            if (type === "decrease" &&
                value > current) {

                warning.classList.remove("d-none");

                adjustmentValue.setCustomValidity(
                    "Stock cannot become negative."
                );

                applyAdjustmentButton.disabled = true;

            }
            else {

                warning.classList.add("d-none");

                adjustmentValue.setCustomValidity("");

                applyAdjustmentButton.disabled = false;

            }

        }


        if (adjustmentType) {

            adjustmentType.addEventListener(
                "change",
                validateAdjustment
            );

        }


        if (adjustmentValue) {

            adjustmentValue.addEventListener(
                "input",
                validateAdjustment
            );

        }

    </script>

}
