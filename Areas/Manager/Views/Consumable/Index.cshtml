@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.ConsumableModel>

@{
    ViewData["Title"] = "Consumables";

    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- =========================================================
     PAGE HEADER
     ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-boxes-stacked text-primary me-2"></i>
                Consumables
            </h4>

            <p class="text-muted mb-0">
                Manage laboratory consumable stock and reorder levels.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addConsumableModal">

            <i class="fa-solid fa-plus me-1"></i>
            Add Consumable

        </button>

    </div>

    <!-- =========================================================
     MESSAGES
     ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Please correct the following errors:
            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }

    <!-- =========================================================
     INFORMATION
     ========================================================= -->

    <div class="alert alert-info border-0 shadow-sm">

        <div class="d-flex">

            <i class="fa-solid fa-circle-info mt-1 me-3"></i>

            <div>

                <div class="fw-semibold">
                    Reorder monitoring
                </div>

                <div class="small">
                    A consumable is flagged when its quantity on hand is
                    at or below the reorder level, or within 10% above
                    the reorder level.
                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
     CONSUMABLE TABLE
     ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="fw-bold mb-0">
                        Consumable Stock
                    </h6>

                    <small class="text-muted">
                        Current laboratory inventory
                    </small>

                </div>

                <span class="badge bg-primary-subtle text-primary">

                    @Model.Count() item(s)

                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Consumable
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Quantity On Hand
                            </th>

                            <th>
                                Reorder Level
                            </th>

                            <th>
                                Stock Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var consumable in Model)
                            {
                                /*
                                 * Reorder threshold:
                                 *
                                 * A consumable is considered near/below
                                 * reorder level when:
                                 *
                                 * QuantityOnHand <= ReorderLevel * 1.10
                                 *
                                 * The calculation is performed here only
                                 * for display. It is not stored in the DB.
                                 */

                                var reorderThreshold =
                                    consumable.ReorderLevel * 1.10m;

                                var isBelow =
                                    consumable.QuantityOnHand <=
                                    consumable.ReorderLevel;

                                var isNear =
                                    !isBelow &&
                                    consumable.QuantityOnHand <=
                                    reorderThreshold;

                                <tr>

                                    <!-- CONSUMABLE -->

                                    <td>

                                        <div class="fw-semibold">
                                            @consumable.Name
                                        </div>

                                    </td>

                                    <!-- SUPPLIER -->

                                    <td>

                                        @if (consumable.Supplier != null)
                                        {
                                            <span>
                                                @consumable.Supplier.SupplierName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No supplier
                                            </span>
                                        }

                                    </td>

                                    <!-- QUANTITY -->

                                    <td>

                                        <span class="fw-semibold">

                                            @consumable.QuantityOnHand

                                        </span>

                                    </td>

                                    <!-- REORDER LEVEL -->

                                    <td>

                                        @consumable.ReorderLevel

                                    </td>

                                    <!-- STATUS -->

                                    <td>

                                        @if (isBelow)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                Reorder Now

                                            </span>
                                        }
                                        else if (isNear)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa-solid fa-bell me-1"></i>
                                                Near Reorder

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-check me-1"></i>
                                                Sufficient

                                            </span>
                                        }

                                    </td>

                                    <!-- ACTIONS -->

                                    <td class="text-end">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-info me-1"
                                                title="View consumable"
                                                data-bs-toggle="modal"
                                                data-bs-target="#viewConsumableModal"
                                                data-id="@consumable.ConsumableId"
                                                data-name="@consumable.Name"
                                                data-quantity="@consumable.QuantityOnHand"
                                                data-reorder="@consumable.ReorderLevel"
                                                data-supplier="@(consumable.Supplier?.SupplierName ?? "No supplier")">

                                            <i class="fa-solid fa-eye"></i>

                                        </button>

                                        <!-- STOCK ADJUSTMENT -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-success me-1"
                                                title="Adjust stock"
                                                data-bs-toggle="modal"
                                                data-bs-target="#adjustStockModal"
                                                data-id="@consumable.ConsumableId"
                                                data-name="@consumable.Name"
                                                data-quantity="@consumable.QuantityOnHand">

                                            <i class="fa-solid fa-arrows-up-down"></i>

                                        </button>

                                        <!-- EDIT -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                title="Edit consumable"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editConsumableModal"
                                                data-id="@consumable.ConsumableId"
                                                data-name="@consumable.Name"
                                                data-quantity="@consumable.QuantityOnHand"
                                                data-reorder="@consumable.ReorderLevel"
                                                data-supplier-id="@consumable.SupplierId">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>

                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete consumable"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteConsumableModal"
                                                data-id="@consumable.ConsumableId"
                                                data-name="@consumable.Name">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-box-open fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No consumables found
                                        </div>

                                        <small>
                                            Add a consumable to begin managing stock.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> <!-- ============================================================= ADD CONSUMABLE MODAL ============================================================= --> <div class="modal fade" id="addConsumableModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-plus text-primary me-2"></i>
                    Add Consumable

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="Name">
                        Consumable Name
                    </label>

                    <input type="text"
                           id="Name"
                           name="Name"
                           class="form-control"
                           maxlength="150"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="SupplierId">
                        Supplier
                    </label>

                    <select id="SupplierId"
                            name="SupplierId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Supplier --
                        </option>

                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var supplier in ViewBag.Suppliers)
                            {
                                <option value="@supplier.SupplierId">
                                    @supplier.SupplierName
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold"
                               for="QuantityOnHand">
                            Quantity On Hand
                        </label>

                        <input type="number"
                               id="QuantityOnHand"
                               name="QuantityOnHand"
                               class="form-control"
                               min="0"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold"
                               for="ReorderLevel">
                            Reorder Level
                        </label>

                        <input type="number"
                               id="ReorderLevel"
                               name="ReorderLevel"
                               class="form-control"
                               min="0"
                               required />

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-check me-1"></i>
                    Save Consumable

                </button>

            </div>

        </form>

    </div>

</div>

</div> <!-- ============================================================= VIEW CONSUMABLE MODAL ============================================================= --> <div class="modal fade" id="viewConsumableModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <div class="modal-header">

            <h5 class="modal-title fw-bold">

                <i class="fa-solid fa-circle-info text-info me-2"></i>
                Consumable Details

            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
            </button>

        </div>

        <div class="modal-body">

            <div class="mb-3">

                <small class="text-muted d-block">
                    Consumable
                </small>

                <div id="viewConsumableName"
                     class="fw-semibold">
                </div>

            </div>

            <div class="mb-3">

                <small class="text-muted d-block">
                    Supplier
                </small>

                <div id="viewConsumableSupplier"
                     class="fw-semibold">
                </div>

            </div>

            <div class="row">

                <div class="col-6">

                    <small class="text-muted d-block">
                        Quantity On Hand
                    </small>

                    <div id="viewConsumableQuantity"
                         class="fw-semibold">
                    </div>

                </div>

                <div class="col-6">

                    <small class="text-muted d-block">
                        Reorder Level
                    </small>

                    <div id="viewConsumableReorder"
                         class="fw-semibold">
                    </div>

                </div>

            </div>

        </div>

        <div class="modal-footer">

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                Close
            </button>

        </div>

    </div>

</div>

</div> <!-- ============================================================= STOCK ADJUSTMENT MODAL ============================================================= --> <div class="modal fade" id="adjustStockModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <form asp-action="AdjustStock"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="adjustConsumableId"
                   name="id" />

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-arrows-up-down text-success me-2"></i>
                    Adjust Stock

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-light border">

                    <div class="small text-muted">
                        Consumable
                    </div>

                    <div id="adjustConsumableName"
                         class="fw-semibold">
                    </div>

                    <div class="small text-muted mt-2">
                        Current quantity
                    </div>

                    <div id="adjustCurrentQuantity"
                         class="fw-bold text-primary">
                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Adjustment Type
                    </label>

                    <select name="adjustmentType"
                            id="adjustmentType"
                            class="form-select"
                            required>

                        <option value="increase">
                            Increase Quantity
                        </option>

                        <option value="decrease">
                            Decrease Quantity
                        </option>

                        <option value="set">
                            Set New Quantity
                        </option>

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="adjustmentValue">
                        Quantity
                    </label>

                    <input type="number"
                           id="adjustmentValue"
                           name="quantity"
                           class="form-control"
                           min="0"
                           required />

                </div>

                <div id="decreaseWarning"
                     class="alert alert-warning d-none">

                    <i class="fa-solid fa-triangle-exclamation me-2"></i>

                    The resulting stock quantity cannot be negative.

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-success">

                    <i class="fa-solid fa-check me-1"></i>
                    Apply Adjustment

                </button>

            </div>

        </form>

    </div>

</div>

</div> <!-- ============================================================= EDIT CONSUMABLE MODAL ============================================================= --> <div class="modal fade" id="editConsumableModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <form asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editConsumableId"
                   name="ConsumableId" />

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-pen text-primary me-2"></i>
                    Edit Consumable

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="editConsumableName">
                        Consumable Name
                    </label>

                    <input type="text"
                           id="editConsumableName"
                           name="Name"
                           class="form-control"
                           maxlength="150"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold"
                           for="editSupplierId">
                        Supplier
                    </label>

                    <select id="editSupplierId"
                            name="SupplierId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Supplier --
                        </option>

                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var supplier in ViewBag.Suppliers)
                            {
                                <option value="@supplier.SupplierId">
                                    @supplier.SupplierName
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold"
                               for="editQuantityOnHand">
                            Quantity On Hand
                        </label>

                        <input type="number"
                               id="editQuantityOnHand"
                               name="QuantityOnHand"
                               class="form-control"
                               min="0"
                               required />

                        <div class="form-text">
                            For normal stock changes use Adjust Stock.
                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold"
                               for="editReorderLevel">
                            Reorder Level
                        </label>

                        <input type="number"
                               id="editReorderLevel"
                               name="ReorderLevel"
                               class="form-control"
                               min="0"
                               required />

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>

</div> <!-- ============================================================= DELETE CONSUMABLE MODAL ============================================================= --> <div class="modal fade" id="deleteConsumableModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="deleteConsumableId"
                   name="id" />

            <div class="modal-header border-0">

                <h5 class="modal-title fw-bold text-danger">

                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Delete Consumable

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <p>
                    Are you sure you want to delete this consumable?
                </p>

                <div class="alert alert-warning mb-0">

                    <i class="fa-solid fa-circle-info me-2"></i>

                    <strong id="deleteConsumableName"></strong>

                    <div class="small mt-1">
                        This will be a soft delete. The consumable
                        will not be permanently removed.
                    </div>

                </div>

            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-danger">

                    <i class="fa-solid fa-trash me-1"></i>
                    Delete Consumable

                </button>

            </div>

        </form>

    </div>

</div>

</div>
@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               VIEW
               ===================================================== */

            const viewModal =
                document.getElementById("viewConsumableModal");

            if (viewModal) {

                viewModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "viewConsumableName"
                        ).textContent =
                            button.dataset.name || "";

                        document.getElementById(
                            "viewConsumableSupplier"
                        ).textContent =
                            button.dataset.supplier || "";

                        document.getElementById(
                            "viewConsumableQuantity"
                        ).textContent =
                            button.dataset.quantity || "0";

                        document.getElementById(
                            "viewConsumableReorder"
                        ).textContent =
                            button.dataset.reorder || "0";
                    }
                );
            }

            /* =====================================================
               EDIT
               ===================================================== */

            const editModal =
                document.getElementById("editConsumableModal");

            if (editModal) {

                editModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "editConsumableId"
                        ).value =
                            button.dataset.id || "";

                        document.getElementById(
                            "editConsumableName"
                        ).value =
                            button.dataset.name || "";

                        document.getElementById(
                            "editQuantityOnHand"
                        ).value =
                            button.dataset.quantity || "0";

                        document.getElementById(
                            "editReorderLevel"
                        ).value =
                            button.dataset.reorder || "0";

                        document.getElementById(
                            "editSupplierId"
                        ).value =
                            button.dataset.supplierId || "";
                    }
                );
            }

            /* =====================================================
               STOCK ADJUSTMENT
               ===================================================== */

            const adjustModal =
                document.getElementById("adjustStockModal");

            if (adjustModal) {

                adjustModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "adjustConsumableId"
                        ).value =
                            button.dataset.id || "";

                        document.getElementById(
                            "adjustConsumableName"
                        ).textContent =
                            button.dataset.name || "";

                        document.getElementById(
                            "adjustCurrentQuantity"
                        ).textContent =
                            button.dataset.quantity || "0";

                        document.getElementById(
                            "adjustmentValue"
                        ).value = "";

                        document.getElementById(
                            "adjustmentType"
                        ).value = "increase";

                        document.getElementById(
                            "decreaseWarning"
                        ).classList.add("d-none");
                    }
                );
            }

            /* =====================================================
               DELETE
               ===================================================== */

            const deleteModal =
                document.getElementById("deleteConsumableModal");

            if (deleteModal) {

                deleteModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "deleteConsumableId"
                        ).value =
                            button.dataset.id || "";

                        document.getElementById(
                            "deleteConsumableName"
                        ).textContent =
                            button.dataset.name || "";
                    }
                );
            }

            /* =====================================================
               ADJUSTMENT TYPE VALIDATION
               ===================================================== */

            const adjustmentType =
                document.getElementById("adjustmentType");

            const adjustmentValue =
                document.getElementById("adjustmentValue");

            const warning =
                document.getElementById("decreaseWarning");

            const currentQuantity =
                document.getElementById("adjustCurrentQuantity");

            function validateAdjustment() {

                if (!adjustmentType ||
                    !adjustmentValue ||
                    !warning ||
                    !currentQuantity)
                    return;

                const type =
                    adjustmentType.value;

                const value =
                    parseInt(adjustmentValue.value || "0");

                const current =
                    parseInt(currentQuantity.textContent || "0");

                if (type === "decrease" &&
                    value > current) {

                    warning.classList.remove("d-none");

                    adjustmentValue.setCustomValidity(
                        "Stock cannot become negative."
                    );

                }
                else {

                    warning.classList.add("d-none");

                    adjustmentValue.setCustomValidity("");
                }
            }

            if (adjustmentType) {

                adjustmentType.addEventListener(
                    "change",
                    validateAdjustment
                );
            }

            if (adjustmentValue) {

                adjustmentValue.addEventListener(
                    "input",
                    validateAdjustment
                );
            }

        });

    </script>

}