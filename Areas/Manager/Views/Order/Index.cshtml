@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.OrderModel>

@{
    ViewData["Title"] = "Orders";

    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- =========================================================
     PAGE HEADER
     ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1 fw-bold text-dark">
                <i class="fa-solid fa-cart-shopping text-primary me-2"></i>
                Orders
            </h4>

            <p class="text-muted mb-0">
                Manage supplier orders, receive items and track order status.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <button type="button"
                    class="btn btn-primary px-4"
                    onclick="openOrderModal('/Manager/Order/Create')">

                <i class="fa-solid fa-plus me-2"></i>
                New Order

            </button>

        </div>

    </div>

    <!-- =========================================================
     SUMMARY
     ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-primary bg-opacity-10
                        text-primary d-flex align-items-center
                        justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-cart-shopping fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Total Orders
                        </div>

                        <div class="fs-4 fw-bold">
                            @Model.Count()
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-warning bg-opacity-10
                        text-warning d-flex align-items-center
                        justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-clock fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Ordered
                        </div>

                        <div class="fs-4 fw-bold">

                            @Model.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered)

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-info bg-opacity-10
                        text-info d-flex align-items-center
                        justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-spinner fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Partially Complete
                        </div>

                        <div class="fs-4 fw-bold">

                            @Model.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete)

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-success bg-opacity-10
                        text-success d-flex align-items-center
                        justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-circle-check fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Complete
                        </div>

                        <div class="fs-4 fw-bold">

                            @Model.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
     ORDERS TABLE
     ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap
                justify-content-between
                align-items-center">

                <div>

                    <h6 class="mb-1 fw-bold">
                        Supplier Orders
                    </h6>

                    <small class="text-muted">
                        Orders and their current processing status
                    </small>

                </div>

                <div class="mt-2 mt-md-0">

                    <div class="input-group input-group-sm"
                         style="width:260px;">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-search text-muted"></i>
                        </span>

                        <input type="text"
                               id="orderSearch"
                               class="form-control"
                               placeholder="Search orders..." />

                    </div>

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="ordersTable">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                Order #
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Items
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Date
                            </th>

                            <th class="text-end px-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                var statusClass =
                                    order.Status switch
                                    {
                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered
                                            => "bg-warning text-dark",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete
                                            => "bg-info text-dark",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                            => "bg-success",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled
                                            => "bg-danger",

                                        _ => "bg-secondary"
                                    };

                                var statusIcon =
                                    order.Status switch
                                    {
                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered
                                            => "fa-clock",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete
                                            => "fa-spinner",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                            => "fa-circle-check",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled
                                            => "fa-ban",

                                        _ => "fa-circle-question"
                                    };

                                <tr>

                                    <td class="px-4">

                                        <div class="fw-semibold text-dark">
                                            @order.OrderNumber
                                        </div>

                                        <small class="text-muted">
                                            ID: @order.OrderId
                                        </small>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @(order.Supplier?.SupplierName ?? "Unknown Supplier")
                                        </div>

                                        @if (order.Supplier != null)
                                        {
                                            <small class="text-muted">
                                                @order.Supplier.ContactPerson
                                            </small>
                                        }

                                    </td>

                                    <td>

                                        <span class="badge bg-light
                                            text-dark border">

                                            @(order.OrderItems?.Count ?? 0)
                                            item(s)

                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge @statusClass">

                                            <i class="fa-solid @statusIcon me-1"></i>

                                            @order.Status

                                        </span>

                                    </td>

                                    <td>

                                        <span class="text-muted">

                                            @order.OrderId

                                        </span>

                                    </td>

                                    <td class="text-end px-4">

                                        <div class="btn-group"
                                             role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    title="View Details"
                                                    onclick="openOrderModal('/Manager/Order/Details/@order.OrderId')">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>

                                            @if (order.Status !=
                                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                                &&
                                                order.Status !=
                                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Edit Order"
                                                        onclick="openOrderModal('/Manager/Order/Edit/@order.OrderId')">

                                                    <i class="fa-solid fa-pen"></i>

                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Cancel Order"
                                                        onclick="openOrderModal('/Manager/Order/Cancel/@order.OrderId')">

                                                    <i class="fa-solid fa-ban"></i>

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-cart-shopping
                                            fa-2x mb-3 opacity-50">
                                        </i>

                                        <h6 class="fw-semibold">
                                            No orders found
                                        </h6>

                                        <p class="small mb-3">
                                            No supplier orders have been created yet.
                                        </p>

                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                onclick="openOrderModal('/Manager/Order/Create')">

                                            <i class="fa-solid fa-plus me-1"></i>
                                            Create First Order

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> <!-- ============================================================= ORDER MODAL ============================================================= --> <div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-centered">

    <div class="modal-content border-0 shadow-lg">

        <div class="modal-header">

            <h5 class="modal-title"
                id="orderModalTitle">

                Order

            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
            </button>

        </div>

        <div class="modal-body"
             id="orderModalBody">

            <div class="text-center py-5">

                <div class="spinner-border text-primary"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>

                </div>

                <div class="mt-3 text-muted">
                    Loading...
                </div>

            </div>

        </div>

    </div>

</div>

</div>
@section Scripts {

    <script>
        /* =========================================================
           ORDER SEARCH
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("orderSearch");

            if (searchInput) {

                searchInput.addEventListener("input", function () {

                    const search =
                        this.value.toLowerCase().trim();

                    document
                        .querySelectorAll("#ordersTable tbody tr")
                        .forEach(function (row) {

                            const text =
                                row.textContent.toLowerCase();

                            row.style.display =
                                text.includes(search)
                                    ? ""
                                    : "none";

                        });

                });

            }

        });

        /* =========================================================
           OPEN ORDER MODAL
           ========================================================= */

        async function openOrderModal(url) {

            const modalElement =
                document.getElementById("orderModal");

            const modalBody =
                document.getElementById("orderModalBody");

            if (!modalElement || !modalBody)
                return;

            modalBody.innerHTML = `

                <div class="text-center py-5">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <div class="mt-3 text-muted">
                        Loading...
                    </div>

                </div>

            `;

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();

            try {

                const response =
                    await fetch(url, {
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    });

                if (!response.ok) {

                    throw new Error(
                        "Unable to load the requested order."
                    );

                }

                const html =
                    await response.text();

                modalBody.innerHTML =
                    html;

                initializeOrderForms();

            }
            catch (error) {

                modalBody.innerHTML = `

                    <div class="alert alert-danger mb-0">

                        <i class="fa-solid fa-circle-exclamation me-2"></i>

                        ${error.message}

                    </div>

                `;

            }

        }

        /* =========================================================
           ORDER FORMS
           ========================================================= */

        function initializeOrderForms() {

            const forms =
                document.querySelectorAll(
                    "#orderModalBody form"
                );

            forms.forEach(function (form) {

                if (
                    form.dataset.ajaxInitialized ===
                    "true"
                )
                    return;

                form.dataset.ajaxInitialized =
                    "true";

                form.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();

                        const submitButton =
                            form.querySelector(
                                "button[type='submit']"
                            );

                        if (submitButton) {

                            submitButton.disabled =
                                true;

                        }

                        try {

                            const response =
                                await fetch(
                                    form.action,
                                    {
                                        method:
                                            form.method ||
                                            "POST",

                                        body:
                                            new FormData(form),

                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );

                            const contentType =
                                response.headers
                                    .get("content-type")
                                    || "";

                            if (
                                contentType.includes(
                                    "application/json"
                                )
                            ) {

                                const result =
                                    await response.json();

                                if (result.success) {

                                    bootstrap
                                        .Modal
                                        .getOrCreateInstance(
                                            document.getElementById(
                                                "orderModal"
                                            )
                                        )
                                        .hide();

                                    location.reload();

                                    return;
                                }

                                alert(
                                    result.message ||
                                    "The operation could not be completed."
                                );

                                if (submitButton)
                                    submitButton.disabled =
                                        false;

                                return;
                            }

                            const html =
                                await response.text();

                            document.getElementById(
                                "orderModalBody"
                            ).innerHTML =
                                html;

                            initializeOrderForms();

                        }
                        catch (error) {

                            alert(
                                "An unexpected error occurred. Please try again."
                            );

                            if (submitButton)
                                submitButton.disabled =
                                    false;

                        }

                    }
                );

            });

        }

    </script>
}