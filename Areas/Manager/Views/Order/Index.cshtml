@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.OrderModel>

@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";

    var orders = Model?.ToList()
        ?? new List<NMB_HLabSys.Areas.Manager.Models.OrderModel>();

    var reorderConsumables =
        ViewBag.ReorderConsumables
        as IEnumerable<NMB_HLabSys.Areas.Manager.Models.ConsumableModel>
        ?? Enumerable.Empty<NMB_HLabSys.Areas.Manager.Models.ConsumableModel>();

    var consumablesNeedingOrder = reorderConsumables
        .Where(c =>
            !c.IsDeleted &&
            (c.StockStatus == NMB_HLabSys.Areas.Manager.Models.StockStatus.ReorderNow ||
             c.StockStatus == NMB_HLabSys.Areas.Manager.Models.StockStatus.OutOfStock))
        .ToList();

    var suppliers =
        ViewBag.Suppliers
        as IEnumerable<NMB_HLabSys.Areas.Manager.Models.SupplierModel>
        ?? Enumerable.Empty<NMB_HLabSys.Areas.Manager.Models.SupplierModel>();

}

<div class="container-fluid py-4">
    <!-- =========================================================
     PAGE HEADER
     ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-cart-shopping text-primary me-2"></i>
                Orders
            </h4>

            <p class="text-muted mb-0">
                Manage supplier orders, receive items and track order status.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createOrderModal">
            <i class="fa-solid fa-plus me-1"></i>
            New Order
        </button>

    </div>

    <!-- =========================================================
     TEMP DATA MESSAGES
     ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- =========================================================
     VALIDATION
     ========================================================= -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Please correct the following errors:
            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }

    <!-- =========================================================
     INFORMATION
     ========================================================= -->

    <div class="alert alert-info border-0 shadow-sm">

        <div class="d-flex">

            <i class="fa-solid fa-circle-info mt-1 me-3"></i>

            <div>

                <div class="fw-semibold">
                    Order management
                </div>

                <div class="small">
                    Create supplier orders for consumables requiring
                    replenishment, receive ordered items, and track
                    the progress of each order.
                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
     SUMMARY
     ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- TOTAL -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary
                        d-flex align-items-center justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-cart-shopping fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Total Orders
                        </div>

                        <div class="fs-4 fw-bold">
                            @orders.Count
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ORDERED -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning
                        d-flex align-items-center justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-clock fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Ordered
                        </div>

                        <div class="fs-4 fw-bold">

                            @orders.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered)

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- PARTIAL -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-info bg-opacity-10 text-info
                        d-flex align-items-center justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-spinner fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Partially Complete
                        </div>

                        <div class="fs-4 fw-bold">

                            @orders.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete)

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- COMPLETE -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-3 bg-success bg-opacity-10 text-success
                        d-flex align-items-center justify-content-center me-3"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-circle-check fs-5"></i>

                    </div>

                    <div>

                        <div class="text-muted small">
                            Complete
                        </div>

                        <div class="fs-4 fw-bold">

                            @orders.Count(o =>
                                o.Status ==
                                NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
     REORDER ITEMS
     ========================================================= -->
    @if (consumablesNeedingOrder.Any())
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-3">

                    <div>

                        <h6 class="fw-bold mb-1">

                            <i class="fa-solid fa-triangle-exclamation
                            text-warning me-2"></i>

                            Consumables Requiring Reorder

                        </h6>

                        <small class="text-muted">

                            Consumables currently marked as
                            <strong>Reorder Now</strong> or
                            <strong>Out of Stock</strong>.

                        </small>

                    </div>

                    <span class="badge bg-warning text-dark">
                        @consumablesNeedingOrder.Count item(s)
                    </span>

                </div>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Consumable</th>
                                <th>Supplier</th>
                                <th>Quantity On Hand</th>
                                <th>Reorder Level</th>
                                <th>Stock Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var consumable in consumablesNeedingOrder)
                            {
                                var isOutOfStock =
                                    consumable.StockStatus ==
                                    NMB_HLabSys.Areas.Manager.Models.StockStatus.OutOfStock;

                                var stockStatusClass =
                                    isOutOfStock
                                        ? "bg-danger"
                                        : "bg-warning text-dark";

                                var stockStatusIcon =
                                    isOutOfStock
                                        ? "fa-ban"
                                        : "fa-arrow-down";

                                var stockStatusText =
                                    isOutOfStock
                                        ? "Out of Stock"
                                        : "Reorder Now";

                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @consumable.Name
                                        </div>

                                        <small class="text-muted">
                                            ID: @consumable.ConsumableId
                                        </small>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @(consumable.Supplier?.SupplierName
                                                ?? "Unknown Supplier")
                                        </div>

                                        @if (consumable.Supplier != null &&
                                             !string.IsNullOrWhiteSpace(
                                                 consumable.Supplier.ContactPerson))
                                        {
                                            <small class="text-muted">
                                                @consumable.Supplier.ContactPerson
                                            </small>
                                        }

                                    </td>

                                    <td>
                                        <span class="badge @stockStatusClass">
                                            @consumable.QuantityOnHand
                                        </span>
                                    </td>

                                    <td>
                                        @consumable.ReorderLevel
                                    </td>

                                    <td>

                                        <span class="badge @stockStatusClass">

                                            <i class="fa-solid @stockStatusIcon me-1"></i>

                                            @stockStatusText

                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <!-- =========================================================
     ORDERS
     ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3">

                <div>

                    <h6 class="fw-bold mb-0">
                        Supplier Orders
                    </h6>

                    <small class="text-muted">
                        Orders and their current processing status
                    </small>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <div class="input-group input-group-sm"
                         style="width:280px;">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                        </span>

                        <input type="text"
                               id="orderSearch"
                               class="form-control"
                               placeholder="Search orders..."
                               autocomplete="off" />

                    </div>

                    <span class="badge bg-primary-subtle text-primary"
                          id="recordCount">
                        @orders.Count order(s)
                    </span>

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="ordersTable">

                    <thead class="table-light">

                        <tr>
                            <th>Order #</th>
                            <th>Supplier</th>
                            <th>Items</th>
                            <th>Status</th>
                            <th>Order ID</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody id="ordersTableBody">

                        @if (orders.Any())
                        {
                            foreach (var order in orders)
                            {
                                var statusClass =
                                    order.Status switch
                                    {
                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered
                                            => "bg-warning text-dark",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete
                                            => "bg-info text-dark",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                            => "bg-success",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled
                                            => "bg-danger",

                                        _ => "bg-secondary"
                                    };

                                var statusIcon =
                                    order.Status switch
                                    {
                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Ordered
                                            => "fa-clock",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.PartiallyComplete
                                            => "fa-spinner",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                            => "fa-circle-check",

                                        NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled
                                            => "fa-ban",

                                        _ => "fa-circle-question"
                                    };

                                <tr class="order-row"
                                    data-order="@order.OrderNumber"
                                    data-supplier="@(order.Supplier?.SupplierName ?? "Unknown Supplier")"
                                    data-status="@order.Status"
                                    data-id="@order.OrderId">

                                    <td>

                                        <div class="fw-semibold">
                                            @order.OrderNumber
                                        </div>

                                        <small class="text-muted">
                                            Order #@order.OrderId
                                        </small>

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @(order.Supplier?.SupplierName
                                                ?? "Unknown Supplier")
                                        </div>

                                        @if (order.Supplier != null &&
                                             !string.IsNullOrWhiteSpace(
                                                 order.Supplier.ContactPerson))
                                        {
                                            <small class="text-muted">
                                                @order.Supplier.ContactPerson
                                            </small>
                                        }

                                    </td>

                                    <td>

                                        <span class="badge bg-info-subtle text-info">
                                            @(order.OrderItems?.Count ?? 0) item(s)
                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge @statusClass">

                                            <i class="fa-solid @statusIcon me-1"></i>

                                            @order.Status

                                        </span>

                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @order.OrderId
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end
                                            align-items-center gap-1">

                                            <!-- DETAILS -->

                                            <a href="@Url.Action(
                                                                                                                                       "Details",
                                                                                                                                       "Order",
                                                                                                                                       new
                                                                                                                                       {
                                                                                                                                           area = "Manager",
                                                                                                                                           id = order.OrderId
                                                                                                                                       })"
                                                   class="btn btn-sm btn-outline-info"
                                                   title="View order">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            @if (order.Status !=
                                                 NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete
                                                &&
                                                order.Status !=
                                                 NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled)
                                            {
                                                <!-- EDIT
                                                 NOTE:
                                                 Your controller currently only
                                                 has POST Edit. This link is
                                                 unrelated to Create. -->

                                                <a href="@Url.Action(
                                                                                                                                                   "Edit",
                                                                                                                                                   "Order",
                                                                                                                                                   new
                                                                                                                                                   {
                                                                                                                                                       area = "Manager",
                                                                                                                                                       id = order.OrderId
                                                                                                                                                   })"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="Edit order">

                                                    <i class="fa-solid fa-pen"></i>

                                                </a>

                                                <!-- CANCEL -->

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#cancelOrderModal-@order.OrderId"
                                                        title="Cancel order">

                                                    <i class="fa-solid fa-ban"></i>

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-cart-shopping fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No orders found
                                        </div>

                                        <small>
                                            Create a supplier order to begin
                                            tracking laboratory supplies.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }

                        <tr id="noSearchResultsRow"
                            style="display:none;">

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="fa-solid fa-magnifying-glass fa-2x mb-3"></i>

                                    <div class="fw-semibold">
                                        No matching orders found
                                    </div>

                                    <small>
                                        Try a different order number,
                                        supplier, status, or order ID.
                                    </small>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> <!-- ============================================================= CREATE ORDER MODAL ============================================================= --> <div class="modal fade" id="createOrderModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-lg modal-dialog-centered">

    <div class="modal-content border-0 shadow">

        <!--
            IMPORTANT:
            This is the ONLY form responsible for creating an order.

            It performs a normal MVC POST.

            There is deliberately NO:
            - fetch()
            - AJAX
            - preventDefault()
            - manual form.submit()
        -->

        <form action="/Manager/Order/Create"
              method="post"
              id="createOrderForm">

            @Html.AntiForgeryToken()

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-cart-shopping text-primary me-2"></i>

                    Create New Order

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="createOrderValidation"
                     class="alert alert-danger d-none">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    <span id="createOrderValidationText"></span>

                </div>

                <!-- ORDER NUMBER -->

                <div class="mb-3">

                    <label for="createOrderNumber"
                           class="form-label fw-semibold">

                        Order Number

                    </label>

                    <input type="text"
                           id="createOrderNumber"
                           name="OrderNumber"
                           class="form-control"
                           maxlength="50"
                           required
                           autocomplete="off"
                           placeholder="Enter supplier order number" />

                </div>

                <!-- SUPPLIER -->

                <div class="mb-4">

                    <label for="createSupplierId"
                           class="form-label fw-semibold">

                        Supplier

                    </label>

                    <select name="SupplierId"
                            id="createSupplierId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Supplier --
                        </option>

                        @foreach (var supplier in suppliers)
                        {
                            <option value="@supplier.SupplierId">
                                @supplier.SupplierName
                            </option>
                        }

                    </select>

                </div>

                <!-- ORDER ITEMS -->

                <div class="card border">

                    <div class="card-header bg-light">

                        <div class="d-flex justify-content-between
                            align-items-center">

                            <div>

                                <div class="fw-semibold">
                                    Order Items
                                </div>

                                <small class="text-muted">
                                    Add consumables requiring replenishment.
                                </small>

                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    id="addOrderItemBtn"
                                    disabled>

                                <i class="fa-solid fa-plus me-1"></i>

                                Add Item

                            </button>

                        </div>

                    </div>

                    <div class="card-body">

                        <div id="supplierRequiredMessage"
                             class="text-center text-muted py-3">

                            <i class="fa-solid fa-building me-2"></i>

                            Select a supplier to see consumables
                            requiring reorder.

                        </div>

                        <div id="orderItemsContainer"></div>

                        <div id="noSupplierConsumables"
                             class="alert alert-warning d-none mb-0">

                            <i class="fa-solid fa-triangle-exclamation me-2"></i>

                            This supplier has no consumables currently
                            requiring reorder.

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <!--
                    IMPORTANT:
                    This is a REAL SUBMIT button.

                    Do not change type="submit" to type="button".
                -->

                <button type="submit"
                        class="btn btn-primary"
                        id="createOrderSubmit">

                    <i class="fa-solid fa-check me-1"></i>

                    Create Order

                </button>

            </div>

        </form>

    </div>

</div>

</div> <!-- ============================================================= CANCEL ORDER MODALS ============================================================= -->
@foreach (var order in orders.Where(o =>
o.Status != NMB_HLabSys.Areas.Manager.Models.OrderStatus.Complete &&
o.Status != NMB_HLabSys.Areas.Manager.Models.OrderStatus.Cancelled))
{
    <div class="modal fade" id="cancelOrderModal-@order.OrderId" tabindex="-1" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <form asp-area="Manager"
                      asp-controller="Order"
                      asp-action="Cancel"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@order.OrderId" />

                    <div class="modal-header">

                        <h5 class="modal-title fw-bold text-danger">

                            <i class="fa-solid fa-ban me-2"></i>

                            Cancel Order

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="alert alert-warning">

                            <i class="fa-solid fa-triangle-exclamation me-2"></i>

                            You are about to cancel:

                            <strong>
                                @order.OrderNumber
                            </strong>

                        </div>

                        <div class="mb-3">

                            <label for="cancellationReason-@order.OrderId"
                                   class="form-label fw-semibold">

                                Cancellation Reason

                            </label>

                            <textarea name="cancellationReason"
                                      id="cancellationReason-@order.OrderId"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      required
                                      placeholder="Enter the reason for cancelling this order..."></textarea>

                            <div class="form-text">
                                Maximum 500 characters.
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Keep Order

                        </button>

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="fa-solid fa-ban me-1"></i>

                            Cancel Order

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

}

@section Scripts {

    <script>

        /* =========================================================
           REORDER DATA
           ========================================================= */

        const reorderConsumables =
            @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            consumablesNeedingOrder.Select(c => new
                            {
                                    id = c.ConsumableId,
                                    name = c.Name,
                                    supplierId = c.SupplierId,
                                    supplierName = c.Supplier != null
                                            ? c.Supplier.SupplierName
                                            : "Unknown Supplier",
                                    quantityOnHand = c.QuantityOnHand,
                                    reorderLevel = c.ReorderLevel,
                                    stockStatus = c.StockStatus.ToString()
                            })
                    )
            );

        /* =========================================================
           PAGE INITIALIZATION
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            initializeSearch();

            initializeCreateOrder();

            initializeCreateOrderDiagnostics();

        });

        /* =========================================================
           CREATE FORM DIAGNOSTICS
       
           IMPORTANT:
           This does NOT interfere with submission.
           It only writes information to the browser console.
           ========================================================= */

        function initializeCreateOrderDiagnostics() {

            const form =
                document.getElementById("createOrderForm");

            if (!form) {

                console.error(
                    "CREATE ORDER FORM NOT FOUND."
                );

                return;
            }

            console.log(
                "CREATE ORDER FORM FOUND."
            );

            console.log(
                "Create form action:",
                form.action
            );

            console.log(
                "Create form method:",
                form.method
            );

            form.addEventListener(
                "submit",
                function () {

                    console.log(
                        "CREATE ORDER FORM SUBMIT FIRED."
                    );

                    console.log(
                        "Submitting to:",
                        form.action
                    );

                    console.log(
                        "Method:",
                        form.method
                    );

                    const formData =
                        new FormData(form);

                    console.log(
                        "Create Order Form Data:"
                    );

                    for (const [key, value] of formData.entries()) {

                        console.log(
                            key + ":",
                            value
                        );

                    }

                    /*
                     * IMPORTANT:
                     *
                     * There is intentionally NO:
                     *
                     * event.preventDefault();
                     *
                     * The browser must continue with the
                     * normal POST request.
                     */

                }
            );

        }

        /* =========================================================
           SEARCH
           ========================================================= */

        function initializeSearch() {

            const input =
                document.getElementById("orderSearch");

            if (!input)
                return;

            input.addEventListener(
                "input",
                function () {

                    const search =
                        this.value.toLowerCase().trim();

                    const rows =
                        document.querySelectorAll(
                            "#ordersTableBody .order-row"
                        );

                    let visibleCount = 0;

                    rows.forEach(function (row) {

                        const order =
                            (row.dataset.order || "")
                                .toLowerCase();

                        const supplier =
                            (row.dataset.supplier || "")
                                .toLowerCase();

                        const status =
                            (row.dataset.status || "")
                                .toLowerCase();

                        const id =
                            (row.dataset.id || "")
                                .toLowerCase();

                        const matches =
                            order.includes(search) ||
                            supplier.includes(search) ||
                            status.includes(search) ||
                            id.includes(search);

                        row.style.display =
                            matches ? "" : "none";

                        if (matches)
                            visibleCount++;

                    });

                    const count =
                        document.getElementById(
                            "recordCount"
                        );

                    if (count) {

                        count.textContent =
                            visibleCount +
                            " order(s)";

                    }

                    const empty =
                        document.getElementById(
                            "noSearchResultsRow"
                        );

                    if (empty) {

                        empty.style.display =
                            rows.length > 0 &&
                            visibleCount === 0
                                ? ""
                                : "none";

                    }

                }
            );

        }

        /* =========================================================
           CREATE ORDER
           ========================================================= */

        function initializeCreateOrder() {

            const supplier =
                document.getElementById(
                    "createSupplierId"
                );

            const addButton =
                document.getElementById(
                    "addOrderItemBtn"
                );

            if (!supplier || !addButton)
                return;

            supplier.addEventListener(
                "change",
                function () {

                    resetItems();

                    const supplierId =
                        Number(this.value);

                    if (!supplierId) {

                        document
                            .getElementById(
                                "supplierRequiredMessage"
                            )
                            ?.classList.remove(
                                "d-none"
                            );

                        addButton.disabled = true;

                        return;
                    }

                    document
                        .getElementById(
                            "supplierRequiredMessage"
                        )
                        ?.classList.add(
                            "d-none"
                        );

                    const available =
                        getSupplierItems(
                            supplierId
                        );

                    if (available.length === 0) {

                        document
                            .getElementById(
                                "noSupplierConsumables"
                            )
                            ?.classList.remove(
                                "d-none"
                            );

                        addButton.disabled = true;

                        return;
                    }

                    document
                        .getElementById(
                            "noSupplierConsumables"
                        )
                        ?.classList.add(
                            "d-none"
                        );

                    addButton.disabled = false;

                    addItem();

                }
            );

            addButton.addEventListener(
                "click",
                function () {

                    if (!this.disabled)
                        addItem();

                }
            );

        }

        /* =========================================================
           GET SUPPLIER ITEMS
           ========================================================= */

        function getSupplierItems(supplierId) {

            return reorderConsumables.filter(
                function (item) {

                    return Number(item.supplierId) ===
                           Number(supplierId);

                }
            );

        }

        /* =========================================================
           RESET ITEMS
           ========================================================= */

        function resetItems() {

            const container =
                document.getElementById(
                    "orderItemsContainer"
                );

            if (container)
                container.innerHTML = "";

            document
                .getElementById(
                    "supplierRequiredMessage"
                )
                ?.classList.remove(
                    "d-none"
                );

            document
                .getElementById(
                    "noSupplierConsumables"
                )
                ?.classList.add(
                    "d-none"
                );

        }

        /* =========================================================
           ADD ITEM
           ========================================================= */

        function addItem() {

            const supplier =
                document.getElementById(
                    "createSupplierId"
                );

            if (!supplier)
                return;

            const supplierId =
                Number(supplier.value);

            if (!supplierId)
                return;

            const available =
                getSupplierItems(
                    supplierId
                );

            const container =
                document.getElementById(
                    "orderItemsContainer"
                );

            if (!container)
                return;

            const selectedIds =
                Array.from(
                    container.querySelectorAll(
                        ".order-consumable-select"
                    )
                )
                .map(function (select) {

                    return Number(select.value);

                })
                .filter(function (id) {

                    return id > 0;

                });

            const item =
                available.find(
                    function (x) {

                        return !selectedIds.includes(
                            Number(x.id)
                        );

                    }
                );

            if (!item)
                return;

            const index =
                container.querySelectorAll(
                    ".order-item-row"
                ).length;

            const quantity =
                Math.max(
                    1,
                    Number(item.reorderLevel) -
                    Number(item.quantityOnHand)
                );

            const row =
                document.createElement("div");

            row.className =
                "order-item-row border rounded p-3 mb-3";

            row.innerHTML = `

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Consumable
                        </label>

                        <select
                            name="Items[${index}].ConsumableId"
                            class="form-select order-consumable-select"
                            required>

                            <option value="">
                                -- Select Consumable --
                            </option>

                            ${available.map(function (x) {

                                const selected =
                                    Number(x.id) ===
                                    Number(item.id)
                                        ? "selected"
                                        : "";

                                const status =
                                    x.stockStatus === "OutOfStock"
                                        ? "Out of Stock"
                                        : "Reorder Now";

                                return `
                                    <option
                                        value="${x.id}"
                                        ${selected}>
                                        ${escapeHtml(x.name)}
                                        — ${status}
                                        — Stock: ${x.quantityOnHand}
                                    </option>
                                `;

                            }).join("")}

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Stock
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               value="${item.quantityOnHand}"
                               readonly />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Reorder Level
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               value="${item.reorderLevel}"
                               readonly />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Quantity
                        </label>

                        <input type="number"
                               name="Items[${index}].QuantityOrdered"
                               class="form-control order-quantity"
                               min="1"
                               value="${quantity}"
                               required />

                    </div>

                    <div class="col-12">

                        <div class="d-flex justify-content-between
                                    align-items-center
                                    bg-light
                                    rounded
                                    p-2">

                            <div class="small text-muted">

                                <i class="fa-solid fa-calculator me-1"></i>

                                Amount needed to reach reorder level:

                                <strong>
                                    ${quantity}
                                </strong>

                                unit(s)

                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-order-item">

                                <i class="fa-solid fa-trash me-1"></i>

                                Remove

                            </button>

                        </div>

                    </div>

                </div>

            `;

            container.appendChild(row);

            attachItemEvents();

            updateAddButton();

        }

        /* =========================================================
           ITEM EVENTS
           ========================================================= */

        function attachItemEvents() {

            document
                .querySelectorAll(
                    ".remove-order-item"
                )
                .forEach(function (button) {

                    if (button.dataset.bound === "true")
                        return;

                    button.dataset.bound = "true";

                    button.addEventListener(
                        "click",
                        function () {

                            const row =
                                this.closest(
                                    ".order-item-row"
                                );

                            if (row)
                                row.remove();

                            renumberItems();

                            updateAddButton();

                        }
                    );

                });

            document
                .querySelectorAll(
                    ".order-consumable-select"
                )
                .forEach(function (select) {

                    if (select.dataset.bound === "true")
                        return;

                    select.dataset.bound = "true";

                    select.addEventListener(
                        "change",
                        function () {

                            updateItemQuantity(
                                this
                            );

                        }
                    );

                });

        }

        /* =========================================================
           UPDATE ITEM QUANTITY
           ========================================================= */

        function updateItemQuantity(select) {

            const row =
                select.closest(
                    ".order-item-row"
                );

            if (!row)
                return;

            const item =
                reorderConsumables.find(
                    function (x) {

                        return Number(x.id) ===
                               Number(select.value);

                    }
                );

            if (!item)
                return;

            const quantity =
                Math.max(
                    1,
                    Number(item.reorderLevel) -
                    Number(item.quantityOnHand)
                );

            const readonlyInputs =
                row.querySelectorAll(
                    "input[readonly]"
                );

            const quantityInput =
                row.querySelector(
                    ".order-quantity"
                );

            if (readonlyInputs.length > 0)
                readonlyInputs[0].value =
                    item.quantityOnHand;

            if (readonlyInputs.length > 1)
                readonlyInputs[1].value =
                    item.reorderLevel;

            if (quantityInput)
                quantityInput.value =
                    quantity;

        }

        /* =========================================================
           RENUMBER ITEMS
           ========================================================= */

        function renumberItems() {

            const rows =
                document.querySelectorAll(
                    "#orderItemsContainer .order-item-row"
                );

            rows.forEach(
                function (row, index) {

                    const select =
                        row.querySelector(
                            ".order-consumable-select"
                        );

                    const quantity =
                        row.querySelector(
                            ".order-quantity"
                        );

                    if (select)
                        select.name =
                            `Items[${index}].ConsumableId`;

                    if (quantity)
                        quantity.name =
                            `Items[${index}].QuantityOrdered`;

                }
            );

        }

        /* =========================================================
           UPDATE ADD BUTTON
           ========================================================= */

        function updateAddButton() {

            const button =
                document.getElementById(
                    "addOrderItemBtn"
                );

            const supplier =
                document.getElementById(
                    "createSupplierId"
                );

            if (!button || !supplier)
                return;

            const supplierId =
                Number(supplier.value);

            if (!supplierId) {

                button.disabled = true;

                return;

            }

            const available =
                getSupplierItems(
                    supplierId
                );

            const selected =
                Array.from(
                    document.querySelectorAll(
                        ".order-consumable-select"
                    )
                )
                .map(function (select) {

                    return Number(select.value);

                })
                .filter(function (id) {

                    return id > 0;

                });

            button.disabled =
                selected.length >=
                available.length;

        }

        /* =========================================================
           CREATE MODAL RESET
           ========================================================= */

        document
            .getElementById(
                "createOrderModal"
            )
            ?.addEventListener(
                "hidden.bs.modal",
                function () {

                    const form =
                        document.getElementById(
                            "createOrderForm"
                        );

                    if (!form)
                        return;

                    form.reset();

                    resetItems();

                    document
                        .getElementById(
                            "supplierRequiredMessage"
                        )
                        ?.classList.remove(
                            "d-none"
                        );

                    const button =
                        document.getElementById(
                            "addOrderItemBtn"
                        );

                    if (button)
                        button.disabled = true;

                }
            );

        /* =========================================================
           ESCAPE HTML
           ========================================================= */

        function escapeHtml(value) {

            const div =
                document.createElement("div");

            div.textContent =
                value == null
                    ? ""
                    : String(value);

            return div.innerHTML;

        }

    </script>

}