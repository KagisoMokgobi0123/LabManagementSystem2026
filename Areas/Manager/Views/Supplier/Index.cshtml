@model IReadOnlyList<Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="page-header">
    <h4 class="page-title">Supplier</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Supplier</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Suppliers</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addRowModal">
                        <i class="fa fa-plus"></i> Add Supplier
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Supplier Name</th>
                                <th>Contacts</th>
                                <th>E-mail Address</th>
                                <th>Registered</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supplier in Model)
                            {
                                <tr>
                                    <td>@supplier.Name</td>
                                    <td>@supplier.ContactNumber</td>
                                    <td>@supplier.EmailAddress</td>
                                    <td>@supplier.CreatedDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (supplier.Status == SupplierStatus.Active)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-button-action">
                                            <button type="button" class="btn btn-link btn-primary btn-lg edit-supplier-btn"
                                                    data-id="@supplier.SupplierId" data-name="@supplier.Name" data-contact="@supplier.ContactNumber"
                                                    data-email="@supplier.EmailAddress" data-status="@supplier.Status"
                                                    data-toggle="modal" data-target="#editSupplierModal" title="Edit Supplier">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-danger remove-supplier-btn"
                                                    data-id="@supplier.SupplierId" data-name="@supplier.Name"
                                                    data-toggle="modal" data-target="#removeSupplierModal" title="Remove Supplier">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted">No suppliers added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD SUPPLIER MODAL -->
<div class="modal fade" id="addRowModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Supplier" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title"><span class="fw-mediumbold">Add</span> <span class="fw-light">Supplier</span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group form-group-default">
                        <label>Supplier Name</label>
                        <input name="Name" type="text" class="form-control" placeholder="Enter supplier name" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Contact Number</label>
                        <input name="ContactNumber" type="text" class="form-control" placeholder="Enter contact number" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Email Address</label>
                        <input name="EmailAddress" type="email" class="form-control" placeholder="Enter email address" />
                    </div>
                    <input type="hidden" name="Status" value="Active" />
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Add</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT SUPPLIER MODAL -->
<div class="modal fade" id="editSupplierModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Supplier" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Edit Supplier</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="SupplierId" id="editSupplierId" />
                    <div class="form-group form-group-default">
                        <label>Supplier Name</label>
                        <input name="Name" id="editSupplierName" type="text" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Contact Number</label>
                        <input name="ContactNumber" id="editSupplierContact" type="text" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Email Address</label>
                        <input name="EmailAddress" id="editSupplierEmail" type="email" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Status</label>
                        <select name="Status" id="editSupplierStatus" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVE SUPPLIER MODAL -->
<div class="modal fade" id="removeSupplierModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Supplier" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Remove Supplier</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="removeSupplierId" />
                    <p>Are you sure you want to remove <strong id="removeSupplierName"></strong>?</p>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-danger">Remove</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.edit-supplier-btn').on('click', function () {
                $('#editSupplierId').val($(this).data('id'));
                $('#editSupplierName').val($(this).data('name'));
                $('#editSupplierContact').val($(this).data('contact'));
                $('#editSupplierEmail').val($(this).data('email'));
                $('#editSupplierStatus').val($(this).data('status'));
            });
            $('.remove-supplier-btn').on('click', function () {
                $('#removeSupplierId').val($(this).data('id'));
                $('#removeSupplierName').text($(this).data('name'));
            });
        });
    </script>
}
