@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.SupplierModel>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-truck-medical text-primary me-2"></i>
                Suppliers
            </h4>

            <p class="text-muted mb-0">
                Manage laboratory consumable suppliers.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addSupplierModal">

            <i class="fa-solid fa-plus me-1"></i>
            Add Supplier

        </button>

    </div>


    <!-- =========================================================
         VALIDATION / SUCCESS MESSAGES
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Please correct the following errors:
            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- =========================================================
         SUPPLIERS TABLE
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h6 class="fw-bold mb-0">
                        Supplier List
                    </h6>

                    <small class="text-muted">
                        Active laboratory suppliers
                    </small>
                </div>

                <span class="badge bg-primary-subtle text-primary">
                    @Model.Count() supplier(s)
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Supplier</th>
                            <th>Contact Person</th>
                            <th>E-mail</th>
                            <th>Consumables</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var supplier in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @supplier.SupplierName
                                        </div>
                                    </td>


                                    <td>
                                        @supplier.ContactPerson
                                    </td>


                                    <td>
                                        <a href="mailto:@supplier.Email"
                                           class="text-decoration-none">

                                            @supplier.Email

                                        </a>
                                    </td>


                                    <td>

                                        <span class="badge bg-info-subtle text-info">

                                            @(supplier.Consumables?.Count ?? 0)

                                        </span>

                                    </td>


                                    <td class="text-end">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-info me-1"
                                                title="View supplier"
                                                data-bs-toggle="modal"
                                                data-bs-target="#viewSupplierModal"
                                                data-id="@supplier.SupplierId"
                                                data-name="@supplier.SupplierName"
                                                data-contact="@supplier.ContactPerson"
                                                data-email="@supplier.Email"
                                                data-consumables="@(supplier.Consumables?.Count ?? 0)">

                                            <i class="fa-solid fa-eye"></i>

                                        </button>


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary me-1"
                                                title="Edit supplier"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editSupplierModal"
                                                data-id="@supplier.SupplierId"
                                                data-name="@supplier.SupplierName"
                                                data-contact="@supplier.ContactPerson"
                                                data-email="@supplier.Email">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>


                                        <!-- DELETE -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete supplier"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteSupplierModal"
                                                data-id="@supplier.SupplierId"
                                                data-name="@supplier.SupplierName">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-truck-medical fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No suppliers found
                                        </div>

                                        <small>
                                            Add a supplier to begin managing laboratory supplies.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     ADD SUPPLIER MODAL
     ============================================================= -->

<div class="modal fade"
     id="addSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-plus text-primary me-2"></i>
                        Add Supplier
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label for="SupplierName"
                               class="form-label fw-semibold">
                            Supplier Name
                        </label>

                        <input type="text"
                               id="SupplierName"
                               name="SupplierName"
                               class="form-control"
                               maxlength="150"
                               required />

                        <div class="form-text">
                            Supplier name must be unique.
                        </div>

                    </div>


                    <div class="mb-3">

                        <label for="ContactPerson"
                               class="form-label fw-semibold">
                            Contact Person
                        </label>

                        <input type="text"
                               id="ContactPerson"
                               name="ContactPerson"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>


                    <div class="mb-3">

                        <label for="Email"
                               class="form-label fw-semibold">
                            E-mail Address
                        </label>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               maxlength="254"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-1"></i>
                        Save Supplier

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     VIEW SUPPLIER MODAL
     ============================================================= -->

<div class="modal fade"
     id="viewSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-circle-info text-info me-2"></i>
                    Supplier Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="mb-3">

                    <small class="text-muted d-block">
                        Supplier Name
                    </small>

                    <div id="viewSupplierName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Contact Person
                    </small>

                    <div id="viewSupplierContact"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        E-mail Address
                    </small>

                    <div id="viewSupplierEmail"
                         class="fw-semibold">
                    </div>

                </div>


                <div>

                    <small class="text-muted d-block">
                        Consumables Supplied
                    </small>

                    <div id="viewSupplierConsumables"
                         class="fw-semibold">
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     EDIT SUPPLIER MODAL
     ============================================================= -->

<div class="modal fade"
     id="editSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="editSupplierId"
                       name="SupplierId" />


                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-pen text-primary me-2"></i>
                        Edit Supplier

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label for="editSupplierName"
                               class="form-label fw-semibold">
                            Supplier Name
                        </label>

                        <input type="text"
                               id="editSupplierName"
                               name="SupplierName"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>


                    <div class="mb-3">

                        <label for="editContactPerson"
                               class="form-label fw-semibold">
                            Contact Person
                        </label>

                        <input type="text"
                               id="editContactPerson"
                               name="ContactPerson"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>


                    <div class="mb-3">

                        <label for="editEmail"
                               class="form-label fw-semibold">
                            E-mail Address
                        </label>

                        <input type="email"
                               id="editEmail"
                               name="Email"
                               class="form-control"
                               maxlength="254"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE SUPPLIER MODAL
     ============================================================= -->

<div class="modal fade"
     id="deleteSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteSupplierId"
                       name="id" />


                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-danger">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        Delete Supplier

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-2">
                        Are you sure you want to delete this supplier?
                    </p>

                    <div class="alert alert-warning mb-0">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        <strong id="deleteSupplierName"></strong>

                        <div class="small mt-1">
                            This will be a soft delete. The supplier will not
                            be permanently removed from the database.
                        </div>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Supplier

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               VIEW SUPPLIER
               ===================================================== */

            const viewModal =
                document.getElementById("viewSupplierModal");

            if (viewModal) {

                viewModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "viewSupplierName"
                        ).textContent =
                            button.dataset.name || "";

                        document.getElementById(
                            "viewSupplierContact"
                        ).textContent =
                            button.dataset.contact || "";

                        document.getElementById(
                            "viewSupplierEmail"
                        ).textContent =
                            button.dataset.email || "";

                        document.getElementById(
                            "viewSupplierConsumables"
                        ).textContent =
                            button.dataset.consumables || "0";
                    }
                );
            }


            /* =====================================================
               EDIT SUPPLIER
               ===================================================== */

            const editModal =
                document.getElementById("editSupplierModal");

            if (editModal) {

                editModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "editSupplierId"
                        ).value =
                            button.dataset.id || "";

                        document.getElementById(
                            "editSupplierName"
                        ).value =
                            button.dataset.name || "";

                        document.getElementById(
                            "editContactPerson"
                        ).value =
                            button.dataset.contact || "";

                        document.getElementById(
                            "editEmail"
                        ).value =
                            button.dataset.email || "";
                    }
                );
            }


            /* =====================================================
               DELETE SUPPLIER
               ===================================================== */

            const deleteModal =
                document.getElementById("deleteSupplierModal");

            if (deleteModal) {

                deleteModal.addEventListener(
                    "show.bs.modal",
                    function (event) {

                        const button =
                            event.relatedTarget;

                        if (!button)
                            return;

                        document.getElementById(
                            "deleteSupplierId"
                        ).value =
                            button.dataset.id || "";

                        document.getElementById(
                            "deleteSupplierName"
                        ).textContent =
                            button.dataset.name || "";
                    }
                );
            }

        });

    </script>
}
