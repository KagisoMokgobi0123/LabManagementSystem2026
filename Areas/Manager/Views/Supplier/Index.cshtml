@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.SupplierModel>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";
}

<div class="container-fluid py-4">


    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-truck-medical text-primary me-2"></i>
                Suppliers
            </h4>

            <p class="text-muted mb-0">
                Manage laboratory consumable suppliers.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addSupplierModal"
                onclick="openCreateSupplierModal()">

            <i class="fa-solid fa-plus me-1"></i>
            Add Supplier

        </button>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                Please correct the following errors:

            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- Table-->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <h6 class="fw-bold mb-0">
                        Supplier List
                    </h6>

                    <small class="text-muted">
                        Active laboratory suppliers
                    </small>

                </div>


                <div class="d-flex align-items-center gap-2">

                    <!-- SEARCH -->

                    <div class="input-group input-group-sm"
                         style="width:280px;">

                        <span class="input-group-text bg-white">

                            <i class="fa-solid fa-magnifying-glass text-muted"></i>

                        </span>

                        <input type="text"
                               id="supplierSearch"
                               class="form-control"
                               placeholder="Search suppliers..."
                               autocomplete="off" />

                    </div>


                    <!-- RECORD COUNT -->

                    <span class="badge bg-primary-subtle text-primary"
                          id="recordCount">

                        @Model.Count() supplier(s)

                    </span>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="suppliersTable">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Contact Person
                            </th>

                            <th>
                                E-mail
                            </th>

                            <th>
                                Consumables
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="suppliersTableBody">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var supplier in Model)
                            {
                                <tr class="supplier-row"
                                    data-name="@supplier.SupplierName"
                                    data-contact="@supplier.ContactPerson"
                                    data-email="@supplier.Email">

                 

                                    <td>

                                        <div class="fw-semibold">
                                            @supplier.SupplierName
                                        </div>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(supplier.ContactPerson))
                                        {
                                            @supplier.ContactPerson
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not provided
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(supplier.Email))
                                        {
                                            <a href="mailto:@supplier.Email"
                                                   class="text-decoration-none">

                                                @supplier.Email

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not provided
                                            </span>
                                        }

                                    </td>



                                    <td>

                                        <span class="badge bg-info-subtle text-info">

                                            @(supplier.Consumables?.Count ?? 0)

                                        </span>

                                    </td>


                            

                                    <td>

                                        <span class="badge bg-success">

                                            <i class="fa-solid fa-check me-1"></i>
                                            Active

                                        </span>

                                    </td>



                                    <td class="text-end">

                                        <div class="btn-group btn-group-sm"
                                             role="group">

                            

                                            <button type="button"
                                                    class="btn btn-outline-info"
                                                    title="View supplier"
                                                    onclick="viewSupplier(
                                                '@supplier.SupplierId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.SupplierName ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.ContactPerson ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.Email ?? ""))',
                                                '@(supplier.Consumables?.Count ?? 0)'
                                                )">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>


                                

                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit supplier"
                                                    onclick="editSupplier(
                                                '@supplier.SupplierId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.SupplierName ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.ContactPerson ?? ""))',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.Email ?? ""))'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>


                        

                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Delete supplier"
                                                    onclick="deleteSupplier(
                                                '@supplier.SupplierId',
                                                '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(supplier.SupplierName ?? ""))'
                                                )">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noSuppliersRow">

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-truck-medical fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No suppliers found
                                        </div>

                                        <small>
                                            Add a supplier to begin managing laboratory supplies.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }




                        <tr id="noSearchResultsRow"
                            style="display:none;">

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="fa-solid fa-magnifying-glass fa-2x mb-3"></i>

                                    <div class="fw-semibold">
                                        No matching suppliers found
                                    </div>

                                    <small>
                                        Try a different supplier, contact person, or email.
                                    </small>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Adding FOrm-->

<div class="modal fade"
     id="addSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="createSupplierForm"
                  method="post"
                  asp-controller="Supplier"
                  asp-action="Create">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-plus text-primary me-2"></i>

                        Add Supplier

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="createSupplierValidation"
                         class="alert alert-danger d-none">
                    </div>


     

                    <div class="mb-3">

                        <label for="SupplierName"
                               class="form-label fw-semibold">

                            Supplier Name

                        </label>

                        <input type="text"
                               id="SupplierName"
                               name="SupplierName"
                               class="form-control"
                               maxlength="150"
                               required />

                        <div class="form-text">
                            Supplier name must be unique.
                        </div>

                    </div>




                    <div class="mb-3">

                        <label for="ContactPerson"
                               class="form-label fw-semibold">

                            Contact Person

                        </label>

                        <input type="text"
                               id="ContactPerson"
                               name="ContactPerson"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>



                    <div class="mb-3">

                        <label for="Email"
                               class="form-label fw-semibold">

                            E-mail Address

                        </label>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               maxlength="254"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            id="createSupplierButton"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-1"></i>

                        <span>
                            Save Supplier
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- View -->

<div class="modal fade"
     id="viewSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-circle-info text-info me-2"></i>

                    Supplier Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="mb-3">

                    <small class="text-muted d-block">
                        Supplier Name
                    </small>

                    <div id="viewSupplierName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Contact Person
                    </small>

                    <div id="viewSupplierContact"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        E-mail Address
                    </small>

                    <div id="viewSupplierEmail"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Consumables Supplied
                    </small>

                    <div id="viewSupplierConsumables"
                         class="fw-semibold">
                    </div>

                </div>


                <div>

                    <small class="text-muted d-block">
                        Status
                    </small>

                    <span class="badge bg-success">

                        <i class="fa-solid fa-check me-1"></i>
                        Active

                    </span>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- edit-->

<div class="modal fade"
     id="editSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="editSupplierForm"
                  method="post"
                  asp-controller="Supplier"
                  asp-action="Edit">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="editSupplierId"
                       name="SupplierId" />


                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="fa-solid fa-pen text-primary me-2"></i>

                        Edit Supplier

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="editSupplierValidation"
                         class="alert alert-danger d-none">
                    </div>



                    <div class="mb-3">

                        <label for="editSupplierName"
                               class="form-label fw-semibold">

                            Supplier Name

                        </label>

                        <input type="text"
                               id="editSupplierName"
                               name="SupplierName"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>




                    <div class="mb-3">

                        <label for="editContactPerson"
                               class="form-label fw-semibold">

                            Contact Person

                        </label>

                        <input type="text"
                               id="editContactPerson"
                               name="ContactPerson"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>



                    <div class="mb-3">

                        <label for="editEmail"
                               class="form-label fw-semibold">

                            E-mail Address

                        </label>

                        <input type="email"
                               id="editEmail"
                               name="Email"
                               class="form-control"
                               maxlength="254"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            id="editSupplierButton"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk me-1"></i>

                        <span>
                            Save Changes
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Delete -->

<div class="modal fade"
     id="deleteSupplierModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="deleteSupplierForm"
                  method="post"
                  asp-controller="Supplier"
                  asp-action="DeleteConfirmed">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteSupplierId"
                       name="id" />


                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-danger">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>

                        Delete Supplier

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-2">
                        Are you sure you want to delete this supplier?
                    </p>

                    <div class="alert alert-warning mb-0">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        <strong id="deleteSupplierName"></strong>

                        <div class="small mt-1">

                            This will be a soft delete. The supplier will not
                            be permanently removed from the database.

                        </div>

                    </div>


                    <div id="deleteSupplierError"
                         class="alert alert-danger mt-3 d-none mb-0">
                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            id="deleteSupplierButton"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>

                        <span>
                            Delete Supplier
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>




<div class="modal fade"
     id="supplierSuccessModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header border-0">

                <h5 class="modal-title fw-bold text-success">

                    <i class="fa-solid fa-circle-check me-2"></i>

                    Success

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body text-center py-4">

                <div class="mb-3">

                    <div class="d-inline-flex
                        align-items-center
                        justify-content-center
                        rounded-circle
                        bg-success-subtle
                        text-success"
                         style="width:70px;height:70px;">

                        <i class="fa-solid fa-check fa-2x"></i>

                    </div>

                </div>


                <h6 class="fw-semibold mb-2">
                    Operation Successful
                </h6>


                <p id="supplierSuccessMessage"
                       class="text-muted mb-0">
                </p>

            </div>


            <div class="modal-footer border-0 justify-content-center">

                <button type="button"
                        class="btn btn-success px-4"
                        data-bs-dismiss="modal">

                    <i class="fa-solid fa-check me-1"></i>

                    OK

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            const createUrl =
                "@Url.Action("Create", "Supplier", new { area = "Manager" })";

            const editUrl =
                "@Url.Action("Edit", "Supplier", new { area = "Manager" })";

            const deleteUrl =
                "@Url.Action("DeleteConfirmed", "Supplier", new { area = "Manager" })";


            /* Success message*/

            function showSuccess(message) {

                document.getElementById(
                    "supplierSuccessMessage"
                ).textContent = message || "Operation successful.";

                const modal =
                    new bootstrap.Modal(
                        document.getElementById(
                            "supplierSuccessModal"
                        )
                    );

                modal.show();
            }


            /* Erro*/

            function showValidationErrors(
                container,
                errors) {

                if (!container)
                    return;

                container.innerHTML = "";

                if (!errors || errors.length === 0) {

                    container.classList.add("d-none");

                    return;
                }

                const ul =
                    document.createElement("ul");

                ul.className = "mb-0";

                errors.forEach(function (error) {

                    const li =
                        document.createElement("li");

                    li.textContent = error;

                    ul.appendChild(li);

                });

                container.appendChild(ul);

                container.classList.remove("d-none");
            }


            /* Create form*/

            window.openCreateSupplierModal =
                function () {

                    const form =
                        document.getElementById(
                            "createSupplierForm"
                        );

                    if (form)
                        form.reset();

                    const validation =
                        document.getElementById(
                            "createSupplierValidation"
                        );

                    if (validation)
                        validation.classList.add("d-none");
                };


            /* vIEW Details */

            window.viewSupplier =
                function (
                    id,
                    name,
                    contact,
                    email,
                    consumables) {

                    document.getElementById(
                        "viewSupplierName"
                    ).textContent = name || "";

                    document.getElementById(
                        "viewSupplierContact"
                    ).textContent =
                        contact || "Not provided";

                    document.getElementById(
                        "viewSupplierEmail"
                    ).textContent =
                        email || "Not provided";

                    document.getElementById(
                        "viewSupplierConsumables"
                    ).textContent =
                        consumables || "0";

                    new bootstrap.Modal(
                        document.getElementById(
                            "viewSupplierModal"
                        )
                    ).show();
                };


            /* Edit details poppig up */

            window.editSupplier =
                function (
                    id,
                    name,
                    contact,
                    email) {

                    document.getElementById(
                        "editSupplierId"
                    ).value = id;

                    document.getElementById(
                        "editSupplierName"
                    ).value = name || "";

                    document.getElementById(
                        "editContactPerson"
                    ).value = contact || "";

                    document.getElementById(
                        "editEmail"
                    ).value = email || "";

                    document.getElementById(
                        "editSupplierValidation"
                    ).classList.add("d-none");

                    new bootstrap.Modal(
                        document.getElementById(
                            "editSupplierModal"
                        )
                    ).show();
                };


            /* Delete form pop up */

            window.deleteSupplier =
                function (
                    id,
                    name) {

                    document.getElementById(
                        "deleteSupplierId"
                    ).value = id;

                    document.getElementById(
                        "deleteSupplierName"
                    ).textContent = name || "";

                    document.getElementById(
                        "deleteSupplierError"
                    ).classList.add("d-none");

                    new bootstrap.Modal(
                        document.getElementById(
                            "deleteSupplierModal"
                        )
                    ).show();
                };


            /* Searching */

            const searchInput =
                document.getElementById(
                    "supplierSearch"
                );

            if (searchInput) {

                searchInput.addEventListener(
                    "input",
                    function () {

                        const search =
                            this.value
                                .toLowerCase()
                                .trim();

                        const rows =
                            document.querySelectorAll(
                                "#suppliersTableBody .supplier-row"
                            );

                        let visibleCount = 0;

                        rows.forEach(function (row) {

                            const name =
                                (
                                    row.dataset.name || ""
                                ).toLowerCase();

                            const contact =
                                (
                                    row.dataset.contact || ""
                                ).toLowerCase();

                            const email =
                                (
                                    row.dataset.email || ""
                                ).toLowerCase();

                            const matches =
                                name.includes(search) ||
                                contact.includes(search) ||
                                email.includes(search);

                            row.style.display =
                                matches ? "" : "none";

                            if (matches)
                                visibleCount++;

                        });


                        document.getElementById(
                            "recordCount"
                        ).innerText =
                            visibleCount + " supplier(s)";


                        const noSearchResults =
                            document.getElementById(
                                "noSearchResultsRow"
                            );

                        if (noSearchResults) {

                            noSearchResults.style.display =
                                rows.length > 0 &&
                                visibleCount === 0
                                    ? ""
                                    : "none";
                        }

                    }
                );
            }


            /* Create*/

            const createForm =
                document.getElementById(
                    "createSupplierForm"
                );

            if (createForm) {

                createForm.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();

                        const button =
                            document.getElementById(
                                "createSupplierButton"
                            );

                        const validation =
                            document.getElementById(
                                "createSupplierValidation"
                            );

                        validation.classList.add("d-none");

                        button.disabled = true;

                        try {

                            const response =
                                await fetch(
                                    createUrl,
                                    {
                                        method: "POST",
                                        body:
                                            new FormData(createForm),
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );

                            const contentType =
                                response.headers.get(
                                    "content-type"
                                ) || "";


                            if (contentType.includes(
                                "application/json")) {

                                const result =
                                    await response.json();

                                if (result.success) {

                                    bootstrap.Modal
                                        .getInstance(
                                            document.getElementById(
                                                "addSupplierModal"
                                            )
                                        )
                                        ?.hide();

                                    showSuccess(
                                        result.message
                                    );

                                    setTimeout(
                                        function () {
                                            location.reload();
                                        },
                                        800
                                    );

                                }
                                else {

                                    showValidationErrors(
                                        validation,
                                        [
                                            result.message ||
                                            "Unable to add supplier."
                                        ]
                                    );

                                }

                            }
                            else {

                                const html =
                                    await response.text();

                                validation.innerHTML =
                                    "Unable to add supplier. Please check the entered information.";

                                validation.classList.remove(
                                    "d-none"
                                );
                            }

                        }
                        catch (error) {

                            showValidationErrors(
                                validation,
                                [
                                    "An unexpected error occurred while adding the supplier."
                                ]
                            );

                        }
                        finally {

                            button.disabled = false;

                        }

                    }
                );
            }



            const editForm =
                document.getElementById(
                    "editSupplierForm"
                );

            if (editForm) {

                editForm.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();

                        const button =
                            document.getElementById(
                                "editSupplierButton"
                            );

                        const validation =
                            document.getElementById(
                                "editSupplierValidation"
                            );

                        validation.classList.add("d-none");

                        button.disabled = true;

                        try {

                            const id =
                                document.getElementById(
                                    "editSupplierId"
                                ).value;

                            const response =
                                await fetch(
                                    editUrl +
                                    "?id=" +
                                    encodeURIComponent(id),
                                    {
                                        method: "POST",
                                        body:
                                            new FormData(editForm),
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );


                            const contentType =
                                response.headers.get(
                                    "content-type"
                                ) || "";


                            if (contentType.includes(
                                "application/json")) {

                                const result =
                                    await response.json();

                                if (result.success) {

                                    bootstrap.Modal
                                        .getInstance(
                                            document.getElementById(
                                                "editSupplierModal"
                                            )
                                        )
                                        ?.hide();

                                    showSuccess(
                                        result.message
                                    );

                                    setTimeout(
                                        function () {
                                            location.reload();
                                        },
                                        800
                                    );

                                }
                                else {

                                    showValidationErrors(
                                        validation,
                                        [
                                            result.message ||
                                            "Unable to update supplier."
                                        ]
                                    );

                                }

                            }
                            else {

                                validation.innerHTML =
                                    "Unable to update supplier. Please check the entered information.";

                                validation.classList.remove(
                                    "d-none"
                                );
                            }

                        }
                        catch (error) {

                            showValidationErrors(
                                validation,
                                [
                                    "An unexpected error occurred while updating the supplier."
                                ]
                            );

                        }
                        finally {

                            button.disabled = false;

                        }

                    }
                );
            }


            const deleteForm =
                document.getElementById(
                    "deleteSupplierForm"
                );

            if (deleteForm) {

                deleteForm.addEventListener(
                    "submit",
                    async function (event) {

                        event.preventDefault();

                        const button =
                            document.getElementById(
                                "deleteSupplierButton"
                            );

                        const errorBox =
                            document.getElementById(
                                "deleteSupplierError"
                            );

                        errorBox.classList.add(
                            "d-none"
                        );

                        button.disabled = true;

                        try {

                            const response =
                                await fetch(
                                    deleteUrl,
                                    {
                                        method: "POST",
                                        body:
                                            new FormData(deleteForm),
                                        headers: {
                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );


                            const result =
                                await response.json();


                            if (result.success) {

                                bootstrap.Modal
                                    .getInstance(
                                        document.getElementById(
                                            "deleteSupplierModal"
                                        )
                                    )
                                    ?.hide();

                                showSuccess(
                                    result.message
                                );

                                setTimeout(
                                    function () {
                                        location.reload();
                                    },
                                    800
                                );

                            }
                            else {

                                errorBox.textContent =
                                    result.message ||
                                    "Unable to delete supplier.";

                                errorBox.classList.remove(
                                    "d-none"
                                );

                            }

                        }
                        catch (error) {

                            errorBox.textContent =
                                "An unexpected error occurred while deleting the supplier.";

                            errorBox.classList.remove(
                                "d-none"
                            );

                        }
                        finally {

                            button.disabled = false;

                        }

                    }
                );
            }

        });

    </script>
}
