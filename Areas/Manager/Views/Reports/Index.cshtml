@model NMB_HLabSys.Areas.Manager.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <h4 class="page-title">Reports</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Reports</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Filter Report</h4>
            </div>
            <div class="card-body">
                <form asp-area="Manager" asp-controller="Reports" asp-action="Index" method="get" class="form-inline">
                    <div class="form-group form-group-default mr-3">
                        <label class="mr-2">Start Date</label>
                        <input type="date" name="startDate" id="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="form-group form-group-default mr-3">
                        <label class="mr-2">End Date</label>
                        <input type="date" name="endDate" id="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" id="applyFilter" class="btn btn-primary">Apply Filter</button>
                    <button type="button" id="printReportBtn" class="btn btn-secondary ml-2" onclick="window.print()">Print</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="reportContent">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Orders by Category</h4></div>
            <div class="card-body">
                <canvas id="categoryChart" height="260"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Order Detail</h4></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Consumable</th>
                                <th>Category</th>
                                <th>Qty Ordered</th>
                                <th>Qty Delivered</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody">
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@row.ConsumableName</td>
                                    <td>@row.CategoryName</td>
                                    <td>@row.QuantityOrdered</td>
                                    <td>@row.QuantityDelivered</td>
                                    <td>@row.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@row.Status</td>
                                </tr>
                            }
                            @if (!Model.Rows.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted">No data for the selected period.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/plugin/chart.js/chart.min.js"></script>
    <script>
        var categoryLabels = @Html.Raw(Json.Serialize(Model.CategoryTotals.Keys));
        var categoryValues = @Html.Raw(Json.Serialize(Model.CategoryTotals.Values));

        var ctx = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryValues,
                    backgroundColor: ['#1572E8', '#4CAF50', '#FFC107', '#F44336', '#9C27B0', '#00BCD4']
                }]
            }
        });
    </script>
}
