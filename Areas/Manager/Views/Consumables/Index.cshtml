@model IReadOnlyList<Consumable>
@{
    ViewData["Title"] = "Consumables";
    var categories = ViewBag.Categories as IReadOnlyList<Category>;
}

<div class="page-header">
    <h4 class="page-title">Consumables</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Consumables</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Consumables</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addConsumableModal">
                        <i class="fa fa-plus"></i> Add Consumable
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Date Added</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consumable in Model)
                            {
                                <tr>
                                    <td>@consumable.Name</td>
                                    <td>@consumable.Description</td>
                                    <td>@consumable.DateAdded.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (consumable.Status == ConsumableStatus.Active)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-button-action">
                                            <button type="button" class="btn btn-link btn-primary btn-lg edit-consumable-btn"
                                                    data-id="@consumable.ConsumableId" data-name="@consumable.Name" data-description="@consumable.Description"
                                                    data-status="@consumable.Status" data-toggle="modal" data-target="#editConsumableModal"
                                                    title="Edit Consumable">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-danger remove-consumable-btn"
                                                    data-id="@consumable.ConsumableId" data-name="@consumable.Name"
                                                    data-toggle="modal" data-target="#removeConsumableModal" title="Remove Consumable">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No consumables added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD CONSUMABLE MODAL -->
<div class="modal fade" id="addConsumableModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Consumables" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title"><span class="fw-mediumbold">Add</span> <span class="fw-light">Consumable</span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group form-group-default">
                        <label>Consumable Name</label>
                        <input name="Name" type="text" class="form-control" placeholder="Enter consumable name" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" type="text" class="form-control" placeholder="Enter description" />
                    </div>
                    @* <div class="form-group form-group-default">
                        <label>Category</label>
                        <select name="CategoryId" class="form-control">
                            <option value="">Select Category</option>
                            @if (categories != null)
                            {
                                foreach (var category in categories)
                                {
                                    <option value="@category.CategoryId">@category.Name</option>
                                }
                            }
                        </select>
                    </div> *@
                    <input type="hidden" name="Status" value="Active" />
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Add</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT CONSUMABLE MODAL -->
<div class="modal fade" id="editConsumableModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Consumables" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Edit Consumable</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ConsumableId" id="editConsumableId" />
                    <div class="form-group form-group-default">
                        <label>Consumable Name</label>
                        <input name="Name" id="editConsumableName" type="text" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" id="editConsumableDescription" type="text" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Status</label>
                        <select name="Status" id="editConsumableStatus" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVE CONSUMABLE MODAL -->
<div class="modal fade" id="removeConsumableModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Consumables" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Remove Consumable</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="removeConsumableId" />
                    <p>Are you sure you want to remove <strong id="removeConsumableName"></strong>?</p>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-danger">Remove</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.edit-consumable-btn').on('click', function () {
                $('#editConsumableId').val($(this).data('id'));
                $('#editConsumableName').val($(this).data('name'));
                $('#editConsumableDescription').val($(this).data('description'));
                $('#editConsumableStatus').val($(this).data('status'));
            });
            $('.remove-consumable-btn').on('click', function () {
                $('#removeConsumableId').val($(this).data('id'));
                $('#removeConsumableName').text($(this).data('name'));
            });
        });
    </script>
}
