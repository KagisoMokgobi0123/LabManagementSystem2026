@model IReadOnlyList<NMB_HLabSys.Areas.Manager.Models.CalendarEvent>
@{
    ViewData["Title"] = "Calendar";
}

<div class="page-header">
    <h4 class="page-title">Calendar</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Calendar</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Inventory Calendar</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#eventModal">
                        <i class="fa fa-plus"></i> Add Event
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover" id="inventoryCalendar">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Date</th>
                                <th>Colour</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in Model)
                            {
                                <tr>
                                    <td>@evt.Title</td>
                                    <td>@evt.EventDate.ToString("yyyy/MM/dd")</td>
                                    <td><span class="badge badge-@evt.Color">@evt.Color</span></td>
                                    <td>
                                        <div class="form-button-action">
                                            <button type="button" class="btn btn-link btn-primary btn-lg edit-event-btn"
                                                    data-id="@evt.CalenderId" data-title="@evt.Title" data-date="@evt.EventDate.ToString("yyyy-MM-dd")"
                                                    data-color="@evt.Color" data-toggle="modal" data-target="#eventModal" title="Edit Event">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <form asp-area="Manager" asp-controller="Calendar" asp-action="Delete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@evt.CalenderId" />
                                                <button type="submit" id="deleteEventBtn" class="btn btn-link btn-danger" title="Delete Event">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted">No events scheduled yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD/EDIT EVENT MODAL -->
<div class="modal fade" id="eventModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Calendar" asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Calendar Event</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="CalenderId" id="eventId" value="0" />
                    <div class="form-group form-group-default">
                        <label>Title</label>
                        <input name="Title" id="eventTitle" type="text" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Date</label>
                        <input name="EventDate" id="eventDate" type="date" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Colour</label>
                        <select name="Color" id="eventColor" class="form-control">
                            <option value="primary">Blue</option>
                            <option value="success">Green</option>
                            <option value="warning">Yellow</option>
                            <option value="danger">Red</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" id="saveEventBtn" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#eventModal').on('show.bs.modal', function (e) {
                if (!$(e.relatedTarget).hasClass('edit-event-btn')) {
                    $('#eventId').val(0);
                    $('#eventTitle').val('');
                    $('#eventDate').val('');
                    $('#eventColor').val('primary');
                }
            });
            $('.edit-event-btn').on('click', function () {
                $('#eventId').val($(this).data('id'));
                $('#eventTitle').val($(this).data('title'));
                $('#eventDate').val($(this).data('date'));
                $('#eventColor').val($(this).data('color'));
            });
        });
    </script>
}
