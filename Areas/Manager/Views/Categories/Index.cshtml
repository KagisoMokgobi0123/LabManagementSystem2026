@model IReadOnlyList<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <h4 class="page-title">Categories</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Categories</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Categories</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addCategoryModal">
                        <i class="fa fa-plus"></i> Add Category
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Date Created</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.Name</td>
                                    <td>@category.Description</td>
                                    <td>@category.DateCreated.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (category.Status == CategoryStatus.Active)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-button-action">
                                            <button type="button" class="btn btn-link btn-primary btn-lg edit-category-btn"
                                                    data-id="@category.CategoryId" data-name="@category.Name" data-description="@category.Description"
                                                    data-status="@category.Status" data-toggle="modal" data-target="#editCategoryModal"
                                                    title="Edit Category">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-danger remove-category-btn"
                                                    data-id="@category.CategoryId" data-name="@category.Name"
                                                    data-toggle="modal" data-target="#removeCategoryModal" title="Remove Category">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No categories added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD CATEGORY MODAL -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Categories" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title"><span class="fw-mediumbold">Add</span> <span class="fw-light">Category</span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p class="small">Create a new category</p>
                    <div class="form-group form-group-default">
                        <label>Category Name</label>
                        <input name="Name" type="text" class="form-control" placeholder="Enter category name" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" type="text" class="form-control" placeholder="Enter description" />
                    </div>
                    <input type="hidden" name="Status" value="Active" />
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Add</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Categories" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Edit Category</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="CategoryId" id="editCategoryId" />
                    <div class="form-group form-group-default">
                        <label>Category Name</label>
                        <input name="Name" id="editCategoryName" type="text" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" id="editCategoryDescription" type="text" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Status</label>
                        <select name="Status" id="editCategoryStatus" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVE CATEGORY MODAL -->
<div class="modal fade" id="removeCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="Categories" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Remove Category</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="removeCategoryId" />
                    <p>Are you sure you want to remove <strong id="removeCategoryName"></strong>?</p>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-danger">Remove</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.edit-category-btn').on('click', function () {
                $('#editCategoryId').val($(this).data('id'));
                $('#editCategoryName').val($(this).data('name'));
                $('#editCategoryDescription').val($(this).data('description'));
                $('#editCategoryStatus').val($(this).data('status'));
            });
            $('.remove-category-btn').on('click', function () {
                $('#removeCategoryId').val($(this).data('id'));
                $('#removeCategoryName').text($(this).data('name'));
            });
        });
    </script>
}
