@model IEnumerable<NMB_HLabSys.Areas.Manager.Models.TechnicianTestTypeModel>

@using NMB_HLabSys.Models.Identity
@using NMB_HLabSys.Areas.Manager.Models

@{
    ViewData["Title"] = "Technician Test Type Assignments";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";

    var technicians =
        ViewBag.Technicians as IEnumerable<ApplicationUser>
        ?? Enumerable.Empty<ApplicationUser>();

    var testTypes =
        ViewBag.TestTypes as IEnumerable<TestTypeModel>
        ?? Enumerable.Empty<TestTypeModel>();

    var assignments =
        Model?.ToList()
        ?? new List<TechnicianTestTypeModel>();


    var assignmentsByTechnician =
        assignments
            .Where(a =>
                a.IsActive &&
                !string.IsNullOrWhiteSpace(a.TechnicianId))
            .GroupBy(a => a.TechnicianId)
            .ToDictionary(
                g => g.Key!,
                g => g.ToList());

    var techniciansWithAssignments =
        technicians.Count(t =>
            assignmentsByTechnician.ContainsKey(t.Id));

    var techniciansWithoutAssignments =
        technicians.Count(t =>
            !assignmentsByTechnician.ContainsKey(t.Id));

    var totalActiveAssignments =
        assignments.Count(a => a.IsActive);

    var totalTechnicians =
        technicians.Count();

    var initialRecordCount =
        totalTechnicians;
}

<div class="container-fluid py-4">



    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>

            <h4 class="fw-bold mb-1">

                <i class="fa-solid fa-user-check text-primary me-2"></i>

                Technician Test Type Assignments

            </h4>

            <p class="text-muted mb-0">

                Assign laboratory test types to technicians and
                ensure every active technician has at least one
                permitted test type.

            </p>

        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#technicianTestTypeModal"
                onclick="openCreateModal()">

            <i class="fa-solid fa-plus me-1"></i>

            Assign Test Type

        </button>

    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div class="fw-semibold mb-2">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                Please correct the following errors:

            </div>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- Small summary Cards -->

    <div class="row g-3 mb-4">

        <!-- TOTAL TECHNICIANS -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Active Technicians
                            </div>

                            <div class="fs-3 fw-bold">
                                @totalTechnicians
                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="fa-solid fa-users"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ASSIGNED -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                With Test Types
                            </div>

                            <div class="fs-3 fw-bold text-success">
                                @techniciansWithAssignments
                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-success-subtle
                            text-success
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="fa-solid fa-user-check"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- NEEDS ASSIGNMENT -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Needs Assignment
                            </div>

                            <div class="fs-3 fw-bold
                                @(techniciansWithoutAssignments > 0
                                     ? "text-danger"
                                     : "text-success")">

                                @techniciansWithoutAssignments

                            </div>

                        </div>

                        <div class="rounded-circle
                            @(techniciansWithoutAssignments > 0
                                 ? "bg-danger-subtle text-danger"
                                 : "bg-success-subtle text-success")
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="fa-solid
                                @(techniciansWithoutAssignments > 0
                                   ? "fa-triangle-exclamation"
                                   : "fa-check")">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ASSIGNMENTS -->

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Active Assignments
                            </div>

                            <div class="fs-3 fw-bold text-info">
                                @totalActiveAssignments
                            </div>

                        </div>

                        <div class="rounded-circle
                            bg-info-subtle
                            text-info
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="fa-solid fa-list-check"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Required information -->
    @if (techniciansWithoutAssignments > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm">

            <div class="d-flex">

                <i class="fa-solid fa-triangle-exclamation mt-1 me-3"></i>

                <div>

                    <div class="fw-semibold">

                        Technician test type assignments require attention

                    </div>

                    <div class="small">

                        <strong>
                            @techniciansWithoutAssignments
                        </strong>

                        active technician(s) currently have no assigned
                        test types. Each technician must have at least
                        one active test type assignment.

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- Table -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <h6 class="fw-bold mb-0">

                        Technician Test Type Assignments

                    </h6>

                    <small class="text-muted">

                        Every active technician is displayed,
                        including technicians requiring an assignment.

                    </small>

                </div>


                <div class="d-flex flex-wrap align-items-center gap-2">

                    <!-- SEARCH -->

                    <div class="input-group input-group-sm"
                         style="width:320px;">

                        <span class="input-group-text bg-white">

                            <i class="fa-solid fa-magnifying-glass text-muted"></i>

                        </span>

                        <input type="text"
                               id="technicianTestTypeSearch"
                               class="form-control"
                               placeholder="Search technician, test type, manager or status..."
                               autocomplete="off" />

                    </div>


                    <!-- RECORD COUNT -->

                    <span class="badge bg-primary-subtle text-primary"
                          id="recordCount">

                        @initialRecordCount technician(s)

                    </span>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="technicianTestTypesTable">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Technician
                            </th>

                            <th>
                                Test Type
                            </th>

                            <th>
                                Assigned By
                            </th>

                            <th>
                                Assigned Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="technicianTestTypesTableBody">

                        @if (technicians.Any())
                        {
                            foreach (var technician in technicians)
                            {
                                var hasAssignments =
                                    assignmentsByTechnician.TryGetValue(
                                        technician.Id,
                                        out var technicianAssignments);

        
                                if (!hasAssignments ||
                                    technicianAssignments == null ||
                                    !technicianAssignments.Any())
                                {
                                    var technicianName =
                                        !string.IsNullOrWhiteSpace(
                                            technician.FullName)
                                            ? technician.FullName
                                            : technician.UserName
                                                ?? "Unknown Technician";

                                    var encodedTechnicianName =
                                        System.Text.Encodings.Web
                                            .JavaScriptEncoder
                                            .Default
                                            .Encode(technicianName);

                                    <tr class="technician-test-type-row"
                                        data-technician="@technicianName"
                                        data-testtype=""
                                        data-manager=""
                                        data-status="Needs Assignment">

                                        <!-- TECHNICIAN -->

                                        <td>

                                            <div class="fw-semibold">

                                                @technicianName

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                technician.UserName))
                                            {
                                                <small class="text-muted">

                                                    @technician.UserName

                                                </small>
                                            }

                                        </td>


                                        <!-- TEST TYPE -->

                                        <td>

                                            <span class="badge
                                                bg-warning-subtle
                                                text-warning-emphasis">

                                                <i class="fa-solid
                                                    fa-triangle-exclamation
                                                    me-1">
                                                </i>

                                                No test types assigned

                                            </span>

                                        </td>


                                        <!-- ASSIGNED BY -->

                                        <td>

                                            <span class="text-muted">
                                                —
                                            </span>

                                        </td>


                                        <!-- ASSIGNED DATE -->

                                        <td>

                                            <span class="text-muted">
                                                —
                                            </span>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <span class="badge bg-danger">

                                                <i class="fa-solid
                                                    fa-circle-exclamation
                                                    me-1">
                                                </i>

                                                Needs Assignment

                                            </span>

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="text-end">

                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    title="Assign test type"
                                                    onclick="openCreateModalForTechnician(
                                                '@technician.Id',
                                                '@Html.Raw(encodedTechnicianName)'
                                                )">

                                                <i class="fa-solid fa-plus me-1"></i>

                                                Assign

                                            </button>

                                        </td>

                                    </tr>

                                    continue;
                                }


  

                                foreach (var assignment in technicianAssignments)
                                {
                                    var technicianName =
                                        !string.IsNullOrWhiteSpace(
                                            technician.FullName)
                                            ? technician.FullName
                                            : technician.UserName
                                                ?? "Unknown Technician";

                                    var testTypeName =
                                        assignment.TestType?.Name
                                        ?? "Unknown Test Type";

                                    var managerName =
                                        assignment.Manager?.UserName
                                        ?? "Unknown Manager";

                                    var status =
                                        assignment.IsActive
                                            ? "Active"
                                            : "Inactive";

                                    var encodedTechnicianName =
                                        System.Text.Encodings.Web
                                            .JavaScriptEncoder
                                            .Default
                                            .Encode(technicianName);

                                    var encodedTestTypeName =
                                        System.Text.Encodings.Web
                                            .JavaScriptEncoder
                                            .Default
                                            .Encode(testTypeName);

                                    var encodedManagerName =
                                        System.Text.Encodings.Web
                                            .JavaScriptEncoder
                                            .Default
                                            .Encode(managerName);

                                    var encodedStatus =
                                        System.Text.Encodings.Web
                                            .JavaScriptEncoder
                                            .Default
                                            .Encode(status);

                                    <tr class="technician-test-type-row"
                                        data-technician="@technicianName"
                                        data-testtype="@testTypeName"
                                        data-manager="@managerName"
                                        data-status="@status">

                                        <!-- TECHNICIAN -->

                                        <td>

                                            <div class="fw-semibold">

                                                @technicianName

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                technician.UserName))
                                            {
                                                <small class="text-muted">

                                                    @technician.UserName

                                                </small>
                                            }

                                        </td>


                                        <!-- TEST TYPE -->

                                        <td>

                                            <div class="fw-semibold">

                                                @testTypeName

                                            </div>

                                        </td>


                                        <!-- ASSIGNED BY -->

                                        <td>

                                            <span class="text-muted">

                                                @managerName

                                            </span>

                                        </td>


                                        <!-- ASSIGNED DATE -->

                                        <td>

                                            <span class="text-muted">

                                                @assignment.AssignedDate.ToString(
                                                    "dd MMM yyyy HH:mm")

                                            </span>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <span class="badge bg-success">

                                                <i class="fa-solid
                                                    fa-check
                                                    me-1">
                                                </i>

                                                Active

                                            </span>

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="text-end">

                                            <div class="btn-group btn-group-sm"
                                                 role="group">

                                                <!-- VIEW -->

                                                <button type="button"
                                                        class="btn btn-outline-info"
                                                        title="View assignment"
                                                        onclick="viewTechnicianTestType(
                                                    '@assignment.TechnicianTestTypeId',
                                                    '@Html.Raw(encodedTechnicianName)',
                                                    '@Html.Raw(encodedTestTypeName)',
                                                    '@Html.Raw(encodedManagerName)',
                                                    '@assignment.AssignedDate.ToString("dd MMM yyyy HH:mm")',
                                                    '@Html.Raw(encodedStatus)'
                                                    )">

                                                    <i class="fa-solid fa-eye"></i>

                                                </button>


                                                <!-- EDIT -->

                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        title="Edit assignment"
                                                        onclick="editTechnicianTestType(
                                                    '@assignment.TechnicianTestTypeId',
                                                    '@assignment.TechnicianId',
                                                    '@assignment.TestTypeId'
                                                    )">

                                                    <i class="fa-solid fa-pen"></i>

                                                </button>


                                                <!-- DELETE -->

                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        title="Deactivate assignment"
                                                        onclick="deleteTechnicianTestType(
                                                    '@assignment.TechnicianTestTypeId',
                                                    '@Html.Raw(encodedTechnicianName)',
                                                    '@Html.Raw(encodedTestTypeName)'
                                                    )">

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-users fa-2x mb-3"></i>

                                        <div class="fw-semibold">

                                            No active technicians found

                                        </div>

                                        <small>

                                            There are currently no active
                                            technicians available for
                                            test-type assignment.

                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }


                        <tr id="noSearchResultsRow"
                            style="display:none;">

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="fa-solid
                                        fa-magnifying-glass
                                        fa-2x
                                        mb-3">
                                    </i>

                                    <div class="fw-semibold">

                                        No matching technicians found

                                    </div>

                                    <small>

                                        Try a different technician,
                                        test type, manager, or status.

                                    </small>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Add form -->

<div class="modal fade"
     id="technicianTestTypeModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="technicianTestTypeForm"
                  method="post"
                  asp-area="Manager"
                  asp-controller="TechnicianTestType"
                  asp-action="Create">

                @Html.AntiForgeryToken()


                <!-- HEADER -->

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="technicianTestTypeModalTitle">

                        <i class="fa-solid fa-plus text-primary me-2"></i>

                        Assign Test Type

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body">

                    <input type="hidden"
                           id="TechnicianTestTypeId"
                           name="TechnicianTestTypeId"
                           value="0" />


                    <!-- TECHNICIAN -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="TechnicianId">

                            Technician

                        </label>

                        <select id="TechnicianId"
                                name="TechnicianId"
                                class="form-select"
                                required>

                            <option value="">
                                Select technician
                            </option>

                            @foreach (var technician in technicians)
                            {
                                <option value="@technician.Id">

                                    @technician.FullName
                                    (@technician.UserName)

                                </option>
                            }

                        </select>

                        <div class="form-text">

                            Select the active technician who will
                            receive this test type assignment.

                        </div>

                    </div>


                    <!-- TEST TYPE -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold"
                               for="TestTypeId">

                            Test Type

                        </label>

                        <select id="TestTypeId"
                                name="TestTypeId"
                                class="form-select"
                                required>

                            <option value="">
                                Select test type
                            </option>

                            @foreach (var testType in testTypes)
                            {
                                <option value="@testType.TestTypeId">

                                    @testType.Name

                                </option>
                            }

                        </select>

                        <div class="form-text">

                            Select the active laboratory test type
                            to assign.

                        </div>

                    </div>


                    <!-- INFORMATION -->

                    <div class="alert alert-light border mb-0">

                        <i class="fa-solid
                            fa-circle-info
                            text-info
                            me-2">
                        </i>

                        The currently authenticated Manager will be
                        recorded as the person making this assignment.

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-1"></i>

                        <span id="saveButtonText">
                            Assign Test Type
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>




<div class="modal fade"
     id="viewTechnicianTestTypeModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid
                        fa-circle-info
                        text-info
                        me-2">
                    </i>

                    Assignment Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="mb-3">

                    <small class="text-muted d-block">
                        Technician
                    </small>

                    <div id="viewTechnicianName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Test Type
                    </small>

                    <div id="viewTestTypeName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Assigned By
                    </small>

                    <div id="viewManagerName"
                         class="fw-semibold">
                    </div>

                </div>


                <div class="mb-3">

                    <small class="text-muted d-block">
                        Assigned Date
                    </small>

                    <div id="viewAssignedDate"
                         class="fw-semibold">
                    </div>

                </div>


                <div>

                    <small class="text-muted d-block">
                        Status
                    </small>

                    <div id="viewAssignmentStatus"
                         class="fw-semibold">
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>



<div class="modal fade"
     id="deleteTechnicianTestTypeModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="deleteTechnicianTestTypeForm"
                  method="post"
                  action="@Url.Action(
                                        "Delete",
                                        "TechnicianTestType",
                                        new { area = "Manager" })">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="deleteTechnicianTestTypeId"
                       name="id"
                       value="" />


                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-danger">

                        <i class="fa-solid
                            fa-triangle-exclamation
                            me-2">
                        </i>

                        Deactivate Assignment

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p>

                        Are you sure you want to deactivate this
                        technician test type assignment?

                    </p>


                    <div class="alert alert-warning mb-0">

                        <i class="fa-solid
                            fa-circle-info
                            me-2">
                        </i>

                        <strong id="deleteAssignmentName"></strong>

                        <div class="small mt-1">

                            This is a soft delete. The assignment will
                            be marked as inactive instead of being
                            permanently removed from the database.

                        </div>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-trash me-1"></i>

                        Deactivate Assignment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!--Pop up success message-->
@if (TempData["SuccessMessage"] != null)
{
    <div class="modal fade"
         id="successMessageModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-success">

                        <i class="fa-solid
                            fa-circle-check
                            me-2">
                        </i>

                        Success

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body text-center py-4">

                    <div class="mb-3">

                        <div class="d-inline-flex
                            align-items-center
                            justify-content-center
                            rounded-circle
                            bg-success-subtle
                            text-success"
                             style="width:70px;height:70px;">

                            <i class="fa-solid fa-check fa-2x"></i>

                        </div>

                    </div>


                    <h6 class="fw-semibold mb-2">

                        Operation Successful

                    </h6>


                    <p class="text-muted mb-0">

                        @TempData["SuccessMessage"]

                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-success px-4"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-check me-1"></i>

                        OK

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        /*Success message*/

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const successModal =
                    document.getElementById(
                        "successMessageModal"
                    );

                if (successModal) {

                    const modal =
                        new bootstrap.Modal(
                            successModal
                        );

                    modal.show();

                }

            }
        );


        /* Create pop up form*/

        function openCreateModal() {

            const form =
                document.getElementById(
                    "technicianTestTypeForm"
                );

            form.method = "post";

            form.action =
                "@Url.Action(
                                            "Create",
                                            "TechnicianTestType",
                                    new { area = "Manager" }
                            )";


            document.getElementById(
                "technicianTestTypeModalTitle"
            ).innerHTML =
                '<i class="fa-solid fa-plus text-primary me-2"></i>' +
                'Assign Test Type';


            document.getElementById(
                "saveButtonText"
            ).innerText =
                "Assign Test Type";


            document.getElementById(
                "TechnicianTestTypeId"
            ).value =
                "0";


            document.getElementById(
                "TechnicianId"
            ).value =
                "";


            document.getElementById(
                "TestTypeId"
            ).value =
                "";

        }


      

        function openCreateModalForTechnician(
            technicianId,
            technicianName) {

            openCreateModal();


            document.getElementById(
                "TechnicianId"
            ).value =
                technicianId;


            const modal =
                new bootstrap.Modal(
                    document.getElementById(
                        "technicianTestTypeModal"
                    )
                );


            modal.show();

        }


        /* view */

        function viewTechnicianTestType(
            id,
            technicianName,
            testTypeName,
            managerName,
            assignedDate,
            status) {

            document.getElementById(
                "viewTechnicianName"
            ).innerText =
                technicianName;


            document.getElementById(
                "viewTestTypeName"
            ).innerText =
                testTypeName;


            document.getElementById(
                "viewManagerName"
            ).innerText =
                managerName;


            document.getElementById(
                "viewAssignedDate"
            ).innerText =
                assignedDate;


            const statusElement =
                document.getElementById(
                    "viewAssignmentStatus"
                );


            if (status === "Active") {

                statusElement.innerHTML =
                    '<span class="badge bg-success">' +
                    '<i class="fa-solid fa-check me-1"></i>' +
                    'Active' +
                    '</span>';

            }
            else {

                statusElement.innerHTML =
                    '<span class="badge bg-secondary">' +
                    '<i class="fa-solid fa-ban me-1"></i>' +
                    status +
                    '</span>';

            }


            new bootstrap.Modal(
                document.getElementById(
                    "viewTechnicianTestTypeModal"
                )
            ).show();

        }



        function editTechnicianTestType(
            id,
            technicianId,
            testTypeId) {

            const form =
                document.getElementById(
                    "technicianTestTypeForm"
                );


            form.method = "post";


            form.action =
                "@Url.Action(
                                            "Edit",
                                            "TechnicianTestType",
                                    new { area = "Manager" }
                            )";


            document.getElementById(
                "technicianTestTypeModalTitle"
            ).innerHTML =
                '<i class="fa-solid fa-pen text-primary me-2"></i>' +
                'Edit Assignment';


            document.getElementById(
                "saveButtonText"
            ).innerText =
                "Update Assignment";


            document.getElementById(
                "TechnicianTestTypeId"
            ).value =
                id;


            document.getElementById(
                "TechnicianId"
            ).value =
                technicianId;


            document.getElementById(
                "TestTypeId"
            ).value =
                testTypeId;


            new bootstrap.Modal(
                document.getElementById(
                    "technicianTestTypeModal"
                )
            ).show();

        }


        function deleteTechnicianTestType(
            id,
            technicianName,
            testTypeName) {

            const form =
                document.getElementById(
                    "deleteTechnicianTestTypeForm"
                );


            form.method = "post";


            form.action =
                "@Url.Action(
                                            "Delete",
                                            "TechnicianTestType",
                                    new { area = "Manager" }
                            )";


            document.getElementById(
                "deleteTechnicianTestTypeId"
            ).value =
                id;


            document.getElementById(
                "deleteAssignmentName"
            ).innerText =
                technicianName +
                " — " +
                testTypeName;


            new bootstrap.Modal(
                document.getElementById(
                    "deleteTechnicianTestTypeModal"
                )
            ).show();

        }


        /* Search */

        const searchInput =
            document.getElementById(
                "technicianTestTypeSearch"
            );


        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    const search =
                        this.value
                            .toLowerCase()
                            .trim();


                    const rows =
                        document.querySelectorAll(
                            "#technicianTestTypesTableBody " +
                            ".technician-test-type-row"
                        );


                    let visibleCount = 0;


                    rows.forEach(
                        function (row) {

                            const technician =
                                (
                                    row.dataset.technician ||
                                    ""
                                ).toLowerCase();


                            const testType =
                                (
                                    row.dataset.testtype ||
                                    ""
                                ).toLowerCase();


                            const manager =
                                (
                                    row.dataset.manager ||
                                    ""
                                ).toLowerCase();


                            const status =
                                (
                                    row.dataset.status ||
                                    ""
                                ).toLowerCase();


                            const matches =
                                technician.includes(search) ||
                                testType.includes(search) ||
                                manager.includes(search) ||
                                status.includes(search);


                            row.style.display =
                                matches
                                    ? ""
                                    : "none";


                            if (matches) {

                                visibleCount++;

                            }

                        }
                    );


                    document.getElementById(
                        "recordCount"
                    ).innerText =
                        visibleCount +
                        " technician(s)";


                    const noSearchResultsRow =
                        document.getElementById(
                            "noSearchResultsRow"
                        );


                    if (noSearchResultsRow) {

                        noSearchResultsRow.style.display =
                            rows.length > 0 &&
                            visibleCount === 0
                                ? ""
                                : "none";

                    }

                }
            );

        }

    </script>
}