@model IReadOnlyList<SampleType>
@{
    ViewData["Title"] = "Sample Types";
}

<div class="page-header">
    <h4 class="page-title">Samples</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Samples</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Sample Types</h4>
                    <button class="btn btn-primary btn-round ml-auto" data-toggle="modal" data-target="#addSampleTypeModal">
                        <i class="fa fa-plus"></i> Add Sample Type
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Added Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sampleType in Model)
                            {
                                <tr>
                                    <td>@sampleType.Name</td>
                                    <td>@sampleType.Description</td>
                                    <td>@sampleType.AddedDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (sampleType.Status == SampleTypeStatus.Active)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-button-action">
                                            <button type="button" class="btn btn-link btn-primary btn-lg edit-sampletype-btn"
                                                    data-id="@sampleType.SampleTypeId" data-name="@sampleType.Name" data-description="@sampleType.Description"
                                                    data-status="@sampleType.Status" data-toggle="modal" data-target="#editSampleTypeModal"
                                                    title="Edit Sample Type">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-link btn-danger remove-sampletype-btn"
                                                    data-id="@sampleType.SampleTypeId" data-name="@sampleType.Name"
                                                    data-toggle="modal" data-target="#removeSampleTypeModal" title="Remove Sample Type">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted">No sample types added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD SAMPLE TYPE MODAL -->
<div class="modal fade" id="addSampleTypeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="SampleType" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title"><span class="fw-mediumbold">Add</span> <span class="fw-light">Sample Type</span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group form-group-default">
                        <label>Sample Type Name</label>
                        <input name="Name" type="text" class="form-control" placeholder="e.g. Whole Blood" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" type="text" class="form-control" placeholder="Enter description" />
                    </div>
                    <input type="hidden" name="Status" value="Active" />
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Add</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT SAMPLE TYPE MODAL -->
<div class="modal fade" id="editSampleTypeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="SampleType" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Edit Sample Type</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editSampleTypeId" />
                    <div class="form-group form-group-default">
                        <label>Sample Type Name</label>
                        <input name="Name" id="editSampleTypeName" type="text" class="form-control" required />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Description</label>
                        <input name="Description" id="editSampleTypeDescription" type="text" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Status</label>
                        <select name="Status" id="editSampleTypeStatus" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVE SAMPLE TYPE MODAL -->
<div class="modal fade" id="removeSampleTypeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="SampleType" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Remove Sample Type</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="removeSampleTypeId" />
                    <p>Are you sure you want to remove <strong id="removeSampleTypeName"></strong>?</p>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-danger">Remove</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('.edit-sampletype-btn').on('click', function () {
                $('#editSampleTypeId').val($(this).data('id'));
                $('#editSampleTypeName').val($(this).data('name'));
                $('#editSampleTypeDescription').val($(this).data('description'));
                $('#editSampleTypeStatus').val($(this).data('status'));
            });
            $('.remove-sampletype-btn').on('click', function () {
                $('#removeSampleTypeId').val($(this).data('id'));
                $('#removeSampleTypeName').text($(this).data('name'));
            });
        });
    </script>
}
