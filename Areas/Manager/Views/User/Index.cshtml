@using NMB_HLabSys.Models.Identity
@using NMB_HLabSys.Models.Users

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_LabManagerLayout.cshtml";

    var doctors = ViewBag.Doctors as List<DoctorProfile>
                   ?? new List<DoctorProfile>();

    var technicians = ViewBag.Technicians as List<TechnicianProfile>
                      ?? new List<TechnicianProfile>();

    var totalUsers = doctors.Count + technicians.Count;
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
    ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-users text-primary me-2"></i>
                Manage Users
            </h4>

            <p class="text-muted mb-0">
                Manage laboratory doctors and technicians, their personal
                information, contact details and account status.
            </p>
        </div>

        <div class="d-flex gap-2">

            <!-- ADD DOCTOR -->
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#userModal"
                    onclick="openCreateDoctorModal()">

                <i class="fa-solid fa-user-doctor me-1"></i>
                Add Doctor

            </button>

            <!-- ADD TECHNICIAN -->
            <button type="button"
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#userModal"
                    onclick="openCreateTechnicianModal()">

                <i class="fa-solid fa-user-gear me-1"></i>
                Add Technician

            </button>

        </div>

    </div>


    <!-- =========================================================
         ERROR MESSAGE
    ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         VALIDATION ERRORS
    ========================================================= -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <div class="fw-semibold mb-2">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                Please correct the following errors:

            </div>

            <ul class="mb-0">

                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var error in entry.Value.Errors)
                    {
                        <li>

                            @if (!string.IsNullOrEmpty(entry.Key))
                            {
                                <strong>@entry.Key:</strong>
                            }

                            @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                ? "The value entered is invalid."
                                : error.ErrorMessage)

                        </li>
                    }
                }

            </ul>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         INFORMATION
    ========================================================= -->

    <div class="alert alert-info border-0 shadow-sm">

        <div class="d-flex">

            <i class="fa-solid fa-circle-info mt-1 me-3"></i>

            <div>

                <div class="fw-semibold">
                    User account management
                </div>

                <div class="small">

                    Doctors and laboratory technicians receive automatically
                    generated temporary passwords by e-mail. New users are
                    required to change their password when they first log in.

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         USER TABLE
    ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <h6 class="fw-bold mb-0">
                        Laboratory Users
                    </h6>

                    <small class="text-muted">
                        Active doctors and laboratory technicians
                    </small>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <!-- SEARCH -->

                    <div class="input-group input-group-sm"
                         style="width:320px;">

                        <span class="input-group-text bg-white">

                            <i class="fa-solid fa-magnifying-glass text-muted"></i>

                        </span>

                        <input type="text"
                               id="userSearch"
                               class="form-control"
                               placeholder="Search users..."
                               autocomplete="off" />

                    </div>


                    <!-- RECORD COUNT -->

                    <span class="badge bg-primary-subtle text-primary"
                          id="recordCount">

                        @totalUsers user(s)

                    </span>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="usersTable">

                    <thead class="table-light">

                        <tr>

                            <th>Name</th>

                            <th>User Type</th>

                            <th>Professional / Employee No.</th>

                            <th>E-mail</th>

                            <th>Contact Number</th>

                            <th>Account Status</th>

                            <th>Password Status</th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="usersTableBody">

                        <!-- =================================================
                             DOCTORS
                        ================================================= -->
                        @foreach (var doctor in doctors)
                        {
                            var user = doctor.User;

                            if (user == null)
                            {
                                continue;
                            }

                            var userType = "Doctor";

                            var status = user.IsActive
                                ? "Active"
                                : "Inactive";

                            var passwordStatus = user.MustChangePassword
                                ? "Must Change Password"
                                : "Password Set";

                            var encodedName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.FullName ?? "");

                            var encodedFirstName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.FirstName ?? "");

                            var encodedLastName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.LastName ?? "");

                            var encodedHpcsa =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(doctor.HPCSANumber ?? "");

                            var encodedEmail =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.Email ?? "");

                            var encodedPhone =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.PhoneNumber ?? "");

                            var encodedStatus =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(status);

                            var encodedPasswordStatus =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(passwordStatus);

                            <tr class="user-row"
                                data-name="@user.FullName"
                                data-type="@userType"
                                data-number="@doctor.HPCSANumber"
                                data-id-number=""
                                data-email="@user.Email"
                                data-phone="@user.PhoneNumber"
                                data-status="@status"
                                data-password-status="@passwordStatus">

                                <!-- NAME -->

                                <td>

                                    <div class="fw-semibold">
                                        @user.FullName
                                    </div>

                                </td>


                                <!-- USER TYPE -->

                                <td>

                                    <span class="badge bg-primary-subtle text-primary">

                                        <i class="fa-solid fa-user-doctor me-1"></i>

                                        Doctor

                                    </span>

                                </td>


                                <!-- HPCSA -->

                                <td>

                                    <div>

                                        <small class="text-muted d-block">
                                            HPCSA Number
                                        </small>

                                        <span class="fw-semibold">
                                            @doctor.HPCSANumber
                                        </span>

                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>
                                    @user.Email
                                </td>


                                <!-- PHONE -->

                                <td>
                                    @user.PhoneNumber
                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            <i class="fa-solid fa-check me-1"></i>
                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="fa-solid fa-ban me-1"></i>
                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- PASSWORD STATUS -->

                                <td>

                                    @if (user.MustChangePassword)
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="fa-solid fa-key me-1"></i>
                                            First Login

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">

                                            <i class="fa-solid fa-lock me-1"></i>
                                            Password Set

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="btn-group btn-group-sm">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="btn btn-outline-info"
                                                title="View user"
                                                onclick="viewUser(
                                            '@user.Id',
                                            '@Html.Raw(encodedName)',
                                            '@Html.Raw(encodedFirstName)',
                                            '@Html.Raw(encodedLastName)',
                                            '@Html.Raw(encodedEmail)',
                                            '@Html.Raw(encodedPhone)',
                                            'Doctor',
                                            '@Html.Raw(encodedHpcsa)',
                                            '',
                                            '@Html.Raw(encodedStatus)',
                                            '@Html.Raw(encodedPasswordStatus)'
                                            )">

                                            <i class="fa-solid fa-eye"></i>

                                        </button>


                                        <!-- EDIT DOCTOR -->
                                        @if (user.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit doctor"
                                                    onclick="editDoctor(
                                                '@user.Id',
                                                '@Html.Raw(encodedFirstName)',
                                                '@Html.Raw(encodedLastName)',
                                                '@Html.Raw(encodedHpcsa)',
                                                '@Html.Raw(encodedEmail)',
                                                '@Html.Raw(encodedPhone)'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>
                                        }


                                        <!-- DEACTIVATE -->
                                        @if (user.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Deactivate user"
                                                    onclick="deleteUser(
                                                '@user.Id',
                                                '@Html.Raw(encodedName)',
                                                'Doctor'
                                                )">

                                                <i class="fa-solid fa-user-slash"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }


                        <!-- =================================================
                             TECHNICIANS
                        ================================================= -->
                        @foreach (var technician in technicians)
                        {
                            var user = technician.User;

                            if (user == null)
                            {
                                continue;
                            }

                            var userType = "Laboratory Technician";

                            var status = user.IsActive
                                ? "Active"
                                : "Inactive";

                            var passwordStatus = user.MustChangePassword
                                ? "Must Change Password"
                                : "Password Set";

                            var encodedName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.FullName ?? "");

                            var encodedFirstName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.FirstName ?? "");

                            var encodedLastName =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.LastName ?? "");

                            var encodedEmployeeNumber =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(
                                    technician.EmployeeNumber ?? "");

                            var encodedIdNumber =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(
                                    technician.IdNumber ?? "");

                            var encodedEmail =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(user.Email ?? "");

                            var encodedPhone =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(
                                    user.PhoneNumber ?? "");

                            var encodedStatus =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(status);

                            var encodedPasswordStatus =
                                System.Text.Encodings.Web.JavaScriptEncoder
                                .Default.Encode(passwordStatus);

                            <tr class="user-row"
                                data-name="@user.FullName"
                                data-type="@userType"
                                data-number="@technician.EmployeeNumber"
                                data-id-number="@technician.IdNumber"
                                data-email="@user.Email"
                                data-phone="@user.PhoneNumber"
                                data-status="@status"
                                data-password-status="@passwordStatus">

                                <!-- NAME -->

                                <td>

                                    <div class="fw-semibold">
                                        @user.FullName
                                    </div>

                                </td>


                                <!-- USER TYPE -->

                                <td>

                                    <span class="badge bg-success-subtle text-success">

                                        <i class="fa-solid fa-user-gear me-1"></i>

                                        Technician

                                    </span>

                                </td>


                                <!-- EMPLOYEE NUMBER -->

                                <td>

                                    <div>

                                        <small class="text-muted d-block">
                                            Employee Number
                                        </small>

                                        <span class="fw-semibold">
                                            @technician.EmployeeNumber
                                        </span>

                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>
                                    @user.Email
                                </td>


                                <!-- PHONE -->

                                <td>
                                    @user.PhoneNumber
                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            <i class="fa-solid fa-check me-1"></i>
                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="fa-solid fa-ban me-1"></i>
                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- PASSWORD STATUS -->

                                <td>

                                    @if (user.MustChangePassword)
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="fa-solid fa-key me-1"></i>
                                            First Login

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">

                                            <i class="fa-solid fa-lock me-1"></i>
                                            Password Set

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="btn-group btn-group-sm">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="btn btn-outline-info"
                                                title="View user"
                                                onclick="viewUser(
                                            '@user.Id',
                                            '@Html.Raw(encodedName)',
                                            '@Html.Raw(encodedFirstName)',
                                            '@Html.Raw(encodedLastName)',
                                            '@Html.Raw(encodedEmail)',
                                            '@Html.Raw(encodedPhone)',
                                            'Laboratory Technician',
                                            '@Html.Raw(encodedEmployeeNumber)',
                                            '@Html.Raw(encodedIdNumber)',
                                            '@Html.Raw(encodedStatus)',
                                            '@Html.Raw(encodedPasswordStatus)'
                                            )">

                                            <i class="fa-solid fa-eye"></i>

                                        </button>


                                        <!-- EDIT TECHNICIAN -->
                                        @if (user.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Edit technician"
                                                    onclick="editTechnician(
                                                '@user.Id',
                                                '@Html.Raw(encodedFirstName)',
                                                '@Html.Raw(encodedLastName)',
                                                '@Html.Raw(encodedEmployeeNumber)',
                                                '@Html.Raw(encodedIdNumber)',
                                                '@Html.Raw(encodedEmail)',
                                                '@Html.Raw(encodedPhone)'
                                                )">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>
                                        }


                                        <!-- DEACTIVATE -->
                                        @if (user.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="Deactivate user"
                                                    onclick="deleteUser(
                                                '@user.Id',
                                                '@Html.Raw(encodedName)',
                                                'Laboratory Technician'
                                                )">

                                                <i class="fa-solid fa-user-slash"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }


                        <!-- =================================================
                             NO USERS
                        ================================================= -->
                        @if (!doctors.Any() && !technicians.Any())
                        {
                            <tr id="noUsersRow">

                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa-solid fa-users fa-2x mb-3"></i>

                                        <div class="fw-semibold">
                                            No users found
                                        </div>

                                        <small>
                                            Add a doctor or laboratory technician
                                            to begin managing users.
                                        </small>

                                    </div>

                                </td>

                            </tr>
                        }


                        <!-- =================================================
                             SEARCH EMPTY
                        ================================================= -->

                        <tr id="noSearchResultsRow"
                            style="display:none;">

                            <td colspan="8"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="fa-solid fa-magnifying-glass fa-2x mb-3"></i>

                                    <div class="fw-semibold">
                                        No matching users found
                                    </div>

                                    <small>
                                        Try searching by name, user type,
                                        employee number, HPCSA number,
                                        ID number, e-mail address or
                                        contact number.
                                    </small>

                                </div>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     ADD / EDIT USER MODAL
============================================================= -->

<div class="modal fade"
     id="userModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="userForm"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="userModalTitle">

                        <i class="fa-solid fa-user-plus text-primary me-2"></i>

                        Add User

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <!-- HIDDEN VALUES -->

                    <input type="hidden"
                           id="UserId"
                           name="UserId"
                           value="" />

                    <input type="hidden"
                           id="UserType"
                           name="UserType"
                           value="" />


                    <!-- =================================================
                         PERSONAL INFORMATION
                    ================================================= -->

                    <div class="mb-3">

                        <h6 class="fw-bold border-bottom pb-2">

                            <i class="fa-solid fa-user text-primary me-2"></i>

                            Personal Information

                        </h6>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="FirstName">

                                First Name

                            </label>

                            <input type="text"
                                   id="FirstName"
                                   name="FirstName"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   autocomplete="given-name" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="LastName">

                                Last Name

                            </label>

                            <input type="text"
                                   id="LastName"
                                   name="LastName"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   autocomplete="family-name" />

                        </div>

                    </div>


                    <!-- =================================================
                         DOCTOR INFORMATION
                    ================================================= -->

                    <div id="doctorFields"
                         style="display:none;">

                        <div class="mb-3">

                            <h6 class="fw-bold border-bottom pb-2">

                                <i class="fa-solid fa-user-doctor text-primary me-2"></i>

                                Professional Information

                            </h6>

                        </div>


                        <div class="mb-3">

                            <label class="form-label fw-semibold"
                                   for="HPCSANumber">

                                HPCSA Number

                            </label>

                            <input type="text"
                                   id="HPCSANumber"
                                   name="HPCSANumber"
                                   class="form-control"
                                   maxlength="50"
                                   autocomplete="off" />

                            <div class="form-text">
                                The HPCSA number must be unique.
                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         TECHNICIAN INFORMATION
                    ================================================= -->

                    <div id="technicianFields"
                         style="display:none;">

                        <div class="mb-3">

                            <h6 class="fw-bold border-bottom pb-2">

                                <i class="fa-solid fa-user-gear text-success me-2"></i>

                                Technician Information

                            </h6>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold"
                                       for="IdNumber">

                                    South African ID Number

                                </label>

                                <input type="text"
                                       id="IdNumber"
                                       name="IdNumber"
                                       class="form-control"
                                       maxlength="13"
                                       minlength="13"
                                       inputmode="numeric"
                                       autocomplete="off" />

                                <div class="form-text">
                                    Must contain exactly 13 digits.
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-semibold"
                                       for="EmployeeNumber">

                                    Employee Number

                                </label>

                                <input type="text"
                                       id="EmployeeNumber"
                                       name="EmployeeNumber"
                                       class="form-control"
                                       maxlength="50"
                                       autocomplete="off" />

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         CONTACT INFORMATION
                    ================================================= -->

                    <div class="mb-3">

                        <h6 class="fw-bold border-bottom pb-2">

                            <i class="fa-solid fa-address-book text-primary me-2"></i>

                            Contact Information

                        </h6>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="Email">

                                E-mail Address

                            </label>

                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="form-control"
                                   required
                                   autocomplete="email" />

                            <div class="form-text">
                                The e-mail address is used as the user's username.
                            </div>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold"
                                   for="PhoneNumber">

                                Contact Number

                            </label>

                            <input type="tel"
                                   id="PhoneNumber"
                                   name="PhoneNumber"
                                   class="form-control"
                                   required
                                   autocomplete="tel" />

                        </div>

                    </div>


                    <!-- =================================================
                         PASSWORD INFORMATION
                    ================================================= -->

                    <div id="passwordInformation"
                         class="alert alert-info border-0 mb-0">

                        <div class="d-flex">

                            <i class="fa-solid fa-key mt-1 me-3"></i>

                            <div>

                                <div class="fw-semibold">
                                    Password automatically generated
                                </div>

                                <div class="small">

                                    A secure temporary password will be
                                    generated automatically and e-mailed
                                    to the user.

                                    The user must change the password
                                    during their first login.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     MODAL FOOTER
                ================================================= -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-check me-1"></i>

                        <span id="saveButtonText">
                            Save User
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     VIEW USER MODAL
============================================================= -->

<div class="modal fade"
     id="viewUserModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold">

                    <i class="fa-solid fa-circle-info text-info me-2"></i>

                    User Details

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            First Name
                        </small>

                        <div id="viewUserFirstName"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            Last Name
                        </small>

                        <div id="viewUserLastName"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            User Type
                        </small>

                        <div id="viewUserType"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small id="viewUserNumberLabel"
                               class="text-muted d-block">

                            Professional / Employee Number

                        </small>

                        <div id="viewUserNumber"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3"
                         id="viewUserIdNumberContainer">

                        <small class="text-muted d-block">
                            South African ID Number
                        </small>

                        <div id="viewUserIdNumber"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            E-mail Address
                        </small>

                        <div id="viewUserEmail"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            Contact Number
                        </small>

                        <div id="viewUserPhone"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            Account Status
                        </small>

                        <div id="viewUserStatus"
                             class="fw-semibold">
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <small class="text-muted d-block">
                            Password Status
                        </small>

                        <div id="viewUserPasswordStatus"
                             class="fw-semibold">
                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE USER MODAL
============================================================= -->

<div class="modal fade"
     id="deleteUserModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <form id="deleteUserForm"
                  method="post"
                  action="@Url.Action("Delete", "User", new { area = "Manager" })">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteUserId"
                       name="id"
                       value="" />


                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-danger">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>

                        Deactivate User

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        Are you sure you want to deactivate this user?
                    </p>


                    <div class="alert alert-warning mb-0">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        <strong id="deleteUserName"></strong>

                        <div class="small mt-1">

                            <span id="deleteUserType"></span>

                            <br />

                            This is a soft delete. The user account will be
                            marked as inactive rather than permanently removed.

                        </div>

                    </div>

                </div>


                <div class="modal-footer border-0">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-user-slash me-1"></i>

                        Deactivate User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =============================================================
     SUCCESS MESSAGE MODAL
============================================================= -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="modal fade"
         id="successMessageModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header border-0">

                    <h5 class="modal-title fw-bold text-success">

                        <i class="fa-solid fa-circle-check me-2"></i>

                        Success

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body text-center py-4">

                    <div class="mb-3">

                        <div class="d-inline-flex
                            align-items-center
                            justify-content-center
                            rounded-circle
                            bg-success-subtle
                            text-success"
                             style="width:70px;height:70px;">

                            <i class="fa-solid fa-check fa-2x"></i>

                        </div>

                    </div>


                    <h6 class="fw-semibold mb-2">
                        Operation Successful
                    </h6>


                    <p class="text-muted mb-0">
                        @TempData["SuccessMessage"]
                    </p>

                </div>


                <div class="modal-footer border-0 justify-content-center">

                    <button type="button"
                            class="btn btn-success px-4"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-check me-1"></i>

                        OK

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>

        /* =========================================================
           SUCCESS MESSAGE
        ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            const successModal =
                document.getElementById("successMessageModal");

            if (successModal) {

                const modal =
                    new bootstrap.Modal(successModal);

                modal.show();
            }

        });


        /* =========================================================
           RESET FORM
        ========================================================= */

        function resetUserForm() {

            document.getElementById("UserId").value = "";

            document.getElementById("UserType").value = "";

            document.getElementById("FirstName").value = "";

            document.getElementById("LastName").value = "";

            document.getElementById("HPCSANumber").value = "";

            document.getElementById("IdNumber").value = "";

            document.getElementById("EmployeeNumber").value = "";

            document.getElementById("Email").value = "";

            document.getElementById("PhoneNumber").value = "";

            document.getElementById("doctorFields").style.display = "none";

            document.getElementById("technicianFields").style.display = "none";

        }


        /* =========================================================
           CREATE DOCTOR
        ========================================================= */

        function openCreateDoctorModal() {

            const form =
                document.getElementById("userForm");

            resetUserForm();

            form.method = "post";

            form.action =
                "@Url.Action("CreateDoctor", "User", new { area = "Manager" })";

            document.getElementById("userModalTitle").innerHTML =
                '<i class="fa-solid fa-user-doctor text-primary me-2"></i>' +
                'Add Doctor';

            document.getElementById("saveButtonText").innerText =
                "Save Doctor";

            document.getElementById("UserType").value =
                "Doctor";

            document.getElementById("doctorFields").style.display =
                "";

            document.getElementById("technicianFields").style.display =
                "none";

        }


        /* =========================================================
           CREATE TECHNICIAN
        ========================================================= */

        function openCreateTechnicianModal() {

            const form =
                document.getElementById("userForm");

            resetUserForm();

            form.method = "post";

            form.action =
                "@Url.Action("CreateTechnician", "User", new { area = "Manager" })";

            document.getElementById("userModalTitle").innerHTML =
                '<i class="fa-solid fa-user-gear text-success me-2"></i>' +
                'Add Laboratory Technician';

            document.getElementById("saveButtonText").innerText =
                "Save Technician";

            document.getElementById("UserType").value =
                "Technician";

            document.getElementById("doctorFields").style.display =
                "none";

            document.getElementById("technicianFields").style.display =
                "";

        }


        /* =========================================================
           EDIT DOCTOR
        ========================================================= */

        function editDoctor(
            id,
            firstName,
            lastName,
            hpcsaNumber,
            email,
            phone
        ) {

            const form =
                document.getElementById("userForm");

            resetUserForm();

            /*
             * This is a POST action.
             *
             * No EditDoctor.cshtml page is required.
             * The controller should process the update and
             * redirect back to Index.
             */

            form.method = "post";

            form.action =
                "@Url.Action("EditDoctor", "User", new { area = "Manager" })";


            document.getElementById("userModalTitle").innerHTML =
                '<i class="fa-solid fa-pen text-primary me-2"></i>' +
                'Edit Doctor';

            document.getElementById("saveButtonText").innerText =
                "Update Doctor";


            document.getElementById("UserId").value =
                id || "";

            document.getElementById("UserType").value =
                "Doctor";

            document.getElementById("FirstName").value =
                firstName || "";

            document.getElementById("LastName").value =
                lastName || "";

            document.getElementById("HPCSANumber").value =
                hpcsaNumber || "";

            document.getElementById("Email").value =
                email || "";

            document.getElementById("PhoneNumber").value =
                phone || "";


            document.getElementById("doctorFields").style.display =
                "";

            document.getElementById("technicianFields").style.display =
                "none";


            new bootstrap.Modal(
                document.getElementById("userModal")
            ).show();

        }


        /* =========================================================
           EDIT TECHNICIAN
        ========================================================= */

        function editTechnician(
            id,
            firstName,
            lastName,
            employeeNumber,
            idNumber,
            email,
            phone
        ) {

            const form =
                document.getElementById("userForm");

            resetUserForm();

            /*
             * IMPORTANT:
             *
             * There is NO EditTechnician.cshtml.
             *
             * This form sends a POST request to the
             * EditTechnician controller action.
             *
             * The controller must save the changes and
             * RedirectToAction("Index").
             */

            form.method = "post";

            form.action =
                "@Url.Action("EditTechnician", "User", new { area = "Manager" })";


            document.getElementById("userModalTitle").innerHTML =
                '<i class="fa-solid fa-pen text-success me-2"></i>' +
                'Edit Laboratory Technician';

            document.getElementById("saveButtonText").innerText =
                "Update Technician";


            document.getElementById("UserId").value =
                id || "";

            document.getElementById("UserType").value =
                "Technician";

            document.getElementById("FirstName").value =
                firstName || "";

            document.getElementById("LastName").value =
                lastName || "";

            document.getElementById("EmployeeNumber").value =
                employeeNumber || "";

            document.getElementById("IdNumber").value =
                idNumber || "";

            document.getElementById("Email").value =
                email || "";

            document.getElementById("PhoneNumber").value =
                phone || "";


            document.getElementById("doctorFields").style.display =
                "none";

            document.getElementById("technicianFields").style.display =
                "";


            new bootstrap.Modal(
                document.getElementById("userModal")
            ).show();

        }


        /* =========================================================
           VIEW USER
        ========================================================= */

        function viewUser(
            id,
            name,
            firstName,
            lastName,
            email,
            phone,
            userType,
            professionalNumber,
            idNumber,
            status,
            passwordStatus
        ) {

            document.getElementById("viewUserFirstName").innerText =
                firstName || "";

            document.getElementById("viewUserLastName").innerText =
                lastName || "";


            const typeElement =
                document.getElementById("viewUserType");


            if (userType === "Doctor") {

                typeElement.innerHTML =
                    '<span class="badge bg-primary">' +
                    '<i class="fa-solid fa-user-doctor me-1"></i>' +
                    'Doctor' +
                    '</span>';

                document.getElementById("viewUserNumberLabel")
                    .innerText = "HPCSA Number";

            }
            else if (userType === "Laboratory Technician") {

                typeElement.innerHTML =
                    '<span class="badge bg-success">' +
                    '<i class="fa-solid fa-user-gear me-1"></i>' +
                    'Laboratory Technician' +
                    '</span>';

                document.getElementById("viewUserNumberLabel")
                    .innerText = "Employee Number";

            }
            else {

                typeElement.innerText =
                    userType || "";

            }


            document.getElementById("viewUserNumber").innerText =
                professionalNumber || "N/A";


            const idContainer =
                document.getElementById(
                    "viewUserIdNumberContainer"
                );


            if (userType === "Laboratory Technician") {

                idContainer.style.display = "";

                document.getElementById("viewUserIdNumber").innerText =
                    idNumber || "N/A";

            }
            else {

                idContainer.style.display = "none";

            }


            document.getElementById("viewUserEmail").innerText =
                email || "";

            document.getElementById("viewUserPhone").innerText =
                phone || "";


            const statusElement =
                document.getElementById("viewUserStatus");


            if (status === "Active") {

                statusElement.innerHTML =
                    '<span class="badge bg-success">' +
                    '<i class="fa-solid fa-check me-1"></i>' +
                    'Active' +
                    '</span>';

            }
            else {

                statusElement.innerHTML =
                    '<span class="badge bg-secondary">' +
                    '<i class="fa-solid fa-ban me-1"></i>' +
                    'Inactive' +
                    '</span>';

            }


            const passwordElement =
                document.getElementById(
                    "viewUserPasswordStatus"
                );


            if (passwordStatus === "Must Change Password") {

                passwordElement.innerHTML =
                    '<span class="badge bg-warning text-dark">' +
                    '<i class="fa-solid fa-key me-1"></i>' +
                    'Must Change Password' +
                    '</span>';

            }
            else {

                passwordElement.innerHTML =
                    '<span class="badge bg-success-subtle text-success">' +
                    '<i class="fa-solid fa-lock me-1"></i>' +
                    'Password Set' +
                    '</span>';

            }


            new bootstrap.Modal(
                document.getElementById("viewUserModal")
            ).show();

        }


        /* =========================================================
           SOFT DELETE
        ========================================================= */

        function deleteUser(
            id,
            name,
            userType
        ) {

            const form =
                document.getElementById("deleteUserForm");

            form.method = "post";

            form.action =
                "@Url.Action("Delete", "User", new { area = "Manager" })";


            document.getElementById("deleteUserId").value =
                id || "";

            document.getElementById("deleteUserName").innerText =
                name || "";

            document.getElementById("deleteUserType").innerText =
                userType || "";


            new bootstrap.Modal(
                document.getElementById("deleteUserModal")
            ).show();

        }


        /* =========================================================
           SEARCH
        ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("userSearch");

            if (!searchInput) {
                return;
            }


            searchInput.addEventListener(
                "input",
                function () {

                    const search =
                        this.value
                            .toLowerCase()
                            .trim();


                    const rows =
                        document.querySelectorAll(
                            "#usersTableBody .user-row"
                        );


                    let visibleCount = 0;


                    rows.forEach(function (row) {

                        const name =
                            (row.dataset.name || "")
                                .toLowerCase();

                        const type =
                            (row.dataset.type || "")
                                .toLowerCase();

                        const number =
                            (row.dataset.number || "")
                                .toLowerCase();

                        const idNumber =
                            (row.dataset.idNumber || "")
                                .toLowerCase();

                        const email =
                            (row.dataset.email || "")
                                .toLowerCase();

                        const phone =
                            (row.dataset.phone || "")
                                .toLowerCase();

                        const status =
                            (row.dataset.status || "")
                                .toLowerCase();

                        const passwordStatus =
                            (row.dataset.passwordStatus || "")
                                .toLowerCase();


                        const matches =
                            name.includes(search) ||
                            type.includes(search) ||
                            number.includes(search) ||
                            idNumber.includes(search) ||
                            email.includes(search) ||
                            phone.includes(search) ||
                            status.includes(search) ||
                            passwordStatus.includes(search);


                        row.style.display =
                            matches ? "" : "none";


                        if (matches) {
                            visibleCount++;
                        }

                    });


                    const recordCount =
                        document.getElementById(
                            "recordCount"
                        );


                    if (recordCount) {

                        recordCount.innerText =
                            visibleCount + " user(s)";

                    }


                    const noSearchResultsRow =
                        document.getElementById(
                            "noSearchResultsRow"
                        );


                    if (noSearchResultsRow) {

                        noSearchResultsRow.style.display =
                            rows.length > 0 &&
                            visibleCount === 0
                                ? ""
                                : "none";

                    }

                }
            );

        });

    </script>
}