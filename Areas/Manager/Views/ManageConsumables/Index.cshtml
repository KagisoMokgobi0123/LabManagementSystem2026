@model IReadOnlyList<ManageConsumable>
@{
    ViewData["Title"] = "Manage Consumables";
    var consumables = ViewBag.Consumables as IReadOnlyList<Consumable>;
    var suppliers = ViewBag.Suppliers as IReadOnlyList<Supplier>;
}

<div class="page-header">
    <h4 class="page-title">Manage Consumable</h4>
    <ul class="breadcrumbs">
        <li class="nav-home"><a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="flaticon-home"></i></a></li>
        <li class="separator"><i class="flaticon-right-arrow"></i></li>
        <li class="nav-item"><a href="#">Manage Consumable</a></li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Consumable Stock</h4>

                    <button class="btn btn-success btn-round ml-auto mr-2"
                            data-toggle="modal"
                            data-target="#addConsumableModal">
                        <i class="fa fa-plus"></i> Add Managed Consumable
                    </button>

                    <button class="btn btn-primary btn-round"
                            data-toggle="modal"
                            data-target="#createOrderModal">
                        <i class="fa fa-shopping-cart"></i> Create Order
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Supplier</th>
                                <th>Reorder</th>
                                <th>Qty</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Active</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Consumable?.Name</td>

                                    <td>@(item.Supplier?.Name ?? "-")</td>

                                    <td>@item.ReorderLevel</td>

                                    <td>
                                        @if (item.QuantityOnHand <= item.ReorderLevel)
                                        {
                                            <span class="text-danger fw-bold">@item.QuantityOnHand</span>
                                        }
                                        else
                                        {
                                            @item.QuantityOnHand
                                        }
                                    </td>

                                    <td>
                                        @switch (item.Status)
                                        {
                                            case ManageConsumableStatus.Sufficient:
                                                <span class="badge badge-success">Sufficient</span>
                                                break;

                                            case ManageConsumableStatus.NearReorder:
                                                <span class="badge badge-warning">Near Reorder</span>
                                                break;

                                            case ManageConsumableStatus.Empty:
                                                <span class="badge badge-danger">Empty</span>
                                                break;
                                        }
                                    </td>

                                    <td>@item.DateUpdated.ToString("yyyy/MM/dd")</td>

                                    <td>
                                        @switch (item.IsActive)
                                        {
                                            case ConsumableStatus.Active:
                                                <span class="badge badge-success">Active</span>
                                                break;

                                            case ConsumableStatus.Inactive:
                                                <span class="badge badge-secondary">Inactive</span>
                                                break;

                                            case ConsumableStatus.Deleted:
                                                <span class="badge badge-danger">Deleted</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="form-button-action">

                                            <button type="button"
                                                    class="btn btn-link btn-primary btn-lg edit-consumable-btn"
                                                    data-id="@item.ManageConsumableId"
                                                    data-consumableid="@item.ConsumableId"
                                                    data-supplierid="@item.SupplierId"
                                                    data-reorder="@item.ReorderLevel"
                                                    data-qty="@item.QuantityOnHand"
                                                    data-status="@((int)item.Status)"
                                                    data-active="@((int)item.IsActive)"
                                                    data-toggle="modal"
                                                    data-target="#editConsumableModal"
                                                    title="Edit Stock">

                                                <i class="fa fa-edit"></i>

                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">
                                        No consumables are being tracked yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD MANAGED CONSUMABLE MODAL -->
<!-- ADD MANAGED CONSUMABLE MODAL -->
<div class="modal fade" id="addConsumableModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <form asp-area="Manager"
                  asp-controller="ManageConsumables"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Add Managed Consumable</h5>

                    <button type="button"
                            class="close"
                            data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>


                <div class="modal-body">

                    <!-- Consumable -->
                    <div class="form-group form-group-default">
                        <label>Consumable</label>

                        <select name="ConsumableId"
                                class="form-control"
                                required>

                            <option value="">Select Consumable</option>

                            @if (consumables != null)
                            {
                                foreach (var item in consumables)
                                {
                                    <option value="@item.ConsumableId">
                                        @item.Name
                                    </option>
                                }
                            }

                        </select>
                    </div>


                    <!-- Supplier -->
                    <div class="form-group form-group-default">
                        <label>Supplier</label>

                        <select name="SupplierId"
                                class="form-control"
                                required>

                            <option value="">Select Supplier</option>

                            @if (suppliers != null)
                            {
                                foreach (var supplier in suppliers)
                                {
                                    <option value="@supplier.SupplierId">
                                        @supplier.Name
                                    </option>
                                }
                            }

                        </select>
                    </div>


                    <!-- Reorder Level -->
                    <div class="form-group form-group-default">
                        <label>Reorder Level</label>

                        <input name="ReorderLevel"
                               type="number"
                               min="0"
                               class="form-control"
                               required />
                    </div>


                    <!-- Quantity -->
                    <div class="form-group form-group-default">
                        <label>Quantity On Hand</label>

                        <input name="QuantityOnHand"
                               type="number"
                               min="0"
                               class="form-control"
                               required />
                    </div>


                    <!-- Manage Consumable Status -->
                    <div class="form-group form-group-default">
                        <label>Stock Status</label>

                        <select name="Status"
                                class="form-control">

                            <option value="1">Sufficient</option>
                            <option value="2">Near Reorder</option>
                            <option value="3">Empty</option>

                        </select>
                    </div>


                    <!-- Active Status -->
                    <div class="form-group form-group-default">
                        <label>Tracking Status</label>

                        <select name="IsActive"
                                class="form-control">

                            <option value="0">
                                Active
                            </option>

                            <option value="1">
                                Inactive
                            </option>

                            <option value="3">
                                Deleted
                            </option>

                        </select>
                    </div>

                </div>


                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-success">
                        Save
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            data-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- EDIT STOCK MODAL -->
<div class="modal fade" id="editConsumableModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-area="Manager" asp-controller="ManageConsumables" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Edit Consumable Stock</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ManageConsumableId" id="editConsumableId" />
                    <div class="form-group form-group-default">
                        <label>Supplier</label>
                        <select name="SupplierId" id="consumableSupplier" class="form-control">
                            <option value="">Select Supplier</option>
                            @if (suppliers != null)
                            {
                                foreach (var supplier in suppliers)
                                {
                                    <option value="@supplier.SupplierId">@supplier.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group form-group-default">
                        <label>Reorder Level</label>
                        <input name="ReorderLevel" id="newReorderLevel" type="number" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Quantity On Hand</label>
                        <input name="QuantityOnHand" id="editConsumableQty" type="number" class="form-control" />
                    </div>
                    <div class="form-group form-group-default">
                        <label>Status</label>
                        <select name="Status" id="editConsumableStatus" class="form-control">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" id="editConsumableActive" class="form-check-input" value="true" />
                        <label class="form-check-label" for="editConsumableActive">Actively tracked for re-ordering</label>
                    </div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" id="updateConsumableBtn" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CREATE ORDER MODAL -->
<div class="modal fade" id="createOrderModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header no-bd">
                <h5 class="modal-title">Create Order</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group form-group-default">
                    <label>Supplier</label>
                    <select id="orderSupplier" class="form-control">
                        <option value="">Select Supplier</option>
                        @if (suppliers != null)
                        {
                            foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.SupplierId">@supplier.Name</option>
                            }
                        }
                    </select>
                    <span id="orderSupplierError" class="text-danger error-span"></span>
                </div>
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <div class="form-group form-group-default">
                            <label>Consumable</label>
                            <select id="orderConsumable" class="form-control" disabled>
                                <option value="">Select Supplier First</option>
                            </select>
                            <span id="orderConsumableError" class="text-danger error-span"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group form-group-default">
                            <label>Quantity</label>
                            <input id="orderQuantity" type="number" min="1" class="form-control" />
                            <span id="orderQuantityError" class="text-danger error-span"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button id="addOrderItemBtn" type="button" class="btn btn-secondary btn-block">Add Item</button>
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Item</th><th>Qty</th><th></th></tr>
                    </thead>
                    <tbody id="orderItemsBody"></tbody>
                </table>
            </div>
            <div class="modal-footer no-bd">
                <button id="clearOrderBtn" type="button" class="btn btn-danger">Clear</button>
                <button id="submitOrderBtn" type="button" class="btn btn-primary">Preview Order</button>
            </div>
        </div>
    </div>
</div>

<!-- ORDER PREVIEW MODAL -->
<div class="modal fade" id="orderPreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="orderPreviewForm" asp-area="Manager" asp-controller="ManageConsumables" asp-action="SubmitOrder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header no-bd">
                    <h5 class="modal-title">Order Preview</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div id="supplierOrderPreview"></div>
                    <div id="orderPreviewFields"></div>
                </div>
                <div class="modal-footer no-bd">
                    <button type="submit" class="btn btn-primary">Submit Order</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Back</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
                    var managedConsumables = [
            @foreach (var item in Model)
            {
                    <text>
                        {
                            supplierId: @item.SupplierId,
                            consumableId: @item.ConsumableId,
                            consumableName: "@item.Consumable?.Name"
                        },
                    </text>
            }
        ];
            var orderItems = [];

            $('.edit-consumable-btn').on('click', function () {
                var btn = $(this);
                $('#editConsumableId').val(btn.data('consumableid'));
                $('#consumableSupplier').val(btn.data('supplierid'));
                $('#newReorderLevel').val(btn.data('reorder'));
                $('#editConsumableQty').val(btn.data('qty'));
                $('#editConsumableStatus').val(btn.data('status'));
                $('#editConsumableActive').prop('checked', btn.data('active') === true || btn.data('active') === 'true');
            });
                    $('#orderSupplier').on('change', function () {

            var supplierId = parseInt($(this).val());

            var consumableSelect = $('#orderConsumable');

            consumableSelect.empty();

            if (!supplierId) {

                consumableSelect
                    .append('<option value="">Select Supplier First</option>')
                    .prop('disabled', true);

                return;
            }

            consumableSelect
                .append('<option value="">Select Consumable</option>')
                .prop('disabled', false);

            managedConsumables
                .filter(function (x) {
                    return x.supplierId === supplierId;
                })
                .forEach(function (x) {

                    consumableSelect.append(
                        '<option value="' +
                        x.consumableId +
                        '">' +
                        x.consumableName +
                        '</option>'
                    );

                });

            if (consumableSelect.children().length === 1) {

                consumableSelect.empty()
                    .append('<option value="">No consumables assigned</option>')
                    .prop('disabled', true);

            }

        });
            function renderItems() {
                var body = $('#orderItemsBody');
                body.empty();
                orderItems.forEach(function (item, idx) {
                    body.append(
                        '<tr><td>' + item.name + '</td><td>' + item.qty +
                        '</td><td><button type="button" class="btn btn-sm btn-link btn-danger remove-item" data-idx="' + idx + '"><i class="fa fa-times"></i></button></td></tr>'
                    );
                });
            }

            $('#addOrderItemBtn').on('click', function () {
                var select = $('#orderConsumable');
                var qty = parseInt($('#orderQuantity').val(), 10);

                $('#orderConsumableError').text('');
                $('#orderQuantityError').text('');

                if (!select.val()) {
                    $('#orderConsumableError').text('Please select a consumable.');
                    return;
                }
                if (!qty || qty < 1) {
                    $('#orderQuantityError').text('Please enter a valid quantity.');
                    return;
                }

                orderItems.push({ id: select.val(), name: select.find('option:selected').text(), qty: qty });
                renderItems();
                $('#orderConsumable').val('');
                $('#orderQuantity').val('');
            });

            $(document).on('click', '.remove-item', function () {
                orderItems.splice($(this).data('idx'), 1);
                renderItems();
            });

        $('#clearOrderBtn').on('click', function () {

            orderItems = [];
            renderItems();

            $('#orderSupplier').val('');

            $('#orderConsumable')
                .empty()
                .append('<option value="">Select Supplier First</option>')
                .prop('disabled', true);

            $('#orderQuantity').val('');

        });

            $('#submitOrderBtn').on('click', function () {
                var supplierSelect = $('#orderSupplier');
                $('#orderSupplierError').text('');

                if (!supplierSelect.val()) {
                    $('#orderSupplierError').text('Please select a supplier.');
                    return;
                }
                if (orderItems.length === 0) {
                    alert('Add at least one item to the order.');
                    return;
                }

                var supplierName = supplierSelect.find('option:selected').text();
                var html = '<p><strong>Supplier:</strong> ' + supplierName + '</p><ul>';
                var fields = '<input type="hidden" name="SupplierId" value="' + supplierSelect.val() + '" />' +
                             '<input type="hidden" name="SupplierName" value="' + supplierName + '" />';

                orderItems.forEach(function (item, idx) {
                    html += '<li>' + item.name + ' &times; ' + item.qty + '</li>';
                    fields += '<input type="hidden" name="Items[' + idx + '].ConsumableId" value="' + item.id + '" />' +
                              '<input type="hidden" name="Items[' + idx + '].ConsumableName" value="' + item.name + '" />' +
                              '<input type="hidden" name="Items[' + idx + '].Quantity" value="' + item.qty + '" />';
                });
                html += '</ul>';

                $('#supplierOrderPreview').html(html);
                $('#orderPreviewFields').html(fields);

                $('#createOrderModal').modal('hide');
                $('#orderPreviewModal').modal('show');
            });
        });
    </script>
}
