@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Laboratory Manager Dashboard";
    Layout = "_LabManagerLayout";

    var currentUser = await UserManager.GetUserAsync(User);

    var managerName = currentUser?.FullName ?? "Laboratory Manager";
    var managerEmail = currentUser?.Email ?? "";

    var managerInitial =
        !string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? currentUser.FirstName.Substring(0, 1).ToUpper()
            : "M";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .manager-dashboard {
        min-height: 100vh;
        background: #f4f7fb;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .manager-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;

        background: linear-gradient(
            135deg,
            #073b5c 0%,
            #075985 45%,
            #0284c7 100%
        );
    }

    .manager-hero::before {
        content: "";
        position: absolute;

        width: 260px;
        height: 260px;

        right: 220px;
        bottom: -190px;

        border-radius: 50%;
        background: rgba(255,255,255,.05);
    }

    .manager-hero::after {
        content: "";
        position: absolute;

        width: 380px;
        height: 380px;

        right: -100px;
        top: -210px;

        border-radius: 50%;
        background: rgba(255,255,255,.06);
    }

    .manager-hero-content {
        position: relative;
        z-index: 2;
    }

    .manager-badge {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        padding: 7px 13px;
        margin-bottom: 14px;

        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50px;

        background: rgba(255,255,255,.13);

        color: #fff;

        font-size: 12px;
        font-weight: 600;
    }

    .manager-hero h1 {
        margin-bottom: 7px;

        color: #fff;

        font-size: 30px;
        font-weight: 700;
    }

    .manager-hero p {
        max-width: 750px;

        margin: 0;

        color: rgba(255,255,255,.82);

        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        padding: 10px 17px;

        border-radius: 8px;

        font-size: 13px;
        font-weight: 600;

        text-decoration: none !important;

        transition: .2s ease;
    }

    .hero-btn:hover {
        transform: translateY(-2px);
    }

    .hero-btn-primary {
        background: #fff;
        color: #075985 !important;
    }

    .hero-btn-outline {
        border: 1px solid rgba(255,255,255,.50);

        background: rgba(255,255,255,.08);

        color: #fff !important;
    }


    /* =========================================================
       PAGE INNER
       ========================================================= */

    .manager-page-inner {
        position: relative;
        z-index: 5;

        margin-top: -48px;
        padding-bottom: 50px;
    }


    /* =========================================================
       STAT CARDS
       ========================================================= */

    .stat-card-link {
        display: block;

        height: 100%;

        color: inherit !important;
        text-decoration: none !important;
    }

    .stat-card {
        position: relative;

        height: 100%;

        padding: 20px;

        overflow: hidden;

        border: 1px solid transparent;
        border-radius: 13px;

        background: #fff;

        box-shadow: 0 4px 18px rgba(15,23,42,.07);

        cursor: pointer;

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            border-color .2s ease;
    }

    .stat-card-link:hover .stat-card {
        transform: translateY(-4px);

        border-color: #bae6fd;

        box-shadow: 0 12px 30px rgba(15,23,42,.13);
    }

    .stat-card::after {
        content: "\f054";

        position: absolute;

        right: 20px;
        bottom: 17px;

        font-family: "Font Awesome 5 Free";

        font-size: 10px;
        font-weight: 900;

        color: #cbd5e1;

        opacity: 0;

        transform: translateX(-5px);

        transition: .2s ease;
    }

    .stat-card-link:hover .stat-card::after {
        opacity: 1;
        transform: translateX(0);
    }

    .stat-top {
        display: flex;

        justify-content: space-between;
        align-items: flex-start;

        gap: 15px;
    }

    .stat-title {
        margin-bottom: 7px;

        color: #64748b;

        font-size: 12px;
        font-weight: 600;
    }

    .stat-number {
        margin: 0;

        color: #0f172a;

        font-size: 28px;
        font-weight: 700;
    }

    .stat-note {
        margin-top: 7px;
        padding-right: 10px;

        color: #94a3b8;

        font-size: 11px;
    }

    .stat-icon {
        display: flex;

        align-items: center;
        justify-content: center;

        width: 44px;
        height: 44px;
        min-width: 44px;

        border-radius: 11px;

        font-size: 17px;
    }

    .icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .icon-cyan {
        background: #cffafe;
        color: #0891b2;
    }

    .icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .icon-purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-red {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-yellow {
        background: #fef3c7;
        color: #d97706;
    }


    /* =========================================================
       GENERAL DASHBOARD CARD
       ========================================================= */

    .dashboard-card {
        margin-bottom: 24px;

        border: 0;
        border-radius: 13px;

        background: #fff;

        box-shadow: 0 4px 18px rgba(15,23,42,.06);
    }

    .dashboard-card .card-header {
        padding: 18px 20px;

        border-bottom: 1px solid #eef2f7;

        background: transparent;
    }

    .dashboard-card .card-body {
        padding: 20px;
    }

    .dashboard-title {
        margin: 0;

        color: #0f172a;

        font-size: 15px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        margin-top: 4px;
        margin-bottom: 0;

        color: #94a3b8;

        font-size: 11px;
    }


    /* =========================================================
       QUICK ACTION
       ========================================================= */

    .quick-action {
        display: flex;
        align-items: center;

        min-height: 78px;

        margin-bottom: 12px;
        padding: 15px;

        border: 1px solid #e8edf3;
        border-radius: 10px;

        background: #fff;

        color: inherit !important;
        text-decoration: none !important;

        transition: .2s ease;
    }

    .quick-action:hover {
        transform: translateY(-2px);

        border-color: #0284c7;

        background: #f8fcff;

        box-shadow: 0 6px 18px rgba(15,23,42,.06);
    }

    .quick-action-icon {
        display: flex;

        align-items: center;
        justify-content: center;

        width: 42px;
        height: 42px;
        min-width: 42px;

        margin-right: 12px;

        border-radius: 10px;

        background: #e0f2fe;

        color: #0284c7;
    }

    .quick-action-title {
        color: #0f172a;

        font-size: 13px;
        font-weight: 700;
    }

    .quick-action-text {
        margin-top: 2px;

        color: #94a3b8;

        font-size: 11px;
    }

    .quick-action-arrow {
        margin-left: auto;
        padding-left: 10px;

        color: #cbd5e1;
    }


    /* =========================================================
       ATTENTION
       ========================================================= */

    .attention-item {
        display: flex;

        align-items: flex-start;

        padding: 13px 0;

        border-bottom: 1px solid #f1f5f9;

        color: inherit !important;
        text-decoration: none !important;
    }

    .attention-item:last-child {
        border-bottom: 0;
    }

    .attention-icon {
        display: flex;

        align-items: center;
        justify-content: center;

        width: 37px;
        height: 37px;
        min-width: 37px;

        margin-right: 11px;

        border-radius: 9px;
    }

    .attention-title {
        color: #334155;

        font-size: 12px;
        font-weight: 700;
    }

    .attention-text {
        margin-top: 2px;

        color: #94a3b8;

        font-size: 11px;
    }


    /* =========================================================
       STOCK TABLE
       ========================================================= */

    .manager-table {
        margin-bottom: 0;
    }

    .manager-table thead th {
        padding: 12px 10px;

        border-top: 0;
        border-bottom: 1px solid #e2e8f0;

        color: #64748b;

        font-size: 10px;
        font-weight: 700;

        text-transform: uppercase;

        letter-spacing: .4px;
    }

    .manager-table tbody td {
        padding: 13px 10px;

        vertical-align: middle;

        border-color: #f1f5f9;

        color: #334155;

        font-size: 12px;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status-badge {
        display: inline-block;

        padding: 5px 9px;

        border-radius: 50px;

        font-size: 10px;
        font-weight: 700;
    }

    .status-good {
        background: #dcfce7;
        color: #15803d;
    }

    .status-warning {
        background: #fef3c7;
        color: #b45309;
    }

    .status-danger {
        background: #fee2e2;
        color: #b91c1c;
    }


    /* =========================================================
       MANAGEMENT MODULE
       ========================================================= */

    .management-module {
        display: block;

        height: 100%;

        padding: 20px;

        border: 1px solid #e8edf3;
        border-radius: 12px;

        background: #fff;

        color: inherit !important;
        text-decoration: none !important;

        transition: .2s ease;
    }

    .management-module:hover {
        transform: translateY(-3px);

        border-color: #0284c7;

        box-shadow: 0 8px 20px rgba(15,23,42,.08);
    }

    .module-icon {
        display: flex;

        align-items: center;
        justify-content: center;

        width: 45px;
        height: 45px;

        margin-bottom: 13px;

        border-radius: 11px;

        background: #e0f2fe;

        color: #0284c7;

        font-size: 17px;
    }

    .module-title {
        margin-bottom: 5px;

        color: #0f172a;

        font-size: 13px;
        font-weight: 700;
    }

    .module-description {
        color: #94a3b8;

        font-size: 11px;
        line-height: 1.6;
    }


    /* =========================================================
       PROFILE
       ========================================================= */

    .profile-summary {
        display: flex;
        align-items: center;
    }

    .profile-avatar {
        display: flex;

        align-items: center;
        justify-content: center;

        width: 46px;
        height: 46px;

        margin-right: 12px;

        border-radius: 50%;

        background: linear-gradient(
            135deg,
            #075985,
            #0284c7
        );

        color: #fff;

        font-weight: 700;
    }

    .profile-name {
        color: #0f172a;

        font-size: 13px;
        font-weight: 700;
    }

    .profile-role,
    .profile-email {
        color: #64748b;

        font-size: 11px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width: 768px) {

        .manager-hero {
            padding-top: 25px;
        }

        .manager-hero h1 {
            font-size: 24px;
        }

        .hero-actions {
            margin-top: 20px;
        }
    }

</style>


<div class="manager-dashboard">


    <!-- =========================================================
         HERO
         ========================================================= -->

    <div class="manager-hero">

        <div class="container-fluid">

            <div class="manager-hero-content">

                <div class="row align-items-center">


                    <div class="col-md-8">

                        <div class="manager-badge">

                            <i class="fas fa-user-tie"></i>

                            Laboratory Manager Subsystem

                        </div>


                        <h1>
                            Welcome, @managerName
                        </h1>


                        <p>
                            Manage the laboratory test catalogue,
                            technicians, doctors, consumable stock,
                            suppliers and orders while monitoring
                            laboratory operations.
                        </p>

                    </div>


                    <div class="col-md-4">

                        <div class="hero-actions justify-content-md-end">


                            <a asp-area="Manager"
                               asp-controller="TestTypes"
                               asp-action="Index"
                               class="hero-btn hero-btn-primary">

                                <i class="fas fa-vials"></i>

                                Test Catalogue

                            </a>


                            <a asp-area="Manager"
                               asp-controller="Consumables"
                               asp-action="LowStock"
                               class="hero-btn hero-btn-outline">

                                <i class="fas fa-triangle-exclamation"></i>

                                Stock Alerts

                            </a>


                        </div>

                    </div>


                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="container-fluid manager-page-inner">


        <!-- =====================================================
             DASHBOARD STATISTICS
             ===================================================== -->

        <div class="row">


            <!-- TEST TYPES -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="TestTypes"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Test Types
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Laboratory tests in the catalogue
                                </div>

                            </div>


                            <div class="stat-icon icon-blue">

                                <i class="fas fa-vial"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- TECHNICIANS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="Technicians"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Lab Technicians
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Registered laboratory technicians
                                </div>

                            </div>


                            <div class="stat-icon icon-cyan">

                                <i class="fas fa-user-gear"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- DOCTORS -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="Doctors"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Doctors
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Registered healthcare providers
                                </div>

                            </div>


                            <div class="stat-icon icon-purple">

                                <i class="fas fa-user-doctor"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- CONSUMABLES -->

            <div class="col-xl-3 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="Consumables"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Consumables
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Consumable stock items
                                </div>

                            </div>


                            <div class="stat-icon icon-green">

                                <i class="fas fa-boxes-stacked"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


        </div>


        <!-- SECOND STAT ROW -->

        <div class="row">


            <!-- LOW STOCK -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="Consumables"
                   asp-action="LowStock"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Low Stock
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Items near or below reorder level
                                </div>

                            </div>


                            <div class="stat-icon icon-red">

                                <i class="fas fa-triangle-exclamation"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- OPEN ORDERS -->

            <div class="col-xl-4 col-md-6 mb-4">

                <a asp-area="Manager"
                   asp-controller="Orders"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Open Orders
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Orders awaiting completion
                                </div>

                            </div>


                            <div class="stat-icon icon-orange">

                                <i class="fas fa-cart-shopping"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- SUPPLIERS -->

            <div class="col-xl-4 col-md-12 mb-4">

                <a asp-area="Manager"
                   asp-controller="Suppliers"
                   asp-action="Index"
                   class="stat-card-link">

                    <div class="stat-card">

                        <div class="stat-top">

                            <div>

                                <div class="stat-title">
                                    Suppliers
                                </div>

                                <h2 class="stat-number">
                                    0
                                </h2>

                                <div class="stat-note">
                                    Registered laboratory suppliers
                                </div>

                            </div>


                            <div class="stat-icon icon-yellow">

                                <i class="fas fa-truck"></i>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


        </div>


        <!-- =====================================================
             MANAGEMENT MODULES
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    Laboratory Management
                </h4>

                <p class="dashboard-subtitle">
                    Manage laboratory configuration, staff,
                    catalogue and stock
                </p>

            </div>


            <div class="card-body">

                <div class="row">


                    <!-- TEST CATEGORIES -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="TestCategories"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-layer-group"></i>

                            </div>

                            <div class="module-title">
                                Test Categories
                            </div>

                            <div class="module-description">
                                Maintain laboratory test
                                categories and descriptions.
                            </div>

                        </a>

                    </div>


                    <!-- TEST TYPES -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="TestTypes"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-vial"></i>

                            </div>

                            <div class="module-title">
                                Test Types
                            </div>

                            <div class="module-description">
                                Manage test names, normal ranges,
                                sample requirements and turnaround times.
                            </div>

                        </a>

                    </div>


                    <!-- SAMPLE TYPES -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="SampleTypes"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-droplet"></i>

                            </div>

                            <div class="module-title">
                                Sample Types
                            </div>

                            <div class="module-description">
                                Maintain blood, plasma and other
                                laboratory sample types.
                            </div>

                        </a>

                    </div>


                    <!-- CONSUMABLES -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="Consumables"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-boxes-stacked"></i>

                            </div>

                            <div class="module-title">
                                Consumables
                            </div>

                            <div class="module-description">
                                Monitor quantities, reorder levels
                                and laboratory stock.
                            </div>

                        </a>

                    </div>


                    <!-- SUPPLIERS -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="Suppliers"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-truck"></i>

                            </div>

                            <div class="module-title">
                                Suppliers
                            </div>

                            <div class="module-description">
                                Manage laboratory suppliers and
                                contact information.
                            </div>

                        </a>

                    </div>


                    <!-- ORDERS -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="Orders"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-cart-shopping"></i>

                            </div>

                            <div class="module-title">
                                Consumable Orders
                            </div>

                            <div class="module-description">
                                Create, receive and track
                                laboratory stock orders.
                            </div>

                        </a>

                    </div>


                    <!-- DOCTORS -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="Doctors"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-user-doctor"></i>

                            </div>

                            <div class="module-title">
                                Doctor Users
                            </div>

                            <div class="module-description">
                                Register and manage doctors and
                                healthcare providers.
                            </div>

                        </a>

                    </div>


                    <!-- TECHNICIANS -->

                    <div class="col-xl-3 col-md-6 mb-4">

                        <a asp-area="Manager"
                           asp-controller="Technicians"
                           asp-action="Index"
                           class="management-module">

                            <div class="module-icon">

                                <i class="fas fa-user-gear"></i>

                            </div>

                            <div class="module-title">
                                Lab Technicians
                            </div>

                            <div class="module-description">
                                Manage technicians and their
                                laboratory test assignments.
                            </div>

                        </a>

                    </div>


                </div>

            </div>

        </div>


        <!-- =====================================================
             STAFF + STOCK ATTENTION
             ===================================================== -->

        <div class="row">


            <!-- STAFF MANAGEMENT -->

            <div class="col-lg-7">

                <div class="dashboard-card">

                    <div class="card-header">

                        <h4 class="dashboard-title">
                            Staff Management
                        </h4>

                        <p class="dashboard-subtitle">
                            Manage laboratory personnel and
                            test-type assignments
                        </p>

                    </div>


                    <div class="card-body">

                        <div class="row">


                            <div class="col-md-6">

                                <a asp-area="Manager"
                                   asp-controller="Doctors"
                                   asp-action="Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fas fa-user-doctor"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Manage Doctors
                                        </div>

                                        <div class="quick-action-text">
                                            Register and maintain
                                            healthcare provider accounts.
                                        </div>

                                    </div>

                                    <i class="fas fa-chevron-right quick-action-arrow"></i>

                                </a>

                            </div>


                            <div class="col-md-6">

                                <a asp-area="Manager"
                                   asp-controller="Technicians"
                                   asp-action="Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fas fa-user-gear"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Manage Technicians
                                        </div>

                                        <div class="quick-action-text">
                                            Register and maintain
                                            laboratory technician accounts.
                                        </div>

                                    </div>

                                    <i class="fas fa-chevron-right quick-action-arrow"></i>

                                </a>

                            </div>


                            <div class="col-md-6">

                                <a asp-area="Manager"
                                   asp-controller="TechnicianAssignments"
                                   asp-action="Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fas fa-list-check"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Test Assignments
                                        </div>

                                        <div class="quick-action-text">
                                            Assign test types that each
                                            technician is permitted to perform.
                                        </div>

                                    </div>

                                    <i class="fas fa-chevron-right quick-action-arrow"></i>

                                </a>

                            </div>


                            <div class="col-md-6">

                                <a asp-area="Manager"
                                   asp-controller="Reports"
                                   asp-action="Index"
                                   class="quick-action">

                                    <div class="quick-action-icon">

                                        <i class="fas fa-chart-column"></i>

                                    </div>

                                    <div>

                                        <div class="quick-action-title">
                                            Management Reports
                                        </div>

                                        <div class="quick-action-text">
                                            Review laboratory test
                                            activity by category.
                                        </div>

                                    </div>

                                    <i class="fas fa-chevron-right quick-action-arrow"></i>

                                </a>

                            </div>


                        </div>

                    </div>

                </div>

            </div>


            <!-- ATTENTION -->

            <div class="col-lg-5">

                <div class="dashboard-card">

                    <div class="card-header">

                        <h4 class="dashboard-title">
                            Requires Attention
                        </h4>

                        <p class="dashboard-subtitle">
                            Laboratory stock and order alerts
                        </p>

                    </div>


                    <div class="card-body">


                        <a asp-area="Manager"
                           asp-controller="Consumables"
                           asp-action="LowStock"
                           class="attention-item">

                            <div class="attention-icon icon-red">

                                <i class="fas fa-box-open"></i>

                            </div>

                            <div>

                                <div class="attention-title">
                                    Low Stock Items
                                </div>

                                <div class="attention-text">
                                    Review consumables near or
                                    below their reorder level.
                                </div>

                            </div>

                        </a>


                        <a asp-area="Manager"
                           asp-controller="Orders"
                           asp-action="Index"
                           class="attention-item">

                            <div class="attention-icon icon-orange">

                                <i class="fas fa-cart-shopping"></i>

                            </div>

                            <div>

                                <div class="attention-title">
                                    Outstanding Orders
                                </div>

                                <div class="attention-text">
                                    Review ordered and partially
                                    completed stock orders.
                                </div>

                            </div>

                        </a>


                        <a asp-area="Manager"
                           asp-controller="TechnicianAssignments"
                           asp-action="Index"
                           class="attention-item">

                            <div class="attention-icon icon-purple">

                                <i class="fas fa-user-check"></i>

                            </div>

                            <div>

                                <div class="attention-title">
                                    Technician Assignments
                                </div>

                                <div class="attention-text">
                                    Review technician test-type
                                    permissions and assignments.
                                </div>

                            </div>

                        </a>


                        <a asp-area="Manager"
                           asp-controller="Orders"
                           asp-action="Create"
                           class="attention-item">

                            <div class="attention-icon icon-green">

                                <i class="fas fa-plus"></i>

                            </div>

                            <div>

                                <div class="attention-title">
                                    Create Stock Order
                                </div>

                                <div class="attention-text">
                                    Create supplier orders for
                                    required consumable stock.
                                </div>

                            </div>

                        </a>


                    </div>

                </div>

            </div>


        </div>


        <!-- =====================================================
             STOCK OVERVIEW
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <div class="row align-items-center">


                    <div class="col-md-8">

                        <h4 class="dashboard-title">
                            Consumable Stock Overview
                        </h4>

                        <p class="dashboard-subtitle">
                            Monitor laboratory consumables and
                            reorder levels
                        </p>

                    </div>


                    <div class="col-md-4 text-md-right mt-2 mt-md-0">

                        <a asp-area="Manager"
                           asp-controller="Consumables"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm">

                            <i class="fas fa-boxes-stacked mr-1"></i>

                            Manage Stock

                        </a>

                    </div>


                </div>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table manager-table">

                        <thead>

                            <tr>

                                <th>
                                    Consumable
                                </th>

                                <th>
                                    Supplier
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Reorder Level
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <tr>

                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <i class="fas fa-boxes-stacked fa-2x mb-3 d-block"></i>

                                    Stock information will appear here.

                                    <div class="mt-3">

                                        <a asp-area="Manager"
                                           asp-controller="Consumables"
                                           asp-action="Index"
                                           class="btn btn-primary btn-sm">

                                            <i class="fas fa-eye mr-1"></i>

                                            View Consumables

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- =====================================================
             STOCK ORDER MANAGEMENT
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    Consumable Order Management
                </h4>

                <p class="dashboard-subtitle">
                    Create and track supplier stock orders
                </p>

            </div>


            <div class="card-body">

                <div class="row">


                    <div class="col-md-4">

                        <a asp-area="Manager"
                           asp-controller="Orders"
                           asp-action="Create"
                           class="quick-action">

                            <div class="quick-action-icon">

                                <i class="fas fa-cart-plus"></i>

                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Create Order
                                </div>

                                <div class="quick-action-text">
                                    Create a new consumable
                                    stock order.
                                </div>

                            </div>

                            <i class="fas fa-chevron-right quick-action-arrow"></i>

                        </a>

                    </div>


                    <div class="col-md-4">

                        <a asp-area="Manager"
                           asp-controller="Orders"
                           asp-action="Index"
                           class="quick-action">

                            <div class="quick-action-icon">

                                <i class="fas fa-truck-ramp-box"></i>

                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Track Orders
                                </div>

                                <div class="quick-action-text">
                                    View ordered, partial and
                                    completed orders.
                                </div>

                            </div>

                            <i class="fas fa-chevron-right quick-action-arrow"></i>

                        </a>

                    </div>


                    <div class="col-md-4">

                        <a asp-area="Manager"
                           asp-controller="Suppliers"
                           asp-action="Index"
                           class="quick-action">

                            <div class="quick-action-icon">

                                <i class="fas fa-truck"></i>

                            </div>

                            <div>

                                <div class="quick-action-title">
                                    Suppliers
                                </div>

                                <div class="quick-action-text">
                                    Manage supplier details and
                                    contact information.
                                </div>

                            </div>

                            <i class="fas fa-chevron-right quick-action-arrow"></i>

                        </a>

                    </div>


                </div>

            </div>

        </div>


        <!-- =====================================================
             REPORTING
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    Management Reports
                </h4>

                <p class="dashboard-subtitle">
                    Generate laboratory management reports
                    within a selected date range
                </p>

            </div>


            <div class="card-body">

                <div class="row align-items-center">


                    <div class="col-md-8">

                        <div class="d-flex align-items-center">

                            <div class="quick-action-icon mr-3">

                                <i class="fas fa-file-pdf"></i>

                            </div>


                            <div>

                                <div class="quick-action-title">
                                    Tests Performed by Category
                                </div>

                                <div class="quick-action-text">
                                    Generate a PDF report showing
                                    total tests performed grouped
                                    by laboratory test category.
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4 text-md-right mt-3 mt-md-0">

                        <a asp-area="Manager"
                           asp-controller="Reports"
                           asp-action="Index"
                           class="btn btn-primary btn-sm">

                            <i class="fas fa-file-pdf mr-1"></i>

                            Generate Report

                        </a>

                    </div>


                </div>

            </div>

        </div>


        <!-- =====================================================
             ACCOUNT & SECURITY
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <h4 class="dashboard-title">
                    My Account & Security
                </h4>

                <p class="dashboard-subtitle">
                    Manage your Laboratory Manager profile
                    and account security
                </p>

            </div>


            <div class="card-body">

                <div class="row align-items-center">


                    <div class="col-md-6">

                        <div class="profile-summary">


                            <div class="profile-avatar">

                                @managerInitial

                            </div>


                            <div>

                                <div class="profile-name">
                                    @managerName
                                </div>

                                <div class="profile-role">
                                    Laboratory Manager
                                </div>

                                <div class="profile-email">
                                    @managerEmail
                                </div>

                            </div>


                        </div>

                    </div>


                    <div class="col-md-6 text-md-right mt-3 mt-md-0">


                        <a asp-area="Manager"
                           asp-controller="Profile"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm mr-2">

                            <i class="fas fa-user mr-1"></i>

                            My Profile

                        </a>


                        <a asp-area="Manager"
                           asp-controller="Profile"
                           asp-action="ChangePassword"
                           class="btn btn-outline-secondary btn-sm mr-2">

                            <i class="fas fa-key mr-1"></i>

                            Change Password

                        </a>


                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">

                                <i class="fas fa-sign-out-alt mr-1"></i>

                                Secure Logout

                            </button>

                        </form>


                    </div>


                </div>

            </div>

        </div>


    </div>

</div>