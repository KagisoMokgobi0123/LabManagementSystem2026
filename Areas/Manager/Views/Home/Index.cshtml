@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const canvas = document.getElementById("testCategoryChart");

        if (!canvas) {
        return;
        }

        const labels = @Html.Raw(categoryLabels);
        const values = @Html.Raw(categoryCounts);

        if (!labels.length || !values.length) {
        return;
        }

        new Chart(canvas, {
        type: "bar",

        data: {
        labels: labels,
        datasets: [{
        label: "Number of Active Test Types",
        data: values,
        backgroundColor: [
        "rgba(2, 132, 199, 0.80)",
        "rgba(8, 145, 178, 0.80)",
        "rgba(22, 163, 74, 0.80)",
        "rgba(147, 51, 234, 0.80)",
        "rgba(234, 88, 12, 0.80)",
        "rgba(217, 119, 6, 0.80)",
        "rgba(220, 38, 38, 0.80)"
        ],
        borderColor: [
        "#0284c7",
        "#0891b2",
        "#16a34a",
        "#9333ea",
        "#ea580c",
        "#d97706",
        "#dc2626"
        ],
        borderWidth: 1,
        borderRadius: 6,
        maxBarThickness: 55
        }]
        },

        options: {
        responsive: true,
        maintainAspectRatio: false,

        plugins: {
        legend: {
        display: false
        },
        tooltip: {
        callbacks: {
        label: function (context) {
        const count = context.parsed.y;
        return count + (count === 1
        ? " active test type"
        : " active test types");
        }
        }
        }
        },

        scales: {
        x: {
        title: {
        display: true,
        text: "Test Category",
        color: "#64748b"
        },
        grid: {
        display: false
        },
        ticks: {
        color: "#64748b",
        maxRotation: 45,
        minRotation: 0
        }
        },

        y: {
        beginAtZero: true,
        ticks: {
        precision: 0,
        stepSize: 1,
        color: "#64748b"
        },
        title: {
        display: true,
        text: "Number of Test Types",
        color: "#64748b"
        },
        grid: {
        color: "#eef2f7"
        }
        }
        }
        }
        });
        });
    </script>
}