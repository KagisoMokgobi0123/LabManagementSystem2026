@model NMB_HLabSys.Areas.Manager.Models.LabManagerDashboardViewModel
@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@using System.Text.Json
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Laboratory Manager Dashboard";
    Layout = "_LabManagerLayout";

    var currentUser = await UserManager.GetUserAsync(User);
    var managerName = Model.ManagerName ?? currentUser?.FullName ?? "Laboratory Manager";
    var managerEmail = Model.ManagerEmail ?? currentUser?.Email ?? "";

    var managerInitial = !string.IsNullOrWhiteSpace(currentUser?.FirstName)
        ? currentUser.FirstName.Substring(0, 1).ToUpper()
        : "M";

    var categoryLabels = JsonSerializer.Serialize(
        Model.TestCategorySummaries.Select(x => x.CategoryName));

    var categoryCounts = JsonSerializer.Serialize(
        Model.TestCategorySummaries.Select(x => x.TestCount));
}

<style>
    .manager-dashboard {
        min-height: 100vh;
        background: #f4f7fb;
    }

    .manager-hero {
        position: relative;
        overflow: hidden;
        padding: 38px 0 82px;
        background: linear-gradient(135deg, #073b5c 0%, #075985 45%, #0284c7 100%);
    }

        .manager-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: 220px;
            bottom: -190px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
        }

        .manager-hero::after {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -100px;
            top: -210px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

    .manager-hero-content {
        position: relative;
        z-index: 2;
    }

    .manager-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        margin-bottom: 14px;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50px;
        background: rgba(255,255,255,.13);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

    .manager-hero h1 {
        margin-bottom: 7px;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
    }

    .manager-hero p {
        max-width: 750px;
        margin: 0;
        color: rgba(255,255,255,.82);
        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s ease;
    }

        .hero-btn:hover {
            transform: translateY(-2px);
        }

    .hero-btn-outline {
        border: 1px solid rgba(255,255,255,.50);
        background: rgba(255,255,255,.08);
        color: #fff !important;
    }

    .manager-page-inner {
        position: relative;
        z-index: 5;
        margin-top: -48px;
        padding-bottom: 50px;
    }

    .stat-card-link {
        display: block;
        height: 100%;
        color: inherit !important;
        text-decoration: none !important;
    }

    .stat-card {
        position: relative;
        height: 100%;
        padding: 20px;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.07);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .stat-card-link:hover .stat-card {
        transform: translateY(-4px);
        border-color: #bae6fd;
        box-shadow: 0 12px 30px rgba(15,23,42,.13);
    }

    .stat-card::after {
        content: "\f054";
        position: absolute;
        right: 20px;
        bottom: 17px;
        font-family: "Font Awesome 5 Free";
        font-size: 10px;
        font-weight: 900;
        color: #cbd5e1;
        opacity: 0;
        transform: translateX(-5px);
        transition: .2s ease;
    }

    .stat-card-link:hover .stat-card::after {
        opacity: 1;
        transform: translateX(0);
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }

    .stat-title {
        margin-bottom: 7px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .stat-number {
        margin: 0;
        color: #0f172a;
        font-size: 28px;
        font-weight: 700;
    }

    .stat-note {
        margin-top: 7px;
        padding-right: 10px;
        color: #94a3b8;
        font-size: 11px;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 11px;
        font-size: 17px;
    }

    .icon-blue {
        background: #e0f2fe;
        color: #0284c7;
    }

    .icon-cyan {
        background: #cffafe;
        color: #0891b2;
    }

    .icon-green {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .icon-purple {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-red {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-yellow {
        background: #fef3c7;
        color: #d97706;
    }

    .dashboard-card {
        margin-bottom: 24px;
        border: 0;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(15,23,42,.06);
    }

        .dashboard-card .card-header {
            padding: 18px 20px;
            border-bottom: 1px solid #eef2f7;
            background: transparent;
        }

        .dashboard-card .card-body {
            padding: 20px;
        }

    .dashboard-title {
        margin: 0;
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        margin-top: 4px;
        margin-bottom: 0;
        color: #94a3b8;
        font-size: 11px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        min-height: 78px;
        margin-bottom: 12px;
        padding: 15px;
        border: 1px solid #e8edf3;
        border-radius: 10px;
        background: #fff;
        color: inherit !important;
        text-decoration: none !important;
        transition: .2s ease;
    }

        .quick-action:hover {
            transform: translateY(-2px);
            border-color: #0284c7;
            background: #f8fcff;
            box-shadow: 0 6px 18px rgba(15,23,42,.06);
        }

    .quick-action-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        min-width: 42px;
        margin-right: 12px;
        border-radius: 10px;
        background: #e0f2fe;
        color: #0284c7;
    }

    .quick-action-title {
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }

    .quick-action-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    .quick-action-arrow {
        margin-left: auto;
        padding-left: 10px;
        color: #cbd5e1;
    }

    .attention-item {
        display: flex;
        align-items: flex-start;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
        color: inherit !important;
        text-decoration: none !important;
    }

        .attention-item:last-child {
            border-bottom: 0;
        }

    .attention-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 37px;
        height: 37px;
        min-width: 37px;
        margin-right: 11px;
        border-radius: 9px;
    }

    .attention-title {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
    }

    .attention-text {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 11px;
    }

    .manager-table {
        margin-bottom: 0;
    }

        .manager-table thead th {
            padding: 12px 10px;
            border-top: 0;
            border-bottom: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .manager-table tbody td {
            padding: 13px 10px;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: #334155;
            font-size: 12px;
        }

    .status-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 50px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-good {
        background: #dcfce7;
        color: #15803d;
    }

    .status-warning {
        background: #fef3c7;
        color: #b45309;
    }

    .status-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .chart-container {
        position: relative;
        width: 100%;
        min-height: 300px;
        height: 340px;
    }

    .empty-state {
        padding: 45px 15px;
        text-align: center;
        color: #94a3b8;
        font-size: 12px;
    }

        .empty-state i {
            display: block;
            margin-bottom: 14px;
            color: #cbd5e1;
        }

    @@media(max-width: 768px) {
        .manager-hero {
            padding-top: 25px;
        }

            .manager-hero h1 {
                font-size: 24px;
            }

        .hero-actions {
            margin-top: 20px;
        }

        .chart-container {
            height: 280px;
        }
    }
</style>

<div class="manager-dashboard">

    <!-- DASHBOARD HEADER -->
    <div class="manager-hero">
        <div class="container-fluid">
            <div class="manager-hero-content">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="manager-badge">
                            <i class="fas fa-user-tie"></i>
                            Laboratory Manager Subsystem
                        </div>

                        <h1>Welcome, @managerName</h1>

                        <p>
                            Manage the laboratory test catalogue, technicians,
                            doctors, consumable stock, suppliers and orders
                            while monitoring laboratory operations.
                        </p>
                    </div>

                    <div class="col-md-4">
                        <div class="hero-actions justify-content-md-end">
                            <a href="/Manager/Order/Index"
                               class="hero-btn hero-btn-outline">
                                <i class="fas fa-triangle-exclamation"></i>
                                Stock Alerts
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid manager-page-inner">

        <!-- PRIMARY STATISTICS -->
        <div class="row">

            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/Manager/TestType/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Test Types</div>
                                <h2 class="stat-number">@Model.TestTypeCount</h2>
                                <div class="stat-note">Laboratory tests in the catalogue</div>
                            </div>
                            <div class="stat-icon icon-blue">
                                <i class="fas fa-vial"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/Manager/User/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Lab Technicians</div>
                                <h2 class="stat-number">@Model.TechnicianCount</h2>
                                <div class="stat-note">Registered laboratory technicians</div>
                            </div>
                            <div class="stat-icon icon-cyan">
                                <i class="fas fa-user-gear"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/Manager/User/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Doctors</div>
                                <h2 class="stat-number">@Model.DoctorCount</h2>
                                <div class="stat-note">Registered healthcare providers</div>
                            </div>
                            <div class="stat-icon icon-purple">
                                <i class="fas fa-user-doctor"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <a href="/Manager/Consumable/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Consumables</div>
                                <h2 class="stat-number">@Model.ConsumableCount</h2>
                                <div class="stat-note">Consumable stock items</div>
                            </div>
                            <div class="stat-icon icon-green">
                                <i class="fas fa-boxes-stacked"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        </div>

        <!-- INVENTORY AND ORDER STATISTICS -->
        <div class="row">

            <div class="col-xl-4 col-md-6 mb-4">
                <a href="/Manager/Consumable/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Low Stock</div>
                                <h2 class="stat-number">@Model.LowStockCount</h2>
                                <div class="stat-note">Items near or below reorder level</div>
                            </div>
                            <div class="stat-icon icon-red">
                                <i class="fas fa-triangle-exclamation"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-4 col-md-6 mb-4">
                <a href="/Manager/StockAdjustment/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Open Orders</div>
                                <h2 class="stat-number">@Model.OpenOrderCount</h2>
                                <div class="stat-note">Orders awaiting completion</div>
                            </div>
                            <div class="stat-icon icon-orange">
                                <i class="fas fa-cart-shopping"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-xl-4 col-md-12 mb-4">
                <a href="/Manager/Supplier/Index" class="stat-card-link">
                    <div class="stat-card">
                        <div class="stat-top">
                            <div>
                                <div class="stat-title">Suppliers</div>
                                <h2 class="stat-number">@Model.SupplierCount</h2>
                                <div class="stat-note">Registered laboratory suppliers</div>
                            </div>
                            <div class="stat-icon icon-yellow">
                                <i class="fas fa-truck"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        </div>

        <!-- LABORATORY MANAGEMENT -->
        <div class="dashboard-card">
            <div class="card-header">
                <h4 class="dashboard-title">Laboratory Management</h4>
                <p class="dashboard-subtitle">
                    Manage laboratory configuration, staff, catalogue and stock.
                </p>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-6">
                        <a href="@Url.Action("Index","User",new {area = "Manager"})"  class="quick-action">
                            <div class="quick-action-icon">
                                <i class="fas fa-user-doctor"></i>
                            </div>
                            <div>
                                <div class="quick-action-title">Manage Doctors</div>
                                <div class="quick-action-text">
                                    Register and maintain healthcare provider accounts.
                                </div>
                            </div>
                            <i class="fas fa-chevron-right quick-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a href="@Url.Action("Index", "User", new { area = "Manager" })" class="quick-action">
                            <div class="quick-action-icon">
                                <i class="fas fa-user-gear"></i>
                            </div>
                            <div>
                                <div class="quick-action-title">Manage Technicians</div>
                                <div class="quick-action-text">
                                    Register and maintain laboratory technician accounts.
                                </div>
                            </div>
                            <i class="fas fa-chevron-right quick-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a href="@Url.Action("Index", "TechnicianAssignments", new { area = "Manager" })" class="quick-action">
                            <div class="quick-action-icon">
                                <i class="fas fa-list-check"></i>
                            </div>
                            <div>
                                <div class="quick-action-title">Test Assignments</div>
                                <div class="quick-action-text">
                                    Assign test types that each technician is permitted to perform.
                                </div>
                            </div>
                            <i class="fas fa-chevron-right quick-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a href="@Url.Action("Index", "Reports", new { area = "Manager" })" class="quick-action">
                            <div class="quick-action-icon">
                                <i class="fas fa-chart-column"></i>
                            </div>
                            <div>
                                <div class="quick-action-title">Management Reports</div>
                                <div class="quick-action-text">
                                    Review laboratory activity and test categories.
                                </div>
                            </div>
                            <i class="fas fa-chevron-right quick-action-arrow"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- CATEGORY GRAPH AND ATTENTION -->
        <div class="row">

            <div class="col-lg-7">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h4 class="dashboard-title">Test Type vs Category</h4>
                        <p class="dashboard-subtitle">
                            Distribution of active laboratory tests by category
                        </p>
                    </div>

                    <div class="card-body">
                        @if (Model.TestCategorySummaries != null &&
                             Model.TestCategorySummaries.Any())
                        {
                            <div class="chart-container">
                                <canvas id="testCategoryChart"
                                        aria-label="Bar chart showing active test types by category"
                                        role="img"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-chart-column fa-2x"></i>
                                No active test category data is available to display.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="dashboard-card">
                    <div class="card-header">
                        <h4 class="dashboard-title">Requires Attention</h4>
                        <p class="dashboard-subtitle">Laboratory stock and order alerts</p>
                    </div>

                    <div class="card-body">

                        <a href="@Url.Action("Index", "Consumable", new { area = "Manager" })" class="attention-item">
                            <div class="attention-icon icon-red">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div>
                                <div class="attention-title">Low Stock Items</div>
                                <div class="attention-text">
                                    @Model.LowStockCount consumable items require stock-level review.
                                </div>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "StockAdjustment", new { area = "Manager" })" class="attention-item">
                            <div class="attention-icon icon-orange">
                                <i class="fas fa-cart-shopping"></i>
                            </div>
                            <div>
                                <div class="attention-title">Outstanding Orders</div>
                                <div class="attention-text">
                                    @Model.OpenOrderCount orders are awaiting completion.
                                </div>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "TechnicianAssignments", new { area = "Manager" })" class="attention-item">
                            <div class="attention-icon icon-purple">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div>
                                <div class="attention-title">Technician Assignments</div>
                                <div class="attention-text">
                                    Review technician test-type permissions and assignments.
                                </div>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "Order", new { area = "Manager" })" class="attention-item">
                            <div class="attention-icon icon-green">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div>
                                <div class="attention-title">Create Stock Order</div>
                                <div class="attention-text">
                                    Create supplier orders for required consumables.
                                </div>
                            </div>
                        </a>

                    </div>
                </div>
            </div>

        </div>

        <!-- CONSUMABLE STOCK OVERVIEW -->
        <div class="dashboard-card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h4 class="dashboard-title">Consumable Stock Overview</h4>
                        <p class="dashboard-subtitle">
                            Monitor laboratory consumables and reorder levels.
                        </p>
                    </div>

                    <div class="col-md-4 text-md-right mt-2 mt-md-0">
                        <a href="@Url.Action("Index", "Consumable", new { area = "Manager" })"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-boxes-stacked mr-1"></i>
                            Manage Stock
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table manager-table">
                        <thead>
                            <tr>
                                <th>Consumable</th>
                                <th>Supplier</th>
                                <th>Quantity</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Consumables != null && Model.Consumables.Any())
                            {
                                @foreach (var item in Model.Consumables)
                                {
                                    <tr>
                                        <td>@item.ConsumableName</td>
                                        <td>@item.SupplierName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.ReorderLevel</td>
                                        <td>
                                            @if (item.Quantity == 0)
                                            {
                                                <span class="status-badge status-danger">Out of Stock</span>
                                            }
                                            else if (item.Quantity <= item.ReorderLevel)
                                            {
                                                <span class="status-badge status-danger">Low Stock</span>
                                            }
                                            else if (item.Status == "Reorder Soon")
                                            {
                                                <span class="status-badge status-warning">Reorder Soon</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-good">Sufficient</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action(" Index", "Consumable" , new { area="Manager" })"
                                               class="btn btn-outline-primary btn-sm">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-boxes-stacked fa-2x mb-3 d-block"></i>
                                        No consumable stock records are available.
                                        <div class="mt-3">
                                            <a href="@Url.Action(" Index", "Consumable", new { area = "Manager" })"
