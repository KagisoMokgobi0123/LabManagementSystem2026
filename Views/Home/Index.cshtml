<script>

    /* ==========================================================
       BACKGROUND VIDEO
       ========================================================== */

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const heroVideo =
                document.querySelector(".hero-video");


            if (!heroVideo) {
                return;
            }


            /*
             * Required for autoplay support.
             */
            heroVideo.muted = true;

            heroVideo.defaultMuted = true;


            const playPromise =
                heroVideo.play();


            if (playPromise !== undefined) {

                playPromise.catch(
                    function(error) {

                        console.log(
                            "Background video autoplay was prevented:",
                            error
                        );

                    }
                );

            }

        }
    );

</script>