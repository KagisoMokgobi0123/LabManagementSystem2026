@{
	ViewData["Title"] = "NMB_HLabSys | Home";
	Layout = "_LandInLayout";
}

<div id="page-wrapper">

	<!-- Header -->
    <div id="header" class="nmb-banner">

		<!-- Inner -->
		<div class="inner">
			<header>
				<h1><a href="index.html" id="logo">NMB-HLabSys Gqeberha</a></h1>
				<hr />
				<p>Laboratory Test Request Management System</p>
			</header>
			<footer>
				<a href="#banner" class="button circled scrolly">Sign In</a>
			</footer>
		</div>

		<!-- Nav -->
        <!-- Navigation -->
        <nav id="nav" class="nmb-nav">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="About">Services</a>

                    <ul>
                        <li><a href="#">Haematology Testing</a></li>
                        <li><a href="#">Blood Sample Processing</a></li>
                        <li><a href="#">Laboratory Results</a></li>
                        <li><a href="#">Diagnostic Reports</a></li>
                    </ul>
                </li>

                <li>
                    <a href="#">Forum</a>
                </li>

                <li>
                    <a asp-controller="Home" asp-action="About">About</a>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Register">
                        Register
                    </a>
                </li>

                <li>
                    <a asp-controller="Account" asp-action="Login">
                        Sign In
                    </a>
                </li>
            </ul>
        </nav>
		</div>

		<!-- Banner -->
        <section id="banner" class="nmb-banner" style="background:">
            <header>
                <h2>
                    Welcome to <strong>NMB-HLabSys</strong>
                </h2>

                <p>
                    Nelson Mandela Bay Haematology Diagnostic Laboratories provides
                    diagnostic haematology testing for local clinics, hospitals,
                    private doctors and patients.
                </p>
            </header>
        </section>

		<!-- Carousel -->
		<section class="carousel">
			<div class="reel">

				<article>
					<a href="#" class="image featured">
						<img src="images/blood-samples.jpg" alt="Blood Samples" />
					</a>
					<header>
						<h3><a href="#">Blood Sample Collection</a></h3>
					</header>
					<p>
						Patient blood samples are collected and prepared for
						diagnostic haematology testing.
					</p>
				</article>

				<article>
					<a href="#" class="image featured">
						<img src="images/laboratory-testing.jpg" alt="Laboratory Testing" />
					</a>
					<header>
						<h3><a href="#">Laboratory Testing</a></h3>
					</header>
					<p>
						Laboratory technicians perform requested tests and
						accurately capture patient results.
					</p>
				</article>

				<article>
					<a href="#" class="image featured">
						<img src="images/microscope.jpg" alt="Microscope Analysis" />
					</a>
					<header>
						<h3><a href="#">Blood Analysis</a></h3>
					</header>
					<p>
						Laboratory analysis assists healthcare professionals
						in identifying blood-related abnormalities.
					</p>
				</article>

				<article>
					<a href="#" class="image featured">
						<img src="images/haematology-analyser.jpg" alt="Haematology Analyser" />
					</a>
					<header>
						<h3><a href="#">Diagnostic Haematology</a></h3>
					</header>
					<p>
						Modern laboratory equipment supports efficient and
						accurate diagnostic testing.
					</p>
				</article>

				<article>
					<a href="#" class="image featured">
						<img src="images/lab-report.jpg" alt="Laboratory Report" />
					</a>
					<header>
						<h3><a href="#">Laboratory Results</a></h3>
					</header>
					<p>
						Verified laboratory results are securely made available
						to doctors and authorised patients.
					</p>
				</article>

			</div>
		</section>
		<!-- Main -->
		<!-- Features -->
    <div class="wrapper style1">

			<section id="features" class="container special">

				<header>
					<h2>Nelson Mandela Bay Haematology Diagnostic Laboratories</h2>

					<p>
						Supporting doctors, patients and laboratory professionals
						through an efficient digital diagnostic process.
					</p>
				</header>

				<div class="row">

					<article class="col-4 col-12-mobile special">

						<a href="#" class="image featured">
							<img src="images/doctor-request.jpg"
								 alt="Doctor submitting test request" />
						</a>

						<header>
							<h3><a href="#">Digital Test Requests</a></h3>
						</header>

						<p>
							Doctors can submit laboratory test requests electronically,
							reducing missing information and delays associated with
							paper forms and e-mails.
						</p>

					</article>


					<article class="col-4 col-12-mobile special">

						<a href="#" class="image featured">
							<img src="images/lab-technician.jpg"
								 alt="Laboratory Technician" />
						</a>

						<header>
							<h3><a href="#">Laboratory Processing</a></h3>
						</header>

						<p>
							Laboratory technicians can receive patient samples,
							perform requested haematology tests and capture
							laboratory results.
						</p>

					</article>


					<article class="col-4 col-12-mobile special">

						<a href="#" class="image featured">
							<img src="images/patient-results.jpg"
								 alt="Patient laboratory results" />
						</a>

						<header>
							<h3><a href="#">Secure Patient Results</a></h3>
						</header>

						<p>
							Patients can securely access their verified laboratory
							results while doctors can review official diagnostic
							reports and patient test history.
						</p>

					</article>

				</div>

			</section>

		</div>
		<!-- Footer -->
        <div id="footer">
            <div class="container">
                <div class="row">

                    <!-- Laboratory Updates -->
                    <section class="col-4 col-12-mobile">
                        <header>
                            <h2 class="icon solid fa-flask circled">
                                <span class="label">Laboratory Updates</span>
                            </h2>
                        </header>

                        <ul class="divided">
                            <li>
                                <article class="tweet">
                                    Patient samples received and prepared for diagnostic testing.
                                    <span class="timestamp">Laboratory Services</span>
                                </article>
                            </li>

                            <li>
                                <article class="tweet">
                                    Haematology tests help identify abnormalities in blood cells
                                    and support accurate diagnosis.
                                    <span class="timestamp">Haematology Testing</span>
                                </article>
                            </li>

                            <li>
                                <article class="tweet">
                                    Laboratory results are reviewed and verified before official
                                    reports are released.
                                    <span class="timestamp">Result Verification</span>
                                </article>
                            </li>

                            <li>
                                <article class="tweet">
                                    NMBHDL provides diagnostic laboratory services to doctors,
                                    clinics, hospitals and patients.
                                    <span class="timestamp">NMBHDL Gqeberha</span>
                                </article>
                            </li>
                        </ul>
                    </section>


                    <!-- Our Services -->
                    <section class="col-4 col-12-mobile">
                        <header>
                            <h2 class="icon solid fa-file-medical circled">
                                <span class="label">Services</span>
                            </h2>
                        </header>

                        <ul class="divided">

                            <li>
                                <article class="post stub">
                                    <header>
                                        <h3>
                                            <a href="#">Haematology Testing</a>
                                        </h3>
                                    </header>
                                    <span class="timestamp">
                                        Diagnostic blood analysis
                                    </span>
                                </article>
                            </li>

                            <li>
                                <article class="post stub">
                                    <header>
                                        <h3>
                                            <a href="#">Blood Sample Processing</a>
                                        </h3>
                                    </header>
                                    <span class="timestamp">
                                        Sample reception and processing
                                    </span>
                                </article>
                            </li>

                            <li>
                                <article class="post stub">
                                    <header>
                                        <h3>
                                            <a href="#">Laboratory Results</a>
                                        </h3>
                                    </header>
                                    <span class="timestamp">
                                        Result capture and verification
                                    </span>
                                </article>
                            </li>

                            <li>
                                <article class="post stub">
                                    <header>
                                        <h3>
                                            <a href="#">Diagnostic Reports</a>
                                        </h3>
                                    </header>
                                    <span class="timestamp">
                                        Secure laboratory reporting
                                    </span>
                                </article>
                            </li>

                        </ul>
                    </section>


                    <!-- Laboratory Gallery -->
                    <section class="col-4 col-12-mobile">
                        <header>
                            <h2 class="icon solid fa-camera circled">
                                <span class="label">Laboratory Gallery</span>
                            </h2>
                        </header>

                        <div class="row gtr-25">

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/blood-samples.jpg"
                                         alt="Patient blood samples" />
                                </a>
                            </div>

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/lab-technician.jpg"
                                         alt="Laboratory technician" />
                                </a>
                            </div>

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/microscope.jpg"
                                         alt="Laboratory microscope" />
                                </a>
                            </div>

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/haematology-analyser.jpg"
                                         alt="Haematology analyser" />
                                </a>
                            </div>

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/laboratory-testing.jpg"
                                         alt="Laboratory testing" />
                                </a>
                            </div>

                            <div class="col-6">
                                <a href="#" class="image fit">
                                    <img src="images/lab-report.jpg"
                                         alt="Laboratory diagnostic report" />
                                </a>
                            </div>

                        </div>
                    </section>

                </div>

                <hr />

                <div class="row">
                    <div class="col-12">

                        <!-- Contact -->
                        <section class="contact">

                            <header>
                                <h3>
                                    Nelson Mandela Bay Haematology Diagnostic Laboratories
                                </h3>
                            </header>

                            <p>
                                Providing reliable diagnostic haematology services to
                                doctors, clinics, hospitals and patients in Nelson Mandela Bay.
                            </p>

                            <ul class="icons">

                                <li>
                                    <a href="#" class="icon solid fa-envelope">
                                        <span class="label">Email</span>
                                    </a>
                                </li>

                                <li>
                                    <a href="#" class="icon solid fa-phone">
                                        <span class="label">Phone</span>
                                    </a>
                                </li>

                                <li>
                                    <a href="#" class="icon brands fa-facebook-f">
                                        <span class="label">Facebook</span>
                                    </a>
                                </li>

                                <li>
                                    <a href="#" class="icon brands fa-linkedin-in">
                                        <span class="label">LinkedIn</span>
                                    </a>
                                </li>

                            </ul>

                        </section>


                        <!-- Copyright -->
                        <div class="copyright">
                            <ul class="menu">

                                <li>
                                    &copy; @DateTime.Now.Year NMB-HLabSys.
                                    All rights reserved.
                                </li>

                                <li>
                                    Nelson Mandela Bay Haematology Diagnostic Laboratories
                                </li>

                                <li>
                                    Laboratory Test Request Management System
                                </li>

                            </ul>
                        </div>

                    </div>
                </div>

            </div>
        </div>
	</div>

	






