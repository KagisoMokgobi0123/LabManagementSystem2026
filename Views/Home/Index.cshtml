@{
    ViewData["Title"] = "NMB_HLabSys | Home";
    Layout = "_LandInLayout";
}

<style>

    /* ==========================================================
           VIDEO HERO
           ========================================================== */

    #header.video-hero {
        position: relative !important;
        min-height: 100vh;
        overflow: hidden;
        /*
             * IMPORTANT:
             * Do not place a solid blue background over the video.
             */
        background: transparent !important;
        background-image: none !important;
    }


        /* ==========================================================
           BACKGROUND VIDEO
           ========================================================== */

        #header.video-hero .hero-video {
            position: absolute !important;
            top: 0;
            left: 0;
            width: 100% !important;
            height: 100% !important;
            min-width: 100%;
            min-height: 100%;
            object-fit: cover;
            object-position: center center;
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
            z-index: 0 !important;
            pointer-events: none;
        }


        /* ==========================================================
           VERY LIGHT TRANSPARENT BLUE OVERLAY

           Video = z-index 0
           Overlay = z-index 1
           Content = z-index 5
           Navigation = z-index 20
           ========================================================== */

        #header.video-hero .hero-video-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            /*
             * Only 6% opacity.
             * This gives the video a slight blue tint without hiding it.
             */
            background: rgba(0, 80, 120, 0.06) !important;
            pointer-events: none;
        }


        /* ==========================================================
           HERO CONTENT
           ========================================================== */

        #header.video-hero .inner {
            position: relative !important;
            z-index: 5 !important;
            background: transparent !important;
        }


        #header.video-hero .hero-content {
            background: transparent !important;
        }


        #header.video-hero header,
        #header.video-hero footer {
            background: transparent !important;
        }


    /* ==========================================================
           HERO LOGO
           ========================================================== */

    #header .hero-logo {
        display: block;
        width: 125px;
        max-width: 30vw;
        height: auto;
        margin: 0 auto 22px auto;
        position: relative;
        z-index: 6;
        filter: drop-shadow( 0 4px 10px rgba(0, 0, 0, .30) );
    }


    /* ==========================================================
           HERO TEXT
           ========================================================== */

    #header.video-hero h1,
    #header.video-hero h1 a,
    #header.video-hero #logo {
        color: #ffffff !important;
        text-shadow: 0 3px 12px rgba(0, 0, 0, .65);
    }


    #header.video-hero header p {
        color: #ffffff !important;
        font-weight: 500;
        text-shadow: 0 2px 8px rgba(0, 0, 0, .75);
    }


    #header.video-hero hr {
        border-color: rgba(255, 255, 255, .55) !important;
    }


    /* ==========================================================
           NAVIGATION
           ========================================================== */

    #header.video-hero #nav {
        position: absolute;
        z-index: 20 !important;
        background: transparent !important;
    }


        #header.video-hero #nav > ul {
            position: relative;
            z-index: 21;
        }


        #header.video-hero #nav a {
            color: #ffffff !important;
            font-weight: 600;
            text-shadow: 0 2px 6px rgba(0, 0, 0, .75);
        }


        /* Dropdown */

        #header.video-hero #nav ul ul {
            background: rgba(5, 47, 74, .92) !important;
            border-radius: 8px;
        }


            #header.video-hero #nav ul ul a {
                color: #ffffff !important;
                text-shadow: none;
            }


    /* ==========================================================
           SIGN IN BUTTON
           ========================================================== */

    #header.video-hero .button.circled {
        background: rgba(0, 136, 169, .78) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, .45);
        box-shadow: 0 8px 25px rgba(0, 0, 0, .22);
        transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
    }


        #header.video-hero .button.circled:hover {
            background: rgba(2, 132, 199, .92) !important;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .28);
        }


    /* ==========================================================
           WELCOME BANNER
           ========================================================== */

    #banner {
        background: linear-gradient( 135deg, #073b5c 0%, #075985 45%, #0088a9 100% ) !important;
        color: #ffffff !important;
        border: none !important;
    }


        #banner h2,
        #banner h2 strong {
            color: #ffffff !important;
        }


        #banner p {
            color: rgba(255, 255, 255, .88) !important;
        }


    /* ==========================================================
           CAROUSEL
           ========================================================== */

    .carousel {
        background: linear-gradient( 135deg, #073b5c, #075985, #0088a9 ) !important;
        border: none !important;
    }


        .carousel article {
            overflow: hidden;
            background: rgba(255, 255, 255, .10) !important;
            border: 1px solid rgba(255, 255, 255, .15);
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, .12);
        }


            .carousel article h3,
            .carousel article h3 a {
                color: #ffffff !important;
            }


            .carousel article p {
                color: rgba(255, 255, 255, .85) !important;
            }


        .carousel .image.featured img {
            height: 220px;
            object-fit: cover;
        }


    /* ==========================================================
           FEATURES
           ========================================================== */

    .wrapper.style1 {
        background: linear-gradient( 135deg, #073b5c 0%, #075985 50%, #0088a9 100% ) !important;
        color: #ffffff !important;
    }


    #features {
        color: #ffffff !important;
    }


        #features > header h2 {
            color: #ffffff !important;
        }


        #features > header p {
            color: rgba(255, 255, 255, .85) !important;
        }


        #features article {
            overflow: hidden;
            padding-bottom: 20px;
            background: rgba(255, 255, 255, .08);
            border: 1px solid rgba(255, 255, 255, .14);
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, .12);
            transition: transform .2s ease, background .2s ease;
        }


            #features article:hover {
                transform: translateY(-5px);
                background: rgba(255, 255, 255, .13);
            }


            #features article h3,
            #features article h3 a {
                color: #ffffff !important;
            }


            #features article p {
                padding-left: 20px;
                padding-right: 20px;
                color: rgba(255, 255, 255, .85) !important;
            }


        #features .image.featured img {
            height: 250px;
            object-fit: cover;
        }


    /* ==========================================================
           FOOTER
           ========================================================== */

    #footer {
        background: linear-gradient( 135deg, #052f4a 0%, #073b5c 50%, #075985 100% ) !important;
        color: #ffffff !important;
    }


        #footer h2,
        #footer h3,
        #footer h3 a,
        #footer p,
        #footer article,
        #footer .timestamp,
        #footer .copyright,
        #footer .copyright li {
            color: rgba(255, 255, 255, .88) !important;
        }


        #footer a {
            color: #ffffff !important;
        }


        #footer hr {
            border-color: rgba(255, 255, 255, .15);
        }


    /* ==========================================================
           MOBILE
           ========================================================== */

    @@media (max-width: 736px) {

        #header.video-hero {
            min-height: 100vh;
        }


            #header.video-hero .hero-video {
                object-position: center center;
            }


        #header .hero-logo {
            width: 90px;
            margin-bottom: 15px;
        }


        #features article {
            margin-bottom: 20px;
        }


        .carousel .image.featured img,
        #features .image.featured img {
            height: 210px;
        }
    }

</style>



