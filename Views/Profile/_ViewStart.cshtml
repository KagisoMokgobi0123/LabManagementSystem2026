@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);

    var roles = user == null
        ? new List<string>()
        : await UserManager.GetRolesAsync(user);


    Layout = roles.FirstOrDefault() switch
    {
        "LabManager" =>
            "~/Views/Shared/_LabManagerLayout.cshtml",

        "LabTechnician" =>
            "~/Views/Shared/_LabTechnicianLayout.cshtml",

        "Doctor" =>
            "~/Views/Shared/_DoctorLayout.cshtml",

        "Administrator" =>
            "~/Views/Shared/_AdministratorLayout.cshtml",

        "Patient" =>
            "~/Views/Shared/_PatientLayout.cshtml",

        _ =>
            "~/Views/Shared/_Layout.cshtml"
    };
}