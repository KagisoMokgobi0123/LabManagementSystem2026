@model NMB_HLabSys.Models.Account.CompleteProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h4 class="page-title">My Profile</h4>

    <ul class="breadcrumbs">
        <li class="nav-home">
            <a asp-area="LabManager"
                   asp-controller="Dashboard"
                   asp-action="Index">
                <i class="flaticon-home"></i>
            </a>
        </li>

        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>

        <li class="nav-item">
            <a href="#">My Profile</a>
        </li>
    </ul>
</div>

<div class="row">

    <!-- Profile Image -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">

                <img id="profilePreview"
                     src="/assets/img/profile.jpg"
                     class="rounded-circle img-fluid mb-3"
                     style="max-width:150px"
                     alt="Profile Image" />

                <h4>Profile</h4>
                <p class="text-muted">
                    Update your personal information.
                </p>

            </div>
        </div>
    </div>

    <!-- Profile Form -->
    <div class="col-md-8">

        <div class="card">

            <div class="card-header">
                <h4 class="card-title">
                    Profile Details
                </h4>
            </div>

            <div class="card-body">

                <form asp-controller="Profile"
                      asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="Title"></label>

                                <select asp-for="Title"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Title>()"
                                        class="form-control">
                                </select>

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="Gender"></label>

                                <select asp-for="Gender"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Gender>()"
                                        class="form-control">
                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>

                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="IDNumber"></label>

                                <input asp-for="IDNumber"
                                       class="form-control" />

                                <span asp-validation-for="IDNumber"
                                      class="text-danger"></span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="DateOfBirth"></label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>

                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="Ethnicity"></label>

                                <select asp-for="Ethnicity"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Ethnicity>()"
                                        class="form-control">
                                </select>

                                <span asp-validation-for="Ethnicity"
                                      class="text-danger"></span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="Country"></label>

                                <input asp-for="Country"
                                       class="form-control" />

                                <span asp-validation-for="Country"
                                      class="text-danger"></span>

                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="ProvinceId"></label>

                                <select asp-for="ProvinceId"
                                        asp-items="Model.Provinces"
                                        class="form-control">
                                    <option value="">
                                        -- Select Province --
                                    </option>
                                </select>

                                <span asp-validation-for="ProvinceId"
                                      class="text-danger"></span>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group form-group-default">

                                <label asp-for="CityId"></label>

                                <select asp-for="CityId"
                                        asp-items="Model.Cities"
                                        class="form-control">
                                    <option value="">
                                        -- Select City --
                                    </option>
                                </select>

                                <span asp-validation-for="CityId"
                                      class="text-danger"></span>

                            </div>
                        </div>

                    </div>

                    <div class="form-group form-group-default">

                        <label asp-for="Address1"></label>

                        <input asp-for="Address1"
                               class="form-control" />

                        <span asp-validation-for="Address1"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group form-group-default">

                        <label asp-for="Address2"></label>

                        <input asp-for="Address2"
                               class="form-control" />

                        <span asp-validation-for="Address2"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group form-group-default">

                        <label asp-for="PostalCode"></label>

                        <input asp-for="PostalCode"
                               class="form-control" />

                        <span asp-validation-for="PostalCode"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group form-group-default">

                        <label asp-for="ProfileImage"></label>

                        <input asp-for="ProfileImage"
                               id="ProfileImage"
                               type="file"
                               accept="image/*"
                               class="form-control-file" />

                        <span asp-validation-for="ProfileImage"
                              class="text-danger"></span>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Update Profile
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $("#ProfileImage").change(function () {

            const file = this.files[0];

            if (!file)
                return;

            const reader = new FileReader();

            reader.onload = function (e) {
                $("#profilePreview").attr("src", e.target.result);
            };

            reader.readAsDataURL(file);

        });
    </script>
}