@model NMB_HLabSys.Models.Account.EditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-header">
    <h4 class="page-title">Edit Profile</h4>

    <ul class="breadcrumbs">
        <li class="nav-home">
            <a asp-controller="Home"
                   asp-action="Index">
                <i class="flaticon-home"></i>
            </a>
        </li>

        <li class="separator">
            <i class="flaticon-right-arrow"></i>
        </li>

        <li class="nav-item">
            <a href="#">
                Edit Profile
            </a>
        </li>
    </ul>
</div>


<div class="container-fluid">

    <form id="profileForm"
          asp-controller="Profile"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>


        <!-- ========================================================
             PROFILE HEADER
             ======================================================== -->

        <div class="card">
            <div class="card-body d-flex align-items-center">

                <div style="margin-right:20px;">

                    <img id="profilePreview"
                         src="@(string.IsNullOrWhiteSpace(Model.ExistingProfileImagePath)
                                                                               ? "/assets/img/profile.jpg"
                                                                               : Model.ExistingProfileImagePath)"
                         class="rounded-circle"
                         width="90"
                         height="90"
                         style="object-fit: cover;" />

                    <br />
                    <br />

                    <label asp-for="ProfileImage"
                           class="form-label">
                    </label>

                    <input asp-for="ProfileImage"
                           id="ProfileImage"
                           type="file"
                           accept="image/*"
                           class="form-control" />

                    <span asp-validation-for="ProfileImage"
                          class="text-danger">
                    </span>

                </div>


                <div class="w-100">

                    <div class="row">

                        <div class="col-md-4">

                            <label asp-for="Title"
                                   class="form-label">
                            </label>

                            <select asp-for="Title"
                                    asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Title>()"
                                    class="form-control">

                                <option value="">
                                    Select Title
                                </option>

                            </select>

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-4">

                            <label asp-for="IDNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="IDNumber"
                                   id="IDNumber"
                                   class="form-control" />

                            <span asp-validation-for="IDNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-4">

                            <label asp-for="DateOfBirth"
                                   class="form-label">
                            </label>

                            <input asp-for="DateOfBirth"
                                   id="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- ========================================================
             PERSONAL / PROFILE INFORMATION
             ======================================================== -->

        <div class="row">

            <!-- Personal Information -->

            <div class="col-md-6">

                <div class="card">

                    <div class="card-header">
                        <h5>Personal Information</h5>
                    </div>

                    <div class="card-body">

                        <label asp-for="Gender"
                               class="form-label">
                        </label>

                        <select asp-for="Gender"
                                asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Gender>()"
                                class="form-control">

                            <option value="">
                                Select Gender
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger">
                        </span>


                        <label asp-for="Ethnicity"
                               class="form-label mt-3">
                        </label>

                        <select asp-for="Ethnicity"
                                asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Ethnicity>()"
                                class="form-control">

                            <option value="">
                                Select Ethnicity
                            </option>

                        </select>

                        <span asp-validation-for="Ethnicity"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Profile Information -->

            <div class="col-md-6">

                <div class="card">

                    <div class="card-header">
                        <h5>Profile Information</h5>
                    </div>

                    <div class="card-body">

                        <label asp-for="Country"
                               class="form-label">
                        </label>

                        <input asp-for="Country"
                               class="form-control" />

                        <span asp-validation-for="Country"
                              class="text-danger">
                        </span>


                        <label asp-for="PostalCode"
                               class="form-label mt-3">
                        </label>

                        <input asp-for="PostalCode"
                               class="form-control" />

                        <span asp-validation-for="PostalCode"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             LOCATION
             ======================================================== -->

        <div class="row">

            <div class="col-md-6">

                <label asp-for="ProvinceId"
                       class="form-label">
                </label>

                <select asp-for="ProvinceId"
                        id="ProvinceId"
                        asp-items="Model.Provinces"
                        class="form-control">

                    <option value="">
                        Select Province
                    </option>

                </select>

                <span asp-validation-for="ProvinceId"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="CityId"
                       class="form-label">
                </label>

                <select asp-for="CityId"
                        id="CityId"
                        asp-items="Model.Cities"
                        class="form-control">

                    <option value="">
                        Select City
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger">
                </span>

            </div>

        </div>


        <br />


        <!-- ========================================================
                                ADDRESS
             ======================================================== -->

        <div class="row">

            <div class="col-md-6">

                <label asp-for="Address1"
                       class="form-label">
                </label>

                <input asp-for="Address1"
                       class="form-control" />

                <span asp-validation-for="Address1"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="Address2"
                       class="form-label">
                </label>

                <input asp-for="Address2"
                       class="form-control" />

                <span asp-validation-for="Address2"
                      class="text-danger">
                </span>

            </div>

        </div>


        <br />


        <!-- ========================================================
             PASSWORD
             ======================================================== -->

        <div class="card mt-4">

            <div class="card-header">
                <h5>Change Password</h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4">

                        <label asp-for="CurrentPassword"
                               class="form-label">
                        </label>

                        <input asp-for="CurrentPassword"
                               class="form-control" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="ConfirmNewPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmNewPassword"
                               class="form-control" />

                        <span asp-validation-for="ConfirmNewPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             ACTION
             ======================================================== -->

        <div class="mt-4">

            <button type="submit"
                    id="btnUpdateProfile"
                    class="btn btn-primary">

                Update Profile

            </button>

            <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-secondary">

                Cancel

            </a>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // ============================================================
        // PROFILE IMAGE PREVIEW
        // ============================================================

        $("#ProfileImage").change(function () {

            const file = this.files[0];

            if (!file)
                return;

            const reader = new FileReader();

            reader.onload = function (e) {

                $("#profilePreview")
                    .attr("src", e.target.result);

            };

            reader.readAsDataURL(file);
        });


        // ============================================================
        // ID NUMBER -> DATE OF BIRTH
        // ============================================================

        $("#IDNumber").on("blur", function () {

            const idNumber =
                $(this).val().toString().trim();

            if (idNumber.length !== 13)
                return;

            const yearPart =
                parseInt(
                    idNumber.substring(0, 2),
                    10);

            const month =
                parseInt(
                    idNumber.substring(2, 4),
                    10);

            const day =
                parseInt(
                    idNumber.substring(4, 6),
                    10);

            if (
                isNaN(yearPart) ||
                isNaN(month) ||
                isNaN(day)
            ) {
                return;
            }

            const currentYear =
                new Date().getFullYear();

            let year =
                yearPart <= currentYear % 100
                    ? 2000 + yearPart
                    : 1900 + yearPart;

            const dob =
                year +
                "-" +
                String(month).padStart(2, "0") +
                "-" +
                String(day).padStart(2, "0");

            $("#DateOfBirth")
                .val(dob);
        });


        // ============================================================
        // LOAD CITIES WHEN PROVINCE CHANGES
        // ============================================================

        $("#ProvinceId").change(function () {

            const provinceId =
                $(this).val();

            const citySelect =
                $("#CityId");

            citySelect.empty();

            citySelect.append(
                $("<option></option>")
                    .val("")
                    .text("Select City")
            );

            if (!provinceId)
                return;

            $.ajax({

                url: '@Url.Action(
                                            "GetCities",
                                            "Profile")',

                type: "GET",

                data: {
                    provinceId: provinceId
                },

                success: function (cities) {

                    $.each(
                        cities,
                        function (index, city) {

                            citySelect.append(
                                $("<option></option>")
                                    .val(city.value)
                                    .text(city.text)
                            );

                        });
                },

                error: function () {

                    console.error(
                        "Unable to load cities."
                    );

                }

            });

        });

    </script>
}
