@model NMB_HLabSys.Models.Account.CompleteProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_ProfileLayout";
}

<div class="row">
    <div class="col-md-4">

        <div class="card">

            <div class="card-body text-center">

                <h5>Welcome!</h5>

                <p class="text-muted">
                    Complete your profile before continuing.
                </p>

                <div class="mt-3">

                    <img id="profilePreview"
                         src="~/images/default-profile.png"
                         alt="Profile Preview"
                         class="img-fluid rounded-circle"
                         style="width: 150px; height: 150px; object-fit: cover;" />

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-8">

        <div class="card">

            <div class="card-header">
                <h4 class="card-title">
                    Personal Information
                </h4>
            </div>

            <div class="card-body">

                <form asp-action="Complete"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- ====================================================
                     TITLE / GENDER
                     ==================================================== -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="Title"></label>

                                <select asp-for="Title"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Title>()"
                                        class="form-control">

                                    <option value="">
                                        Select Title
                                    </option>

                                </select>

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="Gender"></label>

                                <select asp-for="Gender"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Gender>()"
                                        class="form-control">

                                    <option value="">
                                        Select Gender
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                     ID NUMBER / DATE OF BIRTH
                     ==================================================== -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="IDNumber"></label>

                                <input asp-for="IDNumber"
                                       id="IDNumber"
                                       class="form-control"
                                       maxlength="13"
                                       inputmode="numeric"
                                       autocomplete="off" />

                                <span asp-validation-for="IDNumber"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="DateOfBirth"></label>

                                <input asp-for="DateOfBirth"
                                       id="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                     ETHNICITY / COUNTRY
                     ==================================================== -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="Ethnicity"></label>

                                <select asp-for="Ethnicity"
                                        asp-items="Html.GetEnumSelectList<NMB_HLabSys.Models.Users.Enums.Ethnicity>()"
                                        class="form-control">

                                    <option value="">
                                        Select Ethnicity
                                    </option>

                                </select>

                                <span asp-validation-for="Ethnicity"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="Country"></label>

                                <input asp-for="Country"
                                       class="form-control"
                                       autocomplete="country-name" />

                                <span asp-validation-for="Country"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                     PROVINCE / CITY
                     ==================================================== -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="ProvinceId"></label>

                                <select asp-for="ProvinceId"
                                        asp-items="Model.Provinces"
                                        id="ProvinceId"
                                        class="form-control">

                                    <option value="">
                                        Select Province
                                    </option>

                                </select>

                                <span asp-validation-for="ProvinceId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="CityId"></label>

                                <select asp-for="CityId"
                                        asp-items="Model.Cities"
                                        id="CityId"
                                        class="form-control">

                                    <option value="">
                                        Select City
                                    </option>

                                </select>

                                <span asp-validation-for="CityId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                     ADDRESS
                     ==================================================== -->

                    <div class="form-group form-group-default">

                        <label asp-for="Address1"></label>

                        <input asp-for="Address1"
                               class="form-control"
                               autocomplete="street-address" />

                        <span asp-validation-for="Address1"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group form-group-default">

                        <label asp-for="Address2"></label>

                        <input asp-for="Address2"
                               class="form-control" />

                        <span asp-validation-for="Address2"
                              class="text-danger"></span>

                    </div>


                    <!-- ====================================================
                     POSTAL CODE / PROFILE IMAGE
                     ==================================================== -->

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="PostalCode"></label>

                                <input asp-for="PostalCode"
                                       class="form-control"
                                       autocomplete="postal-code" />

                                <span asp-validation-for="PostalCode"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group form-group-default">

                                <label asp-for="ProfileImage"></label>

                                <input asp-for="ProfileImage"
                                       id="ProfileImage"
                                       type="file"
                                       accept=".jpg,.jpeg,.png"
                                       class="form-control-file" />

                                <span asp-validation-for="ProfileImage"
                                      class="text-danger"></span>

                                <small class="form-text text-muted">
                                    JPG, JPEG or PNG. Maximum size: 5 MB.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- ====================================================
                     SUBMIT
                     ==================================================== -->

                    <button type="submit"
                            class="btn btn-primary">

                        Complete Profile

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // ============================================================
        // PROFILE IMAGE PREVIEW
        // ============================================================

        $("#ProfileImage").on("change", function () {

            const file = this.files[0];

            if (!file)
                return;

            const reader = new FileReader();

            reader.onload = function (e) {

                $("#profilePreview")
                    .attr("src", e.target.result);

            };

            reader.readAsDataURL(file);

        });


        // ============================================================
        // SOUTH AFRICAN ID NUMBER
        //
        // Automatically derives Date of Birth from the first
        // six digits of the ID number.
        // ============================================================

        $("#IDNumber").on("input", function () {

            let id =
                $(this)
                    .val()
                    .replace(/\D/g, "");

            if (id.length > 13) {
                id = id.substring(0, 13);
            }

            $(this).val(id);

            if (id.length !== 13)
                return;

            const yy =
                parseInt(
                    id.substring(0, 2),
                    10);

            const mm =
                id.substring(2, 4);

            const dd =
                id.substring(4, 6);

            const currentYear =
                new Date().getFullYear() % 100;

            const century =
                yy <= currentYear
                    ? 2000
                    : 1900;

            const fullYear =
                century + yy;

            const date =
                new Date(
                    fullYear,
                    parseInt(mm, 10) - 1,
                    parseInt(dd, 10));

            // --------------------------------------------------------
            // Do not populate an impossible date.
            // --------------------------------------------------------

            if (
                date.getFullYear() !== fullYear ||
                date.getMonth() !==
                    parseInt(mm, 10) - 1 ||
                date.getDate() !==
                    parseInt(dd, 10)
            ) {
                return;
            }

            const formattedDate =
                fullYear +
                "-" +
                mm +
                "-" +
                dd;

            $("#DateOfBirth")
                .val(formattedDate);

        });


        // ============================================================
        // PROVINCE → CITY
        // ============================================================

        $("#ProvinceId").on("change", function () {

            const provinceId =
                $(this).val();

            const cityDropdown =
                $("#CityId");

            cityDropdown.empty();

            cityDropdown.append(
                $("<option></option>")
                    .val("")
                    .text("Select City")
            );

            if (!provinceId)
                return;

            $.ajax({

                url: "@Url.Action("GetCities", "Profile")",

                type: "GET",

                data: {
                    provinceId: provinceId
                },

                success: function (cities) {

                    $.each(
                        cities,
                        function (index, city) {

                            cityDropdown.append(
                                $("<option></option>")
                                    .val(city.value)
                                    .text(city.text)
                            );

                        }
                    );

                },

                error: function (xhr, status, error) {

                    console.error(
                        "City loading failed:",
                        error
                    );

                }

            });

        });

    </script>

}