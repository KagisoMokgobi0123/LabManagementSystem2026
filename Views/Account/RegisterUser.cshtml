@{
    ViewData["Title"] = "NMB_HLabSys | Register";
    Layout = "_RegisterLayout";

}
<section class="vh-100 d-flex justify-content-center align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="card text-black" style="border-radius: 20px; max-width: 900px; background-color:#F3F4F6;">
                    <div class="card-body p-4">
                        <!-- Form Column -->
                        <div class="col-12 text-center">
                            <h2 class="fw-bold mb-4">Sign Up</h2>

                            <form class="mx-auto" style="max-width: 400px;">

                                <div class="mb-3 text-start">
                                    <label class="form-label" for="name">Your Name</label>
                                    <input type="text" id="name" class="form-control">
                                </div>

                                <div class="mb-3 text-start">
                                    <label class="form-label" for="email">Your Email</label>
                                    <input type="email" id="email" class="form-control">
                                </div>

                                <div class="mb-3 text-start">
                                    <label class="form-label" for="password">Password</label>
                                    <input type="password" id="password" class="form-control">
                                </div>

                                <div class="mb-3 text-start">
                                    <label class="form-label" for="repeatPassword">Repeat Password</label>
                                    <input type="password" id="repeatPassword" class="form-control">
                                </div>

                                <div class="form-check mb-3 text-start">
                                    <input class="form-check-input" type="checkbox" id="terms">
                                    <label class="form-check-label" for="terms">
                                        I agree to <a href="#!">Terms of Service</a>
                                    </label>
                                </div>

                                <div class="d-flex justify-content-center gap-2">
                                    <button type="submit" class="btn btn-primary">Sign Up</button>
                                    <a asp-action="LandIn" asp-controller="Home" type="button" class="btn btn-secondary">Back</a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>