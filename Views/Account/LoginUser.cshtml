    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: white;
            overflow-x: auto;
        }

        /* full-height wrapper */
        .login-dashboard {
            min-height: 100vh;
            padding: 2rem 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Each card gets consistent spacing and smooth hover */
        .role-card {
            transition: transform 0.2s ease, box-shadow 0.25s ease;
            border: none;
            border-radius: 1.25rem !important;
            background: linear-gradient(145deg, #ffffff 0%, #fefefe 100%);
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0,0,0,0.02);
            height: 100%;
        }

        .role-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 28px 36px -14px rgba(0, 0, 0, 0.2);
        }

        /* unified header gradient */
        .card-header-brand {
            background: linear-gradient(120deg, #0b5ed7 0%, #0a58ca 100%);
            border-radius: 1.25rem 1.25rem 0 0 !important;
            padding: 1rem 0.75rem 0.5rem 0.75rem;
            margin-top: -1px;
        }

        .card-title-icon {
            display: flex;
            justify-content: center;
            align-items: baseline;
            gap: 8px;
            flex-wrap: wrap;
        }

        .card-title-icon i {
            font-size: 1.8rem;
            color: rgba(255,255,240,0.95);
        }

        .role-badge {
            background: rgba(255,255,245,0.2);
            padding: 0.2rem 0.9rem;
            border-radius: 40px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            letter-spacing: 0.3px;
            backdrop-filter: blur(2px);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.8rem;
            margin-bottom: 0.3rem;
            color: #1e2a3e;
        }

        .form-control-sm, .form-select-sm {
            border-radius: 0.75rem;
            border: 1px solid #e2e8f0;
            background: #fafcff;
            padding: 0.5rem 0.85rem;
            font-size: 0.85rem;
            transition: all 0.2s;
        }

        .form-control-sm:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13,110,253,0.2);
            background-color: white;
        }

        .btn-coral {
            background: linear-gradient(95deg, #ff7e5e, #feb47b);
            border: none;
            border-radius: 2rem;
            font-weight: 600;
            padding: 0.5rem 0;
            transition: all 0.2s;
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
        }

        .btn-coral:hover {
            background: linear-gradient(95deg, #f66947, #fd9f5e);
            transform: scale(0.98);
            box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        }

        .btn-outline-soft {
            border-radius: 2rem;
            border: 1px solid #ced8e6;
            background: rgba(255,255,245,0.7);
            font-weight: 500;
            color: #2c3e66;
        }

        .btn-outline-soft:hover {
            background: #eef3fc;
            border-color: #0d6efd;
        }

        .text-link-muted {
            color: #2b3b5c;
            font-weight: 500;
            text-decoration: none;
            font-size: 0.75rem;
            transition: color 0.2s;
        }

        .text-link-muted:hover {
            color: #ff6b4a;
            text-decoration: underline;
        }

        .card-body-custom {
            padding: 1.4rem 1.3rem 1.8rem 1.3rem;
