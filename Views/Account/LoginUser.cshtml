@using NMB_HLabSys.Models.Account
@model LoginUser

@{
    ViewData["Title"] = "NMB_HLabSys | Sign In";

    Layout = "_LoginLayout";
}

<section class="vh-100 d-flex justify-content-center align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">

                        <!-- Title -->
                        <h3 class="fw-bold mb-3 text-center">Sign In</h3>

                        <!-- Form -->
                        <form method="post" asp-action="LoginUser" asp-controller="Account" novalidate>
                            @Html.AntiForgeryToken()

                            <!-- Email/Username -->
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Username</label>
                                <input asp-for="Email" class="form-control form-control-sm" placeholder="Enter username or email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" class="form-control form-control-sm" placeholder="Enter password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me -->
                            <div class="form-check mb-3">
                                <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                                    <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
                                </div>

                                <!-- Buttons -->
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-sm fw-semibold">Sign In</button>
                                    <a asp-action="LandIn" asp-controller="Home" class="btn btn-outline-secondary btn-sm">Back</a>
                                </div>

                                <!-- Optional Forgot Password -->
                                <div class="mt-2 text-center">
                                    <a asp-action="ForgotPassword" asp-controller="Account" class="small text-decoration-none">Forgot your password?</a>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
