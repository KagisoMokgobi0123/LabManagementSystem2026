@model NMB_HLabSys.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login | NMB-HLabSys</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f5f8fc;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
        }

        /* LEFT SIDE */

        .auth-image {
            width: 52%;
            min-height: 100vh;
            position: relative;

            background:
                linear-gradient(
                    rgba(6, 30, 54, .75),
                    rgba(0, 103, 140, .78)
                ),
                url('/assets/img/laboratory.jpg');

            background-size: cover;
            background-position: center;

            display: flex;
            align-items: flex-end;

            padding: 60px;
        }

        .image-content {
            color: white;
            max-width: 600px;
        }

        .image-content h1 {
            font-size: 42px;
            font-weight: 800;
        }

        .image-content p {
            font-size: 16px;
            line-height: 1.8;
            color: #e6f4fa;
        }

        /* RIGHT SIDE */

        .auth-form-container {
            width: 48%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px;
        }

        .auth-form {
            width: 100%;
            max-width: 450px;
        }

        .logo {
            width: 75px;
            margin-bottom: 25px;
        }

        .auth-form h2 {
            font-weight: 800;
            color: #082c4c;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #718096;
            margin-bottom: 35px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: #334155;
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            z-index: 5;
        }

        .form-control {
            height: 52px;
            border-radius: 10px;
            border: 1px solid #dbe3eb;
            padding-left: 45px;
        }

        .form-control:focus {
            border-color: #0088a9;
            box-shadow: 0 0 0 .2rem rgba(0,136,169,.12);
        }

        .btn-login {
            height: 52px;
            width: 100%;

            border: none;
            border-radius: 10px;

            background:
                linear-gradient(135deg, #073b5c, #0088a9);

            color: white;

            font-weight: 700;
            font-size: 15px;
        }

        .btn-login:hover {
            color: white;
            opacity: .94;
        }

        .register-text {
            text-align: center;
            margin-top: 25px;
            color: #64748b;
        }

        .register-text a {
            color: #007b9f;
            font-weight: 700;
            text-decoration: none;
        }

        .validation-summary-errors {
            background: #fff2f2;
            color: #b42318;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        @@media(max-width: 900px) {

            .auth-image {
                display: none;
            }

            .auth-form-container {
                width: 100%;
            }
        }

    </style>
</head>

<body>

<div class="auth-container">

    <!-- IMAGE -->

    <section class="auth-image">

        <div class="image-content">

            <h1>NMB-HLabSys</h1>

            <p>
                Securely connecting patients, doctors and laboratory
                professionals for efficient haematology test management.
            </p>

        </div>

    </section>


    <!-- LOGIN -->

    <section class="auth-form-container">

        <div class="auth-form">

            <img src="~/assets/img/logo.png"
                 class="logo"
                 alt="NMB-HLabSys Logo" />

            <h2>Welcome Back</h2>

            <p class="subtitle">
                Sign in to access your NMB-HLabSys account.
            </p>


            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <i class="fa-solid fa-envelope input-icon"></i>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="name@example.com" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                    </label>

                    <div class="input-group">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Enter your password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>

                </div>


                <div class="d-flex justify-content-between mb-4">

                    <div class="form-check">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                        </label>

                    </div>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword">
                        Forgot password?
                    </a>

                </div>


                <button type="submit"
                        class="btn-login">

                    <i class="fa-solid fa-right-to-bracket me-2"></i>

                    Sign In

                </button>

            </form>


            <div class="register-text">

                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Register">
                    Create Account
                </a>

            </div>

        </div>

    </section>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<partial name="_ValidationScriptsPartial" />

</body>
</html>