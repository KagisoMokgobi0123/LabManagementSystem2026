@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login | NMB-HLabSys</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f5f8fc;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
        }


        /* ==========================================================
           LEFT SIDE
           ========================================================== */

        .auth-image {
            width: 43%;
            min-height: 100vh;

            position: relative;

            background:
                linear-gradient(
                    rgba(6, 30, 54, .78),
                    rgba(0, 103, 140, .82)
                ),
                url('/assets/img/laboratory.jpg');

            background-size: cover;
            background-position: center;

            display: flex;
            align-items: flex-end;

            padding: 60px;
        }

        .image-content {
            color: white;
            max-width: 600px;
        }

        .system-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 8px 14px;

            border-radius: 30px;

            background:
                rgba(255,255,255,.14);

            border:
                1px solid
                rgba(255,255,255,.25);

            margin-bottom: 20px;

            font-size: 13px;
            font-weight: 700;
        }

        .image-content h1 {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .image-content p {
            font-size: 15px;
            line-height: 1.8;
            color: #e6f4fa;
            margin-bottom: 0;
        }


        /* ==========================================================
           RIGHT SIDE
           ========================================================== */

        .auth-portal-container {
            width: 57%;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 45px;
        }

        .portal-content {
            width: 100%;
            max-width: 700px;
        }

        .logo {
            width: 75px;
            height: auto;
            margin-bottom: 22px;
        }

        .portal-content h2 {
            font-weight: 800;
            color: #082c4c;

            margin-bottom: 8px;

            font-size: 30px;
        }

        .subtitle {
            color: #718096;
            margin-bottom: 32px;

            line-height: 1.7;
        }


        /* ==========================================================
           PORTAL GRID
           ========================================================== */

        .portal-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 16px;
        }

        .portal-card {
            position: relative;

            display: flex;
            align-items: center;

            min-height: 125px;

            padding: 20px;

            border-radius: 14px;

            border:
                1px solid #e2e8f0;

            background: white;

            text-decoration: none;

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                border-color .2s ease;
        }

        .portal-card:hover {
            text-decoration: none;

            transform:
                translateY(-3px);

            border-color:
                #b9dce6;

            box-shadow:
                0 12px 30px
                rgba(15, 23, 42, .10);
        }


        /* ==========================================================
           ICON
           ========================================================== */

        .portal-icon {
            width: 58px;
            height: 58px;

            min-width: 58px;

            border-radius: 14px;

            display: flex;
            justify-content: center;
            align-items: center;

            margin-right: 17px;

            color: white;

            font-size: 22px;
        }


        /* ADMIN */

        .admin-icon {
            background:
                linear-gradient(
                    135deg,
                    #172033,
                    #475569
                );
        }


        /* PATIENT */

        .patient-icon {
            background:
                linear-gradient(
                    135deg,
                    #075985,
                    #0891b2
                );
        }


        /* DOCTOR */

        .doctor-icon {
            background:
                linear-gradient(
                    135deg,
                    #064e3b,
                    #059669
                );
        }


        /* TECHNICIAN */

        .technician-icon {
            background:
                linear-gradient(
                    135deg,
                    #0f3d63,
                    #0284c7
                );
        }


        /* MANAGER */

        .manager-icon {
            background:
                linear-gradient(
                    135deg,
                    #4c1d95,
                    #7c3aed
                );
        }


        /* ==========================================================
           PORTAL TEXT
           ========================================================== */

        .portal-info {
            flex: 1;
        }

        .portal-info h3 {
            margin: 0 0 6px;

            color: #172033;

            font-size: 15px;
            font-weight: 800;
        }

        .portal-info p {
            margin: 0;

            color: #64748b;

            font-size: 12px;
            line-height: 1.5;
        }

        .arrow {
            color: #94a3b8;

            margin-left: 10px;

            font-size: 13px;

            transition:
                transform .2s ease;
        }

        .portal-card:hover .arrow {
            transform:
                translateX(4px);

            color: #0088a9;
        }


        /* ==========================================================
           PATIENT REGISTER
           ========================================================== */

        .patient-register {
            margin-top: 25px;

            padding: 17px 20px;

            border-radius: 12px;

            background: #f0f9fc;

            border:
                1px solid #d6edf3;

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            gap: 20px;
        }

        .patient-register strong {
            display: block;

            color: #082c4c;

            font-size: 14px;

            margin-bottom: 3px;
        }

        .patient-register span {
            color: #64748b;

            font-size: 12px;
        }

        .register-btn {
            white-space: nowrap;

            text-decoration: none;

            padding:
                10px 16px;

            border-radius: 8px;

            background:
                linear-gradient(
                    135deg,
                    #073b5c,
                    #0088a9
                );

            color: white;

            font-size: 12px;
            font-weight: 700;
        }

        .register-btn:hover {
            color: white;
            opacity: .94;
        }


        /* ==========================================================
           FOOTER
           ========================================================== */

        .security-message {
            margin-top: 25px;

            display: flex;
            align-items: center;

            gap: 8px;

            color: #94a3b8;

            font-size: 12px;
        }

        .security-message i {
            color: #059669;
        }


        /* ==========================================================
           RESPONSIVE
           ========================================================== */

        @@media(max-width: 1050px) {

            .auth-image {
                width: 38%;
                padding: 40px;
            }

            .auth-portal-container {
                width: 62%;
                padding: 35px;
            }

            .image-content h1 {
                font-size: 34px;
            }
        }


        @@media(max-width: 850px) {

            .auth-image {
                display: none;
            }

            .auth-portal-container {
                width: 100%;
                min-height: 100vh;

                padding: 40px 25px;
            }
        }


        @@media(max-width: 600px) {

            .portal-grid {
                grid-template-columns: 1fr;
            }

            .portal-content h2 {
                font-size: 25px;
            }

            .patient-register {
                flex-direction: column;
                align-items: flex-start;
            }

            .register-btn {
                width: 100%;
                text-align: center;
            }
        }

    </style>

</head>


<body>

<div class="auth-container">


    <!-- ============================================================
         LEFT IMAGE
         ============================================================ -->

    <section class="auth-image">

        <div class="image-content">


            <div class="system-badge">

                <i class="fa-solid fa-flask-vial"></i>

                Haematology Laboratory System

            </div>


            <h1>
                NMB-HLabSys
            </h1>


            <p>
                Securely connecting patients, doctors,
                laboratory technicians and laboratory management
                for efficient haematology test request processing
                and result management.

               
            </p>
         <p>
             
                 <b>Login Credentials</b>
                    Administrator - Username:administrator@nmbhlab.co.za | Password:Admin@123
                    Manager - Username:manager@nmbhlab.co.za | Password: Manager@123 <br>
                    Technician - Username: technician@nmbhlab.co.za | Password: Tech@1234 <br>
                    Patient - Username: patient@nmbhlab.co.za | Password: Patient@123 <br>
                    Doctor - Username: doctor@nmbhlab.co.za | Password: Doctor@123
         </p>


        </div>

    </section>



    <!-- ============================================================
         RIGHT SIDE
         ============================================================ -->

    <section class="auth-portal-container">

        <div class="portal-content">


            <!-- LOGO -->

            <img src="~/assets/img/logo.png"
                 class="logo"
                 alt="NMB-HLabSys Logo" />


            <!-- TITLE -->

            <h2>
                Welcome Back
            </h2>


            <p class="subtitle">

                Select your account type to securely
                sign in to NMB-HLabSys.

            </p>



            <!-- ====================================================
                 PORTAL GRID
                 ==================================================== -->

            <div class="portal-grid">


                <!-- ================================================
                     PATIENT
                     ================================================ -->

                <a asp-controller="Account"
                   asp-action="PatientLogin"
                   class="portal-card">


                    <div class="portal-icon patient-icon">

                        <i class="fa-solid fa-hospital-user"></i>

                    </div>


                    <div class="portal-info">

                        <h3>
                            Patient
                        </h3>

                        <p>
                            Access test requests
                            and laboratory results.
                        </p>

                    </div>


                    <i class="fa-solid
                              fa-chevron-right
                              arrow">
                    </i>

                </a>



                <!-- ================================================
                     DOCTOR
                     ================================================ -->

                <a asp-controller="Account"
                   asp-action="DoctorLogin"
                   class="portal-card">


                    <div class="portal-icon doctor-icon">

                        <i class="fa-solid fa-user-doctor"></i>

                    </div>


                    <div class="portal-info">

                        <h3>
                            Doctor
                        </h3>

                        <p>
                            Create test requests
                            and review results.
                        </p>

                    </div>


                    <i class="fa-solid
                              fa-chevron-right
                              arrow">
                    </i>

                </a>



                <!-- ================================================
                     LAB TECHNICIAN
                     ================================================ -->

                <a asp-controller="Account"
                   asp-action="TechnicianLogin"
                   class="portal-card">


                    <div class="portal-icon technician-icon">

                        <i class="fa-solid fa-microscope"></i>

                    </div>


                    <div class="portal-info">

                        <h3>
                            Lab Technician
                        </h3>

                        <p>
                            Receive samples,
                            process tests and results.
                        </p>

                    </div>


                    <i class="fa-solid
                              fa-chevron-right
                              arrow">
                    </i>

                </a>



                <!-- ================================================
                     LAB MANAGER
                     ================================================ -->

                <a asp-controller="Account"
                   asp-action="ManagerLogin"
                   class="portal-card">


                    <div class="portal-icon manager-icon">

                        <i class="fa-solid fa-chart-line"></i>

                    </div>


                    <div class="portal-info">

                        <h3>
                            Lab Manager
                        </h3>

                        <p>
                            Manage laboratory workload,
                            assignments and reports.
                        </p>

                    </div>


                    <i class="fa-solid
                              fa-chevron-right
                              arrow">
                    </i>

                </a>



                <!-- ================================================
                     ADMINISTRATOR
                     ================================================ -->

                <a asp-controller="Account"
                   asp-action="AdminLogin"
                   class="portal-card">


                    <div class="portal-icon admin-icon">

                        <i class="fa-solid fa-user-shield"></i>

                    </div>


                    <div class="portal-info">

                        <h3>
                            Administrator
                        </h3>

                        <p>
                            Manage system data,
                            users and configuration.
                        </p>

                    </div>


                    <i class="fa-solid
                              fa-chevron-right
                              arrow">
                    </i>

                </a>


            </div>



            <!-- ====================================================
                 PATIENT REGISTRATION
                 ==================================================== -->

            <div class="patient-register">

                <div>

                    <strong>
                       Create Account
                    </strong>

                    <span>
                        Create your NMB-HLabSys account.
                    </span>

                </div>


                <a asp-controller="Account"
                   asp-action="RegisterUser"
                       class="register-btn">
                        <!--Changed from Register to RegisterUser-->

                    <i class="fa-solid fa-user-plus me-1"></i>

                    Create Account

                </a>

            </div>



            <!-- ====================================================
                 SECURITY MESSAGE
                 ==================================================== -->

            <div class="security-message">

                <i class="fa-solid fa-shield-halved"></i>

                Secure access to NMB-HLabSys laboratory services.

            </div>


        </div>

    </section>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>