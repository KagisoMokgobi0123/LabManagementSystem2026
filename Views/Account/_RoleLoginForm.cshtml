@model NMB_HLabSys.Models.Account.LoginViewModel

@{
    Layout = null;

    var role = ViewData["Role"]?.ToString() ?? "";
    var portalTitle = ViewData["PortalTitle"]?.ToString() ?? "Login";
    var description = ViewData["Description"]?.ToString() ?? "";
    var image = ViewData["Image"]?.ToString() ?? "/assets/img/laboratory.jpg";
    var icon = ViewData["Icon"]?.ToString() ?? "fa-user";
    var primary = ViewData["Primary"]?.ToString() ?? "#073b5c";
    var secondary = ViewData["Secondary"]?.ToString() ?? "#0088a9";

    var allowRegistration =
        ViewData["AllowRegistration"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@portalTitle | NMB-HLabSys</title>


    <!-- GOOGLE FONT -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- BOOTSTRAP -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <style>

        /* ==========================================================
           GENERAL
           ========================================================== */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f5f8fc;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
        }


        /* ==========================================================
           LEFT SIDE
           ========================================================== */

        .auth-image {
            width: 52%;
            min-height: 100vh;

            position: relative;

            background:
                linear-gradient(
                    rgba(6, 30, 54, .72),
                    rgba(0, 103, 140, .78)
                ),
                url('@image');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;

            display: flex;
            align-items: flex-end;

            padding: 60px;
        }


        .auth-image::before {
            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    180deg,
                    rgba(5, 25, 45, .05),
                    rgba(5, 25, 45, .32)
                );

            pointer-events: none;
        }


        .image-content {
            position: relative;
            z-index: 2;

            max-width: 620px;

            color: #ffffff;
        }


        .image-content h1,
        .image-content p,
        .image-content span,
        .image-content i {
            color: #ffffff;
        }


        /* ==========================================================
           LEFT PORTAL BADGE
           ========================================================== */

        .portal-badge {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding: 9px 16px;

            margin-bottom: 20px;

            background:
                rgba(255, 255, 255, .14);

            border:
                1px solid
                rgba(255, 255, 255, .30);

            border-radius: 50px;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            backdrop-filter: blur(5px);

            -webkit-backdrop-filter: blur(5px);
        }


        .portal-badge i {
            color: #ffffff;
        }


        .image-content h1 {
            margin: 0 0 15px;

            color: #ffffff;

            font-size: 44px;

            font-weight: 800;

            letter-spacing: -.7px;
        }


        .image-content p {
            margin: 0;

            color: #ffffff;

            font-size: 16px;

            line-height: 1.8;
        }


        /* ==========================================================
           RIGHT FORM SIDE
           ========================================================== */

        .auth-form-container {
            width: 48%;
            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

            padding: 50px;

            background:
                linear-gradient(
                    135deg,
                    @primary,
                    @secondary
                );

            color: #ffffff;
        }


        .auth-form {
            width: 100%;

            max-width: 450px;

            color: #ffffff;
        }


        /* ==========================================================
           LOGO
           ========================================================== */

        .logo {
            width: 75px;

            height: auto;

            margin-bottom: 25px;
        }


        /* ==========================================================
           ROLE ICON
           ========================================================== */

        .role-icon {
            width: 58px;

            height: 58px;

            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 20px;

            border-radius: 14px;

            background:
                rgba(255, 255, 255, .16);

            border:
                1px solid
                rgba(255, 255, 255, .28);

            color: #ffffff;

            font-size: 22px;

            box-shadow:
                0 8px 20px
                rgba(0, 0, 0, .10);
        }


        .role-icon i {
            color: #ffffff;
        }


        /* ==========================================================
           FORM TITLE
           ========================================================== */

        .auth-form h2 {
            margin-bottom: 8px;

            color: #ffffff;

            font-size: 30px;

            font-weight: 800;
        }


        .subtitle {
            margin-bottom: 30px;

            color: #ffffff;

            font-size: 14px;

            line-height: 1.7;

            opacity: .92;
        }


        /* ==========================================================
           LABELS
           ========================================================== */

        .form-label {
            margin-bottom: 8px;

            color: #ffffff;

            font-size: 14px;

            font-weight: 600;
        }


        /* ==========================================================
           INPUT WRAPPER
           ========================================================== */

        .input-wrapper {
            position: relative;
        }


        .input-icon {
            position: absolute;

            left: 16px;

            top: 50%;

            transform:
                translateY(-50%);

            z-index: 5;

            color: #64748b;

            pointer-events: none;
        }


        /* ==========================================================
           INPUTS
           ========================================================== */

        .form-control {
            width: 100%;

            height: 52px;

            padding-left: 45px;

            padding-right: 15px;

            border:
                1px solid
                rgba(255, 255, 255, .50);

            border-radius: 10px;

            background: #ffffff;

            /* Keep typed text dark */
            color: #172033;

            font-size: 14px;

            transition:
                border-color .2s ease,
                box-shadow .2s ease;
        }


        .form-control::placeholder {
            color: #94a3b8;
        }


        .form-control:focus {
            background: #ffffff;

            color: #172033;

            border-color: #ffffff;

            outline: none;

            box-shadow:
                0 0 0 .2rem
                rgba(255, 255, 255, .20);
        }


        /* Browser autofill */

        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover,
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #172033;

            -webkit-box-shadow:
                0 0 0 1000px
                #ffffff inset;

            transition:
                background-color 5000s ease-in-out 0s;
        }


        /* ==========================================================
           REMEMBER ME
           ========================================================== */

        .remember-forgot {
            color: #ffffff;
        }


        .form-check-label {
            color: #ffffff;

            font-size: 14px;

            cursor: pointer;
        }


        .form-check-input {
            cursor: pointer;

            border-color:
                rgba(255, 255, 255, .80);
        }


        .form-check-input:checked {
            background-color: #ffffff;

            border-color: #ffffff;
        }


        .form-check-input:focus {
            border-color: #ffffff;

            box-shadow:
                0 0 0 .15rem
                rgba(255, 255, 255, .20);
        }


        /* ==========================================================
           FORGOT PASSWORD
           ========================================================== */

        .forgot-link {
            color: #ffffff;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;
        }


        .forgot-link:hover,
        .forgot-link:focus {
            color: #ffffff;

            text-decoration: underline;
        }


        /* ==========================================================
           LOGIN BUTTON
           ========================================================== */

        .btn-login {
            width: 100%;

            height: 52px;

            border:
                1px solid
                rgba(255, 255, 255, .32);

            border-radius: 10px;

            background:
                rgba(255, 255, 255, .16);

            color: #ffffff !important;

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            transition:
                transform .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }


        .btn-login i {
            color: #ffffff;
        }


        .btn-login:hover {
            background:
                rgba(255, 255, 255, .24);

            color: #ffffff !important;

            transform:
                translateY(-1px);

            box-shadow:
                0 8px 20px
                rgba(0, 0, 0, .15);
        }


        .btn-login:focus,
        .btn-login:active {
            color: #ffffff !important;
        }


        /* ==========================================================
           VALIDATION
           ========================================================== */

        .validation-summary-errors {
            margin-bottom: 20px;

            padding: 13px 15px;

            border:
                1px solid
                rgba(255, 255, 255, .30);

            border-radius: 9px;

            background:
                rgba(127, 29, 29, .28);

            color: #ffffff !important;

            font-size: 14px;
        }


        .validation-summary-errors ul {
            margin: 0;

            padding-left: 20px;
        }


        .validation-summary-errors li {
            color: #ffffff;
        }


        .field-validation-error,
        .text-danger {
            display: block;

            margin-top: 5px;

            color: #ffffff !important;

            font-size: 12px;
        }


        /* ==========================================================
           PATIENT REGISTRATION
           ========================================================== */

        .register-text {
            margin-top: 25px;

            text-align: center;

            color: #ffffff;

            font-size: 14px;
        }


        .register-text a {
            color: #ffffff;

            font-weight: 700;

            text-decoration: underline;
        }


        .register-text a:hover,
        .register-text a:focus {
            color: #ffffff;

            opacity: .90;
        }


        /* ==========================================================
           BACK TO PORTAL SELECTION
           ========================================================== */

        .back-login {
            margin-top: 20px;

            text-align: center;
        }


        .back-login a {
            color: #ffffff;

            font-size: 13px;

            font-weight: 600;

            text-decoration: none;

            opacity: .90;
        }


        .back-login a:hover,
        .back-login a:focus {
            color: #ffffff;

            text-decoration: underline;

            opacity: 1;
        }


        /* ==========================================================
           SYSTEM NAME
           ========================================================== */

        .system-name {
            margin-top: 28px;

            text-align: center;

            color:
                rgba(255, 255, 255, .82);

            font-size: 12px;

            line-height: 1.6;
        }


        .system-name i {
            margin-right: 4px;

            color: #ffffff;
        }


        /* ==========================================================
           MOBILE
           ========================================================== */

        @@media(max-width: 900px) {

            .auth-image {
                display: none;
            }


            .auth-form-container {
                width: 100%;

                min-height: 100vh;

                padding: 30px;
            }


            .auth-form {
                max-width: 480px;
            }

        }


        @@media(max-width: 500px) {

            .auth-form-container {
                padding: 25px 20px;
            }


            .auth-form h2 {
                font-size: 26px;
            }


            .remember-forgot {
                align-items: flex-start !important;

                flex-direction: column;

                gap: 12px;
            }

        }

    </style>

</head>


<body>


<div class="auth-container">


    <!-- ============================================================
         LEFT IMAGE
         ============================================================ -->

    <section class="auth-image">


        <div class="image-content">


            <!-- PORTAL BADGE -->

            <div class="portal-badge">

                <i class="fa-solid @icon"></i>

                <span>
                    @portalTitle
                </span>

            </div>


            <!-- SYSTEM TITLE -->

            <h1>
                NMB-HLabSys
            </h1>


            <!-- DESCRIPTION -->

            <p>
                @description
            </p>


        </div>


    </section>



    <!-- ============================================================
         RIGHT LOGIN FORM
         ============================================================ -->

    <section class="auth-form-container">


        <div class="auth-form">


            <!-- LOGO -->

            <img src="~/assets/img/logo.png"
                 class="logo"
                 alt="NMB-HLabSys Logo" />


            <!-- ROLE ICON -->

            <div class="role-icon">

                <i class="fa-solid @icon"></i>

            </div>


            <!-- TITLE -->

            <h2>
                @portalTitle
            </h2>


            <!-- SUBTITLE -->

            <p class="subtitle">

                Enter your registered email address
                and password to continue.

            </p>



            <!-- ====================================================
                 VALIDATION
                 ==================================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors">
            </div>



            <!-- ====================================================
                 LOGIN FORM
                 ==================================================== -->

            <form asp-controller="Account"
                  asp-action="RoleLogin"
                  method="post">


                @Html.AntiForgeryToken()


                <!-- ROLE -->

                <input type="hidden"
                       name="role"
                       value="@role" />



                <!-- =================================================
                     EMAIL
                     ================================================= -->

                <div class="mb-3">


                    <label asp-for="Email"
                           class="form-label">
                    </label>


                    <div class="input-wrapper">


                      @*   <i class="fa-solid
                                  fa-envelope
                                  input-icon">
                        </i>
 *@

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               placeholder="name@example.com" />


                    </div>


                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>


                </div>



                <!-- =================================================
                     PASSWORD
                     ================================================= -->

                <div class="mb-3">


                    <label asp-for="Password"
                           class="form-label">
                    </label>


                    <div class="input-wrapper">


                   @*      <i class="fa-solid
                                  fa-lock
                                  input-icon">
                        </i>

 *@
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Enter your password" />


                    </div>


                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>


                </div>



                <!-- =================================================
                     REMEMBER / FORGOT
                     ================================================= -->

                <div class="remember-forgot
                            d-flex
                            justify-content-between
                            align-items-center
                            mb-4">


                    <div class="form-check">


                        <input asp-for="RememberMe"
                               class="form-check-input" />


                        <label asp-for="RememberMe"
                               class="form-check-label">
                        </label>


                    </div>



                    <a href="/Account/ForgotPassword"
                       class="forgot-link">

                        Forgot password?

                    </a>


                </div>



                <!-- =================================================
                     SIGN IN BUTTON
                     ================================================= -->

                <button type="submit"
                        class="btn-login">


                    <i class="fa-solid
                              fa-right-to-bracket
                              me-2">
                    </i>


                    Sign In


                </button>


            </form>



            <!-- ====================================================
                 PATIENT REGISTRATION ONLY
                 ==================================================== -->

            @if (allowRegistration)
            {

                <div class="register-text">


                    Don't have a patient account?


                    <a href="/Account/Register">

                        Create Account

                    </a>


                </div>

            }



            <!-- ====================================================
                 BACK TO PORTALS
                 ==================================================== -->

            <div class="back-login">


                <a href="/Account/Login">

                    <i class="fa-solid
                              fa-arrow-left
                              me-1">
                    </i>

                    Back to portal selection

                </a>


            </div>



            <!-- ====================================================
                 SYSTEM NAME
                 ==================================================== -->

            <div class="system-name">


                <i class="fa-solid fa-shield-halved"></i>

                NMB-HLabSys • Haematology Laboratory
                Test Request Management System


            </div>


        </div>


    </section>


</div>



<!-- ==============================================================
     SCRIPTS
     ============================================================== -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<partial name="_ValidationScriptsPartial" />


</body>

</html>