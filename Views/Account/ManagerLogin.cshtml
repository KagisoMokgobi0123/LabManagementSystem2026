@model NMB_HLabSys.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Lab Manager Login";

    ViewData["Role"] = "Manager";

    ViewData["PortalTitle"] = "Lab Manager Login";

    ViewData["Description"] =
        "Manage laboratory operations, technician assignments, " +
        "test workloads, turnaround times and laboratory performance.";

    ViewData["Image"] =
        "/assets/img/manager-login.jpg";

    ViewData["Icon"] =
        "fa-chart-line";

    ViewData["Primary"] =
        "#4c1d95";

    ViewData["Secondary"] =
        "#7c3aed";

    ViewData["AllowRegistration"] = false;
}

<partial name="_RoleLoginForm" model="Model" />