@model NMB_HLabSys.Models.Account.ChangeTemporaryPasswordViewModel

@{
    Layout = null; ViewData["Title"] = "Change Temporary Password";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Change Temporary Password | NMB-HLabSys</title>

    <!-- GOOGLE FONT -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FONT AWESOME -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- BOOTSTRAP -->

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: #f5f8fc;
            }

            /* ========================================================= PAGE ========================================================= */

            .auth-container {
                min-height: 100vh;
                display: flex;
            }

            /* ========================================================= LEFT SIDE ========================================================= */

            .auth-image {
                width: 48%;
                min-height: 100vh;
                position: relative;
                background: linear-gradient( rgba(6, 30, 54, .72), rgba(0, 103, 140, .78) ), url('/assets/img/laboratory.jpg');
                background-size: cover;
                background-position: center;
                display: flex;
                align-items: flex-end;
                padding: 55px;
            }

                .auth-image::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient( 180deg, rgba(5, 25, 45, .05), rgba(5, 25, 45, .40) );
                    pointer-events: none;
                }

            .image-content {
                position: relative;
                z-index: 2;
                max-width: 620px;
                color: #fff;
            }

            .system-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 9px 16px;
                margin-bottom: 20px;
                border: 1px solid rgba(255,255,255,.30);
                border-radius: 50px;
                background: rgba(255,255,255,.14);
                font-size: 13px;
                font-weight: 700;
                backdrop-filter: blur(5px);
            }

            .image-content h1 {
                margin: 0 0 15px;
                font-size: 43px;
                font-weight: 800;
                color: #fff;
            }

            .image-content p {
                margin: 0;
                color: rgba(255,255,255,.92);
                font-size: 15px;
                line-height: 1.8;
            }

            .security-note {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                margin-top: 25px;
                padding: 16px;
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 10px;
                background: rgba(255,255,255,.10);
                font-size: 12px;
                line-height: 1.8;
            }

                .security-note i {
                    margin-top: 3px;
                    font-size: 19px;
                }

            /* ========================================================= RIGHT SIDE ========================================================= */

            .auth-form-container {
                width: 52%;
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 35px 45px;
                background: linear-gradient( 135deg, #073b5c, #0088a9 );
                color: #fff;
            }

            .auth-form {
                width: 100%;
                max-width: 540px;
            }

            /* ========================================================= LOGO ========================================================= */

            .logo {
                width: 68px;
                height: auto;
                margin-bottom: 18px;
            }

            /* ========================================================= TITLE ========================================================= */

            .auth-form h2 {
                margin: 0 0 7px;
                color: #fff;
                font-size: 29px;
                font-weight: 800;
            }

            .subtitle {
                margin-bottom: 22px;
                color: rgba(255,255,255,.88);
                font-size: 13px;
                line-height: 1.8;
            }

            /* ========================================================= SECURITY NOTICE ========================================================= */

            .security-banner {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                margin-bottom: 22px;
                padding: 14px;
                border: 1px solid rgba(255,255,255,.28);
                border-radius: 9px;
                background: rgba(255,255,255,.10);
            }

                .security-banner > i {
                    margin-top: 3px;
                    font-size: 19px;
                }

                .security-banner strong {
                    display: block;
                    margin-bottom: 4px;
                    font-size: 13px;
                    font-weight: 700;
                }

                .security-banner p {
                    margin: 0;
                    color: rgba(255,255,255,.88);
                    font-size: 12px;
                    line-height: 1.7;
                }

            /* ========================================================= LABEL ========================================================= */

            .form-label {
                margin-bottom: 7px;
                color: #fff;
                font-size: 13px;
                font-weight: 600;
            }

            /* ========================================================= INPUT ========================================================= */

            .input-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                z-index: 5;
                color: #64748b;
                pointer-events: none;
            }

            .form-control {
                width: 100%;
                height: 50px;
                padding-left: 44px;
                padding-right: 44px;
                border: 1px solid rgba(255,255,255,.50);
                border-radius: 9px;
                background: #fff;
                color: #172033;
                font-size: 14px;
            }

                .form-control:focus {
                    background: #fff;
                    color: #172033;
                    border-color: #fff;
                    outline: none;
                    box-shadow: 0 0 0 .2rem rgba(255,255,255,.20);
                }

                .form-control::placeholder {
                    color: #94a3b8;
                }

            .password-toggle {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #64748b;
                cursor: pointer;
                z-index: 6;
            }

                .password-toggle:focus-visible {
                    outline: 2px solid #075985;
                    outline-offset: 2px;
                    border-radius: 4px;
                }

            /* ========================================================= PASSWORD GUIDANCE ========================================================= */

            .password-hint {
                margin-top: 7px;
                color: rgba(255,255,255,.82);
                font-size: 11px;
                line-height: 1.7;
            }

            /* ========================================================= VALIDATION ========================================================= */

            .validation-summary-valid {
                display: none;
            }

            .validation-summary-errors {
                margin-bottom: 16px;
                padding: 11px 14px;
                border: 1px solid rgba(255,255,255,.30);
                border-radius: 8px;
                background: rgba(127,29,29,.28);
                color: #fff !important;
                font-size: 13px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 20px;
                }

            .field-validation-error, .text-danger {
                display: block;
                margin-top: 4px;
                color: #fff !important;
                font-size: 11px;
            }

            .input-validation-error {
                border-color: #fecaca !important;
                box-shadow: 0 0 0 .15rem rgba(254,202,202,.15);
            }

            /* ========================================================= BUTTONS ========================================================= */

            .btn-login {
                width: 100%;
                min-height: 50px;
                border: 1px solid rgba(255,255,255,.32);
                border-radius: 9px;
                background: rgba(255,255,255,.16);
                color: #fff !important;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
                text-decoration: none;
            }

                .btn-login:hover {
                    background: rgba(255,255,255,.25);
                    transform: translateY(-1px);
                    box-shadow: 0 8px 20px rgba(0,0,0,.15);
                }

                .btn-login:disabled {
                    opacity: .75;
                    cursor: not-allowed;
                    transform: none;
                }

            /* ========================================================= SYSTEM FOOTER ========================================================= */

            .system-name {
                margin-top: 22px;
                text-align: center;
                color: rgba(255,255,255,.70);
                font-size: 11px;
                line-height: 1.8;
            }

            /* ========================================================= MOBILE ========================================================= */

            @@media(max-width: 900px) {

                .auth-image {
                    display: none;
                }

                .auth-form-container {
                    width: 100%;
                    min-height: 100vh;
                    padding: 30px;
                }
            }

            @@media(max-width: 500px) {

                .auth-form-container {
                    padding: 25px 18px;
                }

                .auth-form h2 {
                    font-size: 25px;
                }
            }

    </style>

</head>

<body>

    <div class="auth-container">

        <!-- ===================================================== LEFT SIDE ===================================================== -->

        <section class="auth-image">

            <div class="image-content">

                <div class="system-badge">

                    <i class="fa-solid fa-flask-vial"></i>

                    NMB-HLabSys Secure Portal

                </div>

                <h1> Secure Your Account </h1>

                <p> Welcome to the NMB-HLabSys Haematology Laboratory Test Request Management System. Before continuing, update your temporary password to secure your account. </p>

                <div class="security-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <div>

                        <strong> Protect your account </strong>

                        Choose a strong password, keep it confidential, and avoid reusing passwords from other accounts.

                    </div>

                </div>

            </div>

        </section>

        <!-- ===================================================== RIGHT SIDE ===================================================== -->

        <section class="auth-form-container">

            <div class="auth-form">

                <!-- LOGO -->

                <img src="~/assets/img/logo.png" class="logo" alt="NMB-HLabSys Logo" />

                <h2> Change Your Password </h2>

                <p class="subtitle"> Your account requires a password change before you can continue. Enter your current password and choose a new password below. </p>

                <!-- SECURITY NOTICE -->

                <div class="security-banner">

                    <i class="fa-solid fa-lock"></i>

                    <div>

                        <strong> Password update required </strong>

                        <p> Set a new password to complete your account activation and continue to the system. </p>

                    </div>

                </div>

                <!-- VALIDATION SUMMARY -->

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"> </div>

                <!-- ================================================= CHANGE PASSWORD FORM ================================================= -->

                <form asp-area="" asp-controller="Account" asp-action="ChangeTemporaryPassword" method="post" id="changePasswordForm">

                    @Html.AntiForgeryToken()

                    <!-- CURRENT PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="CurrentPassword" class="form-label"> </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-lock input-icon"></i>

                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Enter your current password" />

                            <button type="button" class="password-toggle" data-target="CurrentPassword" aria-label="Show current password">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword" class="text-danger"> </span>

                    </div>

                    <!-- NEW PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="NewPassword" class="form-label"> </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-key input-icon"></i>

                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter your new password" />

                            <button type="button" class="password-toggle" data-target="NewPassword" aria-label="Show new password">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword" class="text-danger"> </span>

                        <div class="password-hint">

                            <i class="fa-solid fa-circle-info me-1"></i>

                            Your new password must contain at least 8 characters.

                        </div>

                    </div>

                    <!-- CONFIRM PASSWORD -->

                    <div class="mb-4">

                        <label asp-for="ConfirmPassword" class="form-label"> </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-shield-halved input-icon"></i>

                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Re-enter your new password" />

                            <button type="button" class="password-toggle" data-target="ConfirmPassword" aria-label="Show password confirmation">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword" class="text-danger"> </span>

                    </div>

                    <!-- SUBMIT BUTTON -->

                    <button type="submit" class="btn-login" id="changePasswordButton">

                        <i class="fa-solid fa-shield-halved me-2"></i>

                        <span id="changePasswordButtonText"> Change Password </span>

                    </button>

                </form>

                <!-- SYSTEM FOOTER -->

                <div class="system-name">

                    <i class="fa-solid fa-shield-halved"></i>

                    NMB-HLabSys • Haematology Laboratory Test Request Management System

                </div>

            </div>

        </section>

    </div>

    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>

        (function () {

        "use strict";

        // ===================================================== // ELEMENTS // =====================================================

        const passwordForm = document.getElementById("changePasswordForm");

        const submitButton = document.getElementById("changePasswordButton");

        const submitButtonText = document.getElementById("changePasswordButtonText");

        const passwordToggles = document.querySelectorAll(".password-toggle");

        // ===================================================== // SHOW / HIDE PASSWORDS // =====================================================

        passwordToggles.forEach(function (button) {

        button.addEventListener("click", function () {

        const targetId = button.dataset.target;

        const passwordInput = document.getElementById(targetId);

        const passwordIcon = button.querySelector("i");

        if (!passwordInput || !passwordIcon) { return; }

        const showing = passwordInput.type === "text";

        passwordInput.type = showing ? "password" : "text";

        passwordIcon.className = showing ? "fa-solid fa-eye" : "fa-solid fa-eye-slash";

        const label = targetId === "CurrentPassword" ? "current password" : targetId === "NewPassword" ? "new password" : "password confirmation";

        button.setAttribute( "aria-label", showing ? "Show " + label : "Hide " + label );

        });

        });

        // ===================================================== // PREVENT DOUBLE SUBMISSION // =====================================================

        if (passwordForm) {

        passwordForm.addEventListener( "submit", function () {

        // Allow jQuery validation to run before // disabling the submit button.

        if ( window.jQuery && window.jQuery.validator && !window.jQuery(passwordForm).valid() ) { return; }

        if (submitButton) {

        submitButton.disabled = true;

        submitButtonText.textContent = "Changing Password...";

        }

        } );

        }

        })();

    </script>

</body>

</html>