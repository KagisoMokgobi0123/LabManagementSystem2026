@using NMB_HLabSys.Models.Account
@model ActivateAccountViewModel

@{
    ViewData["Title"] = "NMB_HLabSys | Activate Account";
    Layout = "_LoginLayout";
}


<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=yes" />


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
          rel="stylesheet">



    <style>

        * {

            font-family:'Inter',
            system-ui,
            -apple-system,
            'Segoe UI',
            Roboto,
            sans-serif;

        }



        body {

            background:

            linear-gradient(135deg,
            #e9f0ff 0%,
            #d9e4f5 100%);

            overflow-x:auto;

        }




        .password-dashboard {

            min-height:100vh;

            padding:2rem 1rem;

            display:flex;

            align-items:center;

            justify-content:center;

        }





        .password-card {

            width:100%;

            max-width:450px;

            border:none;

            border-radius:1.25rem;

            background:white;

            box-shadow:

            0 20px 35px -12px rgba(0,0,0,.15);

        }





        .card-header-brand {


            background:

            linear-gradient(120deg,
            #0b5ed7,
            #0a58ca);



            border-radius:

            1.25rem 1.25rem 0 0;



            padding:1.5rem;



            color:white;



            text-align:center;


        }




        .card-title-icon {


            display:flex;

            justify-content:center;

            align-items:center;

            gap:10px;


        }




        .card-title-icon i {


            font-size:2rem;

        }




        .form-label {


            font-weight:600;

            font-size:.8rem;

            color:#1e2a3e;

        }





        .form-control {


            border-radius:.75rem;

            border:1px solid #e2e8f0;

            background:#fafcff;

            padding:.65rem .85rem;


        }





        .form-control:focus {


            border-color:#0d6efd;


            box-shadow:

            0 0 0 3px rgba(13,110,253,.2);


        }





        .btn-coral {


            background:

            linear-gradient(95deg,
            #ff7e5e,
            #feb47b);



            border:none;

            border-radius:2rem;

            color:white;

            font-weight:600;

            padding:.65rem;

        }





        .btn-outline-soft {


            border-radius:2rem;

            border:1px solid #ced8e6;

            background:white;

            color:#2c3e66;

        }





        .text-danger.small {


            font-size:.7rem;

        }





        .security-note {


            background:#f1f6ff;

            border-radius:.75rem;

            padding:.75rem;

            font-size:.8rem;

            color:#344563;

        }


    </style>


</head>



<body>



<div class="password-dashboard">


    <div class="container">



        <div class="text-center mb-4">


            <h1 class="fw-bold display-6"
                style="color:#1f2b48">


                <i class="fas fa-stethoscope text-primary me-2"></i>

                NMB_HLabSys


            </h1>



            <p class="text-secondary">


                Activate your account and create a new password


            </p>



        </div>






        <div class="card password-card mx-auto">



            <div class="card-header-brand">



                <div class="card-title-icon">


                    <i class="fas fa-key"></i>



                    <h3 class="fw-bold mb-0">

                        Set Password

                    </h3>


                </div>



            </div>





            <div class="card-body p-4">


                    <form method="post"
                          asp-controller="Account"
                          asp-action="Activate">



                    @Html.AntiForgeryToken()

                    

                        <!-- Email<input asp-for="Token"type="hidden" /> -->


                    <div class="mb-3">


                        <label asp-for="Email"
                               class="form-label">


                            <i class="far fa-envelope me-1"></i>

                            Email Address


                        </label>




                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter registered email" />



                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>



                    </div>





                    <!-- Temporary Password -->


                    <div class="mb-3">


                        <label asp-for="TemporaryPassword"
                               class="form-label">


                            <i class="fas fa-unlock-keyhole me-1"></i>

                            Temporary Password


                        </label>




                        <input asp-for="TemporaryPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter password received by email" />



                        <span asp-validation-for="TemporaryPassword"
                              class="text-danger small">
                        </span>



                    </div>
                        <!-- New Password -->


                        <div class="mb-3">


                            <label asp-for="NewPassword"
                                   class="form-label">


                                <i class="fas fa-lock me-1"></i>

                                New Password


                            </label>




                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create new password" />



                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>


                        </div>





                        <!-- Confirm Password -->


                        <div class="mb-3">


                            <label asp-for="ConfirmPassword"
                                   class="form-label">


                                <i class="fas fa-lock me-1"></i>

                                Confirm New Password


                            </label>




                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm new password" />



                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>


                        </div>






                        <div class="security-note mb-4">


                            <i class="fas fa-shield-alt text-primary me-1"></i>


                            Your temporary password will expire after activation.

                            Create a secure password before accessing your account.


                        </div>







                        <div class="d-grid gap-2">



                            <button type="submit"
                                    class="btn btn-coral">


                                <i class="fas fa-check-circle me-1"></i>


                                Activate Account


                            </button>





                            <a asp-controller="Home"
                                   asp-action="LandIn"
                                   class="btn btn-outline-soft">


                                <i class="fas fa-chevron-left me-1"></i>


                                Back


                            </a>


                        </div>







                        <div class="text-center mt-3">


                            <a asp-controller="Account"
                                   asp-action="ForgotPassword"
                                   class="text-link-muted">


                                <i class="fas fa-question-circle"></i>


                                Forgot temporary password?


                            </a>


                        </div>





                    </form>



                </div>


            </div>




            <div class="text-center mt-4">


                <p class="small text-secondary opacity-75">


                    <i class="fas fa-user-shield me-1"></i>


                    Secure account activation · Role based access · NMB_HLabSys


                </p>


            </div>



        </div>


    </div>





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js">
    </script>



</body>


</html>


