@using Microsoft.AspNetCore.Identity
@using NMB_HLabSys.Models.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var doctor = await UserManager.GetUserAsync(User);
    var name = doctor?.FullName ?? "Doctor";
    var initial = string.IsNullOrWhiteSpace(doctor?.FirstName) ? "D" : doctor.FirstName[..1].ToUpperInvariant();
    var title = ViewData["Title"]?.ToString() ?? "Doctor Portal";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title | NMB-HLabSys</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
            :root {
                --navy: #073b5c;
                --blue: #0284c7;
                --soft: #f4f7fb;
            }

            body {
                margin: 0;
                background: var(--soft);
                color: #0f172a;
                font-family: system-ui,-apple-system,"Segoe UI",sans-serif;
            }

            .doctor-shell {
                display: flex;
                min-height: 100vh;
            }

            .doctor-sidebar {
                width: 252px;
                flex: none;
                background: linear-gradient(180deg,#073b5c,#075985);
                color: #fff;
                position: sticky;
                top: 0;
                height: 100vh;
                overflow-y: auto;
            }

            .doctor-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 23px 20px;
                color: #fff;
                text-decoration: none;
                font-weight: 800;
                border-bottom: 1px solid #ffffff25;
            }

                .doctor-brand i {
                    font-size: 25px;
                }

            .doctor-nav {
                padding: 17px 12px;
            }

                .doctor-nav .nav-label {
                    color: #ffffff85;
                    font-size: 10px;
                    letter-spacing: 1.2px;
                    font-weight: 800;
                    padding: 17px 12px 7px;
                }

                .doctor-nav a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 14px;
                    border-radius: 10px;
                    color: #e1f0fa;
                    text-decoration: none;
                    font-size: 13px;
                    margin: 3px 0;
                }

                    .doctor-nav a:hover, .doctor-nav a:focus {
                        background: #ffffff20;
                        color: white;
                    }

                    .doctor-nav a i {
                        width: 19px;
                        text-align: center;
                    }

            .doctor-main {
                flex: 1;
                min-width: 0;
            }

            .doctor-topbar {
                position: sticky;
                top: 0;
                z-index: 1040;
                min-height: 74px;
                background: #fff;
                border-bottom: 1px solid #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 14px;
                padding: 10px 24px;
                box-shadow: 0 2px 10px #0f172a08;
            }

            .top-title {
                font-size: 17px;
                font-weight: 750;
                margin: 0;
            }

            .top-subtitle {
                font-size: 11px;
                color: #64748b;
            }

            .top-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .top-icon {
                border: 1px solid #e2e8f0;
                background: #f8fafc;
                color: #075985;
                width: 42px;
                height: 42px;
                border-radius: 11px;
                display: grid;
                place-items: center;
                position: relative;
            }

                .top-icon:hover {
                    background: #e0f2fe;
                }

            .notice-count {
                position: absolute;
                right: -5px;
                top: -6px;
                border-radius: 999px;
                min-width: 19px;
                height: 19px;
                background: #dc2626;
                color: white;
                font-size: 10px;
                font-weight: 800;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 0 4px;
            }

            .doctor-profile {
                display: flex;
                align-items: center;
                gap: 10px;
                border: 1px solid #e2e8f0;
                background: white;
                border-radius: 12px;
                padding: 5px 10px 5px 5px;
                color: #0f172a;
                text-decoration: none;
            }

            .doctor-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: grid;
                place-items: center;
                background: linear-gradient(135deg,#075985,#0284c7);
                color: white;
                font-weight: 800;
            }

            .profile-meta {
                text-align: left;
                font-size: 12px;
                font-weight: 700;
            }

                .profile-meta small {
                    display: block;
                    color: #64748b;
                    font-weight: 500;
                }

            .doctor-content {
                padding: 0;
            }

            .report-dropdown {
                width: min(390px,calc(100vw - 25px));
                padding: 0;
                border: 1px solid #e2e8f0;
                border-radius: 14px;
                box-shadow: 0 15px 40px #0f172a24;
                overflow: hidden;
            }

            .report-head {
                padding: 15px 17px;
                background: #f8fafc;
                border-bottom: 1px solid #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .report-list {
                max-height: 370px;
                overflow-y: auto;
            }

            .report-item {
                padding: 13px 16px;
                border-bottom: 1px solid #f1f5f9;
                display: flex;
                gap: 10px;
            }

                .report-item:last-child {
                    border: 0;
                }

                .report-item .pdf-symbol {
                    color: #dc2626;
                    font-size: 22px;
                }

                .report-item strong {
                    font-size: 12px;
                    display: block;
                }

                .report-item small {
                    font-size: 11px;
                    color: #64748b;
                }

                .report-item a {
                    font-size: 11px;
                    font-weight: 700;
                }

            .report-prelim {
                font-size: 10px;
                color: #b91c1c;
                font-weight: 800;
            }

            .doctor-footer {
                padding: 20px 24px;
                font-size: 11px;
                color: #64748b;
            }

            .mobile-menu {
                display: none;
            }

            @@media (max-width:850px) {
                .doctor-sidebar {
                    position: fixed;
                    z-index: 1060;
                    transform: translateX(-100%);
                    transition: transform .2s;
                }

                    .doctor-sidebar.show {
                        transform: translateX(0);
                    }

                .mobile-menu {
                    display: grid;
                }

                .doctor-topbar {
                    padding: 10px 13px;
                }

                .profile-meta {
                    display: none;
                }
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="doctor-shell">
        <aside class="doctor-sidebar" id="doctorSidebar">
            <a class="doctor-brand" asp-area="Doctor" asp-controller="Home" asp-action="Index"><i class="fas fa-heart-pulse"></i><span>NMB-HLabSys<br /><small style="font-size:11px;font-weight:400">DOCTOR PORTAL</small></span></a>
            <nav class="doctor-nav" aria-label="Doctor navigation">
                <div class="nav-label">WORKSPACE</div>
                <a asp-area="Doctor" asp-controller="Home" asp-action="Index"><i class="fas fa-gauge-high"></i> Dashboard</a>
                <a asp-area="Doctor" asp-controller="Patients" asp-action="Index"><i class="fas fa-users"></i> My Patients</a>
                <a asp-area="Doctor" asp-controller="TestRequests" asp-action="Index"><i class="fas fa-vials"></i> Test Requests</a>
                <a asp-area="Doctor" asp-controller="TestRequests" asp-action="Create"><i class="fas fa-plus-circle"></i> New Request</a>
                <div class="nav-label">RESULTS & REPORTS</div>
                <a asp-area="Doctor" asp-controller="Results" asp-action="Index"><i class="fas fa-file-medical"></i> Laboratory Results</a>
                <a asp-area="Doctor" asp-controller="Reports" asp-action="Index"><i class="fas fa-file-pdf"></i> Reports</a>
                <a asp-area="Doctor" asp-controller="Alerts" asp-action="Index"><i class="fas fa-bell"></i> Alerts</a>
                <div class="nav-label">ACCOUNT</div>
                <a asp-area="Doctor" asp-controller="Profile" asp-action="Index"><i class="fas fa-user-doctor"></i> My Profile</a>
                <a asp-area="Doctor" asp-controller="Profile" asp-action="ChangePassword"><i class="fas fa-key"></i> Change Password</a>
            </nav>
        </aside>
        <div class="doctor-main">
            <header class="doctor-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="top-icon mobile-menu" id="doctorMenuToggle" aria-label="Toggle navigation"><i class="fas fa-bars"></i></button>
                    <div><h1 class="top-title">@title</h1><div class="top-subtitle">Doctor / Healthcare Provider</div></div>
                </div>
                <div class="top-actions">
                    <div class="dropdown">
                        <button class="top-icon" type="button" id="reportNotificationButton" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Received laboratory PDF reports">
                            <i class="fas fa-file-pdf"></i><span class="notice-count" id="reportCount"></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end report-dropdown" aria-labelledby="reportNotificationButton">
                            <div class="report-head"><strong style="font-size:13px">Received PDF Reports</strong><button type="button" class="btn btn-sm btn-link" id="refreshReports">Refresh</button></div>
                            <div class="report-list" id="reportList"><div class="p-4 text-center text-muted small">Loading reports...</div></div>
                            <div class="p-2 text-center border-top"><a asp-area="Doctor" asp-controller="Results" asp-action="Index" class="small text-decoration-none">View laboratory results</a></div>
                        </div>
                    </div>
                    <a asp-area="Doctor" asp-controller="Alerts" asp-action="Index" class="top-icon" title="Doctor alerts"><i class="fas fa-bell"></i></a>
                    <a asp-area="Doctor" asp-controller="Profile" asp-action="Index" class="doctor-profile" title="My profile"><span class="doctor-avatar">@initial</span><span class="profile-meta">Dr @name<small>My profile</small></span><i class="fas fa-chevron-down small text-muted"></i></a>
                </div>
            </header>
            <main class="doctor-content">@RenderBody()</main>
            <footer class="doctor-footer">&copy; @DateTime.Now.Year NMB Health Laboratory System &middot; Confidential clinical information</footer>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (() => {
                const menu = document.getElementById('doctorMenuToggle');
                menu?.addEventListener('click', () => document.getElementById('doctorSidebar')?.classList.toggle('show'));
                const list = document.getElementById('reportList');
                const badge = document.getElementById('reportCount');
                const emailedEndpoint = '@Url.Action("Recent", "ReceivedReports", new { area = "Doctor" })';
                const portalEndpoint = '@Url.Action("PortalRecent", "ReceivedReports", new { area = "Doctor" })';
                const emailedDownload = '@Url.Action("Download", "ReceivedReports", new { area = "Doctor" })';
                const portalDownload = '@Url.Action("PortalDownload", "ReceivedReports", new { area = "Doctor" })';
                const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

                async function fetchReports(url) {
                    const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
                    if (!response.ok) throw new Error(`Report endpoint returned ${response.status}`);
                    const data = await response.json();
                    return Array.isArray(data) ? data : [];
                }

                async function refresh() {
                    try {
                        // Portal PDFs are available independently of SMTP delivery.
                        const [emailed, portal] = await Promise.all([
                            fetchReports(emailedEndpoint),
                            fetchReports(portalEndpoint)
                        ]);
                        const items = [
                            ...portal.map(r => ({ ...r, source: 'Portal' })),
                            ...emailed.map(r => ({ ...r, source: 'Email' }))
                        ];
                        // Badge counts available reports, not unread notifications.
                        badge.style.display = items.length ? 'flex' : 'none';
                        badge.textContent = items.length > 9 ? '9+' : String(items.length);
                        if (!items.length) {
                            list.innerHTML = '<div class="p-4 text-center text-muted small">No received PDF reports yet.</div>';
                            return;
                        }
                        list.innerHTML = items.map(r => {
                            const portalOnly = r.source === 'Portal';
                            const preliminary = r.reportType === 'Preliminary';
                            const partial = r.reportType === 'PartialVerified';
                            const label = partial ? 'Partial verified-results report'
                                : preliminary ? 'Preliminary laboratory report'
                                    : 'Final laboratory report';
                            const note = partial
                                ? '<span class="report-prelim">INCOMPLETE REQUEST RECORD — NOT A FINAL REPORT</span><br/>'
                                : preliminary
                                    ? '<span class="report-prelim">NOT INDEPENDENTLY VERIFIED</span><br/>'
                                    : '';
                            const timestamp = r.sentAt ? `<small>${escapeHtml(new Date(r.sentAt).toLocaleString())}</small><br/>` : '';
                            const link = portalOnly
                                ? `${portalDownload}?id=${encodeURIComponent(r.testRequestId)}`
                                : `${emailedDownload}?id=${encodeURIComponent(r.id)}`;
                            return `<div class="report-item"><i class="fas fa-file-pdf pdf-symbol"></i><div class="flex-grow-1"><strong>${escapeHtml(label)}</strong><small>Request #${escapeHtml(r.testRequestId)}${r.testRequestTestTypeId ? ' · Test #' + escapeHtml(r.testRequestTestTypeId) : ''}</small><br/>${note}${timestamp}<a href="${link}" target="_blank" rel="noopener noreferrer"><i class="fas fa-file-pdf"></i> View PDF</a></div></div>`;
                        }).join('');
                    } catch (error) {
                        console.error('Unable to load doctor reports:', error);
                        list.innerHTML = '<div class="p-4 text-center text-danger small">Could not load reports. Please retry.</div>';
                        badge.style.display = 'none';
                    }
                }
                document.getElementById('refreshReports')?.addEventListener('click', refresh);
                document.getElementById('reportNotificationButton')?.addEventListener('click', refresh);
                refresh();
                window.setInterval(() => { if (!document.hidden) refresh(); }, 30000);
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
