@using NMB_HLabSys.Areas.Doctor.Models

@{
    ViewBag.Title = "Patient Reports";

    var reports = Model as List<TestRequestsModel>
                  ?? new List<TestRequestsModel>();

    var patientName = ViewBag.PatientName as string ?? "Patient";
    var patientID = ViewBag.PatientID as string ?? "";
}

<style>
    .report-header {
        border-bottom: 2px solid #212529;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

    .report-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .report-card-header {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #dee2e6;
    }

    .report-card-body {
        padding: 20px;
    }

    .report-table th {
        background: #f8f9fa;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .container {
            max-width: 100% !important;
        }

        .report-card {
            break-inside: avoid;
        }
    }
</style>

<div class="container mt-4">

    <!-- TOP ACTIONS -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <a href="@Url.Action("Index", "PatientDashboard")"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>

        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">
            🖨 Print / Save as PDF
        </button>

    </div>

    <!-- REPORT HEADER -->
    <div class="report-header">

        <h2 class="mb-1">
            Patient Laboratory Reports
        </h2>

        <p class="text-muted mb-1">
            NMB-HLabSys Laboratory Test Report
        </p>

        <div class="row mt-3">

            <div class="col-md-6">
                <strong>Patient:</strong>
                @patientName
            </div>

            <div class="col-md-6">
                <strong>Patient ID:</strong>
                @patientID
            </div>

        </div>

        <div class="mt-2">
            <strong>Report Generated:</strong>
            @DateTime.Now.ToString("dd MMMM yyyy HH:mm")
        </div>

    </div>

    <!-- REPORTS -->
    @if (!reports.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <div class="display-5 mb-3">
                    📄
                </div>

                <h5>No Reports Available</h5>

                <p class="text-muted mb-0">
                    You do not currently have any completed laboratory
                    reports available.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <strong>
                @reports.Count Report(s) Available
            </strong>
        </div>

        @foreach (var report in reports)
        {
            <div class="report-card">

                <div class="report-card-header">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <strong>
                                Laboratory Report
                            </strong>

                            <div class="text-muted small">
                                Request:
                                @report.RequestNumber
                            </div>
                        </div>

                        <div>
                            <span class="badge bg-success">
                                @report.Status
                            </span>
                        </div>

                    </div>

                </div>

                <div class="report-card-body">

                    <div class="row mb-3">

                        <div class="col-md-4">
                            <strong>Request Number</strong>
                            <br />
                            @report.RequestNumber
                        </div>

                        <div class="col-md-4">
                            <strong>Request Date</strong>
                            <br />
                            @report.RequestDate.ToString("dd MMM yyyy")
                        </div>

                        <div class="col-md-4">
                            <strong>Urgency</strong>
                            <br />
                            @report.Urgency
                        </div>

                    </div>

                    <hr />

                    <h6 class="mb-3">
                        Laboratory Results
                    </h6>

                    @if (report.TestRequestItems != null &&
                         report.TestRequestItems.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-bordered report-table">

                                <thead>
                                    <tr>
                                        <th>Test</th>
                                        <th>Result</th>
                                        <th>Status</th>
                                        <th>Interpretation</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in report.TestRequestItems)
                                    {
                                        <tr class="@(item.IsAbnormal ? "table-danger" : "")">

                                            <td>
                                                Test #@item.TestTypeID
                                            </td>

                                            <td>
                                                @if (item.ResultValue.HasValue)
                                                {
                                                    @item.ResultValue.Value
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        No result
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @item.Status
                                            </td>

                                            <td>
                                                @if (item.IsAbnormal)
                                                {
                                                    <span class="text-danger fw-bold">
                                                        ⚠ Abnormal
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-success fw-bold">
                                                        Normal
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No test items are associated with this report.
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(report.ClinicalNotes))
                    {
                        <div class="mt-3">

                            <strong>Clinical Notes</strong>

                            <div class="alert alert-light border mt-2">
                                @report.ClinicalNotes
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

    <!-- FOOTER -->
    <div class="text-center text-muted small mt-4 mb-5">

        <p>
            This report is generated from the NMB-HLabSys patient portal.
        </p>

        <p>
            Please consult your healthcare professional for interpretation
            of laboratory results.
        </p>

    </div>

</div>
