    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "My Test Results";
    var requests = Model as List<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>
                   ?? new List<NMB_HLabSys.Areas.Doctor.Models.TestRequestsModel>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>My Test Results</h4>
        <a href="@Url.Action("Index", "PatientDashboard")"
               class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            @if (!requests.Any())
            {
                <p class="text-center text-muted py-4">No results available yet.</p>
            }
            else
            {
                @foreach (var r in requests)
                {
                    <div class="card mb-3 border-success">
                        <div class="card-header bg-success text-white d-flex justify-content-between">
                            <span><strong>@r.RequestNumber</strong> — @r.RequestDate.ToString("dd MMM yyyy")</span>
                            <span class="badge bg-light text-dark">@r.Status</span>
                        </div>
                        <div class="card-body">
                            <p><strong>Clinical Notes:</strong> @r.ClinicalNotes</p>
                            <!--Possible TestRequestID THAT IS NEEDED-->
                            @if (r.TestTypes != null && r.TestTypes.Any())
                            {
                                @* <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Test</th>
                                            <th>Result</th>
                                            <th>Status</th>
                                            <th>Abnormal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in r.TestRequestItems)
                                        {
                                            <tr class="@(item.IsAbnormal ? "table-danger" : "")">
                                                <td>Test #@item.TestTypeID</td>
                                                <td>@(item.ResultValue.HasValue ? item.ResultValue.ToString() : "Pending")</td>
                                                <td>@item.Status</td>
                                                <td>
                                                    @if (item.IsAbnormal)
                                                    {
                                                        <span class="badge bg-danger">⚠ Abnormal</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Normal</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table> *@<!--Kg commented-->
                            }
                            else
                            {
                                <p class="text-muted">No test items found.</p>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
