@model NMB_HLabSys.Areas.Patient.Models.DashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
    Layout = "_Layout";

    var fullName = $"{Model.PatientName} {Model.PatientSurname}".Trim();
    var firstName = Model.PatientName;

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Completed" => "status-completed",
            "ReleasedByDoctor" => "status-released",
            "Submitted" => "status-submitted",
            "InProgress" => "status-progress",
            "Samples Received" => "status-progress",
            _ => "status-default"
        };
    }

    string GetUrgencyClass(string urgency)
    {
        return urgency switch
        {
            "Stat" => "urgency-stat",
            "Urgent" => "urgency-urgent",
            _ => "urgency-routine"
        };
    }
}

<style>

