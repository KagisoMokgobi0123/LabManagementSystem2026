                     class="sidebar-link">

                    <i class="fas fa-file-medical"></i>
                    <span>Patient Reports (PDF)</span>

                </a>

            </nav>


            <div class="sidebar-spacer"></div>

            <div class="sidebar-divider"></div>


            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="sidebar-logout w-100 border-0 bg-transparent">

                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>

                </button>

            </form>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
             ====================================================== -->

        <main class="dashboard-main">


            <!-- TOP BAR -->

            <div class="dashboard-topbar">

                <div class="search-box">

                    <i class="fas fa-search"></i>

                    <span>
                        Search your records...
                    </span>

                </div>


                <div class="top-notification">

                    <i class="far fa-bell"></i>

                    <span class="notification-dot"></span>

                </div>


                <div class="top-user">

                    <div class="top-avatar">
                        @(
                            string.IsNullOrEmpty(firstName)
                            ? "P"
                            : firstName.Substring(0, 1).ToUpper()
                        )
                    </div>

                    <span class="top-user-name">
                        @fullName
                    </span>

                    <i class="fas fa-chevron-down"
                       style="font-size:10px;color:#71839a;"></i>

                </div>

            </div>


            <div class="dashboard-content">


                <!-- =================================================
                     WELCOME
                     ================================================== -->

                <div class="welcome-panel">

                    <div class="welcome-content">

                        <div>

                            <h1 class="welcome-title">
                                Good to see you, @firstName 👋
                            </h1>

                            <p class="welcome-subtitle">
                                Here's an overview of your laboratory requests, results and patient records.
                            </p>

                            <div class="welcome-message">

                                <i class="fas fa-heart"></i>

                                Your health matters. We're here to support you.

                            </div>

                        </div>


                        <div class="welcome-account">

                            <div class="welcome-avatar">

                                @(
                                    string.IsNullOrEmpty(firstName)
                                    ? "P"
                                    : firstName.Substring(0, 1).ToUpper()
                                )

                            </div>

                            <div>

                                <div class="welcome-account-name">
                                    @fullName
                                </div>

                                <div class="welcome-account-email">
                                    @Model.Email
                                </div>

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="logout-btn">

                                        <i class="fas fa-sign-out-alt me-1"></i>
                                        Logout

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     STATISTICS
                     ================================================== -->

                <div class="stat-grid">


                    <div class="stat-card">

                        <div class="stat-icon icon-blue">
                            <i class="fas fa-flask"></i>
                        </div>

                        <div>
                            <div class="stat-label">
                                Test Requests
                            </div>

                            <div class="stat-number">
                                @Model.TotalRequests
                            </div>
                        </div>

                        <div class="stat-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon icon-orange">
                            <i class="fas fa-clock"></i>
                        </div>

                        <div>
                            <div class="stat-label">
                                Pending
                            </div>

                            <div class="stat-number">
                                @Model.PendingRequests
                            </div>
                        </div>

                        <div class="stat-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon icon-green">
                            <i class="fas fa-check"></i>
                        </div>

                        <div>
                            <div class="stat-label">
                                Completed
                            </div>

                            <div class="stat-number">
                                @Model.CompletedRequests
                            </div>
                        </div>

                        <div class="stat-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                    </div>


                    <div class="stat-card">

                        <div class="stat-icon icon-cyan">
                            <i class="fas fa-file-medical"></i>
                        </div>

                        <div>
                            <div class="stat-label">
                                Results Released
                            </div>

                            <div class="stat-number">
                                @Model.ReleasedRequests
                            </div>
                        </div>

                        <div class="stat-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     RECENT REQUESTS + PATIENT INFO
                     ================================================== -->

                <div class="main-grid">


                    <!-- RECENT REQUESTS -->

                    <div class="card-panel">

                        <div class="card-header-custom">

                            <div class="card-heading">

                                <i class="fas fa-flask heading-icon"></i>

                                <div>

                                    <h2 class="card-title">
                                        Recent Laboratory Requests
                                    </h2>

                                    <div class="card-description">
                                        Your most recent test requests and their current status.
                                    </div>

                                </div>

                            </div>

                            <a asp-controller="PatientDashboard"
                                   asp-action="TestRequests"
                                   class="view-all-btn">

                                View All Requests
                                <i class="fas fa-arrow-right ms-1"></i>

                            </a>

                        </div>


                        @if (Model.RecentRequests != null &&
                             Model.RecentRequests.Any())
                        {

                            <div class="table-wrapper">

                                <table class="requests-table">

                                    <thead>

                                        <tr>

                                            <th>
                                                Request #
                                            </th>

                                            <th>
                                                Date
                                            </th>

                                            <th>
                                                Priority
                                            </th>

                                            <th>
                                                Status
                                            </th>

                                            <th>
                                                Result
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var request in Model.RecentRequests)
                                        {

                                            <tr>

                                                <td>

                                                    <span class="request-number">
                                                        @request.RequestNumber
                                                    </span>

                                                </td>


                                                <td>

                                                    <span class="request-date">

                                                        @request.RequestDate.ToString(
                                                            "dd MMM yyyy, HH:mm"
                                                        )

                                                    </span>

                                                </td>


                                                <td>

                                                    @{
                                                        var urgency =
                                                            request.Urgency.ToString();

                                                        var urgencyClass =
                                                            urgency == "Stat"
                                                            ? "priority-stat"
                                                            : urgency == "Urgent"
                                                            ? "priority-urgent"
                                                            : "priority-routine";
                                                    }

                                                    <span class="badge-custom @urgencyClass">

                                                        @if (urgency == "Stat")
                                                        {
                                                            <i class="fas fa-bolt"></i>
                                                        }
                                                        else if (urgency == "Urgent")
                                                        {
                                                            <i class="fas fa-exclamation-circle"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-calendar"></i>
                                                        }

                                                        @urgency

                                                    </span>

                                                </td>


                                                <td>

                                                    <span class="badge-custom @GetStatusClass(request.Status)">

                                                        @if (request.Status == "Completed")
                                                        {
                                                            <i class="fas fa-check-circle"></i>
                                                        }
                                                        else if (request.Status == "ReleasedByDoctor")
                                                        {
                                                            <i class="fas fa-file-medical"></i>
                                                        }
                                                        else if (request.Status == "InProgress")
                                                        {
                                                            <i class="fas fa-spinner"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-circle"></i>
                                                        }

                                                        @request.Status

                                                    </span>

                                                </td>


                                                <td>

                                                    @if (request.Status == "Completed" ||
                                                         request.Status == "ReleasedByDoctor")
                                                    {

                                                        <a asp-controller="PatientDashboard"
                                                               asp-action="TestResults"
                                                               class="result-link">

                                                            View Result

                                                        </a>

                                                    }
                                                    else
                                                    {
                                                        <span style="color:#9aa7b6;">
                                                            -
                                                        </span>
                                                    }

                                                </td>

                                            </tr>

                                        }

                                    </tbody>

                                </table>

                            </div>

                        }
                        else
                        {

                            <div class="empty-state">

                                <div class="empty-icon">
                                    <i class="fas fa-flask"></i>
                                </div>

                                <div class="empty-title">
                                    No laboratory requests yet
                                </div>

                                <div class="empty-text">
                                    Your submitted laboratory requests will appear here.
                                </div>

                            </div>

                        }

                    </div>


                    <!-- PATIENT INFORMATION -->

                    <div class="card-panel">

                        <div class="card-header-custom">

                            <div class="card-heading">

                                <i class="fas fa-user heading-icon"></i>

                                <div>

                                    <h2 class="card-title">
                                        Patient Information
                                    </h2>

                                    <div class="card-description">
                                        Your registered patient details.
                                    </div>

                                </div>

                            </div>

                            <a asp-controller="PatientDashboard"
                                   asp-action="Profile"
                                   class="edit-profile">

                                <i class="fas fa-pen me-1"></i>
                                Edit Profile

                            </a>

                        </div>


                        <div class="patient-info-body">


                            <div class="patient-profile">

                                <div class="large-avatar">

                                    @(
                                        string.IsNullOrEmpty(firstName)
                                        ? "P"
                                        : firstName.Substring(0, 1).ToUpper()
                                    )

                                </div>

                                <div>

                                    <p class="patient-name">
                                        @fullName
                                    </p>

                                    <span class="patient-status">
                                        <i class="fas fa-check-circle me-1"></i>
                                        Registered Patient
                                    </span>

                                </div>

                            </div>


                            <div class="info-row">

                                <i class="fas fa-envelope"></i>

                                <div>

                                    <span class="info-label">
                                        Email
                                    </span>

                                    <span class="info-value">
                                        @Model.Email
                                    </span>

                                </div>

                            </div>


                            <div class="info-row">

                                <i class="fas fa-phone"></i>

                                <div>

                                    <span class="info-label">
                                        Contact
                                    </span>

                                    <span class="info-value">
                                        @Model.ContactNumber
                                    </span>

                                </div>

                            </div>


                            <div class="info-row">

                                <i class="fas fa-map-marker-alt"></i>

                                <div>

                                    <span class="info-label">
                                        Address
                                    </span>

                                    <span class="info-value">
                                        @Model.Address
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BOTTOM SECTION
                     ================================================== -->

                <div class="bottom-grid">


                    <!-- QUICK ACTIONS -->

                    <div class="card-panel">

                        <div class="card-header-custom">

                            <div class="card-heading">

                                <i class="fas fa-bolt heading-icon"></i>

                                <div>

                                    <h2 class="card-title">
                                        Quick Actions
                                    </h2>

                                    <div class="card-description">
                                        Access your most important patient services.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="actions-body">

                            <div class="action-grid">


                                <a asp-controller="PatientDashboard"
                                       asp-action="TestResults"
                                       class="action-card">

                                    <div class="action-icon action-blue">
                                        <i class="fas fa-flask"></i>
                                    </div>

                                    <div>

                                        <div class="action-title">
                                            Test Results
                                        </div>

                                        <div class="action-description">
                                            View released laboratory results
                                        </div>

                                    </div>

                                </a>


                                <a asp-controller="PatientDashboard"
                                       asp-action="MedicalHistory"
                                       class="action-card">

                                    <div class="action-icon action-green">
                                        <i class="fas fa-notes-medical"></i>
                                    </div>

                                    <div>

                                        <div class="action-title">
                                            Medical History
                                        </div>

                                        <div class="action-description">
                                            Conditions, allergies and medication
                                        </div>

                                    </div>

                                </a>


                                <a asp-controller="PatientDashboard"
                                       asp-action="Consent"
                                       class="action-card">

                                    <div class="action-icon action-orange">
                                        <i class="fas fa-user-shield"></i>
                                    </div>

                                    <div>

                                        <div class="action-title">
                                            Consent Management
                                        </div>

                                        <div class="action-description">
                                            Manage access to your records
                                        </div>

                                    </div>

                                </a>


                                <a asp-controller="PatientDashboard"
                                       asp-action="TestRequests"
                                       class="action-card">

                                    <div class="action-icon action-purple">
                                        <i class="fas fa-file-medical"></i>
                                    </div>

                                    <div>

                                        <div class="action-title">
                                            Test Requests
                                        </div>

                                        <div class="action-description">
                                            View and track your requests
                                        </div>

                                    </div>

                                </a>

                            </div>

                        </div>

                    </div>


                    <!-- RECENT ACTIVITY -->

                    <div class="card-panel">

                        <div class="card-header-custom">

                            <div class="card-heading">

                                <i class="far fa-clock heading-icon"></i>

                                <div>

                                    <h2 class="card-title">
                                        Recent Activity
                                    </h2>

                                    <div class="card-description">
                                        Your latest actions and updates.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="activity-body">

                            @if (Model.RecentRequests != null &&
                                 Model.RecentRequests.Any())
                            {

                                @foreach (var request in Model.RecentRequests.Take(4))
                                {

                                    <div class="activity-item">

                                        <div class="activity-dot"></div>

                                        <div style="flex:1;">

                                            @if (request.Status == "Completed" ||
                                                 request.Status == "ReleasedByDoctor")
                                            {
                                                <div class="activity-title">
                                                    Test result released
                                                </div>
                                            }
                                            else if (request.Status == "Submitted")
                                            {
                                                <div class="activity-title">
                                                    Test request submitted
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="activity-title">
                                                    Test request pending
                                                </div>
                                            }

                                            <div class="activity-description">
                                                @request.RequestNumber
                                            </div>

                                        </div>

                                        <div class="activity-date">

                                            @request.RequestDate.ToString("dd MMM")

                                        </div>

                                    </div>

                                }

                            }
                            else
                            {

                                <div class="activity-item">

                                    <div class="activity-dot"></div>

                                    <div>

                                        <div class="activity-title">
                                            Account registered
                                        </div>

                                        <div class="activity-description">
                                            Your patient account is active.
                                        </div>

                                    </div>

                                </div>

                            }

                        </div>


                        <div class="activity-footer">

                            <a href="#">
                                View All Activity
                                <i class="fas fa-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </div>


                    <!-- HEALTH / PRIVACY -->

                    <div class="health-column">


                        <div class="health-card">

                            <div class="health-icon">
                                <i class="fas fa-heartbeat"></i>
                            </div>

                            <div class="health-title">
                                Stay informed, stay healthy
                            </div>

                            <div class="health-text">
                                Keep track of your test results,
                                manage your medical information and
                                take control of your healthcare journey.
                            </div>

                        </div>


                        <div class="privacy-card">

                            <div class="privacy-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>

                            <div>

                                <div class="privacy-title">
                                    Secure • Private • In Your Control
                                </div>

                                <div class="privacy-text">
                                    Your health data is protected and
                                    only accessible to you and authorised
                                    healthcare professionals.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>

</div>


@section Scripts {

    <script>

        console.log("NMB-HLabSys Patient Dashboard loaded.");

    </script>

}