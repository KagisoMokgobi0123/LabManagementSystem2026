@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using NMB_HLabSys.Areas.Doctor.Models

@{
    ViewBag.Title = "Track Results Over Time";

    var results = Model as List<TestRequestsModel>
                  ?? new List<TestRequestsModel>();
}

<style>
    .results-page {
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
        padding: 30px;
    }

    .results-header {
        background: white;
        border-radius: 16px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .results-header h2 {
        margin: 0;
        font-weight: 700;
        color: #1f2937;
    }

    .results-header p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .result-card {
        background: white;
        border-radius: 16px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .result-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .request-number {
        font-weight: 700;
        color: #1f2937;
    }

    .request-date {
        font-size: 13px;
        color: #6b7280;
    }

    .result-card-body {
        padding: 20px;
    }

    .result-table {
        margin-bottom: 0;
    }

    .normal-result {
        color: #15803d;
        font-weight: 600;
    }

    .abnormal-result {
        color: #dc2626;
        font-weight: 600;
    }

    .empty-state {
        background: white;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .empty-state-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .info-box {
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 25px;
        color: #1e40af;
    }

    @@media (max-width: 768px) {
        .results-page {
            padding: 15px;
        }

        .result-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }
    }
</style>

<div class="results-page">

    <!-- Back to Dashboard -->
    <a href="@Url.Action("Index", "PatientDashboard")"
       class="btn btn-outline-secondary mb-4">
        ← Back to Dashboard
    </a>

    <!-- Header -->
    <div class="results-header">
        <h2>Track Results Over Time</h2>
        <p>
            Review your completed laboratory results and monitor your test history.
        </p>
    </div>

    <!-- Information -->
    <div class="info-box">
        <strong>📊 Your Results History</strong><br />
        This section shows laboratory requests that have been completed
        or released by a doctor.
    </div>

    @if (!results.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                📈
            </div>

            <h5>No Results Available Yet</h5>

            <p class="text-muted mb-0">
                Your completed laboratory results will appear here once they
                have been released.
            </p>

        </div>
    }
    else
    {
        @foreach (var request in results)
        {
            <div class="result-card">

                <!-- Request Header -->
                <div class="result-card-header">

                    <div>
                        <div class="request-number">
                            @request.RequestNumber
                        </div>

                        <div class="request-date">
                            @request.RequestDate.ToString("dd MMMM yyyy")
                        </div>
                    </div>

                    @if (request.Status == "ReleasedByDoctor")
                    {
                        <span class="badge bg-success">
                            Released
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary">
                            Completed
                        </span>
                    }

                </div>

                <!-- Results -->
                <div class="result-card-body">

                    @if (!string.IsNullOrWhiteSpace(request.ClinicalNotes))
                    {
                        <p>
                            <strong>Clinical Notes:</strong>
                            @request.ClinicalNotes
                        </p>
                    }

                    @if (request.TestRequestItems != null &&
                         request.TestRequestItems.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover result-table">

                                <thead class="table-light">
                                    <tr>
                                        <th>Test</th>
                                        <th>Result</th>
                                        <th>Status</th>
                                        <th>Interpretation</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in request.TestRequestItems)
                                    {
                                        <tr>

                                            <td>
                                                Test #@item.TestTypeID
                                            </td>

                                            <td>
                                                @if (item.ResultValue.HasValue)
                                                {
                                                    <strong>@item.ResultValue.Value</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        No result
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @item.Status
                                            </td>

                                            <td>
                                                @if (item.IsAbnormal)
                                                {
                                                    <span class="abnormal-result">
                                                        ⚠ Abnormal
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="normal-result">
                                                        ✓ Normal
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No individual test results are available for this request.
                        </p>
                    }

                </div>

            </div>
        }
    }

</div>
